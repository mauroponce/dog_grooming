{
	# Caddy only emits certificates for customer domains that Rails has explicitly
	# enabled. The permission endpoint is reachable only on the Docker network.
	on_demand_tls {
		ask http://web:80/internal/caddy/tls-permission
	}
}

(app_proxy) {
	encode zstd gzip
	reverse_proxy web:80
}

{$APP_HOST:cita.pet} {
	import app_proxy
}

{$APP_WWW_HOST:www.cita.pet} {
	redir https://{$APP_HOST:cita.pet}{uri} permanent
}

# Customer domains resolve to the same server (typically through a CNAME to
# custom.cita.pet). Caddy obtains their certificate on the first TLS
# handshake only after Rails authorizes the domain in the database.
https:// {
	tls {
		on_demand
	}
	import app_proxy
}

http:// {
	redir https://{host}{uri} permanent
}
