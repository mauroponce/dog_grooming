# Copiá este archivo como .env.production en el servidor y reemplazá cada valor.
# Nunca confirmes el archivo real ni secretos.
SECRET_KEY_BASE=replace-with-a-long-random-secret
DOG_GROOMING_DATABASE_PASSWORD=replace-with-a-unique-database-password

APP_HOST=cita.pet
APP_WWW_HOST=www.cita.pet
APP_HOSTS=cita.pet,www.cita.pet
APP_PROTOCOL=https
FORCE_SSL=true

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM=Cita.pet <notificaciones@cita.pet>
MAIL_FROM=Cita.pet <notificaciones@cita.pet>

ACTIVE_STORAGE_SERVICE=r2
CLOUDFLARE_ACCESS_KEY_ID=replace-with-r2-access-key
CLOUDFLARE_SECRET_ACCESS_KEY=replace-with-r2-secret-key
CLOUDFLARE_R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=dog-grooming
CLOUDFLARE_R2_SERVICE_IMAGES_BUCKET=dog-grooming-service-images

# Opcionales: métricas oficiales del panel superadmin.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_R2_ANALYTICS_TOKEN=

RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
JOB_CONCURRENCY=1
POSTGRES_BACKUP_RETENTION_DAYS=30
