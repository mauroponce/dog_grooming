<% content_for :title, "Promos · #{@business.name}" %>
<% content_for :full_width, true %>

<div class="relative min-h-screen overflow-hidden bg-[#F7F7FA] text-ink antialiased">
  <%= render "public_booking/booking_header", business: @business, show_banner: false %>

  <main class="relative z-10 mx-auto w-full max-w-7xl px-4 pb-10 pt-8 sm:px-7 sm:pt-10 lg:px-10">
    <section class="rounded-[30px] border border-white/90 bg-white/95 p-6 shadow-soft sm:p-8">
      <p class="text-xs font-bold uppercase tracking-[.16em] text-brand-700">Promos</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">Oportunidades activas</h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-zinc-500">Promos y acciones vigentes de <%= @business.name %>.</p>

      <div class="mt-7 grid gap-4 md:grid-cols-2">
        <% @promotions.each do |promotion| %>
          <article class="rounded-3xl border border-zinc-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-[.12em] text-brand-700"><%= promotion.promotion_type.humanize %></p>
            <h2 class="mt-2 text-xl font-bold text-zinc-950"><%= promotion.name %></h2>
            <p class="mt-2 text-sm font-semibold leading-6 text-zinc-600"><%= promotion.description %></p>
            <%= link_to "Reservar", promotion.campaign_link&.tracked_url.presence || public_business_path(@business.slug), class: "mt-4 inline-flex h-11 items-center rounded-2xl bg-ink px-5 text-sm font-bold text-white" %>
          </article>
        <% end %>
        <% if @promotions.empty? %>
          <p class="rounded-3xl border border-dashed border-zinc-200 bg-zinc-50 p-6 text-sm font-semibold text-zinc-500">No hay promos activas en este momento.</p>
        <% end %>
      </div>
    </section>
  </main>
</div>
