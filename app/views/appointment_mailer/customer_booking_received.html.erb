<% confirmed_booking = @appointment.confirmed? %>
<% content_for :email_preheader, confirmed_booking ? "Tu turno en #{@business.name} está confirmado." : "Recibimos tu solicitud de turno en #{@business.name}." %>
<% content_for :email_badge, "Reserva" %>
<% content_for :email_status, confirmed_booking ? "Turno confirmado" : "Solicitud recibida" %>
<% content_for :email_footer_note, "Este email fue enviado porque solicitaste un turno en #{@business.name}." %>

<h1><%= confirmed_booking ? "Tu turno está confirmado" : "Recibimos tu solicitud de turno" %></h1>

<p>
  Hola <%= @appointment.customer_name %>,
  <% if confirmed_booking %>
    tu turno en <strong><%= @business.name %></strong> quedó confirmado.
  <% else %>
    recibimos tu solicitud en <strong><%= @business.name %></strong>.
  <% end %>
</p>

<div class="email-card" style="margin-top:24px;">
  <div class="email-card-inner">
    <div class="email-card-title">Detalle de la reserva</div>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top:10px;">
      <tr class="email-detail-row">
        <td class="email-detail-label">Servicio</td>
        <td class="email-detail-value"><%= @appointment.service.name %></td>
      </tr>
      <tr>
        <td class="email-detail-label">Turno</td>
        <td class="email-detail-value"><%= CustomerDateFormatter.datetime_label(@appointment.starts_at) %></td>
      </tr>
    </table>
  </div>
</div>

<p style="margin-top:24px;"><%= link_to "Ver mi reserva", @booking_url, class: "email-button button" %></p>

<% if @appointment.deposit_submitted? %>
  <div class="email-note">También recibimos tu comprobante de pago. El turno queda pendiente hasta que el centro lo revise.</div>
<% elsif @appointment.manual_payment_required? %>
  <p>Para avanzar con la reserva, subí el comprobante de pago.</p>
  <p><%= link_to "Subir comprobante", @deposit_upload_url, class: "email-button button" %></p>
<% elsif confirmed_booking && @appointment.mercado_pago_payment_required? %>
  <p>El pago se acreditó por Mercado Pago y la reserva quedó confirmada automáticamente.</p>
<% elsif confirmed_booking %>
  <p>Te esperamos en el horario indicado.</p>
<% else %>
  <p>El centro revisará la solicitud y te confirmará por email.</p>
<% end %>
