<div class="mx-auto max-w-xl px-4 py-10 sm:px-7">
  <section class="overflow-hidden rounded-lg border border-zinc-200 bg-white shadow-sm">
    <div class="border-b border-zinc-100 p-5 sm:p-7">
      <p class="text-xs font-bold uppercase tracking-[.16em] text-brand-700">Invitación de empleado</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight text-zinc-950">Crear acceso</h1>
      <p class="mt-2 text-sm leading-6 text-zinc-500"><%= @membership.business.name %> te invitó a gestionar turnos en Cita.pet.</p>
    </div>

    <div class="space-y-5 p-5 sm:p-7">
      <p class="text-sm leading-6 text-zinc-600">Continuá con la cuenta de Google de <strong><%= @membership.email_address %></strong> para activar tu acceso.</p>
      <%= button_to "/auth/google_oauth2?origin=employee_invitation:#{params[:token]}", method: :post, class: "inline-flex h-12 w-full cursor-pointer items-center justify-center rounded-lg bg-zinc-950 px-5 text-sm font-bold text-white shadow-lg shadow-zinc-900/15 transition hover:-translate-y-0.5 hover:bg-zinc-800" do %>
        Continuar con Google
      <% end %>
    </div>
  </section>
</div>
