<% content_for :title, "Mi reserva · #{@business.name}" %>
<% content_for :full_width, true %>

<% upload_accept = ".jpg,.jpeg,.png,.webp,.pdf,image/jpeg,image/png,image/webp,application/pdf" %>
<% can_upload_receipt = @appointment.manual_payment_required? && !@appointment.confirmed? && @appointment.deposit_status != "approved" && !@appointment.terminal_status? %>
<% pet = @appointment.pet %>
<% pet_details = [ pet&.breed, pet&.size_label, pet&.sex_label ].compact_blank %>

<div class="min-h-screen bg-[#F7F7FA] px-4 py-6 text-zinc-950 sm:px-6 sm:py-10">
  <div class="mx-auto max-w-5xl">
    <header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <%= link_to public_business_path(@business.slug), class: "flex min-w-0 items-center gap-3" do %>
        <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-zinc-950 text-sm font-bold text-white shadow-lg shadow-zinc-900/15"><%= @business.initials %></span>
        <span class="min-w-0">
          <span class="block truncate text-base font-bold"><%= @business.name %></span>
          <span class="block truncate text-xs font-semibold text-zinc-500"><%= @business.public_city %></span>
        </span>
      <% end %>
      <div class="flex flex-wrap gap-2">
        <% if customer_portal_authenticated? %>
          <%= link_to "Mis turnos", customer_portal_dashboard_path(@business.slug), class: "inline-flex h-11 items-center justify-center rounded-2xl border border-zinc-200 bg-white px-4 text-sm font-bold text-zinc-800 shadow-sm" %>
        <% else %>
          <%= link_to "Ver mis turnos", customer_portal_entry_path(@business.slug), class: "inline-flex h-11 items-center justify-center rounded-2xl border border-zinc-200 bg-white px-4 text-sm font-bold text-zinc-800 shadow-sm" %>
        <% end %>
        <%= link_to "Reservar", public_business_path(@business.slug), class: "inline-flex h-11 items-center justify-center rounded-2xl bg-zinc-950 px-4 text-sm font-bold text-white shadow-lg shadow-zinc-900/15" %>
      </div>
    </header>

    <div class="mt-6 grid gap-5 lg:grid-cols-[minmax(0,1fr)_340px]">
      <main class="rounded-[32px] border border-white bg-white p-5 shadow-card sm:p-7">
        <span class="inline-flex rounded-full px-3 py-1.5 text-[11px] font-bold uppercase tracking-[.12em] <%= portal_booking_status_classes(@appointment) %>"><%= appointment_status_label(@appointment) %></span>
        <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl"><%= @appointment.service.name %></h1>
        <p class="mt-3 text-sm font-semibold leading-6 text-zinc-600">
          <% if pet.present? %>
            Reserva para la mascota <span class="font-bold text-zinc-950"><%= pet.name %></span>, a cargo de <span class="font-bold text-zinc-950"><%= @appointment.customer_name %></span>, en <%= @business.name %>.
          <% else %>
            Reserva para <span class="font-bold text-zinc-950"><%= @appointment.customer_name %></span> en <%= @business.name %>.
          <% end %>
        </p>

        <section class="mt-6 grid gap-3 sm:grid-cols-3">
          <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-4">
            <p class="text-[10px] font-bold uppercase tracking-[.12em] text-zinc-400">Fecha</p>
            <p class="mt-1 text-sm font-bold text-zinc-950"><%= format_ar_date(@appointment.starts_at) %></p>
          </div>
          <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-4">
            <p class="text-[10px] font-bold uppercase tracking-[.12em] text-zinc-400">Hora</p>
            <p class="mt-1 text-sm font-bold text-zinc-950"><%= format_ar_time(@appointment.starts_at) %></p>
          </div>
          <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-4">
            <p class="text-[10px] font-bold uppercase tracking-[.12em] text-zinc-400">Duración</p>
            <p class="mt-1 text-sm font-bold text-zinc-950"><%= @appointment.service.duration_minutes %> min</p>
          </div>
        </section>

        <% if @appointment.deposit_required? %>
          <section class="mt-6 rounded-[28px] border border-zinc-200 bg-white p-5">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <p class="text-xs font-bold uppercase tracking-[.14em] text-brand-700">Seña</p>
                <h2 class="mt-1 text-xl font-bold"><%= @appointment.mercado_pago_payment_required? ? "Mercado Pago" : "Comprobante" %></h2>
                <p class="mt-1 text-sm font-semibold leading-6 text-zinc-600">Estado: <span class="font-bold"><%= appointment_deposit_status_label(@appointment) %></span></p>
              </div>
              <span class="self-start rounded-full px-2.5 py-1 text-[11px] font-bold <%= portal_deposit_status_classes(@appointment) %>"><%= @appointment.formatted_deposit_amount %></span>
            </div>

            <% if @appointment.deposit_receipt.attached? %>
              <div class="mt-4 rounded-2xl border border-zinc-200 bg-zinc-50 p-4">
                <p class="text-sm font-bold text-zinc-950"><%= @appointment.deposit_receipt.filename %></p>
                <p class="mt-1 text-xs font-semibold text-zinc-500">Recibido <%= format_ar_datetime(@appointment.deposit_submitted_at) if @appointment.deposit_submitted_at.present? %></p>
              </div>
            <% end %>

            <% if @appointment.pending_deposit_review? %>
              <p class="mt-4 rounded-2xl bg-amber-50 p-4 text-sm font-semibold leading-6 text-amber-900">El centro está revisando el comprobante. Si subiste un archivo equivocado, podés reemplazarlo.</p>
            <% elsif @appointment.deposit_rejected? && @appointment.deposit_rejection_reason.present? %>
              <p class="mt-4 rounded-2xl bg-rose-50 p-4 text-sm font-semibold leading-6 text-rose-900"><span class="font-bold">Motivo del rechazo:</span> <%= @appointment.deposit_rejection_reason %></p>
            <% end %>

            <% if can_upload_receipt %>
              <%= form_with url: customer_portal_booking_receipt_path(@business.slug, @appointment.customer_portal_booking_token), class: "mt-5 grid gap-4", html: { multipart: true } do %>
                <div>
                  <%= label_tag :deposit_receipt, @appointment.deposit_receipt.attached? ? "Reemplazar comprobante" : "Subir comprobante", class: "mb-2 block text-sm font-bold text-zinc-900" %>
                  <%= file_field_tag :deposit_receipt, required: true, accept: upload_accept, class: "block w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm font-semibold text-zinc-700 file:mr-4 file:rounded-xl file:border-0 file:bg-zinc-950 file:px-4 file:py-2.5 file:text-xs file:font-bold file:text-white" %>
                  <p class="mt-2 text-xs font-semibold leading-5 text-zinc-500">JPG, JPEG, PNG, WebP o PDF. Máximo 5 MB.</p>
                </div>
                <%= submit_tag @appointment.deposit_receipt.attached? ? "Reemplazar comprobante" : "Enviar comprobante", class: "h-12 cursor-pointer rounded-2xl bg-zinc-950 px-5 text-sm font-bold text-white shadow-lg shadow-zinc-900/15 transition hover:bg-zinc-800" %>
              <% end %>
            <% end %>
          </section>
        <% end %>

        <% deposit_payment_details = @appointment.service.deposit_payment_details %>
        <% deposit_payment_link = @appointment.service.external_payment_link.presence || (@appointment.service.effective_payment_account.blank? ? @business.deposit_payment_link.presence : nil) %>
        <% if @appointment.service.before_care.present? || @appointment.service.after_care.present? || (@appointment.manual_payment_required? && (deposit_payment_details.present? || deposit_payment_link.present?)) %>
          <section class="mt-6 rounded-[28px] border border-zinc-200 bg-white p-5">
            <h2 class="text-xl font-bold">Indicaciones del centro</h2>
            <div class="mt-4 grid gap-3">
              <% if @appointment.service.before_care.present? %>
                <article class="rounded-2xl bg-zinc-50 p-4">
                  <p class="text-xs font-bold uppercase tracking-[.12em] text-zinc-400">Antes del turno</p>
                  <p class="mt-2 whitespace-pre-line text-sm font-semibold leading-6 text-zinc-700"><%= @appointment.service.before_care %></p>
                </article>
              <% end %>
              <% if @appointment.service.after_care.present? %>
                <article class="rounded-2xl bg-zinc-50 p-4">
                  <p class="text-xs font-bold uppercase tracking-[.12em] text-zinc-400">Después del turno</p>
                  <p class="mt-2 whitespace-pre-line text-sm font-semibold leading-6 text-zinc-700"><%= @appointment.service.after_care %></p>
                </article>
              <% end %>
              <% if @appointment.manual_payment_required? && (deposit_payment_details.present? || deposit_payment_link.present?) %>
                <article class="rounded-2xl bg-amber-50 p-4">
                  <p class="text-xs font-bold uppercase tracking-[.12em] text-amber-700">Seña</p>
                  <% if deposit_payment_details.present? %>
                    <p class="mt-2 whitespace-pre-line text-sm font-semibold leading-6 text-amber-900"><%= deposit_payment_details %></p>
                  <% end %>
                  <% if deposit_payment_link.present? %>
                    <%= link_to "Abrir enlace de pago", deposit_payment_link, target: "_blank", rel: "noopener", class: "mt-3 inline-flex h-10 items-center justify-center rounded-full bg-zinc-950 px-4 text-xs font-bold text-white" %>
                  <% end %>
                </article>
              <% end %>
            </div>
          </section>
        <% end %>

        <% customer_portal_path = @appointment.customer_profile.present? ? customer_portal_profile_access_path(@business.slug, @appointment.customer_profile.customer_portal_short_token.presence || @appointment.customer_profile.customer_portal_token) : customer_portal_entry_path(@business.slug) %>
        <section class="mt-6 rounded-[28px] border border-zinc-200 bg-white p-5">
          <h2 class="text-xl font-bold">Acciones</h2>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <% if @appointment.confirmed? && @appointment.google_calendar_available_for_customer? %>
              <%= link_to @appointment.google_calendar_url, target: "_blank", rel: "noopener", class: "inline-flex h-12 items-center justify-center gap-2 rounded-2xl border border-zinc-200 bg-white px-5 text-sm font-bold text-zinc-800 shadow-sm" do %>
                <%= public_icon("calendar", css: "h-4 w-4") %>
                Agregar a Google Calendar
              <% end %>
            <% end %>

            <%= link_to customer_portal_path, class: "inline-flex h-12 items-center justify-center gap-2 rounded-2xl border border-zinc-200 bg-white px-5 text-sm font-bold text-zinc-800 shadow-sm" do %>
              <%= public_icon("list", css: "h-4 w-4") %>
              Gestionar mis turnos
            <% end %>
          </div>
        </section>
      </main>

      <aside class="space-y-5">
        <section class="rounded-[32px] border border-white bg-white p-5 shadow-card">
          <p class="text-xs font-bold uppercase tracking-[.14em] text-brand-700">Detalle</p>
          <dl class="mt-4 grid gap-3 text-sm">
            <% if pet.present? %>
              <div class="flex justify-between gap-4 border-b border-zinc-100 pb-3">
                <dt class="font-semibold text-zinc-500">Mascota</dt>
                <dd class="text-right font-bold text-zinc-950"><%= pet.name %></dd>
              </div>
              <% if pet_details.any? %>
                <div class="flex justify-between gap-4 border-b border-zinc-100 pb-3">
                  <dt class="font-semibold text-zinc-500">Datos de mascota</dt>
                  <dd class="text-right font-bold text-zinc-950"><%= pet_details.join(" · ") %></dd>
                </div>
              <% end %>
              <div class="flex justify-between gap-4 border-b border-zinc-100 pb-3">
                <dt class="font-semibold text-zinc-500">Responsable</dt>
                <dd class="text-right font-bold text-zinc-950"><%= @appointment.customer_name %></dd>
              </div>
            <% else %>
              <div class="flex justify-between gap-4 border-b border-zinc-100 pb-3">
                <dt class="font-semibold text-zinc-500">Cliente</dt>
                <dd class="text-right font-bold text-zinc-950"><%= @appointment.customer_name %></dd>
              </div>
            <% end %>
            <div class="flex justify-between gap-4 border-b border-zinc-100 pb-3">
              <dt class="font-semibold text-zinc-500">WhatsApp</dt>
              <dd class="text-right font-bold text-zinc-950"><%= @appointment.customer_phone %></dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-zinc-100 pb-3">
              <dt class="font-semibold text-zinc-500">Lugar</dt>
              <dd class="text-right font-bold text-zinc-950"><%= portal_appointment_location(@appointment) %></dd>
            </div>
            <% if portal_professional_visible?(@appointment) && @appointment.employee_membership.present? %>
              <div class="flex justify-between gap-4 border-b border-zinc-100 pb-3">
                <dt class="font-semibold text-zinc-500">Profesional</dt>
                <dd class="text-right font-bold text-zinc-950"><%= @appointment.employee_membership.name %></dd>
              </div>
            <% end %>
            <div class="flex justify-between gap-4">
              <dt class="font-semibold text-zinc-500">Total</dt>
              <dd class="text-right font-bold text-zinc-950"><%= portal_money(@appointment.current_total_price_cents) %></dd>
            </div>
          </dl>
        </section>

        <section class="rounded-[32px] border border-white bg-white p-5 shadow-card">
          <h2 class="text-lg font-bold text-zinc-950">Enlace seguro</h2>
          <p class="mt-2 text-sm font-semibold leading-6 text-zinc-500">Guardá este link para volver a consultar esta reserva.</p>
          <div class="mt-4 flex items-center gap-2" data-controller="copy-text" data-copy-text-preserve-content-value="true">
            <a href="<%= @appointment.customer_portal_booking_url %>" target="_blank" rel="noopener" data-copy-text-target="source" class="min-w-0 flex-1 truncate text-sm font-bold text-brand-700 underline decoration-brand-200 underline-offset-4 hover:text-brand-900">
              <%= @appointment.customer_portal_booking_url %>
            </a>
            <button type="button" data-action="copy-text#copy" data-copy-text-target="button" class="shrink-0 rounded-xl border border-brand-200 bg-white px-3 py-2 text-xs font-bold text-brand-700 transition hover:border-brand-400 hover:bg-brand-50">Copiar</button>
          </div>
        </section>
      </aside>
    </div>
  </div>
</div>
