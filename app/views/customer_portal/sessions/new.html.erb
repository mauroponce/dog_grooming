<% content_for :title, "Mis turnos · #{@business.name}" %>
<% content_for :full_width, true %>

<div class="min-h-screen bg-[#F7F7FA] px-4 py-6 text-zinc-950 sm:px-6 sm:py-10">
  <div class="mx-auto max-w-xl">
    <header class="flex items-center justify-between gap-4">
      <%= link_to public_business_path(@business.slug), class: "flex min-w-0 items-center gap-3" do %>
        <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-zinc-950 text-sm font-bold text-white shadow-lg shadow-zinc-900/15"><%= @business.initials %></span>
        <span class="min-w-0">
          <span class="block truncate text-base font-bold"><%= @business.name %></span>
          <span class="block truncate text-xs font-semibold text-zinc-500"><%= @business.public_city %></span>
        </span>
      <% end %>
      <%= link_to "Reservar", public_business_path(@business.slug), class: "inline-flex h-11 items-center justify-center rounded-2xl border border-zinc-200 bg-white px-4 text-sm font-bold text-zinc-800 shadow-sm" %>
    </header>

    <main class="mt-8 overflow-hidden rounded-[32px] border border-white bg-white p-6 shadow-card sm:p-8">
      <span class="inline-flex rounded-full bg-brand-50 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[.14em] text-brand-700">Consulta segura</span>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Ver mis turnos</h1>
      <p class="mt-3 text-sm font-semibold leading-6 text-zinc-600">Ingresá tu email y te enviaremos un link seguro para consultar tus reservas.</p>

      <% if params[:sent].present? %>
        <div class="mt-6 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-semibold leading-6 text-emerald-900">
          Si encontramos turnos asociados a ese contacto, te enviamos un link para ingresar.
        </div>
      <% end %>

      <%= form_with url: customer_portal_entry_path(@business.slug), class: "mt-6 grid gap-4" do %>
        <div>
          <%= label_tag :contact, "Email", class: "mb-2 block text-sm font-bold text-zinc-900" %>
          <%= email_field_tag :contact, params[:contact] || params[:email], required: true, autocomplete: "email", placeholder: "nombre@email.com", class: "h-12 w-full rounded-2xl border border-zinc-200 bg-white px-4 text-sm font-semibold outline-none transition placeholder:text-zinc-400 focus:border-brand-400 focus:ring-4 focus:ring-brand-100" %>
          <p class="mt-2 text-xs font-semibold leading-5 text-zinc-500">No necesitás contraseña.</p>
        </div>
        <%= submit_tag "Enviarme link", class: "h-12 cursor-pointer rounded-2xl bg-zinc-950 px-5 text-sm font-bold text-white shadow-lg shadow-zinc-900/15 transition hover:bg-zinc-800" %>
      <% end %>
    </main>
  </div>
</div>
