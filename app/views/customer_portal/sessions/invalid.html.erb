<% content_for :title, "Enlace vencido · #{@business.name}" %>
<% content_for :full_width, true %>

<div class="min-h-screen bg-[#F7F7FA] px-4 py-8 text-zinc-950 sm:px-6 sm:py-12">
  <main class="mx-auto max-w-lg rounded-[32px] border border-white bg-white p-6 text-center shadow-card sm:p-8">
    <div class="mx-auto grid h-16 w-16 place-items-center rounded-3xl bg-amber-50 text-amber-700">
      <%= public_icon("clock", css: "h-8 w-8") %>
    </div>
    <h1 class="mt-5 text-3xl font-bold tracking-tight">El enlace no está disponible</h1>
    <p class="mt-3 text-sm font-semibold leading-6 text-zinc-600">Puede estar vencido o ya haber sido usado. Pedí un nuevo enlace para consultar tus turnos.</p>
    <%= link_to "Pedir nuevo enlace", customer_portal_entry_path(@business.slug), class: "mt-6 inline-flex h-12 w-full items-center justify-center rounded-2xl bg-zinc-950 px-5 text-sm font-bold text-white shadow-lg shadow-zinc-900/15" %>
  </main>
</div>
