<% content_for :title, "Crear cuenta | Cita.pet" %>
<main class="mx-auto max-w-xl px-4 py-12 sm:py-20">
  <%= link_to "← Volver a Cita.pet", root_path, class: "text-sm font-bold text-brand-700" %>
  <section class="mt-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <p class="text-sm font-bold text-brand-700">Prueba gratuita de 14 días</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Creá tu cuenta</h1>

    <% if alert.present? %>
      <p class="mt-5 rounded-xl bg-rose-50 p-3 text-sm font-semibold text-rose-700"><%= alert %></p>
    <% end %>

    <% if @identity.present? %>
      <p class="mt-2 text-slate-600">Vas a ingresar con <strong><%= @identity.email_address %></strong>. Configurá tu peluquería para empezar.</p>
      <%= form_with url: registro_path, scope: :registration, class: "mt-6 space-y-4" do |form| %>
        <div><%= form.label :plan_selected, "Elegí tu plan", class: "text-sm font-bold" %><%= form.select :plan_selected, [["Básico · $35.000 ARS/mes", "basic"], ["PRO · $45.000 ARS/mes", "pro"]], { selected: @values&.fetch("plan_selected", nil) || "basic" }, class: "mt-1 w-full rounded-xl border-slate-300" %></div>
        <div><%= form.label :business_name, "Nombre de la peluquería", class: "text-sm font-bold" %><%= form.text_field :business_name, value: @values&.fetch("business_name", nil), required: true, autofocus: true, class: "mt-1 w-full rounded-xl border-slate-300" %></div>
        <div><%= form.label :owner_name, "Tu nombre", class: "text-sm font-bold" %><%= form.text_field :owner_name, value: @values&.fetch("owner_name", nil) || @identity.name, required: true, class: "mt-1 w-full rounded-xl border-slate-300" %></div>
        <div><%= form.label :contact_phone, "Teléfono", class: "text-sm font-bold" %><%= form.telephone_field :contact_phone, value: @values&.fetch("contact_phone", nil), required: true, autocomplete: "tel", class: "mt-1 w-full rounded-xl border-slate-300" %></div>
        <div><%= form.label :slug, "Link público (opcional)", class: "text-sm font-bold" %><%= form.text_field :slug, value: @values&.fetch("slug", nil), class: "mt-1 w-full rounded-xl border-slate-300", placeholder: "mi-peluqueria" %></div>
        <%= form.submit "Empezar mi prueba gratuita", class: "w-full cursor-pointer rounded-xl bg-slate-950 px-4 py-3 font-bold text-white hover:bg-brand-700" %>
      <% end %>
    <% else %>
      <p class="mt-2 text-slate-600">Usá tu cuenta de Google para crear y administrar la cuenta de tu peluquería.</p>
      <%= button_to "/auth/google_oauth2?origin=registration", method: :post, class: "mt-6 flex w-full items-center justify-center gap-3 rounded-xl border border-slate-300 bg-white px-4 py-3 font-bold text-slate-900 shadow-sm transition hover:bg-slate-50" do %>
        <span aria-hidden="true">G</span>
        Continuar con Google
      <% end %>
    <% end %>
  </section>
</main>
