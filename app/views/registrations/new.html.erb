<% content_for :title, "Crear cuenta | Cita.pet" %>
<main class="mx-auto max-w-xl px-4 py-12 sm:py-20">
  <%= link_to "← Volver a Cita.pet", root_path, class: "text-sm font-bold text-brand-700" %>
  <section class="mt-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <p class="text-sm font-bold text-brand-700">Prueba gratuita de 14 días</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Creá tu cuenta</h1>
    <p class="mt-2 text-slate-600">Configurá tus horarios y ajustá el catálogo de nueve servicios que ya viene incluido.</p>
    <% if alert.present? %><p class="mt-5 rounded-xl bg-rose-50 p-3 text-sm font-semibold text-rose-700"><%= alert %></p><% end %>
    <%= form_with url: registro_path, scope: :registration, class: "mt-6 space-y-4" do |form| %>
      <div><%= form.label :plan_selected, "Elegí tu plan", class: "text-sm font-bold" %><%= form.select :plan_selected, [["Básico · $35.000 ARS/mes", "basic"], ["PRO · $45.000 ARS/mes · recordatorios WhatsApp ilimitados", "pro"]], { selected: @values&.fetch("plan_selected", nil) || "basic" }, class: "mt-1 w-full rounded-xl border-slate-300" %><p class="mt-2 text-sm text-slate-600">PRO incluye hasta 20 recordatorios WhatsApp durante la prueba de 14 días.</p></div>
      <div><%= form.label :business_name, "Nombre de la peluquería", class: "text-sm font-bold" %><%= form.text_field :business_name, value: @values&.fetch("business_name", nil), required: true, autofocus: true, class: "mt-1 w-full rounded-xl border-slate-300" %></div>
      <div><%= form.label :owner_name, "Tu nombre", class: "text-sm font-bold" %><%= form.text_field :owner_name, value: @values&.fetch("owner_name", nil), required: true, class: "mt-1 w-full rounded-xl border-slate-300" %></div>
      <div><%= form.label :contact_phone, "WhatsApp", class: "text-sm font-bold" %><%= form.telephone_field :contact_phone, value: @values&.fetch("contact_phone", nil), required: true, autocomplete: "tel", class: "mt-1 w-full rounded-xl border-slate-300" %></div>
      <div><%= form.label :email_address, "Email", class: "text-sm font-bold" %><%= form.email_field :email_address, value: @values&.fetch("email_address", nil), required: true, autocomplete: "email", class: "mt-1 w-full rounded-xl border-slate-300" %></div>
      <div><%= form.label :slug, "Link público (opcional)", class: "text-sm font-bold" %><%= form.text_field :slug, value: @values&.fetch("slug", nil), class: "mt-1 w-full rounded-xl border-slate-300", placeholder: "mi-peluqueria" %></div>
      <div><%= form.label :password, "Contraseña", class: "text-sm font-bold" %><%= form.password_field :password, required: true, autocomplete: "new-password", class: "mt-1 w-full rounded-xl border-slate-300" %></div>
      <div><%= form.label :password_confirmation, "Repetí la contraseña", class: "text-sm font-bold" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "mt-1 w-full rounded-xl border-slate-300" %></div>
      <%= form.submit "Empezar mi prueba gratuita", class: "w-full cursor-pointer rounded-xl bg-slate-950 px-4 py-3 font-bold text-white hover:bg-brand-700" %>
    <% end %>
  </section>
</main>
