        <a href="#que-resuelve" class="hover:text-brand-700">Qué resuelve</a>
        <a href="#ia" class="hover:text-brand-700">IA</a>
        <a href="#preguntas" class="hover:text-brand-700">Preguntas</a>
        <a href="#contacto" class="hover:text-brand-700">Contacto</a>
        <%= link_to "Acceso", new_session_path, class: "hover:text-brand-700" %>
        <%= link_to "Privacidad", privacy_policy_path, class: "hover:text-brand-700" %>
        <%= link_to "Eliminación de datos", data_deletion_path, class: "hover:text-brand-700" %>
        <a href="https://www.instagram.com/cita_pet" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-brand-700" aria-label="Instagram de Cita.pet">
          <%= landing_icon.call(:instagram, classes: "h-3.5 w-3.5") %>
          @cita_pet
        </a>
      </nav>

      <p class="text-xs font-semibold text-slate-400 md:ml-6">© 2026 Cita.pet</p>
    </div>
  </footer>
</div>

<script>
  (() => {
    const root = document.querySelector("[data-landing-page]");
    if (!root) return;

    const menuButton = root.querySelector("#landingMenuButton");
    const mobileMenu = root.querySelector("#landingMobileMenu");

    if (menuButton && mobileMenu) {
      menuButton.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!isOpen));
        mobileMenu.classList.toggle("hidden", isOpen);
      });

      root.querySelectorAll(".landing-mobile-link").forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          menuButton.setAttribute("aria-expanded", "false");
        });
      });
    }

    root.querySelectorAll(".landing-faq-toggle").forEach((button) => {
      button.addEventListener("click", () => {
        const item = button.closest(".landing-faq-item");
        if (!item) return;

        item.classList.toggle("is-open");
      });
    });

    const contactForm = root.querySelector("#contactForm");
    const formStatus = root.querySelector("#formStatus");
    const submitButton = root.querySelector("#submitButton");
    const submitButtonText = root.querySelector("#submitButtonText");

    if (!contactForm || !formStatus || !submitButton || !submitButtonText) return;

    contactForm.addEventListener("submit", async (event) => {
      event.preventDefault();

      submitButton.disabled = true;
      submitButtonText.textContent = "Enviando...";
      formStatus.classList.add("hidden");

      try {
        const response = await fetch(contactForm.getAttribute("action"), {
          method: "POST",
          body: new FormData(contactForm),
          headers: { Accept: "application/json" }
        });

        if (!response.ok) throw new Error("Formspree rejected the request.");

        contactForm.reset();
        formStatus.className = "rounded-2xl bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-700";
        formStatus.textContent = "Gracias. Recibimos tu consulta y te responderemos pronto.";
      } catch (error) {
        formStatus.className = "rounded-2xl bg-rose-50 px-4 py-3 text-sm font-bold text-rose-700";
        formStatus.textContent = "No pudimos enviar la consulta. Revisá tu conexión o intentá nuevamente.";
      } finally {
        submitButton.disabled = false;
        submitButtonText.textContent = "Enviar y ver cómo quedaría";
      }
    });
  })();
</script>
