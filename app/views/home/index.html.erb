  <svg class="cp-ambient" viewBox="0 0 1500 1500" preserveAspectRatio="none" aria-hidden="true"><g fill="none" stroke="white" opacity=".77"><path d="M-60 360C60 58 268 106 330 59S545 29 487 162s-29 159 134 96 220-143 309-135 111 170 16 235-9 184 170 68 250-25 274 67"/><path d="M-70 1055C170 780 285 1014 345 1244s191 148 255-55 135-282 238-123 208 246 336 69"/></g></svg>

  <div class="cp-page">
