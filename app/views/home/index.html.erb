            </div>
          </div>
        </div>

        <div class="rounded-[32px] border border-white bg-white p-5 shadow-soft sm:p-7">
          <form id="contactForm" action="https://formspree.io/f/maqgegwn" method="POST" data-turbo="false" class="space-y-5">
            <input type="hidden" name="_subject" value="Nuevo contacto desde Cita.pet">
            <input type="hidden" name="_language" value="es">
            <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off">

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-2 block text-sm font-bold text-slate-800">Nombre</label>
                <input id="name" name="name" type="text" autocomplete="name" required class="h-12 w-full rounded-2xl border border-slate-200 bg-slate-50/65 px-4 text-sm font-semibold outline-none transition placeholder:text-slate-400 focus:border-brand-300 focus:bg-white focus:ring-4 focus:ring-brand-100" placeholder="Tu nombre">
              </div>
              <div>
                <label for="email" class="mb-2 block text-sm font-bold text-slate-800">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" required class="h-12 w-full rounded-2xl border border-slate-200 bg-slate-50/65 px-4 text-sm font-semibold outline-none transition placeholder:text-slate-400 focus:border-brand-300 focus:bg-white focus:ring-4 focus:ring-brand-100" placeholder="nombre@email.com">
              </div>
              <div class="sm:col-span-2">
                <label for="phone" class="mb-2 block text-sm font-bold text-slate-800">Teléfono</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" class="h-12 w-full rounded-2xl border border-slate-200 bg-slate-50/65 px-4 text-sm font-semibold outline-none transition placeholder:text-slate-400 focus:border-brand-300 focus:bg-white focus:ring-4 focus:ring-brand-100" placeholder="+54 11 5555 5555">
              </div>

              <div class="sm:col-span-2">
                <label for="businessType" class="mb-2 block text-sm font-bold text-slate-800">¿Qué tipo de peluquería canina tenés?</label>
                <div class="relative">
                  <select id="businessType" name="business_type" required class="h-12 w-full appearance-none rounded-2xl border border-slate-200 bg-slate-50/65 px-4 pr-11 text-sm font-semibold text-slate-700 outline-none transition focus:border-brand-300 focus:bg-white focus:ring-4 focus:ring-brand-100">
                    <option value="">Seleccionar una opción</option>
                    <option>Peluquería canina integral</option>
                    <option>Baño y secado</option>
                    <option>Corte y grooming de raza</option>
                    <option>Higiene y bienestar</option>
                    <option>Groomer a domicilio</option>
                    <option>Otro servicio para mascotas</option>
                  </select>
                  <%= landing_icon.call(:chevron_down, classes: "pointer-events-none absolute right-4 top-4 h-4 w-4 text-slate-400") %>
                </div>
              </div>
            </div>

            <div>
              <label for="message" class="mb-2 block text-sm font-bold text-slate-800">¿Qué problema querés ordenar primero?</label>
              <textarea id="message" name="message" rows="5" class="w-full resize-none rounded-2xl border border-slate-200 bg-slate-50/65 px-4 py-3 text-sm font-semibold leading-6 outline-none transition placeholder:font-medium placeholder:text-slate-400 focus:border-brand-300 focus:bg-white focus:ring-4 focus:ring-brand-100" placeholder="Por ejemplo: muchos mensajes, mascotas que no llegan, horarios cruzados, cambios de último momento o señas difíciles de controlar."></textarea>
            </div>

            <div id="formStatus" class="hidden rounded-2xl px-4 py-3 text-sm font-bold"></div>

            <button id="submitButton" type="submit" class="flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-brand-600 to-brand-600 px-5 py-3.5 text-sm font-bold text-white shadow-lg shadow-brand-600/20 transition hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:opacity-60">
              <span id="submitButtonText">Enviar y ver cómo quedaría</span>
              <%= landing_icon.call(:arrow_right, classes: "h-4 w-4") %>
            </button>

            <p class="mt-4 text-center text-[10px] leading-5 text-slate-400">
              Este formulario utiliza Formspree para procesar el envío.
            </p>
          </form>
        </div>
      </div>
    </section>
