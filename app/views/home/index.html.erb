    <symbol id="cp-arrow" viewBox="0 0 24 24"><path d="M4 12h16m-6-6 6 6-6 6"/></symbol><symbol id="cp-check" viewBox="0 0 24 24"><path d="m5 12 4.5 4.5L19 7"/></symbol><symbol id="cp-calendar" viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M7.5 3v4M16.5 3v4M3.5 10h17m-12 4h3m-3 3h6"/></symbol><symbol id="cp-link" viewBox="0 0 24 24"><path d="M9.5 14.5a5 5 0 0 0 7.1 0l2-2a5 5 0 0 0-7.1-7.1l-1 1M14.5 9.5a5 5 0 0 0-7.1 0l-2 2a5 5 0 0 0 7.1 7.1l1-1"/></symbol><symbol id="cp-card" viewBox="0 0 24 24"><rect x="2.5" y="5.5" width="19" height="13" rx="2.5"/><path d="M2.5 10h19M6.5 15h4"/></symbol><symbol id="cp-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol><symbol id="cp-scissors" viewBox="0 0 24 24"><circle cx="5.8" cy="7" r="3.2"/><circle cx="5.8" cy="17" r="3.2"/><path d="M8.4 9 20 20M8.4 15 20 4"/></symbol><symbol id="cp-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3 20a6 6 0 0 1 12 0M17 5a3 3 0 0 1 0 6M16 14a6 6 0 0 1 5 6"/></symbol><symbol id="cp-heart" viewBox="0 0 24 24"><path d="M20.5 5.5a5.3 5.3 0 0 0-7.5 0L12 6.6l-1.1-1.1a5.3 5.3 0 0 0-7.4 7.5L12 21l8.5-8a5.3 5.3 0 0 0 0-7.5Z"/></symbol><symbol id="cp-upload" viewBox="0 0 24 24"><path d="M12 16V4m-5 5 5-5 5 5M5 14v5h14v-5"/></symbol><symbol id="cp-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol><symbol id="cp-close" viewBox="0 0 24 24"><path d="m5 5 14 14M19 5 5 19"/></symbol>
