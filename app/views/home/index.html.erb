<% content_for :title, "Cita.pet - Reservas online" %>
<% content_for :full_width, true %>
<% content_for :head do %>
  <meta name="description" content="Publicá tu página de reservas, cobrá señas con Mercado Pago y administrá turnos. 14 días gratis, sin tarjeta.">
  <meta name="theme-color" content="#ffded4">
  <meta property="og:title" content="Cita.pet - Reservas online">
  <meta property="og:description" content="Tu cliente reserva y paga la seña por Mercado Pago automáticamente.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://cita.pet">
  <style>
    [data-landing-page] {
      color: #0f172a;
      scroll-behavior: smooth;
    }

    [data-landing-page] .landing-glass {
      background: rgba(255, 255, 255, .86);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    [data-landing-page] .landing-gradient-text {
      color: #bf482f;
    }

    [data-landing-page] .landing-hero-grid {
      position: relative;
      isolation: isolate;
      background:
        radial-gradient(circle at 88% 8%, rgba(255, 222, 212, .13), transparent 30rem),
        radial-gradient(circle at 7% 78%, rgba(255, 222, 212, .16), transparent 34rem),
        linear-gradient(180deg, #fcfbfd 0%, #f8f7fb 100%);
    }

    [data-landing-page] .landing-hero-grid::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255, 222, 212, .045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 222, 212, .045) 1px, transparent 1px);
      background-size: 34px 34px;
      opacity: .72;
      -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 1) 78%, rgba(0, 0, 0, 0) 100%);
      mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 1) 78%, rgba(0, 0, 0, 0) 100%);
    }

    [data-landing-page] .landing-feature-card {
      transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
    }

    [data-landing-page] .landing-feature-card:hover {
      transform: translateY(-5px);
      border-color: #A63826;
      box-shadow: 0 22px 58px rgba(255, 222, 212, .10);
    }

    [data-landing-page] .landing-faq-panel {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height .28s ease, opacity .22s ease, padding-top .22s ease;
    }

    [data-landing-page] .landing-faq-item.is-open .landing-faq-panel {
      max-height: 240px;
      opacity: 1;
      padding-top: .85rem;
    }

    [data-landing-page] .landing-faq-chevron {
      transition: transform .22s ease;
    }

    [data-landing-page] .landing-faq-item.is-open .landing-faq-chevron {
      transform: rotate(180deg);
    }
  </style>
<% end %>

<%
  landing_icons = {
    calendar: '<path d="M7 3v3M17 3v3M4.5 9.5h15"/><path d="M6 5h12a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z"/><path d="m9 14 2 2 4-4"/>',
    calendar_range: '<path d="M7 3v3M17 3v3M4 9h16"/><path d="M6 5h12a2 2 0 0 1 2 2v12H4V7a2 2 0 0 1 2-2Z"/><path d="M8 14h3M14 14h2M8 17h2"/>',
    calendar_search: '<path d="M7 3v3M17 3v3M4 9h16"/><rect x="4" y="5" width="16" height="16" rx="2"/><circle cx="11" cy="14" r="2.5"/><path d="m13 16 2.5 2.5"/>',
    calendar_sync: '<path d="M7 3v3M17 3v3M4 9h16"/><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M10 14a3 3 0 0 1 5-2.2l1 .9"/><path d="M16 10v2.7h-2.7"/><path d="M14 17a3 3 0 0 1-5 2.2l-1-.9"/><path d="M8 21v-2.7h2.7"/>',
    menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
    arrow_right: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
    chevron_down: '<path d="m6 9 6 6 6-6"/>',
    sparkles: '<path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z"/><path d="m19 16 .8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8L19 16Z"/>',
    message_off: '<path d="M4 5h16v11H8l-4 4V5Z"/><path d="m8 8 8 5M16 8l-8 5"/>',
    message_more: '<path d="M4 5h16v11H8l-4 4V5Z"/><path d="M8 11h.01M12 11h.01M16 11h.01"/>',
    dollar: '<circle cx="12" cy="12" r="9"/><path d="M12 6v12M15 8.5c-.8-.7-2.2-1-3.2-.7-1.2.3-1.8 1.1-1.8 2 0 1.1 1 1.6 2.8 2.1 1.8.5 2.7 1.1 2.7 2.4 0 1.4-1.2 2.3-3.1 2.3-1.3 0-2.5-.4-3.4-1.2"/>',
    bot: '<path d="M12 8V4"/><rect x="5" y="8" width="14" height="11" rx="3"/><path d="M8.5 13h.01M15.5 13h.01M9 17h6"/>',
    badge_check: '<path d="M12 3 14.7 5.1 18 5.6l.5 3.3L21 12l-2.5 3.1L18 18.4l-3.3.5L12 21l-2.7-2.1-3.3-.5-.5-3.3L3 12l2.5-3.1L6 5.6l3.3-.5L12 3Z"/><path d="m8.7 12.2 2.1 2.1 4.7-4.8"/>',
    workflow: '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="M8.3 7.3 11 10a4 4 0 0 1 1 2.8V15M15.7 7.3 13 10a4 4 0 0 0-1 2.8V15"/>',
    wallet: '<path d="M4 7a2 2 0 0 1 2-2h12v14H6a2 2 0 0 1-2-2V7Z"/><path d="M4 8h14a2 2 0 0 1 2 2v7"/><path d="M16 13h.01"/>',
    user: '<path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="8" r="4"/>',
    users_round: '<path d="M16 21a6 6 0 0 0-12 0"/><circle cx="10" cy="8" r="4"/><path d="M22 21a5 5 0 0 0-4-4.9"/><path d="M18 4.2a4 4 0 0 1 0 7.6"/>',
    chart_up: '<path d="M3 3v18h18"/><path d="m7 14 4-4 3 3 5-6"/><path d="M19 7v5h-5"/>',
    repeat_2: '<path d="m17 2 4 4-4 4"/><path d="M3 11V9a3 3 0 0 1 3-3h15"/><path d="m7 22-4-4 4-4"/><path d="M21 13v2a3 3 0 0 1-3 3H3"/>',
    check_circle: '<circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 5-6"/>',
    check: '<path d="m5 12 4 4L19 6"/>',
    scan: '<path d="M7 3H5a2 2 0 0 0-2 2v2M17 3h2a2 2 0 0 1 2 2v2M7 21H5a2 2 0 0 1-2-2v-2M17 21h2a2 2 0 0 0 2-2v-2"/><circle cx="11" cy="11" r="3"/><path d="m15 15 3 3"/>',
    wand: '<path d="M15 4 20 9"/><path d="M14 5 5 14a2 2 0 0 0 0 3l2 2a2 2 0 0 0 3 0l9-9"/><path d="M6 4v3M4.5 5.5h3M19 16v3M17.5 17.5h3"/>',
    calendar_heart: '<path d="M7 3v3M17 3v3M4 9h16"/><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M12 17s-3-1.7-3-3.6A1.8 1.8 0 0 1 12 12a1.8 1.8 0 0 1 3 1.4c0 1.9-3 3.6-3 3.6Z"/>',
    mail_check: '<path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/><path d="m9 15 1.6 1.6L14 13"/>',
    history: '<path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/><path d="M12 7v5l3 2"/>',
    instagram: '<rect x="4" y="4" width="16" height="16" rx="5"/><circle cx="12" cy="12" r="3.2"/><path d="M17 7.2h.01"/>'
  }

  landing_icon = lambda do |name, classes: "h-5 w-5"|
    raw(%(<svg viewBox="0 0 24 24" class="#{classes}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">#{landing_icons.fetch(name)}</svg>))
  end
%>

<div data-landing-page class="min-h-screen bg-[#fbfafc] text-slate-900 antialiased">
  <header class="landing-glass sticky top-0 z-50 border-b border-white/80">
    <div class="mx-auto flex h-[74px] max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8">
      <a href="#inicio" class="flex items-center gap-3" aria-label="Cita.pet">
        <span class="block h-11 w-11 overflow-hidden rounded-2xl shadow-lg shadow-brand-600/25">
          <%= image_tag "/icon.png?v=4", alt: "", class: "h-full w-full object-cover" %>
        </span>
        <span>
          <span class="block text-[17px] font-bold tracking-tight">Cita.pet</span>
          <span class="block text-[10px] font-bold text-brand-700">Reservas online para peluquerías</span>
        </span>
      </a>

      <nav class="mx-auto hidden items-center gap-7 text-sm font-bold text-slate-500 lg:flex">
        <a href="#que-resuelve" class="transition hover:text-brand-700">El recorrido</a>
        <a href="#como-funciona" class="transition hover:text-brand-700">Cómo funciona</a>
        <a href="#ia" class="transition hover:text-brand-700">Automatización</a>
        <a href="#precio" class="transition hover:text-brand-700">Precio</a>
        <a href="#preguntas" class="transition hover:text-brand-700">Preguntas</a>
      </nav>

      <div class="ml-auto hidden items-center gap-2 sm:flex">
        <%= link_to "Acceso", new_session_path, class: "rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm hover:border-brand-200 hover:text-brand-700" %>
        <a href="#contacto" class="rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm hover:border-brand-200 hover:text-brand-700">
          Contacto
        </a>
        <%= link_to "Empezar prueba", registro_path, class: "rounded-2xl bg-slate-950 px-4 py-2.5 text-sm font-bold text-white shadow-lg shadow-slate-950/15 transition hover:-translate-y-0.5 hover:bg-brand-700" %>
      </div>

      <button id="landingMenuButton" type="button" class="ml-auto grid h-11 w-11 place-items-center rounded-2xl border border-slate-200 bg-white text-slate-600 shadow-sm sm:hidden" aria-label="Abrir menú" aria-expanded="false">
        <%= landing_icon.call(:menu, classes: "h-5 w-5") %>
      </button>
    </div>

    <div id="landingMobileMenu" class="hidden border-t border-slate-100 bg-white px-4 py-4 sm:hidden">
      <div class="grid gap-2">
        <a href="#que-resuelve" class="landing-mobile-link rounded-xl px-3 py-2.5 text-sm font-bold hover:bg-brand-50">El recorrido</a>
        <a href="#como-funciona" class="landing-mobile-link rounded-xl px-3 py-2.5 text-sm font-bold hover:bg-brand-50">Cómo funciona</a>
        <a href="#ia" class="landing-mobile-link rounded-xl px-3 py-2.5 text-sm font-bold hover:bg-brand-50">Automatización</a>
        <a href="#precio" class="landing-mobile-link rounded-xl px-3 py-2.5 text-sm font-bold hover:bg-brand-50">Precio</a>
        <a href="#preguntas" class="landing-mobile-link rounded-xl px-3 py-2.5 text-sm font-bold hover:bg-brand-50">Preguntas</a>
        <%= link_to "Acceso", new_session_path, class: "landing-mobile-link rounded-xl px-3 py-2.5 text-sm font-bold hover:bg-brand-50" %>
        <%= link_to "Empezar prueba", registro_path, class: "landing-mobile-link mt-2 rounded-xl bg-slate-950 px-3 py-3 text-center text-sm font-bold text-white" %>
      </div>
    </div>
  </header>

  <main id="inicio">
    <section class="landing-hero-grid overflow-hidden">
      <div class="mx-auto grid min-h-[760px] max-w-7xl items-center gap-14 px-4 py-20 sm:px-6 lg:grid-cols-[.95fr_1.05fr] lg:px-8">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white/90 px-3 py-1.5 text-xs font-bold text-brand-700 shadow-sm">
            <%= landing_icon.call(:sparkles, classes: "h-3.5 w-3.5") %>
            Reservas 24/7, sin responder cada mensaje
          </span>

          <h1 class="mt-7 max-w-2xl text-5xl font-bold leading-[.98] tracking-[-.055em] text-slate-950 sm:text-6xl lg:text-[72px]">
            Tu página toma turnos.
            <span class="landing-gradient-text block">Vos cuidás mascotas.</span>
          </h1>

          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600 [text-shadow:0_1px_0_rgba(255,255,255,.75)]">
            Compartí tu enlace de reservas donde quieras. Tus clientes eligen un servicio, reservan en una web rápida y pagan la seña con Mercado Pago.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <%= link_to registro_path, class: "inline-flex items-center justify-center gap-2 rounded-2xl bg-slate-950 px-5 py-3.5 text-sm font-bold text-white shadow-lg shadow-slate-950/15 transition hover:-translate-y-0.5 hover:bg-brand-700" do %>
              Empezar mi prueba gratis
              <%= landing_icon.call(:arrow_right, classes: "h-4 w-4") %>
            <% end %>
            <a href="#que-resuelve" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-5 py-3.5 text-sm font-bold text-slate-700 shadow-sm hover:border-brand-200 hover:text-brand-700">
              Ver cómo funciona
              <%= landing_icon.call(:chevron_down, classes: "h-4 w-4") %>
            </a>
          </div>

          <div class="mt-9 grid max-w-2xl gap-3 sm:grid-cols-3">
            <div class="rounded-2xl border border-white bg-white/80 p-4 shadow-sm">
              <%= landing_icon.call(:message_off, classes: "h-5 w-5 text-brand-700") %>
              <p class="mt-3 text-sm font-bold">Un enlace propio</p>
              <p class="mt-1 text-xs leading-5 text-slate-500">Para compartir en tus canales.</p>
            </div>
            <div class="rounded-2xl border border-white bg-white/80 p-4 shadow-sm">
              <%= landing_icon.call(:dollar, classes: "h-5 w-5 text-emerald-700") %>
              <p class="mt-3 text-sm font-bold">Señas acreditadas</p>
              <p class="mt-1 text-xs leading-5 text-slate-500">Mercado Pago confirma el turno.</p>
            </div>
            <div class="rounded-2xl border border-white bg-white/80 p-4 shadow-sm">
              <%= landing_icon.call(:bot, classes: "h-5 w-5 text-blue-700") %>
              <p class="mt-3 text-sm font-bold">Huecos que se recuperan</p>
              <p class="mt-1 text-xs leading-5 text-slate-500">Tutores compatibles y mensajes listos.</p>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="overflow-hidden rounded-[34px] border border-white bg-white p-3 shadow-soft">
            <div class="overflow-hidden rounded-[26px] border border-slate-200 bg-[#f8f7fa]">
              <div class="flex h-12 items-center border-b border-slate-200 bg-white px-4">
                <div class="flex gap-1.5">
                  <span class="h-2.5 w-2.5 rounded-full bg-rose-300"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-amber-300"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-emerald-300"></span>
                </div>
                <div class="mx-auto rounded-full bg-slate-100 px-4 py-1.5 text-[10px] font-bold text-slate-500">cita.pet/patitas-grooming</div>
              </div>

              <div class="grid min-h-[470px] sm:grid-cols-[205px_1fr]">
                <aside class="hidden border-r border-slate-200 bg-white p-4 sm:block">
                  <p class="text-[9px] font-bold uppercase tracking-[.15em] text-slate-400">Patitas Grooming</p>
                  <h3 class="mt-2 text-xl font-bold leading-tight">Todo el local, conectado</h3>

                  <div class="mt-5 space-y-2">
                    <div class="rounded-2xl border border-brand-200 bg-brand-50 p-3">
                      <p class="text-xs font-bold text-brand-800">Turnos</p>
                      <p class="mt-1 text-[10px] text-brand-600">Agenda de hoy</p>
                    </div>
                    <div class="rounded-2xl border border-slate-200 p-3">
                      <p class="text-xs font-bold">Comprobantes</p>
                      <p class="mt-1 text-[10px] text-slate-500">2 pendientes</p>
                    </div>
                    <div class="rounded-2xl border border-slate-200 p-3">
                      <p class="text-xs font-bold">Tutores y mascotas</p>
                      <p class="mt-1 text-[10px] text-slate-500">Historial y seguimiento</p>
                    </div>
                    <div class="rounded-2xl border border-slate-200 p-3">
                      <p class="text-xs font-bold">Asistente IA</p>
                      <p class="mt-1 text-[10px] text-slate-500">Qué atender hoy</p>
                    </div>
                  </div>
                </aside>

                <div class="p-4 sm:p-5">
                  <div class="flex items-start justify-between">
                    <div>
                      <p class="text-[9px] font-bold uppercase tracking-[.14em] text-brand-700">Resumen del día</p>
                      <h3 class="mt-1 text-xl font-bold">Lo importante, primero</h3>
                    </div>
                    <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[9px] font-bold text-emerald-700">En orden</span>
                  </div>

                  <div class="mt-4 grid grid-cols-3 gap-2">
                    <div class="rounded-2xl bg-white p-3 shadow-sm">
                      <p class="text-[9px] font-bold text-slate-400">Turnos</p>
                      <p class="mt-1 text-xl font-bold">14</p>
                    </div>
                    <div class="rounded-2xl bg-white p-3 shadow-sm">
                      <p class="text-[9px] font-bold text-slate-400">Ocupación</p>
                      <p class="mt-1 text-xl font-bold">82%</p>
                    </div>
                    <div class="rounded-2xl bg-white p-3 shadow-sm">
                      <p class="text-[9px] font-bold text-slate-400">Pendientes</p>
                      <p class="mt-1 text-xl font-bold">3</p>
                    </div>
                  </div>

                  <div class="mt-4 rounded-[22px] bg-slate-950 p-4 text-white">
                    <div class="flex items-center gap-3">
                      <span class="grid h-10 w-10 place-items-center rounded-2xl bg-white/10">
                        <%= landing_icon.call(:sparkles, classes: "h-5 w-5") %>
                      </span>
                      <div>
                        <p class="text-xs font-bold">Cita.pet IA</p>
                        <p class="mt-1 text-[10px] text-slate-300">Encontró 3 oportunidades</p>
                      </div>
                    </div>

                    <div class="mt-4 space-y-2">
                      <div class="rounded-xl bg-white/10 p-3">
                        <p class="text-[10px] font-bold">Revisar una seña urgente</p>
                        <p class="mt-1 text-[9px] text-slate-300">El turno es hoy a las 18:30.</p>
                      </div>
                      <div class="rounded-xl bg-white/10 p-3">
                        <p class="text-[10px] font-bold">Cubrir un hueco de 90 min</p>
                        <p class="mt-1 text-[9px] text-slate-300">Hay 8 tutores compatibles.</p>
                      </div>
                      <div class="rounded-xl bg-white/10 p-3">
                        <p class="text-[10px] font-bold">Recuperar mascotas</p>
                        <p class="mt-1 text-[9px] text-slate-300">7 tutores podrían volver.</p>
                      </div>
                    </div>
                  </div>

                  <div class="mt-4 flex items-center justify-between rounded-2xl border border-brand-100 bg-brand-50 p-3">
                    <div>
                      <p class="text-[10px] font-bold text-brand-800">Todo conectado</p>
                      <p class="mt-1 text-[9px] text-brand-600">Agenda, cobros, mascotas y equipo.</p>
                    </div>
                    <%= landing_icon.call(:workflow, classes: "h-5 w-5 text-brand-700") %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="absolute -bottom-5 right-2 hidden rounded-2xl border border-white bg-white p-4 shadow-card sm:block">
            <div class="flex items-center gap-3">
              <%= landing_icon.call(:badge_check, classes: "h-5 w-5 text-emerald-700") %>
              <div>
                <p class="text-[10px] font-bold uppercase tracking-wide text-slate-400">Pago aprobado</p>
                <p class="mt-1 text-sm font-bold">Turno confirmado</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="que-resuelve" class="border-y border-slate-100 bg-white py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-xs font-bold uppercase tracking-[.18em] text-brand-700">Mucho más que turnos</p>
          <h2 class="mt-4 text-4xl font-bold tracking-[-.045em] sm:text-5xl">
            Un mensaje activa la reserva.
            <span class="landing-gradient-text block">Cita.pet completa el recorrido.</span>
          </h2>
          <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-slate-500">
            Dentro de la ventana de 24 horas, el cliente elige un servicio y sigue a una reserva web personalizada, sin crear una cuenta.
          </p>
        </div>

        <div class="mt-14 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          <article class="landing-feature-card rounded-[26px] border border-slate-200 bg-white p-5">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-brand-50 text-brand-700">
              <%= landing_icon.call(:calendar_range, classes: "h-5 w-5") %>
            </span>
            <h3 class="mt-5 text-lg font-bold">Lista interactiva</h3>
            <p class="mt-2 text-sm leading-6 text-slate-500">El cliente encuentra catálogo, horarios o la opción de hablar con una persona.</p>
          </article>

          <article class="landing-feature-card rounded-[26px] border border-slate-200 bg-white p-5">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-emerald-50 text-emerald-700">
              <%= landing_icon.call(:wallet, classes: "h-5 w-5") %>
            </span>
            <h3 class="mt-5 text-lg font-bold">Señas y pagos</h3>
            <p class="mt-2 text-sm leading-6 text-slate-500">Mercado Pago cobra la seña; su webhook confirma el turno automáticamente.</p>
          </article>

