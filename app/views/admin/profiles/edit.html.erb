<% content_for :title, "Editar perfil · Dog Grooming" %>
<% content_for :admin_section_title, "Editar perfil" %>

<div class="mx-auto w-full max-w-6xl">
  <section class="rounded-[28px] border border-white bg-white p-6 shadow-soft sm:p-8" data-controller="profile-photo-removal">
    <div>
      <p class="text-xs font-bold uppercase tracking-[.16em] text-brand-700">Tu cuenta</p>
      <h1 class="mt-2 text-3xl font-bold tracking-[-.04em] text-zinc-950">Editar perfil</h1>
      <p class="mt-2 text-sm font-semibold leading-6 text-zinc-500">Actualizá tus datos personales, foto o contraseña.</p>
    </div>

    <%= form_with model: @user,
      url: admin_profile_path,
      method: :patch,
      multipart: true,
      class: "mt-8 grid gap-6",
      data: { controller: "password-confirmation", action: "submit->password-confirmation#submit" } do |form| %>
      <div class="flex items-center gap-4">
        <div class="grid h-20 w-20 shrink-0 place-items-center overflow-hidden rounded-full bg-brand-600 text-2xl font-bold text-white">
          <% if @user.profile_photo.attached? %>
            <%= image_tag @user.profile_photo, alt: @user.name.presence || "Perfil", class: "h-full w-full object-cover" %>
          <% else %>
            <%= (@user.name.presence || @user.email_address).first.upcase %>
          <% end %>
        </div>
        <div class="min-w-0 flex-1">
          <%= form.label :profile_photo, "Foto de perfil", class: "block text-sm font-bold text-zinc-950" %>
          <div class="mt-2 flex items-center gap-2">
            <%= form.file_field :profile_photo, accept: "image/png,image/jpeg,image/webp", class: "block min-w-0 flex-1 text-sm font-semibold text-zinc-600 file:mr-4 file:rounded-full file:border-0 file:bg-zinc-100 file:px-4 file:py-2 file:font-bold file:text-zinc-800 hover:file:bg-zinc-200" %>
            <% if @user.profile_photo.attached? %>
              <button type="button" class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-rose-200 bg-rose-50 text-rose-600 transition hover:bg-rose-100 hover:text-rose-700 focus:outline-none focus:ring-4 focus:ring-rose-100" data-action="profile-photo-removal#open" aria-label="Eliminar foto de perfil" title="Eliminar foto de perfil">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
            <% end %>
          </div>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :name, "Nombre", class: "block text-sm font-bold text-zinc-950" %>
          <%= form.text_field :name, class: "mt-2 h-12 w-full rounded-2xl border border-zinc-200 px-4 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100" %>
        </div>
        <div>
          <%= form.label :phone, "Teléfono", class: "block text-sm font-bold text-zinc-950" %>
          <%= form.telephone_field :phone, class: "mt-2 h-12 w-full rounded-2xl border border-zinc-200 px-4 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100" %>
        </div>
      </div>

      <div>
        <p class="text-sm font-bold text-zinc-950">Email de acceso</p>
        <p class="mt-2 rounded-2xl bg-zinc-50 px-4 py-3 text-sm font-semibold text-zinc-500"><%= @user.email_address %></p>
      </div>

      <div class="grid gap-5 border-t border-zinc-100 pt-6 sm:grid-cols-2">
        <div>
          <%= form.label :password, "Nueva contraseña", class: "block text-sm font-bold text-zinc-950" %>
          <div class="relative mt-2" data-controller="password-visibility" data-password-visibility-show-label-value="Mostrar nueva contraseña" data-password-visibility-hide-label-value="Ocultar nueva contraseña">
            <%= form.password_field :password,
              autocomplete: "new-password",
              placeholder: "Dejar vacío para no cambiar",
              class: "h-12 w-full rounded-2xl border border-zinc-200 px-4 pr-12 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100",
              data: { password_confirmation_target: "password", password_visibility_target: "input", action: "input->password-confirmation#validate" } %>
            <button type="button" class="absolute inset-y-0 right-0 grid w-12 place-items-center rounded-r-2xl text-zinc-400 transition hover:text-zinc-700 focus:outline-none" data-password-visibility-target="button" data-action="password-visibility#toggle" aria-label="Mostrar nueva contraseña" aria-controls="user_password" aria-pressed="false" title="Mostrar nueva contraseña">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-password-visibility-target="icon"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" /><circle cx="12" cy="12" r="2.75" /></svg>
            </button>
          </div>
        </div>
        <div>
          <%= form.label :password_confirmation, "Confirmar contraseña", class: "block text-sm font-bold text-zinc-950" %>
          <div class="relative mt-2" data-controller="password-visibility" data-password-visibility-show-label-value="Mostrar confirmación de contraseña" data-password-visibility-hide-label-value="Ocultar confirmación de contraseña">
            <%= form.password_field :password_confirmation,
              autocomplete: "new-password",
              class: "h-12 w-full rounded-2xl border border-zinc-200 px-4 pr-12 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100",
              data: { password_confirmation_target: "confirmation", password_visibility_target: "input", action: "input->password-confirmation#validate" } %>
            <button type="button" class="absolute inset-y-0 right-0 grid w-12 place-items-center rounded-r-2xl text-zinc-400 transition hover:text-zinc-700 focus:outline-none" data-password-visibility-target="button" data-action="password-visibility#toggle" aria-label="Mostrar confirmación de contraseña" aria-controls="user_password_confirmation" aria-pressed="false" title="Mostrar confirmación de contraseña">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-password-visibility-target="icon"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" /><circle cx="12" cy="12" r="2.75" /></svg>
            </button>
          </div>
          <p class="mt-2 text-xs font-bold text-red-600" data-password-confirmation-target="error" hidden></p>
        </div>
      </div>

      <div class="flex justify-end gap-3 border-t border-zinc-100 pt-6">
        <%= link_to "Cancelar", admin_calendar_path, class: "inline-flex h-12 items-center rounded-full border border-zinc-200 px-5 text-sm font-bold text-zinc-700 hover:bg-zinc-50" %>
        <%= form.submit "Guardar cambios", class: "h-12 cursor-pointer rounded-full bg-zinc-950 px-6 text-sm font-bold text-white hover:bg-zinc-800" %>
      </div>
    <% end %>

    <dialog class="w-[min(420px,calc(100vw-32px))] rounded-[28px] border border-zinc-200 bg-white p-0 text-zinc-950 shadow-2xl backdrop:bg-zinc-950/35" data-profile-photo-removal-target="dialog" data-action="click->profile-photo-removal#closeOnBackdrop">
      <div class="p-6 sm:p-7">
        <div class="grid h-12 w-12 place-items-center rounded-2xl bg-rose-50 text-rose-600">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </div>
        <h2 class="mt-5 text-xl font-bold tracking-tight">Eliminar foto de perfil</h2>
        <p class="mt-2 text-sm font-semibold leading-6 text-zinc-500">¿Deseas eliminar tu foto de perfil?</p>
        <div class="mt-7 flex justify-end gap-3">
          <button type="button" class="inline-flex h-11 items-center justify-center rounded-full border border-zinc-200 px-5 text-sm font-bold text-zinc-700 hover:bg-zinc-50" data-action="profile-photo-removal#close">Cancelar</button>
          <%= button_to "Confirmar", admin_profile_photo_path, method: :delete, form: { class: "inline" }, class: "h-11 rounded-full bg-rose-600 px-5 text-sm font-bold text-white hover:bg-rose-700" %>
        </div>
      </div>
    </dialog>
  </section>
</div>
