<% content_for :title, "Editar perfil · Dog Grooming" %>
<% content_for :admin_section_title, "Editar perfil" %>

<div class="mx-auto w-full max-w-6xl">
  <section class="rounded-[28px] border border-white bg-white p-6 shadow-soft sm:p-8">
    <div>
      <p class="text-xs font-bold uppercase tracking-[.16em] text-brand-700">Tu cuenta</p>
      <h1 class="mt-2 text-3xl font-bold tracking-[-.04em] text-zinc-950">Editar perfil</h1>
      <p class="mt-2 text-sm font-semibold leading-6 text-zinc-500">Actualizá tus datos personales, foto o contraseña.</p>
    </div>

    <%= form_with model: @user,
      url: admin_profile_path,
      method: :patch,
      multipart: true,
      class: "mt-8 grid gap-6",
      data: { controller: "password-confirmation", action: "submit->password-confirmation#submit" } do |form| %>
      <div class="flex items-center gap-4">
        <div class="grid h-20 w-20 shrink-0 place-items-center overflow-hidden rounded-full bg-brand-600 text-2xl font-bold text-white">
          <% if @user.profile_photo.attached? %>
            <%= image_tag @user.profile_photo, alt: @user.name.presence || "Perfil", class: "h-full w-full object-cover" %>
          <% else %>
            <%= (@user.name.presence || @user.email_address).first.upcase %>
          <% end %>
        </div>
        <div class="min-w-0 flex-1">
          <%= form.label :profile_photo, "Foto de perfil", class: "block text-sm font-bold text-zinc-950" %>
          <%= form.file_field :profile_photo, accept: "image/png,image/jpeg,image/webp", class: "mt-2 block w-full text-sm font-semibold text-zinc-600 file:mr-4 file:rounded-full file:border-0 file:bg-zinc-100 file:px-4 file:py-2 file:font-bold file:text-zinc-800 hover:file:bg-zinc-200" %>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :name, "Nombre", class: "block text-sm font-bold text-zinc-950" %>
          <%= form.text_field :name, class: "mt-2 h-12 w-full rounded-2xl border border-zinc-200 px-4 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100" %>
        </div>
        <div>
          <%= form.label :phone, "Teléfono", class: "block text-sm font-bold text-zinc-950" %>
          <%= form.telephone_field :phone, class: "mt-2 h-12 w-full rounded-2xl border border-zinc-200 px-4 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100" %>
        </div>
      </div>

      <div>
        <p class="text-sm font-bold text-zinc-950">Email de acceso</p>
        <p class="mt-2 rounded-2xl bg-zinc-50 px-4 py-3 text-sm font-semibold text-zinc-500"><%= @user.email_address %></p>
      </div>

      <div class="grid gap-5 border-t border-zinc-100 pt-6 sm:grid-cols-2">
        <div>
          <%= form.label :password, "Nueva contraseña", class: "block text-sm font-bold text-zinc-950" %>
          <%= form.password_field :password,
            autocomplete: "new-password",
            placeholder: "Dejar vacío para no cambiar",
            class: "mt-2 h-12 w-full rounded-2xl border border-zinc-200 px-4 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100",
            data: { password_confirmation_target: "password", action: "input->password-confirmation#validate" } %>
        </div>
        <div>
          <%= form.label :password_confirmation, "Confirmar contraseña", class: "block text-sm font-bold text-zinc-950" %>
          <%= form.password_field :password_confirmation,
            autocomplete: "new-password",
            class: "mt-2 h-12 w-full rounded-2xl border border-zinc-200 px-4 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100",
            data: { password_confirmation_target: "confirmation", action: "input->password-confirmation#validate" } %>
          <p class="mt-2 text-xs font-bold text-red-600" data-password-confirmation-target="error" hidden></p>
        </div>
      </div>

      <div class="flex justify-end gap-3 border-t border-zinc-100 pt-6">
        <%= link_to "Cancelar", admin_calendar_path, class: "inline-flex h-12 items-center rounded-full border border-zinc-200 px-5 text-sm font-bold text-zinc-700 hover:bg-zinc-50" %>
        <%= form.submit "Guardar cambios", class: "h-12 cursor-pointer rounded-full bg-zinc-950 px-6 text-sm font-bold text-white hover:bg-zinc-800" %>
      </div>
    <% end %>
  </section>
</div>
