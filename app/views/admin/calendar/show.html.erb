          <div><label class="mb-2 block text-sm font-bold">Tamaño</label><select id="appointmentPetSizeInput" class="w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100"><option value="">No especificado</option><option value="extra_small">Mini</option><option value="small">Chico</option><option value="medium">Mediano</option><option value="large">Grande</option><option value="extra_large">Gigante</option></select></div>
