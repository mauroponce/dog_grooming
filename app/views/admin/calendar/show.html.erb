    const entry = waitlistEditingEntryId ? waitlistEntries.find(item => String(item.id) === waitlistEditingEntryId) : null;
    if (entry && !selectedWaitlistCustomer) {
      selectedWaitlistCustomer = {
        id: entry.customerProfileId || null,
        name: entry.clientName,
        phone: entry.clientPhone,
        email: entry.email || ""
      };
    }
    const customer = selectedWaitlistCustomer;
    if (!customer) return openWaitlistCustomerPicker();

    const selectedWindow = normalizeWaitlistWindow(entry?.preferredTimeWindows?.[0]);
    const selectedServiceId = entry?.serviceId || services[0]?.id || "";
    const selectedEmployeeId = entry?.employeeId || "";
    openDrawer(`
