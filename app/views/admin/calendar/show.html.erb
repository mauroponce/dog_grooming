  function openCalendarProfessionalPicker(appointmentId) {
    const appointment = appointments.find(item => String(item.id) === String(appointmentId));
    if (!appointment?.availableProfessionalsUrl || !appointment?.changeProfessionalUrl) return;

    openProfessionalPicker({
      professionalsUrl: appointment.availableProfessionalsUrl,
