                  <div class="min-w-0">
                    <p class="text-sm font-bold">${escapeHTML(item.title)}</p>
                    <p class="mt-1 text-xs font-semibold text-zinc-500">${escapeHTML(item.time)}</p>
                    <p class="mt-2 text-sm leading-5 text-zinc-600">${escapeHTML(item.body || "")}</p>
                    ${item.actionUrl && item.actionLabel ? `<a href="${escapeAttribute(item.actionUrl)}" class="mt-3 inline-flex rounded-full bg-zinc-950 px-4 py-2 text-xs font-bold text-white">${escapeHTML(item.actionLabel)}</a>` : ""}
                  </div>
                </div>
              </article>
            `).join("") : `<p class="rounded-2xl border border-zinc-100 bg-white p-5 text-sm font-semibold text-zinc-500">No hay notificaciones en esta categoría.</p>`}
          </div>
        </section>
      </div>
    `);
  }

  function notificationIcon(key) {
    return { appointments: "📅", tips: "💡", sales: "◇", actions: "⚡" }[key] || "•";
  }

  function openSalePanel() {
    openDrawer(`${drawerHeader("Crear venta", "Venta rápida fuera de turno")}<div class="drawer-scroll flex-1 overflow-y-auto px-6 py-5"><div class="rounded-2xl bg-zinc-50 p-4"><p class="text-sm font-bold">Módulo placeholder</p><p class="mt-1 text-sm text-zinc-500">El flujo de venta rápida se conecta después.</p></div></div>`);
  }

  function openPaymentPanel() {
    openDrawer(`${drawerHeader("Pago rápido", "Registrar cobro manual")}<div class="drawer-scroll flex-1 overflow-y-auto px-6 py-5"><div class="rounded-2xl bg-zinc-50 p-4"><p class="text-sm font-bold">Módulo placeholder</p><p class="mt-1 text-sm text-zinc-500">El registro de pagos se conecta después.</p></div></div>`);
  }

  function showToast(message) {
    const toast = document.getElementById("toast");
    if (!toast) return;

    toast.textContent = message;
    toast.classList.add("show");
    setTimeout(() => toast.classList.remove("show"), 2200);
  }

  function toggleTeamMenu() {
    document.getElementById("teamMenu").classList.toggle("open");
    document.getElementById("viewMenu").classList.remove("open");
  }

  function closeTeamMenu() {
    document.getElementById("teamMenu").classList.remove("open");
  }

  function renderTeamMenu() {
    const menu = document.getElementById("teamMenu");
    const selectedCount = selectedEmployeeIds.size;
    document.getElementById("teamSelectorLabel").textContent =
      selectedCount === employees.length ? "Equipo completo" : `${selectedCount} profesional${selectedCount === 1 ? "" : "es"}`;

    menu.innerHTML = `
      <button type="button" onclick="selectAllEmployees()" class="team-menu-row bg-brand-50 text-brand-950"><span class="text-lg">◎</span><span>Equipo completo</span></button>
      <div class="my-2 border-t border-zinc-100"></div>
      <div class="px-2 pb-2 pt-1 text-xs font-bold uppercase tracking-wide text-zinc-500">Profesionales</div>
      ${employees.map(employee => `
        <button type="button" onclick="toggleEmployee('${employee.id}')" class="team-menu-row">
          <span class="team-checkbox ${selectedEmployeeIds.has(employee.id) ? "checked" : ""}">✓</span>
          ${employeeAvatarMarkup(employee, "team-menu-avatar")}
          <span class="min-w-0 flex-1 truncate">${escapeHTML(employee.name)}</span>
        </button>
      `).join("")}
    `;
  }

  function selectAllEmployees() {
    selectedEmployeeIds = new Set(employees.map(employee => employee.id));
    refreshCalendarAfterEmployeeChange();
  }

  function toggleEmployee(employeeId) {
    if (selectedEmployeeIds.has(employeeId) && selectedEmployeeIds.size > 1) {
      selectedEmployeeIds.delete(employeeId);
    } else {
      selectedEmployeeIds.add(employeeId);
    }
    refreshCalendarAfterEmployeeChange();
  }

  function refreshCalendarAfterEmployeeChange() {
    if (selectedSlot && !selectedEmployeeIds.has(selectedSlot.employeeId)) {
      selectedSlot.employeeId = firstVisibleEmployeeId();
    }
    renderTeamMenu();
    renderResourceHeader();
    renderCalendar();
    renderWeekCalendar();
    renderMonthCalendar();
    requestAnimationFrame(syncCalendarHeader);
  }

  function toggleViewMenu() {
    document.getElementById("viewMenu").classList.toggle("open");
    document.getElementById("teamMenu").classList.remove("open");
  }

  function closeViewMenu() {
    document.getElementById("viewMenu").classList.remove("open");
  }

  function setCalendarView(view, options = {}) {
    calendarView = view;
    if (options.resetDate !== false) {
      selectedDate = new Date();
      selectedMonthDay = currentDateISO();
    }
    closeViewMenu();
    closeQuickMenu();
    document.getElementById("viewSelectorLabel").textContent = { day: "Día", week: "Semana", month: "Mes" }[view] || "Día";
    document.getElementById("viewCheckDay").classList.toggle("hidden", view !== "day");
    document.getElementById("viewCheckWeek").classList.toggle("hidden", view !== "week");
    document.getElementById("viewCheckMonth").classList.toggle("hidden", view !== "month");
    document.getElementById("resourceHeaderViewport").classList.toggle("hidden", view !== "day");
    document.getElementById("dayCalendarShell").classList.toggle("hidden", view !== "day");
    document.getElementById("weekCalendarShell").classList.toggle("hidden", view !== "week");
    document.getElementById("monthCalendarShell").classList.toggle("hidden", view !== "month");
    updateDateNavigationLabel();

    if (view === "month") {
      renderMonthCalendar();
    } else if (view === "week") {
      renderWeekCalendar();
    } else {
      renderResourceHeader();
      renderCalendar();
      requestAnimationFrame(syncCalendarHeader);
      requestAnimationFrame(() => scrollCalendarToCurrentTime());
    }
  }

  function updateDateNavigationLabel() {
    document.getElementById("dateNavigationLabel").textContent = currentDateLabel();
  }

  function moveDate(direction) {
    selectedDate = calendarView === "month"
      ? addMonths(selectedDate, direction)
      : addDays(selectedDate, calendarView === "week" ? direction * 7 : direction);
    selectedMonthDay = currentDateISO();
    closeDrawer();
    renderAll();
  }

  function goToday() {
    selectedDate = new Date();
    selectedMonthDay = currentDateISO();
    renderAll();
    if (calendarView === "day") requestAnimationFrame(() => scrollCalendarToCurrentTime("smooth"));
  }

  function refreshCalendar() {
    renderAll();
    showToast("Turnos actualizados");
  }

  function renderWeekCalendar() {
    const week = document.getElementById("weekCalendar");
    if (!week) return;

    const dates = weekDates();
    const staff = visibleEmployees();
    const todayISO = dateToISO(new Date());

    week.innerHTML = `
      <div class="week-corner"></div>
      ${dates.map(day => {
        const iso = dateToISO(day);
        return `
          <div class="week-day-header ${iso === todayISO ? "today" : ""}">
            <span class="week-day-number">${day.getDate()}</span>
            <span>${SPANISH_WEEKDAYS[(day.getDay() + 6) % 7]}</span>
          </div>
        `;
      }).join("")}
      ${staff.map(employee => `
        <div class="week-employee">
          ${employeeAvatarMarkup(employee, "week-employee-avatar")}
          <span class="week-employee-name" title="${escapeAttribute(employee.name)}">${escapeHTML(employee.name)}</span>
        </div>
        ${dates.map(day => renderWeekCell(employee, day)).join("")}
      `).join("")}
    `;
  }

  function renderWeekCell(employee, day) {
    const iso = dateToISO(day);
    const dayAppointments = appointments
      .filter(item => item.dateISO === iso && item.employeeId === employee.id)
      .sort((a, b) => a.start.localeCompare(b.start));
    const dayBlocks = blocks
      .filter(item => item.dateISO === iso && (!item.employeeId || item.employeeId === employee.id))
      .sort((a, b) => a.start.localeCompare(b.start));
    const items = [
      ...dayAppointments.map(item => ({ ...item, kind: "appointment" })),
      ...dayBlocks.map(item => ({ ...item, kind: "block" }))
    ].sort((a, b) => a.start.localeCompare(b.start));
    const selected = selectedSlot?.employeeId === employee.id && selectedSlot?.dateISO === iso;
    const weekend = day.getDay() === 0 || day.getDay() === 6;
    const label = monthDayLabel(day);

    return `
      <button type="button" class="week-cell ${weekend ? "weekend" : ""} ${selected ? "selected" : ""}" onclick="handleWeekCellClick(event, '${escapeAttribute(employee.id)}', '${iso}', '${escapeAttribute(label)}')">
        ${items.slice(0, 5).map(item => item.kind === "appointment" ? `
          <span role="button" tabindex="0" class="week-item" style="background:${item.color || "#ffded4"}; border-left-color:${employee.color};" onclick="event.stopPropagation(); openCalendarAppointmentDetails('${escapeAttribute(item.id)}')">
            <span class="week-item-time">${escapeHTML(item.start)}</span>
            <span class="week-item-label">${escapeHTML(item.client)} · ${escapeHTML(item.service)}</span>
          </span>
        ` : `
          <span role="button" tabindex="0" class="week-item" style="background:${item.color || "#e5e7eb"}; border-left-color:#a1a1aa;" onclick="event.stopPropagation(); openBlockedDetails('${escapeAttribute(item.id)}')">
            <span class="week-item-time">${escapeHTML(item.start)}</span>
            <span class="week-item-label">No disponible · ${escapeHTML(item.reason)}</span>
          </span>
        `).join("")}
        ${items.length > 5 ? `<span class="week-more">+${items.length - 5} más</span>` : ""}
      </button>
    `;
  }

  function handleWeekCellClick(event, employeeId, iso, label) {
    selectedDate = dateFromISO(iso);
    selectedMonthDay = iso;
    selectedSlot = { employeeId, time: "10:00", dateISO: iso, dateLabel: label };

    if (actionMode === "appointment") {
      selectedService = null;
      selectedServices = [];
      editingServiceIndex = null;
      renderWeekCalendar();
      openServicePanel();
      return;
    }

    if (actionMode === "blocked") {
      renderWeekCalendar();
      openBlockedTimePanel();
      return;
    }

    renderWeekCalendar();
    showQuickMenu(event.clientX, event.clientY, employeeId, "10:00", iso, label);
  }

  function renderMonthCalendar() {
    const month = document.getElementById("monthCalendar");
    if (!month) return;
    const firstDay = new Date(selectedDate.getFullYear(), selectedDate.getMonth(), 1);
    const lastDay = new Date(selectedDate.getFullYear(), selectedDate.getMonth() + 1, 0);
    const mondayIndex = (firstDay.getDay() + 6) % 7;
    const gridStart = addDays(firstDay, -mondayIndex);
    const totalDays = Math.ceil((mondayIndex + lastDay.getDate()) / 7) * 7;
    const todayISO = dateToISO(new Date());
    const visibleIds = new Set(visibleEmployees().map(employee => employee.id));

    const days = Array.from({ length: totalDays }, (_, index) => addDays(gridStart, index));
    month.innerHTML = `
      ${SPANISH_WEEKDAYS.map(day => `<div class="month-weekday">${day}</div>`).join("")}
      ${days.map(day => {
        const iso = dateToISO(day);
        const dayAppointments = appointments
          .filter(item => item.dateISO === iso && visibleIds.has(item.employeeId))
          .sort((a, b) => a.start.localeCompare(b.start));
        const muted = day.getMonth() !== selectedDate.getMonth();
        const label = monthDayLabel(day);
        return `
          <button type="button" onclick="handleMonthDayClick('${iso}', '${label}')" class="month-day ${muted ? "muted" : ""} ${selectedMonthDay === iso ? "selected" : ""}" data-date="${iso}">
            <span class="${iso === todayISO ? "month-today-badge" : "month-day-number"}">${day.getDate() === 1 ? `${day.getDate()} ${SPANISH_MONTHS[day.getMonth()]}` : day.getDate()}</span>
            <div class="mt-3">
              ${dayAppointments.slice(0, 3).map(item => `<div class="month-appt" onclick="event.stopPropagation(); openCalendarAppointmentDetails('${escapeAttribute(item.id)}')">${escapeHTML(item.start)} ${escapeHTML(item.client)}</div>`).join("")}
              ${dayAppointments.length > 3 ? `<div class="month-more">+${dayAppointments.length - 3} más</div>` : ""}
            </div>
          </button>
        `;
      }).join("")}
    `;
  }

  function handleMonthDayClick(iso, label) {
    selectedDate = dateFromISO(iso);
    selectedMonthDay = iso;
    selectedSlot = { employeeId: firstVisibleEmployeeId(), time: "10:00", dateLabel: label, dateISO: iso };
    actionMode = "appointment";
    selectedService = null;
    selectedServices = [];
    editingServiceIndex = null;
    selectedCustomer = null;

    document.body.classList.add("action-mode-active");

    updateDateNavigationLabel();
    renderMonthCalendar();
    openServicePanel();
  }

  document.addEventListener("click", event => {
    const quickMenu = document.getElementById("quickMenu");
    if (!event.target.closest("#teamMenu") && !event.target.closest("#teamSelectorButton")) closeTeamMenu();
    if (!event.target.closest("#viewMenu") && !event.target.closest("#viewSelectorButton")) closeViewMenu();
    if (!event.target.closest(".waitlist-card-menu") && !event.target.closest("button[onclick^='toggleWaitlistEntryMenu']")) closeWaitlistEntryMenus();
    if (!event.target.closest("#quickMenu") && !event.target.closest(".calendar-slot") && !event.target.closest(".week-cell")) quickMenu.classList.remove("open");
  }, { signal: calendarSignal });

  document.addEventListener("keydown", event => {
    if (event.key === "Escape") {
      if (document.querySelector("dialog[open]")) return;
      closeTeamMenu();
      closeViewMenu();
      closeQuickMenu();
      closeWaitlistEntryMenus();
      const drawer = document.getElementById("rightDrawer");
      if (drawer?.classList.contains("open")) {
        dismissDrawer();
      } else if (actionMode) {
        cancelAction();
      }
    }
  }, { signal: calendarSignal });

  function syncCalendarHeader() {
    const scroll = document.getElementById("calendarScroll");
    const header = document.getElementById("resourceHeader");
    const body = document.getElementById("calendarBody");
    if (!scroll || !header || !body) return;
    header.style.width = `${body.scrollWidth}px`;
    header.style.transform = `translateX(${-scroll.scrollLeft}px)`;
  }

  function renderAll() {
    updateDateNavigationLabel();
    renderWaitlistToolbarCount();
    renderTeamMenu();
    if (calendarView === "month") {
      renderMonthCalendar();
    } else if (calendarView === "week") {
      renderWeekCalendar();
    } else {
      renderResourceHeader();
      renderCalendar();
      requestAnimationFrame(syncCalendarHeader);
    }
  }

  function customerDetailRow({ label, value, href = "", icon = "", external = false, muted = false }) {
    const body = `
      <span class="appointment-client-detail-icon">${icon}</span>
      <span class="min-w-0">
        <span class="appointment-client-detail-label">${escapeHTML(label)}</span>
        <span class="appointment-client-detail-value">${escapeHTML(value)}</span>
      </span>
    `;
    const classes = `appointment-client-detail${muted ? " muted" : ""}`;
    if (!href) return `<div class="${classes}">${body}</div>`;
    const targetAttrs = external ? ` target="_blank" rel="noopener noreferrer"` : "";
    return `<a href="${escapeAttribute(href)}" class="${classes}"${targetAttrs}>${body}</a>`;
  }

  function formatCustomerCreatedAt(value) {
    if (!value) return "Sin fecha";
    const parsed = new Date(`${value}T00:00:00`);
    if (Number.isNaN(parsed.getTime())) return "Sin fecha";
    return new Intl.DateTimeFormat("es-AR", { day: "2-digit", month: "2-digit", year: "numeric" }).format(parsed);
  }

  function emailIconMarkup() {
    return '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16v12H4V6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m5 7 7 6 7-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  }

  function calendarSmallIconMarkup() {
    return '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><rect x="4" y="5" width="16" height="16" rx="3" stroke="currentColor" stroke-width="2"/><path d="M4 10h16" stroke="currentColor" stroke-width="2"/></svg>';
  }

  function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, character => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    }[character]));
  }

  function escapeAttribute(value) {
    return escapeHTML(value);
  }

  function init() {
    selectedMonthDay = currentDateISO();
    renderAll();
    setCalendarView("week", { resetDate: false });
    const scroll = document.getElementById("calendarScroll");
    if (calendarView === "day") requestAnimationFrame(() => scrollCalendarToCurrentTime());
    scroll.addEventListener("scroll", syncCalendarHeader, { signal: calendarSignal });
    window.addEventListener("resize", syncCalendarHeader, { signal: calendarSignal });
    const currentTimeTimer = window.setInterval(refreshCurrentTimeLine, 30_000);
    calendarSignal.addEventListener("abort", () => window.clearInterval(currentTimeTimer), { once: true });
    requestAnimationFrame(syncCalendarHeader);
    if (initialAppointmentToken) {
      requestAnimationFrame(() => openCalendarAppointmentDetails(initialAppointmentToken));
    } else if (initialWaitlistOpen) {
      requestAnimationFrame(() => openWaitlistPanel());
    }
  }

  Object.assign(window, {
    addAppointmentService,
    cancelAction,
    chooseExistingCustomer,
    chooseNewCustomer,
    chooseWalkInCustomer,
    chooseWaitlistExistingCustomer,
    chooseWaitlistNewCustomer,
    changeWaitlistServiceFilter,
    changeWaitlistSort,
    changeWaitlistSpecificDate,
    changeWaitlistTab,
    clearWaitlistStartTimeFilter,
    closeDrawer,
    dismissDrawer,
    closeQuickMenu,
    changeWaitlistDateFilter,
    createAppointmentFromForm,
    createBlockedTime,
    deleteBlockedTime,
    deleteExistingAppointment,
    deleteWaitlistEntry,
    editWaitlistEntry,
    bookWaitlistEntry,
    goToday,
    handleMonthDayClick,
    handleWeekCellClick,
    editAppointmentService,
    moveDate,
    openNotificationsPanel,
    openCustomerPicker,
    openBlockedDetails,
    openCalendarAppointmentDetails,
    openAppointmentDetails,
    openRemainingBalancePaymentDialog,
    closeRemainingBalancePaymentDialog,
    confirmRemainingBalancePayment,
    approveCalendarDeposit,
    rejectCalendarDeposit,
    openCalendarProfessionalPicker,
    cancelCalendarAppointment,
    openPaymentPanel,
    openSalePanel,
    openWaitlistCustomerPicker,
    openWaitlistPanel,
    openWaitlistPreferenceForm,
    quickAction,
    refreshCalendar,
    removeAppointmentService,
    selectAllEmployees,
    selectService,
    setCalendarView,
    saveWaitlistEntry,
    showNewCustomerForm,
    showWaitlistNewCustomerForm,
    startAction,
    syncBlockedDescriptionCounter,
    syncBlockedDurationLabel,
    syncWaitlistEmployeeOptions,
    syncWaitlistWindowFields,
    toggleEmployee,
    toggleTeamMenu,
    toggleWaitlistEntryMenu,
    toggleViewMenu
  });

  init();
})();
</script>
