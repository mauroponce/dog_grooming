  function editWaitlistEntry(entryId) {
    closeWaitlistEntryMenus();
    selectedWaitlistCustomer = null;
    openWaitlistPreferenceForm(entryId);
  }

  function normalizeWaitlistWindow(window) {
    const normalized = window || WAITLIST_TIME_PRESETS.any;
    const period = WAITLIST_TIME_PRESETS[normalized.period] ? normalized.period : "custom";
    return {
      period,
      label: normalized.label || WAITLIST_TIME_PRESETS[period].label,
      start_time: normalized.start_time || normalized.startTime || WAITLIST_TIME_PRESETS[period].start_time,
      end_time: normalized.end_time || normalized.endTime || WAITLIST_TIME_PRESETS[period].end_time
    };
  }

  function syncWaitlistWindowFields() {
    const fields = document.getElementById("waitlistCustomWindowFields");
    const preset = document.getElementById("waitlistWindowPresetInput")?.value;
    fields?.classList.toggle("hidden", preset !== "custom");
  }

  function waitlistEmployeeOptions(serviceId, selectedEmployeeId = "") {
    const service = serviceById(serviceId) || services[0];
    const allowedIds = new Set(service?.employees || employees.map(employee => employee.id));
    const allowedEmployees = employees.filter(employee => allowedIds.has(employee.id));
    return `
      <option value="" ${selectedEmployeeId ? "" : "selected"}>Cualquier miembro del equipo</option>
      ${allowedEmployees.map(employee => `<option value="${escapeAttribute(employee.id)}" ${String(employee.id) === String(selectedEmployeeId) ? "selected" : ""}>${escapeHTML(employee.name)}</option>`).join("")}
    `;
  }

  function syncWaitlistEmployeeOptions() {
    const serviceId = document.getElementById("waitlistServiceInput")?.value;
    const employeeInput = document.getElementById("waitlistEmployeeInput");
    if (!employeeInput) return;

    employeeInput.innerHTML = waitlistEmployeeOptions(serviceId, employeeInput.value);
  }

  function waitlistWindowFromForm() {
    const period = document.getElementById("waitlistWindowPresetInput")?.value || "any";
    if (period !== "custom") return { ...WAITLIST_TIME_PRESETS[period], period };

    const start = document.getElementById("waitlistStartInput")?.value || "09:00";
    const finish = document.getElementById("waitlistEndInput")?.value || "18:00";
    return { period: "custom", label: `${start} a ${finish}`, start_time: start, end_time: finish };
  }

  async function saveWaitlistEntry() {
    const customer = selectedWaitlistCustomer;
    const submitButton = document.getElementById("saveWaitlistButton");
    const errorBox = document.getElementById("waitlistFormError");
    if (!customer || !submitButton || !errorBox) return;

    errorBox.classList.add("hidden");
    errorBox.textContent = "";
    if (!customer.phone || !customer.email) {
      errorBox.textContent = "El cliente debe tener teléfono y email para ingresar a la lista de espera.";
      errorBox.classList.remove("hidden");
      return;
    }
    submitButton.disabled = true;
    submitButton.textContent = "Guardando...";

    try {
      const entryId = waitlistEditingEntryId;
      const response = await fetch(entryId ? waitlistUpdateUrlTemplate.replace("__ID__", encodeURIComponent(entryId)) : waitlistCreateUrl, {
        method: entryId ? "PATCH" : "POST",
        headers: {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "X-CSRF-Token": csrfToken
        },
        body: JSON.stringify({
          waitlist_entry: {
            customer_profile_id: customer.id || "",
            client_name: customer.name,
            client_phone: customer.phone || "",
            email: customer.email || "",
            service_id: document.getElementById("waitlistServiceInput")?.value,
            employee_membership_id: document.getElementById("waitlistEmployeeInput")?.value || "",
            desired_date: document.getElementById("waitlistDateInput")?.value,
            preferred_time_windows: [waitlistWindowFromForm()],
            notes: document.getElementById("waitlistNotesInput")?.value.trim() || ""
          }
        })
      });
      const payload = await response.json().catch(() => ({}));

      if (!response.ok) {
        errorBox.textContent = Array.isArray(payload.errors) && payload.errors.length ? payload.errors.join(". ") : "No se pudo guardar la lista de espera.";
        errorBox.classList.remove("hidden");
        return;
      }

      upsertWaitlistEntry(payload);
      selectedWaitlistCustomer = null;
      waitlistEditingEntryId = null;
      openWaitlistPanel();
      showToast(entryId ? "Lista de espera actualizada" : "Cliente añadido a la lista de espera");
    } catch (_error) {
      errorBox.textContent = "No se pudo conectar con el servidor. Probá de nuevo.";
      errorBox.classList.remove("hidden");
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = waitlistEditingEntryId ? "Guardar cambios" : "Añadir a lista de espera";
    }
  }

  function upsertWaitlistEntry(entry) {
    waitlistEntries = waitlistEntries.filter(item => String(item.id) !== String(entry.id));
    waitlistEntries.push(entry);
    renderWaitlistToolbarCount();
  }

  function markWaitlistEntryBooked(entryId) {
    waitlistEntries = waitlistEntries.map(entry => {
      if (String(entry.id) !== String(entryId)) return entry;
      return { ...entry, status: "booked", statusLabel: "Reservada" };
    });
    renderWaitlistToolbarCount();
  }

  async function deleteWaitlistEntry(entryId) {
    closeWaitlistEntryMenus();
    try {
      const response = await fetch(waitlistDestroyUrlTemplate.replace("__ID__", encodeURIComponent(entryId)), {
        method: "DELETE",
        headers: {
          "Accept": "application/json",
          "X-CSRF-Token": csrfToken
        }
      });
      if (!response.ok) throw new Error("delete failed");

      waitlistEntries = waitlistEntries.filter(entry => String(entry.id) !== String(entryId));
      renderWaitlistPanel();
      showToast("Entrada eliminada de la lista de espera");
    } catch (_error) {
      showToast("No se pudo eliminar la entrada");
    }
  }

  function firstEmployeeForService(service) {
    const allowedIds = new Set(service?.employees || []);
    const visible = visibleEmployees().find(employee => allowedIds.has(employee.id));
    if (visible) return visible.id;

    return employees.find(employee => allowedIds.has(employee.id))?.id || firstVisibleEmployeeId();
  }

  function waitlistBookingStartTime(entry) {
    const window = normalizeWaitlistWindow(entry.preferredTimeWindows?.[0]);
    return window.start_time === "00:00" ? "10:00" : window.start_time;
  }

  function bookWaitlistEntry(entryId) {
    const entry = waitlistEntries.find(item => String(item.id) === String(entryId));
    const service = serviceById(entry?.serviceId);
    if (!entry || !service) {
      showToast("No se encontró la entrada de lista de espera");
      return;
    }

    closeWaitlistEntryMenus();
    const employeeId = entry.employeeId || firstEmployeeForService(service);
    selectedEmployeeIds.add(employeeId);
    selectedDate = dateFromISO(entry.desiredDate);
    selectedMonthDay = entry.desiredDate;
    selectedSlot = {
      employeeId,
      time: waitlistBookingStartTime(entry),
      dateISO: entry.desiredDate,
      dateLabel: monthDayLabel(dateFromISO(entry.desiredDate))
    };
    selectedService = service;
    selectedServices = [service];
    editingServiceIndex = null;
    selectedCustomer = {
      id: entry.customerProfileId || null,
      name: entry.clientName,
      phone: entry.clientPhone || "",
      email: entry.email || "",
      isNew: !entry.customerProfileId
    };
    waitlistAppointmentEntryId = entry.id;
    actionMode = "appointment";
    document.body.classList.add("action-mode-active");
    renderAll();
    openClientFormPanel();
  }

