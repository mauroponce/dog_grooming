            </div>
            <div>
              <label class="mb-2 block text-sm font-bold">Hora preferida</label>
              <select id="waitlistWindowPresetInput" onchange="syncWaitlistWindowFields()" class="w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100">
                ${Object.entries(WAITLIST_TIME_PRESETS).map(([key, preset]) => `<option value="${key}" ${selectedWindow.period === key ? "selected" : ""}>${escapeHTML(preset.label)}</option>`).join("")}
              </select>
              <div id="waitlistCustomWindowFields" class="${selectedWindow.period === "custom" ? "" : "hidden"} mt-3 grid grid-cols-2 gap-3">
                <select id="waitlistStartInput" class="rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100">${timeSelectOptions(selectedWindow.start_time)}</select>
                <select id="waitlistEndInput" class="rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100">${timeSelectOptions(selectedWindow.end_time)}</select>
