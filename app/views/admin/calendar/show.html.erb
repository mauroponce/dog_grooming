  function openCustomerPicker() {
    const pane = document.getElementById("appointmentClientPane");
    if (!pane) return;

    pane.innerHTML = `
      <div class="customer-picker-header">
        <h3 class="customer-picker-title">Seleccionar responsable</h3>
        <input type="search" class="customer-picker-search" placeholder="Buscar por nombre, teléfono o email" data-customer-search autocomplete="off">
      </div>
      <div>
        <button type="button" onclick="showNewCustomerForm()" class="customer-picker-option"><span class="customer-picker-option-avatar">+</span><span><span class="customer-picker-option-name">Añadir un nuevo responsable</span><span class="customer-picker-option-meta">Crear al guardar el turno</span></span></button>
        <button type="button" onclick="chooseWalkInCustomer()" class="customer-picker-option"><span class="customer-picker-option-avatar">○</span><span><span class="customer-picker-option-name">Sin cita</span><span class="customer-picker-option-meta">Sin cliente registrado</span></span></button>
      </div>
      <div id="customerPickerResults"></div>
      <div id="customerPickerLoading" class="hidden px-5 py-4 text-center text-xs font-bold text-zinc-500">Cargando clientes...</div>
    `;

    pane.dataset.customerPage = "0";
    pane.dataset.customerHasMore = "true";
    pane.dataset.customerQuery = "";
    pane.addEventListener("scroll", handleCustomerPickerScroll, { signal: calendarSignal });
    pane.querySelector("[data-customer-search]").addEventListener("input", event => {
      window.clearTimeout(customerSearchTimer);
      customerSearchTimer = window.setTimeout(() => resetAndLoadCustomers(event.target.value), 220);
    }, { signal: calendarSignal });
    loadMoreCustomers();
  }

  function resetAndLoadCustomers(query) {
    const pane = document.getElementById("appointmentClientPane");
    if (!pane) return;
    pane.dataset.customerPage = "0";
    pane.dataset.customerHasMore = "true";
    pane.dataset.customerQuery = query.trim();
    document.getElementById("customerPickerResults").innerHTML = "";
    loadedCustomers = new Map();
    loadMoreCustomers();
  }

  function handleCustomerPickerScroll(event) {
    const pane = event.currentTarget;
    if (pane.scrollTop + pane.clientHeight >= pane.scrollHeight - 120) loadMoreCustomers();
  }

  async function loadMoreCustomers() {
    const pane = document.getElementById("appointmentClientPane");
    const results = document.getElementById("customerPickerResults");
    const loading = document.getElementById("customerPickerLoading");
    if (!pane || !results || pane.dataset.customerLoading === "true" || pane.dataset.customerHasMore !== "true") return;

    pane.dataset.customerLoading = "true";
    loading?.classList.remove("hidden");
    const page = Number(pane.dataset.customerPage || 0) + 1;
    const query = pane.dataset.customerQuery || "";
    const sequence = ++customerRequestSequence;

    try {
      const url = new URL(customerAutocompleteUrl, window.location.origin);
      url.searchParams.set("page", page);
      if (query) url.searchParams.set("q", query);
      const response = await fetch(url, { headers: { "Accept": "application/json" } });
      if (!response.ok) throw new Error("customer request failed");
      const payload = await response.json();
      if (sequence !== customerRequestSequence || query !== (pane.dataset.customerQuery || "")) return;

      payload.results.forEach(customer => loadedCustomers.set(String(customer.id), customer));
      results.insertAdjacentHTML("beforeend", payload.results.map(customer => `
        <button type="button" onclick="chooseExistingCustomer('${escapeAttribute(customer.id)}')" class="customer-picker-option">
          <span class="customer-picker-option-avatar">${escapeHTML(customer.initials)}</span>
          <span class="min-w-0"><span class="customer-picker-option-name">${escapeHTML(customer.name)}</span><span class="customer-picker-option-meta">${escapeHTML(customer.phone || customer.email || customer.subtitle || "Sin datos de contacto")}</span></span>
        </button>
      `).join(""));
      pane.dataset.customerPage = String(payload.page);
      pane.dataset.customerHasMore = String(payload.has_more);
      if (page === 1 && payload.results.length === 0) results.innerHTML = `<p class="px-5 py-6 text-center text-sm font-semibold text-zinc-500">No encontramos clientes.</p>`;
    } catch (_error) {
      if (page === 1) results.innerHTML = `<p class="px-5 py-6 text-center text-sm font-semibold text-red-600">No se pudo cargar el listado.</p>`;
    } finally {
      pane.dataset.customerLoading = "false";
      loading?.classList.add("hidden");
    }
  }

  function chooseExistingCustomer(customerId) {
    selectedCustomer = loadedCustomers.get(String(customerId));
    if (selectedServices.length) openClientFormPanel(); else openServicePanel();
  }

  function chooseWalkInCustomer() {
