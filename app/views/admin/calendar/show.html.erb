    if (!blocked) return;
    const employee = employeeById(blocked.employeeId || firstVisibleEmployeeId());
    openDrawer(`
      ${drawerHeader("Horario no disponible", `${blocked.start} · ${employee.name}`)}
      <div class="drawer-scroll flex-1 overflow-y-auto px-6 py-5">
        <div class="rounded-3xl border border-zinc-100 bg-zinc-50 p-5">
          <p class="text-sm font-bold">${escapeHTML(blocked.reason || "No disponible")}</p>
          <p class="mt-1 text-sm font-semibold text-zinc-500">${serviceDurationLabel(blocked.duration)}</p>
          ${blocked.description ? `<p class="mt-4 text-sm font-semibold leading-6 text-zinc-600">${escapeHTML(blocked.description)}</p>` : ""}
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="rounded-full bg-white px-3 py-1 text-xs font-bold text-zinc-600">${escapeHTML(blocked.recurrenceLabel || "No se repite")}</span>
            ${blocked.onlineBookingAllowed ? `<span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">Reserva online permitida</span>` : ""}
          </div>
        </div>
        <button type="button" onclick="deleteBlockedTime('${escapeAttribute(blocked.id)}')" class="mt-5 w-full rounded-full border border-red-200 bg-red-50 px-5 py-4 text-sm font-bold text-red-600">Eliminar bloqueo</button>
        <p id="blockedDeleteError" class="mt-3 hidden rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-bold text-red-700"></p>
      </div>
    `);
  }

  async function deleteBlockedTime(blockId) {
    const blocked = blocks.find(item => String(item.id) === String(blockId));
    if (!blocked) return;

    const errorBox = document.getElementById("blockedDeleteError");
    if (errorBox) {
      errorBox.classList.add("hidden");
      errorBox.textContent = "";
    }

    try {
      const seriesId = blocked.seriesId || blocked.id;
      const response = await fetch(availabilityBlockDeleteUrlTemplate.replace("__ID__", encodeURIComponent(seriesId)), {
        method: "DELETE",
        headers: {
          "Accept": "application/json",
          "X-CSRF-Token": csrfToken
        }
      });
      const payload = await response.json().catch(() => ({}));

      if (!response.ok) {
        if (errorBox) {
          errorBox.textContent = Array.isArray(payload.errors) && payload.errors.length ? payload.errors.join(". ") : "No se pudo eliminar el bloqueo.";
          errorBox.classList.remove("hidden");
        }
        return;
      }

      const removedSeriesId = String(payload.seriesId || seriesId);
      blocks = blocks.filter(item => String(item.seriesId || item.id) !== removedSeriesId);
      closeDrawer();
      renderAll();
      showToast("Horario no disponible eliminado");
    } catch (_error) {
      if (errorBox) {
        errorBox.textContent = "No se pudo conectar con el servidor. Probá de nuevo.";
        errorBox.classList.remove("hidden");
      }
    }
  }

  function waitlistActiveEntries() {
    return waitlistEntries.filter(entry => ["waiting", "offered"].includes(entry.status));
  }

  function renderWaitlistToolbarCount() {
    const badge = document.getElementById("waitlistToolbarCount");
    if (!badge) return;

    badge.textContent = waitlistActiveEntries().length;
  }

  function waitlistStatusGroup(entry) {
    if (entry.status === "booked") return "booked";
    if (entry.status === "expired") return "expired";
    return ["waiting", "offered"].includes(entry.status) ? "waiting" : entry.status;
  }

  function waitlistTabCount(tab) {
    return waitlistEntries.filter(entry => waitlistStatusGroup(entry) === tab).length;
  }

  function waitlistWindowCovers(entry, time) {
    if (!time) return true;

    const target = minutesFromTime(time);
    const windows = Array.isArray(entry.preferredTimeWindows) && entry.preferredTimeWindows.length ? entry.preferredTimeWindows : [WAITLIST_TIME_PRESETS.any];
    return windows.some(window => {
      const start = minutesFromTime(window.start_time || window.startTime || "00:00");
      const finish = minutesFromTime(window.end_time || window.endTime || "23:55");
      if (start <= finish) return target >= start && target < finish;
      return target >= start || target < finish;
    });
  }

  function waitlistFilteredEntries() {
    const todayISO = dateToISO(new Date());
    let entries = waitlistEntries.filter(entry => waitlistStatusGroup(entry) === waitlistTab);

    if (waitlistDateFilter === "upcoming") entries = entries.filter(entry => entry.desiredDate >= todayISO);
    if (waitlistDateFilter === "specific" && waitlistDesiredDateFilter) entries = entries.filter(entry => entry.desiredDate === waitlistDesiredDateFilter);
    if (waitlistServiceFilter) entries = entries.filter(entry => String(entry.serviceId) === String(waitlistServiceFilter));
    if (waitlistStartTimeFilter) entries = entries.filter(entry => waitlistWindowCovers(entry, waitlistStartTimeFilter));

    return entries.sort((left, right) => {
      if (waitlistSort === "date_asc") return `${left.desiredDate}${left.createdAt}`.localeCompare(`${right.desiredDate}${right.createdAt}`);
      if (waitlistSort === "created_desc") return String(right.createdAt).localeCompare(String(left.createdAt));
      return String(left.createdAt).localeCompare(String(right.createdAt));
    });
  }

  function openWaitlistPanel() {
    if (actionMode) cancelAction();
    closeTeamMenu();
    closeViewMenu();
    closeQuickMenu();
    openDrawer(waitlistPanelHTML());
    renderWaitlistToolbarCount();
  }

  function renderWaitlistPanel() {
    const content = document.getElementById("drawerContent");
    if (!content) return;

    content.innerHTML = waitlistPanelHTML();
    renderWaitlistToolbarCount();
  }

  function waitlistPanelHTML() {
    const counts = {
      waiting: waitlistTabCount("waiting"),
      expired: waitlistTabCount("expired"),
      booked: waitlistTabCount("booked")
    };
    const entries = waitlistFilteredEntries();
    const offeredEntries = entries.filter(entry => entry.status === "offered");
    const waitingEntries = entries.filter(entry => entry.status !== "offered");

    return `
      ${drawerHeader("Lista de espera")}
      <div class="drawer-scroll min-h-0 flex-1 overflow-y-auto px-6 py-5">
        <div class="mb-5 flex items-center justify-end gap-3">
          <button type="button" onclick="openWaitlistCustomerPicker()" class="inline-flex h-11 items-center justify-center rounded-full bg-zinc-950 px-5 text-sm font-bold text-white">Añadir</button>
        </div>
        <div class="grid gap-3">
          <select onchange="changeWaitlistDateFilter(this.value)" class="rounded-full border border-zinc-200 bg-white px-4 py-3 text-sm font-bold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100">
            <option value="upcoming" ${waitlistDateFilter === "upcoming" ? "selected" : ""}>Todas las próximas fechas</option>
            <option value="all" ${waitlistDateFilter === "all" ? "selected" : ""}>Todas las fechas</option>
            <option value="specific" ${waitlistDateFilter === "specific" ? "selected" : ""}>Una fecha específica</option>
          </select>
          ${waitlistDateFilter === "specific" ? `<input type="text" inputmode="numeric" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" placeholder="dd/mm/aaaa" value="${escapeAttribute(localizedDateFromISO(waitlistDesiredDateFilter || currentDateISO()))}" onchange="changeWaitlistSpecificDate(this.value)" class="rounded-full border border-zinc-200 bg-white px-4 py-3 text-sm font-bold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100">` : ""}
          <select onchange="changeWaitlistServiceFilter(this.value)" class="rounded-full border border-zinc-200 bg-white px-4 py-3 text-sm font-bold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100">
            <option value="" ${waitlistServiceFilter === "" ? "selected" : ""}>Todos los servicios</option>
            ${services.map(service => `<option value="${escapeAttribute(service.id)}" ${String(waitlistServiceFilter) === String(service.id) ? "selected" : ""}>${escapeHTML(service.name)}</option>`).join("")}
          </select>
          <select onchange="changeWaitlistSort(this.value)" class="rounded-full border border-zinc-200 bg-white px-4 py-3 text-sm font-bold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100">
            <option value="created_asc" ${waitlistSort === "created_asc" ? "selected" : ""}>Creado (más antiguo primero)</option>
            <option value="created_desc" ${waitlistSort === "created_desc" ? "selected" : ""}>Creado (más reciente primero)</option>
            <option value="date_asc" ${waitlistSort === "date_asc" ? "selected" : ""}>Fecha más próxima</option>
          </select>
          ${waitlistStartTimeFilter ? `
            <div class="flex items-center justify-between gap-3 rounded-2xl border border-brand-200 bg-brand-50 px-4 py-3 text-sm font-bold text-brand-900">
              <span>Horario liberado: ${escapeHTML(waitlistStartTimeFilter)}</span>
              <button type="button" onclick="clearWaitlistStartTimeFilter()" class="rounded-full bg-white px-3 py-1 text-xs font-bold text-brand-700">Quitar</button>
            </div>
          ` : ""}
        </div>
        <div class="mt-6 flex border-b border-zinc-200">
          ${waitlistTabButton("waiting", "En espera", counts.waiting)}
          ${waitlistTabButton("expired", "Caducada", counts.expired)}
          ${waitlistTabButton("booked", "Reservada", counts.booked)}
        </div>
        <div class="mt-6 space-y-5">
          ${entries.length ? (
            waitlistTab === "waiting"
              ? `${waitlistEntrySection("Disponible para reservar", offeredEntries)}${waitlistEntrySection("En espera", waitingEntries)}`
              : waitlistEntrySection(waitlistTab === "expired" ? "Caducadas" : "Reservadas", entries)
          ) : waitlistEmptyState()}
        </div>
      </div>
    `;
  }

  function waitlistTabButton(tab, label, count) {
    return `
      <button type="button" onclick="changeWaitlistTab('${tab}')" class="waitlist-tab ${waitlistTab === tab ? "active" : ""} -mb-px flex flex-1 items-center justify-center gap-2 border-b-2 border-transparent px-2 py-3 text-sm font-bold text-zinc-500">
        ${label}
        <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-bold text-zinc-600">${count}</span>
      </button>
    `;
  }

  function waitlistEntrySection(title, entries) {
    if (!entries.length) return "";

    return `
      <section>
        <h3 class="mb-3 flex items-center gap-2 text-base font-bold">
          ${escapeHTML(title)}
          <span class="grid h-6 min-w-6 place-items-center rounded-full bg-rose-600 px-2 text-xs font-bold text-white">${entries.length}</span>
        </h3>
        <div class="space-y-3">${entries.map(waitlistEntryCard).join("")}</div>
      </section>
    `;
  }

  function waitlistEntryCard(entry) {
    const professional = entry.employeeName || "Cualquier miembro del equipo";
    const windows = (entry.preferredTimeLabels || []).join(", ") || "En cualquier momento";

    return `
      <article class="waitlist-card p-5">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <p class="truncate text-lg font-bold">${escapeHTML(entry.clientName)}</p>
            <p class="mt-1 truncate text-sm font-semibold text-zinc-500">${escapeHTML(entry.email || entry.clientPhone || "Sin contacto")}</p>
          </div>
