  function syncBlockedDurationLabel() {
    const start = document.getElementById("blockedStartInput")?.value;
    const finish = document.getElementById("blockedEndInput")?.value;
    const label = document.getElementById("blockedDurationLabel");
    if (!start || !finish || !label) return;

    label.textContent = `${serviceDurationLabel(durationFromTimes(start, finish))} de duración`;
  }

  function syncBlockedDescriptionCounter() {
    const textarea = document.getElementById("blockedDescriptionInput");
    const counter = document.getElementById("blockedDescriptionCounter");
    if (!textarea || !counter) return;

    counter.textContent = `${textarea.value.length}/255`;
  }

  async function createBlockedTime() {
    const submitButton = document.getElementById("createBlockedButton");
    const errorBox = document.getElementById("blockedFormError");
    const date = document.getElementById("blockedDateInput")?.value;
    const start = document.getElementById("blockedStartInput")?.value;
    const finish = document.getElementById("blockedEndInput")?.value;

    errorBox.classList.add("hidden");
    errorBox.textContent = "";
    submitButton.disabled = true;
    submitButton.textContent = "Guardando...";

    try {
      const response = await fetch(availabilityBlockCreateUrl, {
        method: "POST",
        headers: {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "X-CSRF-Token": csrfToken
        },
        body: JSON.stringify({
          range_start: calendarLoadedRangeStartISO(),
          range_end: calendarLoadedRangeEndISO(),
          availability_block: {
            title: document.getElementById("blockedTitleInput")?.value.trim() || "",
            date: date,
            start_time: start,
            end_time: finish,
            employee_membership_id: document.getElementById("blockedEmployeeInput")?.value || "",
            recurrence: document.getElementById("blockedRecurrenceInput")?.value || "none",
            description: document.getElementById("blockedDescriptionInput")?.value.trim() || "",
            online_booking_allowed: document.getElementById("blockedOnlineBookingAllowedInput")?.checked || false
          }
        })
      });
      const payload = await response.json().catch(() => ({}));

      if (!response.ok) {
        errorBox.textContent = Array.isArray(payload.errors) && payload.errors.length ? payload.errors.join(". ") : "No se pudo guardar el horario no disponible.";
        errorBox.classList.remove("hidden");
        return;
      }

      blocks = [
        ...blocks.filter(block => !payload.blocks?.some(newBlock => String(newBlock.id) === String(block.id))),
        ...(payload.blocks || [])
      ];
      showToast("Horario no disponible añadido");
      cancelAction();
      renderAll();
    } catch (_error) {
      errorBox.textContent = "No se pudo conectar con el servidor. Probá de nuevo.";
      errorBox.classList.remove("hidden");
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = "Añadir horario no disponible";
    }
  }

  function openAppointmentDetails(appointmentId) {
    const targetId = String(appointmentId || "");
    const appointment = appointments.find(item => String(item.id) === targetId);
    if (!appointment) return;

    openDrawer(renderAppointmentDetail(appointment, {
      actions: {
        changeProfessional: appointment.availableProfessionalsUrl && appointment.changeProfessionalUrl ? `onclick="openCalendarProfessionalPicker('${escapeAttribute(appointment.id)}')"` : "",
        approveDeposit: appointment.approveDepositUrl ? `onclick="approveCalendarDeposit('${escapeAttribute(appointment.id)}')"` : "",
        rejectDeposit: appointment.rejectDepositUrl ? `onclick="rejectCalendarDeposit('${escapeAttribute(appointment.id)}')"` : "",
        markPaid: appointment.markRemainingBalancePaidUrl ? `onclick="openRemainingBalancePaymentDialog('${escapeAttribute(appointment.id)}')"` : "",
        cancel: appointment.cancelUrl ? "data-appointment-detail-cancel" : "",
        destroy: appointment.destroyUrl ? `onclick="deleteExistingAppointment('${escapeAttribute(appointment.id)}')"` : ""
      },
      calendarUrl: appointment.url,
      variant: "customer-profile"
    }), { wide: true });
    bindAppointmentDetailPanel(document.getElementById("drawerContent"), {
      onSaveNotes: (internalNotes) => saveCalendarAppointmentNotes(appointment, internalNotes),
      onCancel: (reason) => cancelCalendarAppointment(appointment.id, reason),
      onChangeServiceVariant: (serviceVariantId) => changeCalendarAppointmentVariant(appointment, serviceVariantId)
    });
  }

  async function changeCalendarAppointmentVariant(appointment, serviceVariantId) {
    if (!appointment?.updateServiceVariantUrl) throw new Error("No se puede cambiar el tamaño de este turno.");
    const response = await fetch(appointment.updateServiceVariantUrl, {
      method: "PATCH",
      headers: { "Accept": "application/json", "Content-Type": "application/json", "X-CSRF-Token": csrfToken },
      body: JSON.stringify({ appointment: { service_variant_id: serviceVariantId } })
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(Array.isArray(payload.errors) ? payload.errors.join(". ") : "No se pudo cambiar el tamaño.");
    appointments = appointments.map(item => String(item.id) === String(payload.id) ? payload : item);
    renderAll();
    openAppointmentDetails(payload.id);
    showToast("Tamaño y precio del turno actualizados");
  }

  async function saveCalendarAppointmentNotes(appointment, internalNotes) {
    if (!appointment?.notesUrl) throw new Error("No tenés permisos para editar las notas del turno.");

    const response = await fetch(appointment.notesUrl, {
      method: "PATCH",
      headers: {
        "Accept": "application/json",
        "Content-Type": "application/json",
        "X-CSRF-Token": csrfToken
      },
      body: JSON.stringify({ appointment: { internal_notes: internalNotes } })
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) {
      throw new Error(Array.isArray(payload.errors) && payload.errors.length ? payload.errors.join(". ") : "No pudimos guardar las notas.");
    }

    appointments = appointments.map(item => String(item.id) === String(appointment.id) ? payload : item);
    renderAll();
    openAppointmentDetails(appointment.id);
  }

  async function cancelCalendarAppointment(appointmentId, providedReason = "") {
    const appointment = appointments.find(item => String(item.id) === String(appointmentId));
    if (!appointment?.cancelUrl) return;

    const reason = providedReason || document.getElementById("appointmentCancellationNote")?.value.trim() || "";

    try {
      const response = await fetch(appointment.cancelUrl, {
        method: "PATCH",
        headers: {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "X-CSRF-Token": csrfToken
        },
        body: JSON.stringify({ reason })
      });
      const payload = await response.json().catch(() => ({}));

      if (!response.ok) {
        const message = Array.isArray(payload.errors) && payload.errors.length ? payload.errors.join(". ") : "No se pudo cancelar el turno.";
        throw new Error(message);
      }

      appointments = appointments.filter(item => String(item.id) !== String(appointment.id));
      closeDrawer();
      renderAll();
      showToast("Turno cancelado");
    } catch (_error) {
      throw new Error(_error.message || "No se pudo conectar con el servidor. Probá de nuevo.");
    }
  }

  function openRemainingBalancePaymentDialog(appointmentId) {
    const appointment = appointments.find(item => String(item.id) === String(appointmentId));
    if (!appointment?.markRemainingBalancePaidUrl) return;

    const dialog = document.getElementById("remainingBalancePaymentDialog");
    const description = document.getElementById("remainingBalancePaymentDialogDescription");
    const errorBox = document.getElementById("remainingBalancePaymentDialogError");
    if (!dialog || !description) return;

    dialog.dataset.appointmentId = appointment.id;
    description.textContent = `¿Confirmás que se pagó el total restante de ${formatMoney(appointment.remainingBalance)}?`;
    errorBox?.classList.add("hidden");
    if (!dialog.open) dialog.showModal();
  }

  function closeRemainingBalancePaymentDialog() {
    const dialog = document.getElementById("remainingBalancePaymentDialog");
    if (dialog?.open) dialog.close();
  }

  async function confirmRemainingBalancePayment() {
    const dialog = document.getElementById("remainingBalancePaymentDialog");
    const appointment = appointments.find(item => String(item.id) === String(dialog?.dataset.appointmentId));
    const errorBox = document.getElementById("remainingBalancePaymentDialogError");
    const submitButton = document.getElementById("confirmRemainingBalancePaymentButton");
    if (!appointment?.markRemainingBalancePaidUrl) return;

    errorBox?.classList.add("hidden");
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "Guardando...";
    }

    try {
      const response = await fetch(appointment.markRemainingBalancePaidUrl, {
        method: "PATCH",
        headers: {
          "Accept": "application/json",
          "X-CSRF-Token": csrfToken
        }
      });
      const payload = await response.json().catch(() => ({}));

      if (!response.ok) {
        const message = Array.isArray(payload.errors) && payload.errors.length ? payload.errors.join(". ") : "No se pudo registrar el pago restante.";
        if (errorBox) {
          errorBox.textContent = message;
          errorBox.classList.remove("hidden");
        }
        return;
      }

      appointments = appointments.map(item => String(item.id) === String(appointment.id) ? payload : item);
      closeRemainingBalancePaymentDialog();
      renderAll();
      openAppointmentDetails(appointment.id);
      showToast("Saldo restante registrado como pagado");
    } catch (_error) {
      if (errorBox) {
        errorBox.textContent = "No se pudo conectar con el servidor. Probá de nuevo.";
        errorBox.classList.remove("hidden");
      }
    } finally {
      if (submitButton?.isConnected) {
        submitButton.disabled = false;
        submitButton.textContent = "Confirmar pago";
      }
    }
  }

  async function approveCalendarDeposit(appointmentId) {
    const appointment = appointments.find(item => String(item.id) === String(appointmentId));
    if (!appointment?.approveDepositUrl) return;
    if (!window.confirm("¿Confirmás que la seña es válida? El turno quedará confirmado.")) return;

    await updateCalendarDepositStatus(appointment, appointment.approveDepositUrl, {}, "Seña aprobada. El turno fue confirmado.");
  }

  async function rejectCalendarDeposit(appointmentId) {
    const appointment = appointments.find(item => String(item.id) === String(appointmentId));
    if (!appointment?.rejectDepositUrl) return;

    const reason = window.prompt("Indicá el motivo para rechazar el comprobante:")?.trim();
    if (!reason) return;

    await updateCalendarDepositStatus(appointment, appointment.rejectDepositUrl, { reason }, "Comprobante rechazado.");
  }

  async function updateCalendarDepositStatus(appointment, url, body, successMessage) {
    try {
      const response = await fetch(url, {
        method: "PATCH",
        headers: {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "X-CSRF-Token": csrfToken
        },
        body: JSON.stringify(body)
      });
      const payload = await response.json().catch(() => ({}));

      if (!response.ok) {
        const message = Array.isArray(payload.errors) && payload.errors.length ? payload.errors.join(". ") : "No se pudo actualizar la seña.";
        showToast(message);
