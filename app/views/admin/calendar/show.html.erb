          method: "PATCH",
          headers: {
            "Accept": "application/json",
            "Content-Type": "application/json",
            "X-CSRF-Token": csrfToken
          },
          body: JSON.stringify({ employee_membership_id: employeeMembershipId })
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(Array.isArray(payload.errors) ? payload.errors.join(". ") : "No se pudo cambiar el profesional.");
        }

        appointments = appointments.map(item => String(item.id) === String(appointment.id) ? payload : item);
        renderAll();
        openAppointmentDetails(appointment.id);
        showToast("Profesional actualizado");
      }
    });
  }

  async function deleteExistingAppointment(appointmentId) {
    const appointment = appointments.find(item => String(item.id) === String(appointmentId));
    if (!appointment) return;
    if (!appointment.destroyUrl) {
      showToast("Solo se pueden eliminar turnos creados desde el calendario");
      return;
    }
    if (!window.confirm("¿Eliminar este turno? Esta acción borra el turno de la agenda. Si necesitás cancelar una reserva, usá Cancelar turno.")) return;

    try {
      const response = await fetch(appointment.destroyUrl, {
        method: "DELETE",
        headers: { "Accept": "application/json", "X-CSRF-Token": csrfToken }
      });
      const payload = await response.json().catch(() => ({}));

      if (!response.ok) {
        const message = Array.isArray(payload.errors) && payload.errors.length ? payload.errors.join(". ") : "No se pudo eliminar el turno";
        showToast(message);
        return;
      }

      appointments = appointments.filter(item => String(item.id) !== String(appointment.id));
      closeDrawer();
      renderAll();
      showToast("Turno eliminado");
    } catch (_error) {
      showToast("No se pudo conectar con el servidor. Probá de nuevo.");
    }
  }

  function openCalendarAppointmentDetails(appointmentId) {
    const targetId = String(appointmentId || "");
    if (!targetId) return false;

    const appointment = appointments.find(item => String(item.id) === targetId);
    if (!appointment) return false;

    window.AdminNotificationsDrawer?.close?.();
    openAppointmentDetails(targetId);
    return true;
  }

  function openBlockedDetails(blockId) {
