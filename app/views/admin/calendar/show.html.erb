<script type="module">
import { bindAppointmentDetailPanel, openProfessionalPicker, renderAppointmentDetail } from "appointment_detail_panel";

(() => {
  if (window.dogGroomingCalendarAbortController) {
    window.dogGroomingCalendarAbortController.abort();
  }

  const calendarAbortController = new AbortController();
  window.dogGroomingCalendarAbortController = calendarAbortController;
  const calendarSignal = calendarAbortController.signal;

  const employees = <%= raw json_escape(@calendar_employees.to_json) %>;
  const services = <%= raw json_escape(@calendar_services.to_json) %>;
  let appointments = <%= raw json_escape(@calendar_appointments.to_json) %>;
  let blocks = <%= raw json_escape(@calendar_blocks.to_json) %>;
  let waitlistEntries = <%= raw json_escape(@calendar_waitlist_entries.to_json) %>;
  const notifications = <%= raw json_escape(@calendar_notifications.to_json) %>;
  const initialDateISO = "<%= @calendar_date.iso8601 %>";
  const initialAppointmentToken = <%= raw json_escape(params[:t].to_s.to_json) %>;
  const initialWaitlistOpen = <%= params[:waitlist].present? ? "true" : "false" %>;
  const initialWaitlistFilters = <%= raw json_escape(params.permit(:service_id, :desired_date, :start_time, :status).to_h.to_json) %>;
  const appointmentCreateUrl = "<%= admin_appointments_path(format: :json) %>";
  const availabilityBlockCreateUrl = "<%= admin_availability_blocks_path(format: :json) %>";
  const availabilityBlockDeleteUrlTemplate = "<%= admin_availability_block_path("__ID__", format: :json) %>";
  const waitlistCreateUrl = "<%= admin_waitlist_entries_path(format: :json) %>";
  const waitlistUpdateUrlTemplate = "<%= admin_waitlist_entry_path("__ID__", format: :json) %>";
  const waitlistDestroyUrlTemplate = "<%= admin_waitlist_entry_path("__ID__", format: :json) %>";
  const customerAutocompleteUrl = "<%= autocomplete_admin_customer_profiles_path(format: :json) %>";
  const csrfToken = document.querySelector("meta[name='csrf-token']")?.content;

  const START_HOUR = 0;
  const END_HOUR = 24;
  const SLOT_MINUTES = 30;
  const SLOT_HEIGHT = 56;
  const SLOT_COUNT = ((END_HOUR - START_HOUR) * 60) / SLOT_MINUTES;
  const SPANISH_WEEKDAYS_SHORT = ["Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb"];
  const SPANISH_WEEKDAYS = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"];
  const SPANISH_MONTHS = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
  const WAITLIST_TIME_PRESETS = {
    any: { label: "En cualquier momento", start_time: "00:00", end_time: "23:55" },
    morning: { label: "Mañana", start_time: "06:00", end_time: "12:00" },
    afternoon: { label: "Tarde", start_time: "12:00", end_time: "18:00" },
    night: { label: "Noche", start_time: "18:00", end_time: "23:55" },
    custom: { label: "Personalizado", start_time: "09:00", end_time: "18:00" }
  };

  let actionMode = null;
  let selectedSlot = null;
  let selectedService = null;
  let selectedServices = [];
  let editingServiceIndex = null;
  let selectedCustomer = null;
  let loadedCustomers = new Map();
  let customerSearchTimer = null;
  let customerRequestSequence = 0;
  let waitlistCustomerSearchTimer = null;
  let waitlistCustomerRequestSequence = 0;
  let loadedWaitlistCustomers = new Map();
  let selectedWaitlistCustomer = null;
  let waitlistEditingEntryId = null;
  let waitlistAppointmentEntryId = null;
  let waitlistTab = "waiting";
  let waitlistDateFilter = initialWaitlistFilters.desired_date ? "specific" : "upcoming";
  let waitlistSort = "created_asc";
  let waitlistServiceFilter = initialWaitlistFilters.service_id || "";
  let waitlistDesiredDateFilter = initialWaitlistFilters.desired_date || "";
  let waitlistStartTimeFilter = initialWaitlistFilters.start_time || "";
  let currentNotificationCategory = "appointments";
  let calendarView = "week";
  let selectedDate = dateFromISO(initialDateISO);
  let selectedEmployeeIds = new Set(employees.map(employee => employee.id));
  let selectedMonthDay = null;

  document.documentElement.style.setProperty("--employee-count", Math.max(1, selectedEmployeeIds.size));
  document.documentElement.style.setProperty("--slot-count", SLOT_COUNT);

  function dateFromISO(iso) {
    const [year, month, day] = iso.split("-").map(Number);
    return new Date(year, month - 1, day);
  }

  function dateToISO(date) {
    return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
  }

  function localizedDateFromISO(iso) {
    const [year, month, day] = iso.split("-");
    return `${day}/${month}/${year}`;
  }

  function isoFromLocalizedDate(value) {
    const match = String(value || "").trim().match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
    if (!match) return null;

    const [, day, month, year] = match;
    const date = new Date(Number(year), Number(month) - 1, Number(day));
    return date.getFullYear() === Number(year) && date.getMonth() === Number(month) - 1 && date.getDate() === Number(day)
      ? `${year}-${month}-${day}`
      : null;
  }

  function addDays(date, amount) {
    const next = new Date(date);
    next.setDate(next.getDate() + amount);
    return next;
  }

  function addMonths(date, amount) {
    const next = new Date(date);
    next.setMonth(next.getMonth() + amount);
    return next;
  }

  function currentDateISO() {
    return dateToISO(selectedDate);
  }

  function currentDateLabel() {
    if (calendarView === "month") return `${SPANISH_MONTHS[selectedDate.getMonth()]} ${selectedDate.getFullYear()}`;
    if (calendarView === "week") return weekDateLabel();
    return `${SPANISH_WEEKDAYS_SHORT[selectedDate.getDay()]} ${selectedDate.getDate()} ${SPANISH_MONTHS[selectedDate.getMonth()].slice(0, 3)}`;
  }

  function beginningOfWeek(date) {
    return addDays(date, -((date.getDay() + 6) % 7));
  }

  function weekDates() {
    const start = beginningOfWeek(selectedDate);
    return Array.from({ length: 7 }, (_, index) => addDays(start, index));
  }

  function weekDateLabel() {
    const [start, , , , , , finish] = weekDates();
    const startMonth = SPANISH_MONTHS[start.getMonth()].slice(0, 3);
    const finishMonth = SPANISH_MONTHS[finish.getMonth()].slice(0, 3);
    const year = finish.getFullYear();
    return start.getMonth() === finish.getMonth()
      ? `${start.getDate()} – ${finish.getDate()} ${finishMonth} ${year}`
      : `${start.getDate()} ${startMonth} – ${finish.getDate()} ${finishMonth} ${year}`;
  }

  function monthDayLabel(date) {
    return `${SPANISH_WEEKDAYS_SHORT[date.getDay()]} ${date.getDate()} ${SPANISH_MONTHS[date.getMonth()].slice(0, 3)}`;
  }

  function minutesFromTime(time) {
    const [h, m] = time.split(":").map(Number);
    return h * 60 + m;
  }

  function timeFromMinutes(minutes) {
    const h = Math.floor(minutes / 60);
    const m = minutes % 60;
    return `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}`;
  }

  function timeValueFromMinutes(minutes) {
    return timeFromMinutes(((minutes % (24 * 60)) + (24 * 60)) % (24 * 60));
  }

  function durationFromTimes(start, finish) {
    const startMinutes = minutesFromTime(start);
    let finishMinutes = minutesFromTime(finish);
    if (finishMinutes <= startMinutes) finishMinutes += 24 * 60;
    return finishMinutes - startMinutes;
  }

  function timeSelectOptions(selected) {
    return Array.from({ length: 96 }, (_, index) => {
      const value = timeValueFromMinutes(index * 15);
      return `<option value="${value}" ${value === selected ? "selected" : ""}>${value}</option>`;
    }).join("");
  }

  function blockDateOptions(selectedISO) {
    const options = new Map();
    const today = new Date();
    options.set(selectedISO, monthDayLabel(dateFromISO(selectedISO)));
    Array.from({ length: 181 }, (_, index) => addDays(today, index)).forEach(date => {
      options.set(dateToISO(date), monthDayLabel(date));
    });

    return Array.from(options.entries())
      .sort(([left], [right]) => left.localeCompare(right))
      .map(([value, label]) => `<option value="${value}" ${value === selectedISO ? "selected" : ""}>${escapeHTML(label)}</option>`)
      .join("");
  }

  function calendarLoadedRangeStartISO() {
    const first = new Date(selectedDate.getFullYear(), selectedDate.getMonth(), 1);
    return dateToISO(beginningOfWeek(first));
  }

  function calendarLoadedRangeEndISO() {
    const last = new Date(selectedDate.getFullYear(), selectedDate.getMonth() + 1, 0);
    return dateToISO(addDays(beginningOfWeek(last), 6));
  }

  function formatMoney(value) {
    return `$${new Intl.NumberFormat("es-AR").format(value)}`;
  }

  function paymentDateTimeLabel(value) {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "";

    const parts = new Intl.DateTimeFormat("es-AR", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23"
    }).formatToParts(date).reduce((memo, part) => {
      memo[part.type] = part.value;
      return memo;
    }, {});
    return `${parts.day}/${parts.month}/${parts.year}, ${parts.hour}:${parts.minute}hs`;
  }

  function paymentSummaryMarkup(appointment, { allowMarkPaid = true } = {}) {
    const depositAmount = Number(appointment.depositAmount || 0);
    const remainingBalance = Number(appointment.remainingBalance ?? appointment.price ?? 0);
    const remainingPaidAt = appointment.remainingBalancePaidAt;
    const remainingPaidAmount = Number(appointment.remainingBalancePaidAmount || 0);
    const depositPaidAt = appointment.depositPaidAt;
    const depositMethod = appointment.depositPaymentMethod || "Medio no registrado";
    const remainingMethod = appointment.remainingBalancePaymentMethod || depositMethod;

    return `
      <div class="mt-4 grid gap-2 rounded-2xl border border-zinc-100 bg-zinc-50 px-4 py-3">
        ${depositAmount > 0 ? `
          <div class="flex items-start justify-between gap-4">
            <div>
              <span class="text-sm font-bold text-zinc-500">Seña pagada${depositPaidAt ? ` (${escapeHTML(paymentDateTimeLabel(depositPaidAt))})` : ""}</span>
              <p class="mt-1 text-xs font-bold text-zinc-500">${escapeHTML(depositMethod)}</p>
            </div>
            <strong>${formatMoney(depositAmount)}</strong>
          </div>
        ` : ""}
        <div class="flex items-start justify-between gap-4">
          <div>
            <span class="text-sm font-bold text-zinc-500">${remainingPaidAt ? `Restante pagado (${escapeHTML(paymentDateTimeLabel(remainingPaidAt))})` : "Resta pagar"}</span>
            ${remainingPaidAt ? `<p class="mt-1 text-xs font-bold text-zinc-500">${escapeHTML(remainingMethod)}</p>` : ""}
          </div>
          <strong>${formatMoney(remainingPaidAt ? remainingPaidAmount : remainingBalance)}</strong>
        </div>
      </div>
      ${allowMarkPaid && appointment.markRemainingBalancePaidUrl ? `<button type="button" onclick="openRemainingBalancePaymentDialog('${escapeAttribute(appointment.id)}')" class="mt-4 w-full rounded-full bg-zinc-950 px-5 py-3 text-sm font-bold text-white hover:bg-zinc-800">Marcar como pagado</button>` : ""}
    `;
  }

  function appointmentDetailTone(appointment) {
    const status = String(appointment?.status || "");
    const label = String(appointment?.statusLabel || "").toLowerCase();
    if (status === "completed" || label.includes("finalizado") || label.includes("realizado")) return "violet";
    if (["confirmed", "pending_confirmation"].includes(status) || label.includes("confirmado")) return "emerald";
    if (["pending_deposit_review"].includes(status) || label.includes("comprobante")) return "amber";
    if (["pending_deposit", "deposit_rejected", "pending_payment"].includes(status) || label.includes("pendiente")) return "rose";
    if (["canceled", "expired", "no_show", "rescheduled"].includes(status)) return "zinc";

    return "brand";
  }

  function appointmentStatusLabel(appointment) {
    return appointment?.status === "completed" ? "Finalizado" : String(appointment?.statusLabel || appointment?.status || "");
  }

  function finishTime(start, duration) {
    return timeFromMinutes(minutesFromTime(start) + Number(duration || 0));
  }

  function initials(value) {
    return String(value || "")
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map(part => part[0])
      .join("")
      .toUpperCase() || "HT";
  }

  function employeeAvatarMarkup(employee, className = "resource-avatar") {
    const color = employee?.color || "#ffded4";
    const photoUrl = employee?.photoUrl;
    const label = escapeAttribute(employee?.name || "Profesional");
    const baseStyle = `background:${color}; border-color:${color};`;

    if (photoUrl) {
      return `<span class="${className}" style="${baseStyle}" title="${label}"><img src="${escapeAttribute(photoUrl)}" alt="${label}" loading="lazy"></span>`;
    }

    return `<span class="${className}" style="${baseStyle}" title="${label}">${escapeHTML(employee?.avatar || initials(employee?.name))}</span>`;
  }

  function trashIconMarkup() {
    return `
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="h-4 w-4">
        <path d="M9 4h6m-8 4h10m-9 0 .6 11.2A2 2 0 0 0 10.6 21h2.8a2 2 0 0 0 2-1.8L16 8M10 11v6m4-6v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    `;
  }

  function employeeById(id) {
    return employees.find(employee => employee.id === id) || employees[0];
  }

  function visibleEmployees() {
    return employees.filter(employee => selectedEmployeeIds.has(employee.id));
  }

  function firstVisibleEmployeeId() {
    return visibleEmployees()[0]?.id || employees[0]?.id;
  }

  function updateEmployeeCountCss() {
    document.documentElement.style.setProperty("--employee-count", Math.max(1, visibleEmployees().length));
  }

  function serviceById(id) {
    return services.find(service => service.id === id);
  }

  function serviceDurationLabel(minutes) {
    const total = Number(minutes) || 0;
    if (total < 60) return `${total} min`;

    const hours = Math.floor(total / 60);
    const rest = total % 60;
    return rest > 0 ? `${hours} h ${rest} min` : `${hours} h`;
  }

  function normalizeServiceSearch(value) {
    return String(value ?? "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim();
  }

  function groupedServicesFor(availableServices, query) {
    const needle = normalizeServiceSearch(query);
    const matchingServices = needle
      ? availableServices.filter(service => {
          const searchable = normalizeServiceSearch(`${service.name} ${service.category}`);
          return searchable.includes(needle);
        })
      : availableServices;

    return matchingServices.reduce((groups, service) => {
      const category = service.category || "General";
      if (!groups.has(category)) groups.set(category, []);
      groups.get(category).push(service);
      return groups;
    }, new Map());
  }

  function renderServiceGroups(container, availableServices, query, selectionHandler = "selectService") {
    const groups = Array.from(groupedServicesFor(availableServices, query).entries());

    if (!groups.length) {
      container.innerHTML = `<p class="rounded-2xl border border-zinc-100 bg-white px-4 py-5 text-sm font-semibold text-zinc-500">${query ? "No encontramos servicios con esa búsqueda." : "No hay servicios disponibles para este profesional."}</p>`;
      return;
    }

    const accentColors = ["#ffded4", "#f472b6", "#22d3ee", "#facc15", "#34d399", "#60a5fa"];
    container.innerHTML = groups.map(([category, categoryServices], index) => {
      const accentColor = accentColors[index % accentColors.length];
      return `
        <section>
          <div class="flex items-center gap-2">
            <h3 class="text-lg font-bold tracking-[-0.02em] text-zinc-950">${escapeHTML(category)}</h3>
            <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-bold text-zinc-600">${categoryServices.length}</span>
          </div>
          <div class="mt-3 overflow-hidden rounded-2xl border border-zinc-100 bg-white">
            ${categoryServices.map(service => `
              <button type="button" onclick="${selectionHandler}('${escapeAttribute(service.id)}')" class="service-row flex w-full items-center justify-between gap-4 border-b border-zinc-100 px-4 py-4 text-left last:border-b-0">
                <span class="border-l-4 pl-3" style="border-left-color: ${accentColor};">
                  <span class="block text-sm font-bold text-zinc-950">${escapeHTML(service.name)}</span>
                  <span class="mt-1 block text-xs font-semibold text-zinc-500">${serviceDurationLabel(service.duration)}</span>
                </span>
                <span class="text-sm font-bold text-zinc-950">${formatMoney(service.price)}</span>
              </button>
            `).join("")}
          </div>
        </section>
      `;
    }).join("");
  }

  function topFromTime(time) {
    const start = START_HOUR * 60;
    return ((minutesFromTime(time) - start) / SLOT_MINUTES) * SLOT_HEIGHT;
  }

  function heightFromDuration(duration) {
    return Math.max(28, (duration / SLOT_MINUTES) * SLOT_HEIGHT - 4);
  }

  function buildTimeSlots() {
    const slots = [];
    for (let minutes = START_HOUR * 60; minutes < END_HOUR * 60; minutes += SLOT_MINUTES) {
      slots.push(timeFromMinutes(minutes));
    }
    return slots;
  }

  function appointmentsForCurrentDate() {
    const dateISO = currentDateISO();
    const visibleIds = new Set(visibleEmployees().map(employee => employee.id));
    return appointments.filter(appointment => appointment.dateISO === dateISO && visibleIds.has(appointment.employeeId));
  }

  function blocksForCurrentDate() {
    const dateISO = currentDateISO();
    return blocks.filter(blocked => blocked.dateISO === dateISO);
  }

  function renderResourceHeader() {
    updateEmployeeCountCss();
    const header = document.getElementById("resourceHeader");
    const staff = visibleEmployees();

    header.innerHTML = `
      <div class="h-[var(--resource-height)] border-r border-zinc-200 bg-white"></div>
      ${staff.map(employee => `
        <div class="resource-cell">
          <div class="resource-card">
            ${employeeAvatarMarkup(employee)}
            <p class="resource-name" title="${escapeAttribute(employee.name)}">${escapeHTML(employee.name)}</p>
          </div>
        </div>
      `).join("")}
    `;
  }

  function renderCalendar() {
    updateEmployeeCountCss();
    const slots = buildTimeSlots();
    const body = document.getElementById("calendarBody");
    const staff = visibleEmployees();

    body.innerHTML = `
      <div class="time-column">
        ${Array.from({ length: END_HOUR - START_HOUR }).map((_, index) => {
          const hour = START_HOUR + index;
          return `<div class="time-label">${String(hour).padStart(2, "0")}:00</div>`;
        }).join("")}
      </div>
      ${staff.map(employee => `
        <div class="calendar-column" data-employee-id="${employee.id}">
          ${slots.map(time => `<div class="calendar-slot" data-employee-id="${employee.id}" data-time="${time}"></div>`).join("")}
        </div>
      `).join("")}
    `;

    body.querySelectorAll(".calendar-slot").forEach(slot => {
      slot.addEventListener("click", event => {
        event.stopPropagation();
        handleCalendarSlotClick(slot, event);
      });
    });

    renderCalendarItems();
  }

  function renderCalendarItems() {
    document.querySelectorAll(".calendar-column").forEach(column => {
      column.querySelectorAll(".appt-block,.selection-block,.now-line").forEach(item => item.remove());
    });
    document.querySelectorAll(".global-now-line").forEach(item => item.remove());

    appointmentsForCurrentDate().forEach(appointment => {
      const column = document.querySelector(`.calendar-column[data-employee-id="${appointment.employeeId}"]`);
      if (!column) return;

      const block = document.createElement("button");
      block.type = "button";
      block.className = "appt-block text-left";
      block.style.top = `${topFromTime(appointment.start)}px`;
      block.style.height = `${heightFromDuration(appointment.duration)}px`;
      block.style.background = appointment.color || "#dbeafe";
      block.dataset.appointmentId = appointment.id;

      const statusLabel = appointmentStatusLabel(appointment);
      const statusTone = appointmentDetailTone(appointment);
      block.innerHTML = `<div class="appt-line">${escapeHTML(appointment.start)} · ${escapeHTML(appointment.client)} · ${escapeHTML(appointment.service)} <span class="appt-status is-${statusTone}">(${escapeHTML(statusLabel)})</span></div>`;
      block.addEventListener("click", event => {
        event.stopPropagation();
        openAppointmentDetails(appointment.id);
      });
      column.appendChild(block);
    });

    blocksForCurrentDate().forEach(blocked => {
      const targetIds = blocked.employeeId ? [blocked.employeeId] : visibleEmployees().map(employee => employee.id);
      targetIds.forEach(employeeId => {
        const column = document.querySelector(`.calendar-column[data-employee-id="${employeeId}"]`);
        if (!column) return;

        const block = document.createElement("button");
        block.type = "button";
        block.className = "appt-block text-left";
        block.style.top = `${topFromTime(blocked.start)}px`;
        block.style.height = `${heightFromDuration(blocked.duration)}px`;
        block.style.background = blocked.color || "#e5e7eb";
        block.innerHTML = `<div class="appt-line">${escapeHTML(blocked.start)} - ${escapeHTML(blocked.finish || finishTime(blocked.start, blocked.duration))} · ${escapeHTML(blocked.reason || "Horario no disponible")}</div>`;
        block.addEventListener("click", event => {
          event.stopPropagation();
          openBlockedDetails(blocked.id);
        });
        column.appendChild(block);
      });
    });

    if (selectedSlot && actionMode && selectedSlot.dateISO === currentDateISO()) {
      const column = document.querySelector(`.calendar-column[data-employee-id="${selectedSlot.employeeId}"]`);
      if (column) {
        const selection = document.createElement("div");
        selection.className = "selection-block";
        selection.style.top = `${topFromTime(selectedSlot.time)}px`;
        selection.style.height = `${heightFromDuration(actionMode === "blocked" ? 15 : selectedServices.reduce((sum, service) => sum + Number(service.duration), 0) || 45)}px`;
        column.appendChild(selection);
      }
    }

    renderCurrentTimeLine();
    syncCalendarHeader();
  }

  function renderCurrentTimeLine() {
    const todayISO = dateToISO(new Date());
    if (currentDateISO() !== todayISO) return;

    const now = new Date();
    const minutes = now.getHours() * 60 + now.getMinutes();
    if (minutes < START_HOUR * 60 || minutes > END_HOUR * 60) return;

    const body = document.getElementById("calendarBody");
    const line = document.createElement("div");
    const time = timeFromMinutes(minutes);
    line.className = "global-now-line";
    line.dataset.time = time;
    line.style.top = `${topFromTime(time)}px`;
    body.appendChild(line);
  }

  function refreshCurrentTimeLine() {
    document.querySelectorAll(".global-now-line").forEach(item => item.remove());
    renderCurrentTimeLine();
  }

  function scrollCalendarToCurrentTime(behavior = "auto") {
    const scroll = document.getElementById("calendarScroll");
    if (!scroll) return;

    const now = new Date();
    const currentMinutes = now.getHours() * 60 + now.getMinutes();
    const currentTop = ((currentMinutes - START_HOUR * 60) / SLOT_MINUTES) * SLOT_HEIGHT;
    const targetTop = Math.max(0, currentTop - Math.min(scroll.clientHeight * 0.35, 220));
    scroll.scrollTo({ top: targetTop, behavior });
  }

  function handleCalendarSlotClick(slot, event) {
    const employeeId = slot.dataset.employeeId;
    const time = slot.dataset.time;
    selectedSlot = { employeeId, time, dateISO: currentDateISO(), dateLabel: monthDayLabel(selectedDate) };

    if (actionMode === "appointment") {
      selectedService = null;
      selectedServices = [];
      editingServiceIndex = null;
      renderCalendarItems();
      openServicePanel();
      return;
    }

    if (actionMode === "blocked") {
      renderCalendarItems();
      openBlockedTimePanel();
      return;
    }

    showQuickMenu(event.clientX, event.clientY, employeeId, time);
  }

  function showQuickMenu(x, y, employeeId, time, dateISO = currentDateISO(), dateLabel = monthDayLabel(selectedDate)) {
    selectedSlot = { employeeId, time, dateISO, dateLabel };
    const menu = document.getElementById("quickMenu");
    const employee = employeeById(employeeId);

    document.getElementById("quickMenuTime").textContent = time;
    document.getElementById("quickMenuEmployee").textContent = employee.name;

    const maxX = window.innerWidth - 265;
    const maxY = window.innerHeight - 250;
    menu.style.left = `${Math.min(x + 10, maxX)}px`;
    menu.style.top = `${Math.min(y + 10, maxY)}px`;
    menu.classList.add("open");
  }

  function closeQuickMenu() {
    document.getElementById("quickMenu").classList.remove("open");
  }

  function quickAction(type) {
    closeQuickMenu();
    startAction(type, { keepSlot: true });
    if (type === "appointment") openServicePanel();
    if (type === "blocked") openBlockedTimePanel();
    renderCalendarItems();
  }

  function startAction(type, options = {}) {
    closeQuickMenu();
    actionMode = type;
    selectedService = null;
    selectedServices = [];
    editingServiceIndex = null;
    selectedCustomer = null;
    waitlistAppointmentEntryId = null;
    if (!options.keepSlot) selectedSlot = null;

    document.body.classList.add("action-mode-active");
    renderCalendarItems();
    if (calendarView === "week") renderWeekCalendar();
  }

  function cancelAction() {
    actionMode = null;
    selectedSlot = null;
    selectedService = null;
    selectedServices = [];
    editingServiceIndex = null;
    selectedCustomer = null;
    waitlistAppointmentEntryId = null;
    document.body.classList.remove("action-mode-active");
    closeDrawer();
    renderCalendarItems();
    if (calendarView === "week") renderWeekCalendar();
  }

  function openDrawer(html, options = {}) {
    const drawer = document.getElementById("rightDrawer");
    const content = document.getElementById("drawerContent");
    content.innerHTML = html;
    drawer.classList.toggle("appointment-editor", options.wide === true);
    drawer.classList.add("open");
  }

  function closeDrawer() {
    const drawer = document.getElementById("rightDrawer");
    drawer.classList.remove("open");
    drawer.classList.remove("appointment-editor");
    closeWaitlistEntryMenus();
  }

  function dismissDrawer() {
    if (actionMode) {
      cancelAction();
    } else {
      closeDrawer();
    }
  }

  function drawerHeader(title, subtitle = "") {
    return `
      <header class="relative flex shrink-0 items-start justify-between border-b border-zinc-200 py-5 pl-6 pr-20">
        <div>
          <h2 class="text-2xl font-bold tracking-[-0.03em]">${escapeHTML(title)}</h2>
          ${subtitle ? `<p class="mt-1 text-sm font-semibold text-zinc-500">${escapeHTML(subtitle)}</p>` : ""}
        </div>
      </header>
    `;
  }

  function customerPaneSummary() {
    if (selectedCustomer) {
      return `
        <button type="button" onclick="openCustomerPicker()" class="appointment-client-summary w-full">
          <span class="appointment-client-avatar">${escapeHTML(initials(selectedCustomer.name))}</span>
          <span class="appointment-client-action">${escapeHTML(selectedCustomer.name)}</span>
          <span class="appointment-client-hint">${escapeHTML(selectedCustomer.phone || selectedCustomer.email || "Responsable seleccionado")}</span>
          <span class="mt-4 rounded-full border border-zinc-200 bg-white px-4 py-2 text-xs font-bold">Cambiar responsable</span>
        </button>
      `;
    }

    return `
      <button type="button" onclick="openCustomerPicker()" class="appointment-client-summary w-full">
        <span class="appointment-client-avatar">+</span>
        <span class="appointment-client-action">Añadir responsable</span>
        <span class="appointment-client-hint">Elegí a quien acompaña a la mascota</span>
      </button>
    `;
  }

  function appointmentEditorShell(mainContent) {
    return `
      <div class="appointment-editor-layout">
        <aside id="appointmentClientPane" class="appointment-client-pane">${customerPaneSummary()}</aside>
        <section class="appointment-main-pane">${mainContent}</section>
      </div>
    `;
  }

  function openServicePanel() {
    if (!selectedSlot) return;
    const employee = employeeById(selectedSlot.employeeId);
    const filteredServices = services.filter(service => service.employees.includes(employee.id));

    openDrawer(appointmentEditorShell(`
      ${drawerHeader(selectedServices.length ? "Añadir un servicio" : "Seleccionar un servicio", `${employee.name} · ${selectedSlot.dateLabel ? selectedSlot.dateLabel + " · " : ""}${selectedSlot.time}`)}
      <div class="drawer-scroll min-h-0 flex-1 overflow-y-auto px-6 py-5">
        ${selectedServices.length ? `<button type="button" onclick="openClientFormPanel()" class="mb-5 rounded-full border border-zinc-200 px-4 py-2 text-sm font-bold">← Atrás</button>` : ""}
        <div class="mb-5 rounded-2xl bg-brand-50 p-4">
          <p class="text-xs font-bold uppercase tracking-wide text-brand-700">Nuevo turno confirmado</p>
          <p class="mt-1 text-sm font-semibold text-brand-950">Elegí el servicio para el bloque seleccionado. Después cargá los datos del cliente.</p>
        </div>
        <label class="relative block">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-400">⌕</span>
          <input id="serviceSearchInput" type="search" placeholder="Buscar por nombre de servicio" class="w-full rounded-2xl border border-zinc-200 bg-white py-3 pl-10 pr-4 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100" />
        </label>
        <div class="mt-6">
          <p class="text-sm font-bold">Servicios disponibles para ${escapeHTML(employee.name)}</p>
          <div id="serviceGroups" class="mt-4 grid gap-6"></div>
        </div>
      </div>
    `), { wide: true });

    const searchInput = document.getElementById("serviceSearchInput");
    const serviceGroups = document.getElementById("serviceGroups");
    const renderGroups = () => renderServiceGroups(serviceGroups, filteredServices, searchInput.value);
    searchInput.addEventListener("input", renderGroups, { signal: calendarSignal });
    renderGroups();
  }

  function selectService(serviceId) {
    const service = serviceById(serviceId);
    if (service?.variants?.length) {
      openDrawer(appointmentEditorShell(`
        ${drawerHeader("Elegir tamaño", service.name)}
        <div class="drawer-scroll min-h-0 flex-1 overflow-y-auto px-6 py-5">
          <button type="button" onclick="openServicePanel()" class="mb-5 rounded-full border border-zinc-200 px-4 py-2 text-sm font-bold">← Volver</button>
          <p class="mb-4 text-sm font-semibold text-zinc-600">Seleccioná el rango que corresponda al peso de la mascota.</p>
