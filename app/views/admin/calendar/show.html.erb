  function setupWaitlistCustomerSearch() {
    const pane = document.getElementById("waitlistCustomerPickerPane");
    if (!pane) return;

    pane.addEventListener("scroll", handleWaitlistCustomerPickerScroll, { signal: calendarSignal });
    pane.querySelector("[data-waitlist-customer-search]")?.addEventListener("input", event => {
      window.clearTimeout(waitlistCustomerSearchTimer);
      waitlistCustomerSearchTimer = window.setTimeout(() => resetAndLoadWaitlistCustomers(event.target.value), 220);
    }, { signal: calendarSignal });
  }

  function resetAndLoadWaitlistCustomers(query) {
    const pane = document.getElementById("waitlistCustomerPickerPane");
    const results = document.getElementById("waitlistCustomerResults");
    if (!pane || !results) return;

    pane.dataset.customerPage = "0";
    pane.dataset.customerHasMore = "true";
    pane.dataset.customerQuery = query.trim();
    results.innerHTML = "";
    loadedWaitlistCustomers = new Map();
    loadMoreWaitlistCustomers();
  }

  function handleWaitlistCustomerPickerScroll(event) {
    const pane = event.currentTarget;
    if (pane.scrollTop + pane.clientHeight >= pane.scrollHeight - 120) loadMoreWaitlistCustomers();
  }

  async function loadMoreWaitlistCustomers() {
    const pane = document.getElementById("waitlistCustomerPickerPane");
    const results = document.getElementById("waitlistCustomerResults");
    const loading = document.getElementById("waitlistCustomerLoading");
    if (!pane || !results || pane.dataset.customerLoading === "true" || pane.dataset.customerHasMore !== "true") return;

    pane.dataset.customerLoading = "true";
    loading?.classList.remove("hidden");
    const page = Number(pane.dataset.customerPage || 0) + 1;
    const query = pane.dataset.customerQuery || "";
    const sequence = ++waitlistCustomerRequestSequence;

    try {
      const url = new URL(customerAutocompleteUrl, window.location.origin);
      url.searchParams.set("page", page);
      if (query) url.searchParams.set("q", query);
      const response = await fetch(url, { headers: { "Accept": "application/json" } });
      if (!response.ok) throw new Error("customer request failed");
      const payload = await response.json();
      if (sequence !== waitlistCustomerRequestSequence || query !== (pane.dataset.customerQuery || "")) return;

      payload.results.forEach(customer => loadedWaitlistCustomers.set(String(customer.id), customer));
      results.insertAdjacentHTML("beforeend", payload.results.map(customer => `
        <button type="button" onclick="chooseWaitlistExistingCustomer('${escapeAttribute(customer.id)}')" class="customer-picker-option">
          <span class="customer-picker-option-avatar">${escapeHTML(customer.initials)}</span>
          <span class="min-w-0"><span class="customer-picker-option-name">${escapeHTML(customer.name)}</span><span class="customer-picker-option-meta">${escapeHTML(customer.phone || customer.email || customer.subtitle || "Sin datos de contacto")}</span></span>
        </button>
      `).join(""));
      pane.dataset.customerPage = String(payload.page);
      pane.dataset.customerHasMore = String(payload.has_more);
      if (page === 1 && payload.results.length === 0) results.innerHTML = `<p class="px-5 py-6 text-center text-sm font-semibold text-zinc-500">No encontramos clientes.</p>`;
    } catch (_error) {
      if (page === 1) results.innerHTML = `<p class="px-5 py-6 text-center text-sm font-semibold text-red-600">No se pudo cargar el listado.</p>`;
    } finally {
      pane.dataset.customerLoading = "false";
      loading?.classList.add("hidden");
    }
  }

  function chooseWaitlistExistingCustomer(customerId) {
