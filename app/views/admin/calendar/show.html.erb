  function chooseNewCustomer() {
    const name = document.getElementById("newAppointmentCustomerName")?.value.trim();
    const phone = document.getElementById("newAppointmentCustomerPhone")?.value.trim();
    const email = document.getElementById("newAppointmentCustomerEmail")?.value.trim();
