              <button type="button" onclick="selectServiceVariant('${escapeAttribute(service.id)}', '${escapeAttribute(variant.id)}')" class="flex w-full items-center justify-between rounded-2xl border border-zinc-200 bg-white p-4 text-left hover:border-brand-500">
