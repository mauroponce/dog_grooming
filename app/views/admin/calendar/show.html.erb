  async function createAppointmentFromForm() {
    const employee = employeeById(selectedSlot.employeeId);
    const customer = selectedCustomer || { id: null, name: "Sin cita", phone: "", email: "", walkIn: true };
    const name = customer.name;
    const phone = customer.phone || "";
    const email = customer.email || "";
    const petId = document.getElementById("appointmentPetIdInput")?.value || "";
    const petName = document.getElementById("appointmentPetNameInput")?.value.trim() || "";
    const petBreed = document.getElementById("appointmentPetBreedInput")?.value.trim() || "";
    const petSex = document.getElementById("appointmentPetSexInput")?.value || "";
    const petNotes = document.getElementById("appointmentPetNotesInput")?.value.trim() || "";
    const status = document.getElementById("appointmentStatusInput").value;
    const notes = document.getElementById("appointmentNotesInput").value.trim();
    const submitButton = document.getElementById("createAppointmentButton");
    const errorBox = document.getElementById("appointmentFormError");

    errorBox.classList.add("hidden");
    errorBox.textContent = "";
    if (!phone || !email) {
      errorBox.textContent = "El cliente debe tener teléfono y email para crear el turno.";
      errorBox.classList.remove("hidden");
      return;
    }
    if (!petId && !petName) {
      errorBox.textContent = "Seleccioná o agregá una mascota para crear el turno.";
      errorBox.classList.remove("hidden");
      return;
    }
    submitButton.disabled = true;
    submitButton.textContent = "Guardando...";

    try {
      const response = await fetch(appointmentCreateUrl, {
        method: "POST",
        headers: {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "X-CSRF-Token": csrfToken
        },
        body: JSON.stringify({
          appointment: {
            service_id: selectedServices[0].id,
            service_variant_id: selectedServices[0].variantId || "",
            add_on_service_ids: selectedServices.slice(1).map(service => service.id),
            employee_membership_id: employee.id === "center" ? "" : employee.id,
            customer_profile_id: customer.id || "",
            create_customer_profile: customer.isNew === true,
            customer_name: name,
            customer_phone: phone,
            customer_email: email,
            pet_id: petId,
            pet_name: petName,
            pet_breed: petBreed,
            pet_sex: petSex,
            pet_notes: petNotes,
            waitlist_entry_id: waitlistAppointmentEntryId || "",
            starts_at: `${selectedSlot.dateISO}T${selectedSlot.time}`,
            notes,
            status
          }
        })
      });
      const payload = await response.json().catch(() => ({}));

      if (!response.ok) {
        const message = Array.isArray(payload.errors) && payload.errors.length ? payload.errors.join(". ") : "No se pudo guardar el turno.";
        errorBox.textContent = message;
        errorBox.classList.remove("hidden");
        return;
      }

      appointments = appointments.filter(appointment => appointment.id !== payload.id);
      appointments.push(payload);
      if (waitlistAppointmentEntryId) {
        markWaitlistEntryBooked(waitlistAppointmentEntryId);
        waitlistAppointmentEntryId = null;
      }
      showToast("Turno guardado");
      cancelAction();
      renderAll();
    } catch (_error) {
      errorBox.textContent = "No se pudo conectar con el servidor. Probá de nuevo.";
      errorBox.classList.remove("hidden");
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = "Guardar turno";
    }
  }

