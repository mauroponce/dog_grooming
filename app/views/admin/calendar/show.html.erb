    }
    commitSelectedService(service);
  }

  function selectServiceVariant(serviceId, variantId) {
    const service = serviceById(serviceId);
    const variant = service?.variants?.find(item => item.id === variantId);
    if (!service || !variant) return;
    commitSelectedService({ ...service, variantId: variant.id, variantName: variant.name, duration: variant.duration, price: variant.price });
  }

  function commitSelectedService(service) {
    if (editingServiceIndex === null) selectedServices.push(service);
    else selectedServices[editingServiceIndex] = service;
    editingServiceIndex = null;
    selectedService = selectedServices[0] || null;
    renderCalendarItems();
    openClientFormPanel();
  }

  function addAppointmentService() {
    editingServiceIndex = null;
    openServicePanel();
  }

  function editAppointmentService(index) {
    editingServiceIndex = Number(index);
    openServicePanel();
  }

  function removeAppointmentService(index) {
    const service = selectedServices[Number(index)];
    if (!window.confirm(`¿Eliminar ${service?.name || "este servicio"} del turno?`)) return;

    selectedServices.splice(Number(index), 1);
    selectedService = selectedServices[0] || null;
    renderCalendarItems();
    openClientFormPanel();
  }

