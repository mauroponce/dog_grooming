<% content_for :title, "Cita.pet Admin | Calendario" %>
<% content_for :admin_full_bleed, true %>
<% content_for :admin_section_title, "Calendario" %>

<style>
  :root {
    --sidebar-width: var(--admin-sidebar-width, 280px);
    --topbar-height: 78px;
    --toolbar-height: 58px;
    --resource-height: 104px;
    --slot-height: 56px;
    --drawer-width: 390px;
    --time-col-width: 70px;
    --calendar-start-hour: 0;
  }

  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  html,
  body {
    height: 100%;
    overflow: hidden;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #f7f7f8;
    color: #121212;
  }

  button,
  input,
  textarea,
  select { font-family: inherit; }

  .admin-calendar-app { --color-ink: #071014; --color-brand: #bf482f; }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid #e6e6e9;
    background: #fff;
    transition: .16s ease;
  }

  .icon-btn:hover {
    border-color: #d4d4d8;
    background: #fafafa;
    transform: translateY(-1px);
  }

  .sidebar-item {
    position: relative;
    display: flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    color: #cfd8dc;
    transition: .16s ease;
  }

  .sidebar-item:hover {
    color: #fff;
    background: rgba(255,255,255,.08);
  }

  .sidebar-item.active {
    color: #fff;
    background: #ffded4;
    box-shadow: 0 10px 24px rgba(255, 222, 212, .30);
  }

  .sidebar-item:hover::after {
    content: attr(data-tooltip);
    position: absolute;
    left: calc(100% + 10px);
    top: 50%;
    transform: translateY(-50%);
    z-index: 100;
    white-space: nowrap;
    border-radius: 10px;
    background: #111;
    color: #fff;
    padding: 8px 10px;
    font-size: 12px;
    font-weight: 700;
    box-shadow: 0 8px 26px rgba(0,0,0,.18);
  }

  .shadow-drawer { box-shadow: -16px 0 45px rgba(15,23,42,.10); }
  .shadow-menu { box-shadow: 0 18px 45px rgba(15,23,42,.16); }
  .shadow-soft { box-shadow: 0 8px 28px rgba(15,23,42,.08); }

  .calendar-shell {
    height: calc(100vh - var(--topbar-height) - var(--toolbar-height) - var(--resource-height));
    overflow: hidden;
  }

  body.action-mode-active .calendar-shell {
    height: calc(100vh - var(--topbar-height) - var(--toolbar-height) - var(--resource-height) - 48px);
  }

  .calendar-scroll {
    height: 100%;
    overflow: auto;
    background: #fff;
  }

  .calendar-scroll::-webkit-scrollbar,
  .drawer-scroll::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  .calendar-scroll::-webkit-scrollbar-thumb,
  .drawer-scroll::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: #d6d6dc;
    border: 3px solid #fff;
  }

  .resource-header-viewport {
    position: relative;
    z-index: 25;
    height: var(--resource-height);
    overflow: hidden;
    border-bottom: 1px solid #e5e7eb;
    background: #fff;
    box-shadow: 0 8px 18px rgba(15, 23, 42, .08);
  }

  .resource-header-grid,
  .calendar-body-grid {
    display: grid;
    grid-template-columns: var(--time-col-width) repeat(var(--employee-count), minmax(230px, 1fr));
    min-width: calc(var(--time-col-width) + (var(--employee-count) * 260px));
    width: max(100%, calc(var(--time-col-width) + (var(--employee-count) * 260px)));
  }

  .resource-header-grid { will-change: transform; }
  .calendar-body-grid { position: relative; }

  .resource-cell {
    height: var(--resource-height);
    min-height: var(--resource-height);
    display: flex;
    align-items: center;
    justify-content: center;
    border-left: 1px solid #e5e7eb;
    background: #fff;
    overflow: hidden;
  }

  .resource-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    text-align: center;
  }

  .resource-avatar {
    display: flex;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 3px solid #fff;
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 7px 18px rgba(15, 23, 42, .14);
    overflow: hidden;
  }

  .resource-avatar img,
  .week-employee-avatar img,
  .team-menu-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .resource-name {
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1.15;
  }

  .resource-name { font-size: 13px; font-weight: 700; color: #121212; }

  .calendar-column {
    position: relative;
    min-height: calc(var(--slot-height) * var(--slot-count));
    border-left: 1px solid #ececf1;
    background:
      repeating-linear-gradient(-45deg, rgba(255, 222, 212, .022) 0, rgba(255, 222, 212, .022) 4px, transparent 4px, transparent 8px),
      #fff;
  }

  .time-column {
    min-height: calc(var(--slot-height) * var(--slot-count));
    background: #fff;
    border-right: 1px solid #ececf1;
  }

  .time-label {
    height: calc(var(--slot-height) * 2);
    border-top: 1px solid #f0f0f3;
    padding-top: 6px;
    padding-right: 8px;
    text-align: right;
    font-size: 12px;
    font-weight: 700;
    color: #60646c;
  }

  .calendar-slot {
    height: var(--slot-height);
    border-top: 1px solid #f0f0f3;
    transition: background .12s ease;
    cursor: crosshair;
  }

  .calendar-slot:nth-child(even) {
    border-top-style: dashed;
    border-top-color: #f5f5f7;
  }

  .calendar-slot:hover { background: rgba(255, 222, 212, .045); }

  .global-now-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 35;
    background: #ef6b8b;
    pointer-events: none;
  }

  .global-now-line::before {
    content: attr(data-time);
    position: absolute;
    left: 8px;
    top: -11px;
    width: 48px;
    border-radius: 999px;
    border: 1px solid #ef6b8b;
    background: #fff;
    color: #ef6b8b;
    font-size: 11px;
    font-weight: 700;
    text-align: center;
    line-height: 20px;
  }

  .appt-block {
    position: absolute;
    left: 8px;
    right: 8px;
    z-index: 12;
    border-radius: 9px;
    padding: 8px 10px;
    font-size: 12px;
    line-height: 1.2;
    overflow: hidden;
    cursor: pointer;
    border: 1px solid rgba(15, 23, 42, .08);
    box-shadow: 0 7px 20px rgba(15,23,42,.08);
    transition: .14s ease;
  }

  .appt-block:hover {
    filter: brightness(.98);
    transform: translateY(-1px);
  }

  .appt-line {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 700;
  }

  .appt-status {
    font-weight: 700;
  }

  .appt-status.is-emerald { color: #047857; }
  .appt-status.is-violet { color: #A63826; }

  .selection-block {
    position: absolute;
    left: 6px;
    right: 6px;
    z-index: 10;
    border: 2px solid #ffded4;
    background: rgba(255, 222, 212, .08);
    border-radius: 8px;
    pointer-events: none;
  }

  .drawer {
    top: var(--admin-impersonation-offset, 0px);
    z-index: 2147483647;
    isolation: isolate;
    width: var(--drawer-width);
    max-width: var(--drawer-width);
    overflow: hidden;
    transform: translateX(100%);
    opacity: 0;
    transition: transform .22s ease, opacity .22s ease;
    pointer-events: none;
  }

  .drawer.open {
    transform: translateX(0);
    opacity: 1;
    pointer-events: auto;
  }

  .drawer.appointment-editor {
    width: min(820px, calc(100vw - var(--sidebar-width)));
    max-width: min(820px, calc(100vw - var(--sidebar-width)));
  }

  .appointment-editor-layout { display: grid; grid-template-columns: 265px minmax(0, 1fr); height: 100%; min-height: 0; }
  .appointment-client-pane { display: flex; min-height: 0; flex-direction: column; overflow-y: auto; border-right: 1px solid #e4e4e7; background: #fafafa; }
  .appointment-client-summary { display: flex; min-height: 100%; flex: 1; flex-direction: column; align-items: stretch; padding: 22px 18px; }
  .appointment-client-identity { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .appointment-client-avatar { display: grid; width: 78px; height: 78px; place-items: center; border: 12px solid #ffded4; border-radius: 999px; background: #ffded4; color: #A63826; font-size: 21px; font-weight: 700; }
  .appointment-client-action { margin-top: 16px; color: #071014; font-size: 22px; font-weight: 700; line-height: 1.1; letter-spacing: -.04em; }
  .appointment-client-details { margin-top: 22px; width: 100%; display: grid; text-align: left; }
  .appointment-client-detail { display: flex; min-width: 0; align-items: center; gap: 14px; border-top: 1px solid #ececf0; padding: 18px 0; color: #3f3f46; text-decoration: none; }
  .appointment-client-detail:first-child { border-top: 0; }
  .appointment-client-detail:hover .appointment-client-detail-value { color: #A63826; text-decoration: underline; text-underline-offset: 3px; }
  .appointment-client-detail-icon { display: grid; width: 36px; height: 36px; flex: 0 0 auto; place-items: center; border-radius: 12px; background: #ffded4; color: #A63826; }
  .appointment-client-detail-icon svg { width: 18px; height: 18px; }
  .appointment-client-detail-label { display: block; color: #a1a1aa; font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .appointment-client-detail-value { display: block; min-width: 0; margin-top: 6px; overflow-wrap: anywhere; color: #18181b; font-size: 16px; font-weight: 700; line-height: 1.28; }
  .appointment-client-detail.muted .appointment-client-detail-icon { background: #f4f4f5; color: #71717a; }
  .appointment-client-detail.muted .appointment-client-detail-value { color: #3f3f46; }
  .appointment-client-detail-button { display: inline-flex; width: 100%; min-height: 48px; margin-top: auto; align-items: center; justify-content: center; border-radius: 999px; border: 1px solid #d4d4d8; background: #fff; color: #18181b; font-size: 14px; font-weight: 700; text-decoration: none; box-shadow: 0 12px 28px rgba(15,23,42,.08); }
  .appointment-client-detail-button:hover { border-color: #18181b; background: #fafafa; }
  .appointment-main-pane { display: flex; min-width: 0; min-height: 0; flex-direction: column; background: #fff; }
  .customer-picker-header { position: sticky; top: 0; z-index: 2; border-bottom: 1px solid #e4e4e7; background: #fff; padding: 20px; }
  .customer-picker-title { margin: 0 0 14px; font-size: 19px; font-weight: 700; }
  .customer-picker-search { width: 100%; height: 48px; border: 1px solid #d4d4d8; border-radius: 12px; padding: 0 14px; background: #fff; font-size: 13px; font-weight: 700; outline: none; }
  .customer-picker-search:focus { border-color: #A63826; box-shadow: 0 0 0 4px rgba(255, 222, 212, .12); }
  .customer-picker-option { display: flex; width: 100%; align-items: center; gap: 12px; border-bottom: 1px solid #e4e4e7; padding: 15px 18px; background: transparent; text-align: left; }
  .customer-picker-option:hover { background: #ffded4; }
  .customer-picker-option-avatar { display: grid; width: 44px; height: 44px; flex: 0 0 auto; place-items: center; border-radius: 999px; background: #ffded4; color: #A63826; font-weight: 700; }
  .customer-picker-option-name { display: block; overflow: hidden; font-size: 13px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
  .customer-picker-option-meta { display: block; overflow: hidden; margin-top: 3px; color: #71717a; font-size: 11px; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
  .appointment-status-badge { display: inline-flex; align-items: center; border-radius: 999px; padding: 4px 12px; background: #ffded4; color: #A63826; font-size: 12px; font-weight: 700; }
  .appointment-status-badge.is-emerald { background: #d1fae5; color: #047857; }
  .appointment-status-badge.is-violet { background: #ffded4; color: #A63826; }
  .appointment-status-badge.is-amber { background: #fef3c7; color: #b45309; }
  .appointment-status-badge.is-rose { background: #ffe4e6; color: #be123c; }
  .appointment-status-badge.is-zinc { background: #f4f4f5; color: #52525b; }
  .appointment-service-card { border-left: 4px solid #ffded4; border-radius: 12px; background: #fafafa; padding: 17px; }
  .appointment-service-card.is-emerald { border-left-color: #10b981; }
  .appointment-service-card.is-violet { border-left-color: #A63826; }
  .appointment-service-card.is-amber { border-left-color: #f59e0b; }
  .appointment-service-card.is-rose { border-left-color: #f43f5e; }
  .appointment-service-card.is-zinc { border-left-color: #a1a1aa; }
  .appointment-editor-footer { margin-top: auto; border-top: 1px solid #e4e4e7; background: #fff; padding: 18px 24px; }
  .appointment-total-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; }
  .appointment-save-button { width: 100%; height: 52px; margin-top: 15px; border: 0; border-radius: 999px; background: #071014; color: #fff; font-size: 15px; font-weight: 700; }

  .waitlist-toolbar-button {
    display: inline-flex;
    height: 40px;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    border: 1px solid #d4d4d8;
    background: #fff;
    padding: 0 12px;
    color: #18181b;
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 6px 18px rgba(15,23,42,.08);
    transition: .16s ease;
  }

  .waitlist-toolbar-button:hover {
    border-color: #A63826;
    color: #A63826;
    transform: translateY(-1px);
  }

  .waitlist-toolbar-count {
    display: inline-flex;
    min-width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #BF482F;
    color: #fff;
    padding: 0 8px;
    font-size: 12px;
    font-weight: 700;
  }

  .waitlist-tab.active {
    border-bottom-color: #18181b;
    color: #18181b;
  }

  .waitlist-card {
    border: 1px solid #e4e4e7;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 10px 28px rgba(15,23,42,.06);
  }

  .waitlist-card-menu {
    display: none;
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 15;
    width: 230px;
    overflow: hidden;
    border: 1px solid #e4e4e7;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 18px 45px rgba(15,23,42,.16);
  }

  .waitlist-card-menu.open { display: block; }

  .drawer-close-button {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 4;
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border: 1px solid #e4e4e7;
    border-radius: 999px;
    background: #fff;
    color: #18181b;
    font-size: 28px;
    font-weight: 300;
    line-height: 1;
    box-shadow: 0 10px 28px rgba(15,23,42,.12);
    transition: background .16s ease, transform .16s ease;
  }

  .drawer-close-button:hover {
    background: #f4f4f5;
    transform: translateY(-1px);
  }

  .payment-confirmation-dialog {
    width: min(440px, calc(100vw - 32px));
    margin: auto;
    border: 1px solid #e4e4e7;
    border-radius: 24px;
    padding: 0;
    color: #18181b;
    box-shadow: 0 28px 80px rgba(15, 23, 42, .26);
  }

  .payment-confirmation-dialog::backdrop { background: rgba(9, 9, 11, .42); }

  .quick-menu,
  .team-menu,
  .view-menu {
    display: none;
    border: 1px solid #e7e7ec;
    background: #fff;
    box-shadow: 0 18px 45px rgba(15,23,42,.16);
    overflow: hidden;
  }

  .quick-menu.open,
  .team-menu.open,
  .view-menu.open { display: block; }

  .quick-menu {
    position: fixed;
    z-index: 80;
    width: 245px;
    border-radius: 12px;
  }

  .team-menu,
  .view-menu {
    position: absolute;
    top: calc(100% + 8px);
    z-index: 75;
    min-width: 250px;
    border-radius: 14px;
  }

  .team-menu { left: 0; width: 310px; padding: 8px; }
  .view-menu { right: 0; width: 176px; min-width: 176px; padding: 6px; }

  .team-menu-row {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 12px;
    border-radius: 10px;
    padding: 10px;
    font-size: 13px;
    font-weight: 700;
    text-align: left;
    transition: .14s ease;
  }

  .team-menu-row:hover,
  .view-menu button:hover { background: #ffded4; }

  .team-checkbox {
    display: flex;
    width: 22px;
    height: 22px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border: 1px solid #d6d6dd;
    background: #fff;
    color: transparent;
    font-size: 14px;
    font-weight: 700;
  }

  .team-checkbox.checked {
    border-color: #A63826;
    background: #BF482F;
    color: #fff;
  }

  .team-menu-avatar {
    display: flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    border: 2px solid currentColor;
    border-radius: 999px;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }

  .calendar-week-shell {
    height: calc(100vh - var(--topbar-height) - var(--toolbar-height));
    overflow: auto;
    background: #fff;
  }

  body.action-mode-active .calendar-week-shell {
    height: calc(100vh - var(--topbar-height) - var(--toolbar-height) - 48px);
  }

  .week-grid {
    display: grid;
    grid-template-columns: 112px repeat(7, minmax(150px, 1fr));
    min-width: 1180px;
    border-top: 1px solid #e4e4e7;
    border-left: 1px solid #e4e4e7;
  }

  .week-corner,
  .week-day-header {
    position: sticky;
    top: 0;
    z-index: 22;
    height: 62px;
    border-right: 1px solid #e4e4e7;
    border-bottom: 1px solid #e4e4e7;
    background: #fff;
  }

  .week-corner { left: 0; z-index: 24; }

  .week-day-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #52525b;
    font-size: 13px;
    font-weight: 700;
  }

  .week-day-number {
    display: inline-flex;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: #18181b;
    font-size: 15px;
    font-weight: 700;
  }

  .week-day-header.today { color: #A63826; }
  .week-day-header.today .week-day-number { background: #BF482F; color: #fff; }

  .week-employee {
    position: sticky;
    left: 0;
    z-index: 18;
    display: flex;
    min-height: 178px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border-right: 1px solid #e4e4e7;
    border-bottom: 1px solid #e4e4e7;
    background: #fafafa;
    padding: 12px 8px;
    text-align: center;
  }

  .week-employee-avatar {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 3px solid #fff;
    border-radius: 999px;
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    box-shadow: 0 5px 14px rgba(15,23,42,.15);
    overflow: hidden;
  }

  .week-employee-name {
    width: 100%;
    overflow: hidden;
    color: #18181b;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    text-overflow: ellipsis;
  }

  .week-cell {
    min-height: 178px;
    border-right: 1px solid #e4e4e7;
    border-bottom: 1px solid #e4e4e7;
    background: #fff;
    padding: 9px;
    text-align: left;
    transition: background .14s ease, box-shadow .14s ease;
  }

  .week-cell:hover { background: #ffded4; box-shadow: inset 0 0 0 1px rgba(255, 222, 212, .18); }
  .week-cell.weekend { background-color: #fafafa; background-image: repeating-linear-gradient(-45deg, rgba(24,24,27,.025) 0, rgba(24,24,27,.025) 3px, transparent 3px, transparent 7px); }
  .week-cell.selected { box-shadow: inset 0 0 0 2px #ffded4; background: #ffded4; }

  .week-item {
    display: block;
    width: 100%;
    margin-bottom: 7px;
    overflow: hidden;
    border: 1px solid rgba(15,23,42,.07);
    border-left: 4px solid #ffded4;
    border-radius: 8px;
    padding: 7px 8px;
    color: #18181b;
    font-size: 11px;
    line-height: 1.25;
    text-align: left;
    box-shadow: 0 3px 10px rgba(15,23,42,.05);
  }

  .week-item-time { display: block; font-weight: 700; }
  .week-item-label { display: block; margin-top: 2px; overflow: hidden; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
  .week-more { color: #A63826; font-size: 11px; font-weight: 700; }

  .calendar-month-shell {
