          <div class="mb-5 rounded-3xl border border-zinc-100 bg-zinc-50 p-4">
            <p class="text-sm font-bold">${escapeHTML(customer.name)}</p>
            <p class="mt-1 text-sm font-semibold text-zinc-500">${escapeHTML(customer.phone || customer.email || "Sin contacto")}</p>
          </div>
