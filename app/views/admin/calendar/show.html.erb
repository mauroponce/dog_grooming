            <div>
              <label class="mb-2 block text-sm font-bold">Servicio</label>
              <select id="waitlistServiceInput" onchange="syncWaitlistEmployeeOptions()" class="w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100">
                ${services.map(service => `<option value="${escapeAttribute(service.id)}" ${String(service.id) === String(selectedServiceId) ? "selected" : ""}>${escapeHTML(service.name)}</option>`).join("")}
              </select>
            </div>
            <div>
              <label class="mb-2 block text-sm font-bold">Fecha</label>
              <select id="waitlistDateInput" class="w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100">
                ${blockDateOptions(entry?.desiredDate || currentDateISO())}
              </select>
            </div>
            <div>
              <label class="mb-2 block text-sm font-bold">Profesional</label>
              <select id="waitlistEmployeeInput" class="w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100">
