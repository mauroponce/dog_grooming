<% content_for :title, "Cita.pet Admin | Asistente diario" %>
<% content_for :admin_section_title, "Asistente diario" %>
<% content_for :admin_full_bleed, true %>
<% content_for :admin_hide_shell_header, true %>

<% business_name = @business&.name.presence || "tu negocio" %>
<% assistant_faq_questions = [
  { question: "¿Qué necesita mi atención hoy?", short_title: "¿Qué necesita mi atención hoy?", short_copy: "Pendientes y prioridades", icon: "sparkles" },
  { question: "¿Cómo está la agenda de hoy y mañana?", short_title: "Agenda de hoy y mañana", short_copy: "Turnos, ocupación y huecos", icon: "calendar" },
  { question: "¿Qué huecos puedo llenar y a quién conviene escribirle?", short_title: "Huecos para llenar", short_copy: "Clientes compatibles", icon: "calendar-search" },
  { question: "¿Qué comprobantes tengo que revisar primero?", short_title: "Comprobantes prioritarios", short_copy: "Señas para revisar", icon: "receipt" },
  { question: "¿Qué clientes debería contactar hoy para que vuelvan?", short_title: "Clientes para recuperar", short_copy: "Oportunidades de regreso", icon: "users" },
  { question: "¿Qué turnos tienen riesgo de ausencia?", short_title: "Riesgo de ausencia", short_copy: "Turnos a reforzar", icon: "alert" },
  { question: "¿Cómo viene el negocio esta semana?", short_title: "Resumen semanal", short_copy: "Ingresos y ocupación", icon: "chart" },
  { question: "¿Dónde estoy perdiendo turnos o ingresos?", short_title: "Pérdidas y oportunidades", short_copy: "Huecos, cancelaciones y ausencias", icon: "sparkles" }
] %>

<style>
  .admin-ai-page {
    position: relative;
    display: flex;
    min-height: 0;
    height: 100%;
    overflow: hidden;
    color: #0f172a;
    background:
      radial-gradient(circle at 92% -5%, rgba(255, 222, 212, .27), transparent 29rem),
      radial-gradient(circle at 6% 100%, rgba(255, 222, 212, .30), transparent 31rem),
      #f8f7fb;
  }

  .admin-ai-page * {
    scrollbar-width: thin;
    scrollbar-color: #A63826 transparent;
  }

  .admin-ai-shell {
    display: flex;
    min-width: 0;
    min-height: 0;
    flex: 1;
    flex-direction: column;
  }

  .admin-ai-topbar {
    position: relative;
    z-index: 3;
    display: flex;
    min-height: 76px;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid rgba(255,255,255,.80);
    background: rgba(255,255,255,.82);
    padding: 0 clamp(18px, 3vw, 44px);
    box-shadow: 0 1px 0 rgba(148,163,184,.10);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .admin-ai-title-row {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 13px;
  }

  .admin-ai-orb {
    position: relative;
    isolation: isolate;
    display: grid;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 16px;
    background:
      radial-gradient(circle at 30% 18%, rgba(255,255,255,.64), transparent 22%),
      radial-gradient(circle at 75% 82%, rgba(236,72,153,.34), transparent 38%),
      linear-gradient(145deg, #ffded4 0%, #ffded4 48%, #ffded4 100%);
    color: #fff;
    box-shadow:
      0 18px 45px rgba(255, 222, 212, .30),
      inset 0 1px 0 rgba(255,255,255,.35);
  }

  .admin-ai-orb::after {
    content: "";
    position: absolute;
    inset: 5px;
    z-index: -1;
    border: 1px solid rgba(255,255,255,.18);
    border-radius: inherit;
  }

  .admin-ai-orb svg,
  .admin-ai-icon-button svg,
  .admin-ai-action-button svg,
  .admin-ai-send svg,
  .admin-ai-drawer-question svg,
  .admin-ai-copy-button svg,
  .admin-ai-toast-icon svg,
  .admin-ai-clear-icon svg,
  .admin-ai-attachment svg {
    width: 18px;
    height: 18px;
  }

  .admin-ai-heading {
    margin: 0;
    color: #0f172a;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -.04em;
    line-height: 1.1;
  }

  .admin-ai-status {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 8px;
    margin: 4px 0 0;
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
  }

  .admin-ai-status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    border-radius: 999px;
    background: #22c55e;
  }

  .admin-ai-status-dot::before {
    content: "";
    position: absolute;
    inset: -5px;
    border-radius: inherit;
    background: rgba(34,197,94,.22);
    animation: admin-ai-pulse-ring 2s infinite;
  }

  @keyframes admin-ai-pulse-ring {
    0% { opacity: .8; transform: scale(.7); }
    70%, 100% { opacity: 0; transform: scale(1.7); }
  }

  .admin-ai-topbar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .admin-ai-action-button,
  .admin-ai-icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #e2e8f0;
    background: rgba(255,255,255,.92);
    color: #475569;
    font-weight: 700;
    transition: transform .18s ease, border-color .18s ease, background .18s ease, color .18s ease, box-shadow .18s ease;
  }

  .admin-ai-action-button {
    min-height: 44px;
    gap: 8px;
    border-radius: 16px;
    padding: 0 16px;
    font-size: 14px;
    box-shadow: 0 1px 2px rgba(15,23,42,.05);
  }

  .admin-ai-icon-button {
    width: 44px;
    height: 44px;
    border-radius: 16px;
    padding: 0;
  }

  .admin-ai-action-button:hover,
  .admin-ai-icon-button:hover {
    transform: translateY(-1px);
    border-color: #A63826;
    background: #fff;
    color: #A63826;
    box-shadow: 0 12px 28px rgba(255, 222, 212, .08);
  }

  .admin-ai-chat-stage {
    position: relative;
    display: flex;
    min-height: 0;
    flex: 1;
    flex-direction: column;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 15%, rgba(255, 222, 212, .08), transparent 25rem),
      linear-gradient(rgba(255,255,255,.68), rgba(255,255,255,.68));
  }

  .admin-ai-chat-stage::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: .34;
    background-image:
      linear-gradient(rgba(255, 222, 212, .025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 222, 212, .025) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, black, transparent 88%);
  }

  .admin-ai-scroll {
    position: relative;
    z-index: 1;
    min-height: 0;
    flex: 1;
    overflow-y: auto;
    padding: clamp(24px, 4vh, 42px) clamp(18px, 4vw, 56px) 22px;
  }

  .admin-ai-messages {
    width: min(900px, 100%);
    margin: 0 auto;
  }

  .admin-ai-messages.has-conversation {
    display: grid;
    gap: 28px;
  }

  .admin-ai-welcome {
    display: flex;
    min-height: min(620px, calc(100dvh - 255px));
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px 0;
    text-align: center;
  }

  .admin-ai-welcome-orb {
    width: 78px;
    height: 78px;
    border-radius: 26px;
  }

  .admin-ai-welcome-orb svg {
    width: 32px;
    height: 32px;
  }

  .admin-ai-welcome-eyebrow {
    margin: 28px 0 0;
    color: #A63826;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .admin-ai-welcome-title {
    max-width: 760px;
    margin: 10px auto 0;
    color: #0f172a;
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 700;
    letter-spacing: -.055em;
    line-height: 1.04;
  }

  .admin-ai-gradient-text {
    background: linear-gradient(100deg, #ffded4 0%, #ffded4 48%, #ffded4 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .admin-ai-welcome-copy {
    max-width: 650px;
    margin: 16px auto 0;
    color: #64748b;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.65;
  }

  .admin-ai-faq-grid-wrap {
    width: min(760px, 100%);
    margin-top: 34px;
  }

  .admin-ai-faq-grid-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 4px 12px;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 700;
  }

  .admin-ai-faq-grid-head strong {
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .admin-ai-faq-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    text-align: left;
  }

  .admin-ai-faq-button {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid rgba(226,232,240,.9);
    border-radius: 18px;
    background: rgba(255,255,255,.86);
    padding: 15px;
    color: #334155;
    cursor: pointer;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: transform .18s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease;
  }

  .admin-ai-faq-button:hover {
    transform: translateY(-2px);
    border-color: #A63826;
    background: #fff;
    box-shadow: 0 10px 24px rgba(255, 222, 212, .08);
  }

  .admin-ai-faq-icon {
    display: grid;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 14px;
    background: #ffded4;
    color: #A63826;
  }

  .admin-ai-faq-icon svg {
    width: 17px;
    height: 17px;
  }

  .admin-ai-faq-title {
    display: block;
    color: #1e293b;
    font-size: 14px;
    font-weight: 700;
  }

  .admin-ai-faq-copy {
    display: block;
    margin-top: 3px;
    color: #64748b;
    font-size: 12px;
    font-weight: 650;
  }

  .admin-ai-show-faq {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    padding: 9px 11px;
    color: #A63826;
    cursor: pointer;
    font-size: 12px;
    font-weight: 700;
    transition: background .16s ease;
  }

  .admin-ai-show-faq:hover {
    background: #ffded4;
  }

  .admin-ai-show-faq svg {
    width: 16px;
    height: 16px;
  }

  .admin-ai-message {
    animation: admin-ai-message-in .34s ease both;
  }

  @keyframes admin-ai-message-in {
    from { opacity: 0; transform: translateY(9px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .admin-ai-message-user {
    display: flex;
    justify-content: flex-end;
  }

  .admin-ai-message-assistant {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .admin-ai-message-meta {
    margin-top: 7px;
    color: #94a3b8;
    font-size: 10px;
    font-weight: 700;
  }

  .admin-ai-message-user .admin-ai-message-meta {
    text-align: right;
  }

  .admin-ai-bubble-user {
    max-width: min(74%, 620px);
    border-radius: 22px 22px 6px 22px;
    background: linear-gradient(135deg, #ffded4 0%, #ffded4 100%);
    padding: 14px 20px;
    color: #fff;
    font-size: 14px;
    font-weight: 650;
    line-height: 1.55;
    box-shadow: 0 16px 34px rgba(255, 222, 212, .16);
  }

  .admin-ai-bubble-assistant {
    max-width: min(82%, 720px);
    border: 1px solid rgba(226,232,240,.88);
    border-radius: 22px 22px 22px 6px;
    background: rgba(255,255,255,.94);
    padding: 18px 22px;
    color: #334155;
    font-size: 14px;
    font-weight: 560;
    line-height: 1.7;
    box-shadow: 0 10px 30px rgba(255, 222, 212, .08);
  }

  .admin-ai-bubble-assistant strong {
    color: #0f172a;
    font-weight: 700;
  }

  .admin-ai-bubble-assistant em {
    color: #475569;
    font-style: italic;
  }

  .admin-ai-bubble-assistant a {
    color: #A63826;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .admin-ai-bubble-assistant a:hover {
    color: #A63826;
  }

  .admin-ai-bubble-assistant p {
    margin: 0;
  }

  .admin-ai-bubble-assistant p + p,
  .admin-ai-bubble-assistant p + ul,
  .admin-ai-bubble-assistant p + ol,
  .admin-ai-bubble-assistant ul + p,
  .admin-ai-bubble-assistant ol + p {
    margin-top: 12px;
  }

  .admin-ai-bubble-assistant ul,
  .admin-ai-bubble-assistant ol {
    margin: 14px 0 0;
    padding-left: 20px;
  }

  .admin-ai-bubble-assistant li + li {
    margin-top: 6px;
  }

  .admin-ai-bubble-assistant code {
    border-radius: 7px;
    background: #f1f5f9;
    padding: 2px 6px;
    color: #A63826;
    font-size: .92em;
    font-weight: 700;
  }

  .admin-ai-small-orb {
    width: 36px;
    height: 36px;
    border-radius: 13px;
  }

  .admin-ai-assistant-footer {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-top: 8px;
    padding-left: 3px;
  }

  .admin-ai-copy-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: #cbd5e1;
    cursor: pointer;
    padding: 0;
    transition: color .16s ease;
  }

  .admin-ai-copy-button:hover {
    color: #A63826;
  }

  .admin-ai-typing {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 22px;
  }

  .admin-ai-typing span {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #ffded4;
    animation: admin-ai-typing-dot 1.2s infinite ease-in-out;
  }

  .admin-ai-typing span:nth-child(2) { animation-delay: .15s; }
  .admin-ai-typing span:nth-child(3) { animation-delay: .3s; }

  @keyframes admin-ai-typing-dot {
    0%, 70%, 100% { opacity: .25; transform: translateY(0); }
    35% { opacity: 1; transform: translateY(-3px); }
  }

  .admin-ai-composer-area {
    position: relative;
    z-index: 2;
    flex-shrink: 0;
    padding: 0 clamp(18px, 4vw, 56px) max(16px, env(safe-area-inset-bottom));
  }

  .admin-ai-composer-inner {
    width: min(900px, 100%);
    margin: 0 auto;
  }

  .admin-ai-suggestions {
    display: flex;
    gap: 9px;
    overflow-x: auto;
    padding: 8px 0 14px;
  }

  .admin-ai-suggestions.is-hidden {
    display: none;
  }

  .admin-ai-suggestion {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    background: rgba(255,255,255,.92);
    padding: 9px 14px;
    color: #475569;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: transform .18s ease, border-color .18s ease, background .18s ease, color .18s ease, box-shadow .18s ease;
  }

  .admin-ai-suggestion svg {
    width: 14px;
    height: 14px;
  }

  .admin-ai-suggestion-more {
    border-color: #A63826;
    background: #fff;
    color: #A63826;
  }

  .admin-ai-suggestion:hover {
    transform: translateY(-2px);
    border-color: #A63826;
    background: #ffded4;
    color: #A63826;
    box-shadow: 0 10px 24px rgba(255, 222, 212, .08);
  }

  .admin-ai-composer {
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    background: rgba(255,255,255,.94);
    padding: 8px;
    box-shadow: 0 18px 60px rgba(255, 222, 212, .14);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
  }

  .admin-ai-composer:focus-within {
    border-color: #A63826;
    background: #fff;
    box-shadow:
      0 0 0 5px rgba(255, 222, 212, .22),
      0 18px 60px rgba(255, 222, 212, .13);
  }

  .admin-ai-composer-row {
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }

  .admin-ai-attachment {
    display: grid;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    place-items: center;
    border: 0;
    border-radius: 16px;
    background: transparent;
    color: #94a3b8;
    cursor: pointer;
    transition: background .16s ease, color .16s ease;
  }

  .admin-ai-attachment:hover {
    background: #f1f5f9;
    color: #A63826;
  }

  .admin-ai-input {
    min-height: 44px;
    max-height: 144px;
    flex: 1;
    resize: none;
    border: 0;
    background: transparent;
    padding: 12px 4px;
    color: #334155;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.45;
    outline: none;
  }

  .admin-ai-input::placeholder {
    color: #94a3b8;
  }

  .admin-ai-send {
    display: grid;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    place-items: center;
    border: 0;
    border-radius: 16px;
    background: #BF482F;
    color: #fff;
    cursor: pointer;
    box-shadow: 0 14px 28px rgba(255, 222, 212, .20);
    transition: transform .18s ease, background .18s ease, opacity .18s ease;
  }

  .admin-ai-send:hover:not(:disabled) {
    transform: translateY(-1px);
    background: #ffded4;
  }

  .admin-ai-send:disabled {
    cursor: not-allowed;
    opacity: .45;
  }

  .admin-ai-disclaimer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    margin: 8px 0 0;
    color: #94a3b8;
    font-size: 10px;
    font-weight: 650;
    text-align: center;
  }

  .admin-ai-drawer,
  .admin-ai-clear-modal {
    position: fixed;
    inset: 0;
    z-index: 2147483646;
    display: none;
  }

  .admin-ai-drawer.is-open,
  .admin-ai-clear-modal.is-open {
    display: block;
  }

  .admin-ai-drawer-backdrop,
  .admin-ai-clear-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(15,23,42,.35);
    cursor: default;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .admin-ai-drawer-panel {
    position: absolute;
    inset: 0 0 0 auto;
    display: flex;
    width: min(430px, 100%);
    flex-direction: column;
    border-left: 1px solid rgba(226,232,240,.9);
    background: #fff;
    box-shadow: -24px 0 70px rgba(15,23,42,.18);
  }

  .admin-ai-drawer-header {
    display: flex;
    min-height: 76px;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid #f1f5f9;
    padding: 0 20px;
  }

  .admin-ai-drawer-title {
    margin: 0;
    color: #0f172a;
    font-size: 16px;
    font-weight: 700;
  }

  .admin-ai-drawer-copy {
    margin: 3px 0 0;
    color: #64748b;
    font-size: 12px;
    font-weight: 650;
  }

  .admin-ai-drawer-body {
    min-height: 0;
    flex: 1;
    overflow-y: auto;
    padding: 16px;
  }

  .admin-ai-drawer-list {
    display: grid;
    gap: 8px;
  }

  .admin-ai-drawer-question {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 12px;
    border: 0;
    border-radius: 18px;
    background: transparent;
    padding: 14px;
    color: #334155;
    text-align: left;
    cursor: pointer;
    transition: background .16s ease, color .16s ease;
  }

  .admin-ai-drawer-question:hover {
    background: #ffded4;
    color: #A63826;
  }

  .admin-ai-drawer-question-icon {
    display: grid;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 13px;
    background: #ffded4;
    color: #A63826;
  }

  .admin-ai-clear-dialog {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(360px, calc(100% - 32px));
    transform: translate(-50%, -50%);
    border-radius: 28px;
    background: #fff;
    padding: 24px;
    text-align: center;
    box-shadow: 0 28px 80px rgba(15,23,42,.24);
  }

  .admin-ai-clear-icon {
    display: grid;
    width: 56px;
    height: 56px;
    margin: 0 auto;
    place-items: center;
    border-radius: 18px;
    background: #fff1f2;
    color: #e11d48;
  }

  .admin-ai-clear-title {
    margin: 18px 0 0;
    color: #0f172a;
    font-size: 20px;
    font-weight: 700;
  }

  .admin-ai-clear-copy {
    margin: 8px 0 0;
    color: #64748b;
