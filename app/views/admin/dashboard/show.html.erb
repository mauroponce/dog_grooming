<script>
  (() => {
    const root = document.querySelector("[data-admin-ai-chat]");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const endpoint = root.dataset.endpoint;
    const businessName = root.dataset.businessName || "tu negocio";
    const messages = root.querySelector("[data-admin-ai-messages]");
    const scroll = root.querySelector("[data-admin-ai-scroll]");
    const form = root.querySelector("[data-admin-ai-form]");
    const input = root.querySelector("[data-admin-ai-input]");
    const submit = root.querySelector("[data-admin-ai-submit]");
    const faqDrawer = root.querySelector("[data-admin-ai-faq-drawer]");
    const clearModal = root.querySelector("[data-admin-ai-clear-modal]");
    const toast = root.querySelector("[data-admin-ai-toast]");
    const toastText = root.querySelector("[data-admin-ai-toast-text]");
    const suggestions = root.querySelector("[data-admin-ai-suggestions]");
    const initialWelcome = root.querySelector("[data-admin-ai-welcome]")?.outerHTML || "";
    const history = [];
    let responding = false;
    let toastTimer = null;

    const icons = {
      sparkles: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 3 2.1 5.7L20 11l-5.9 2.3L12 19l-2.1-5.7L4 11l5.9-2.3L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>',
      copy: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 8V5.8C8 4.8 8.8 4 9.8 4h8.4c1 0 1.8.8 1.8 1.8v8.4c0 1-.8 1.8-1.8 1.8H16" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M4 9.8C4 8.8 4.8 8 5.8 8h8.4c1 0 1.8.8 1.8 1.8v8.4c0 1-.8 1.8-1.8 1.8H5.8C4.8 20 4 19.2 4 18.2V9.8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>',
      thumbsUp: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3M7 22V10l5-8 1 1a4 4 0 0 1 1 3v3h5a2 2 0 0 1 2 2l-1 7a4 4 0 0 1-4 4H7Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>'
    };

    function csrfToken() {
      return document.querySelector("meta[name='csrf-token']")?.content || "";
    }

    function escapeHtml(value) {
      const element = document.createElement("div");
      element.textContent = value || "";
      return element.innerHTML;
    }

    function safeLinkHref(value) {
      const rawValue = String(value || "").trim();
      if (!rawValue) return "";

      if (rawValue.startsWith("//")) return "";
      if (rawValue.startsWith("/")) return rawValue;

      try {
        let normalizedValue = rawValue;
        if (/^localhost(?::\d+)?(?:\/|$)/i.test(normalizedValue)) {
          normalizedValue = `http://${normalizedValue}`;
        } else if (/^www\./i.test(normalizedValue)) {
          normalizedValue = `https://${normalizedValue}`;
        } else if (/^(?:[a-z0-9-]+\.)+[a-z]{2,}(?:\/|$)/i.test(normalizedValue)) {
          normalizedValue = `https://${normalizedValue}`;
        }

        const url = new URL(normalizedValue);
        return ["http:", "https:", "mailto:", "tel:"].includes(url.protocol) ? url.href : "";
      } catch (_) {
        return "";
      }
    }

    function linkHtml(href, label) {
      const safeHref = safeLinkHref(href);
      if (!safeHref) return escapeHtml(label);

      return `<a href="${escapeHtml(safeHref)}" target="_blank" rel="noopener noreferrer">${escapeHtml(label)}</a>`;
    }

    function autolinkPlainUrls(value, reserve) {
      const urlPattern = /(^|[\s([<{])((?:https?:\/\/|www\.|localhost(?::\d+)?(?:\/|$)|(?:[a-z0-9-]+\.)+[a-z]{2,}(?:\/|$))[^\s<]*)/gi;

      return String(value || "").replace(urlPattern, (match, prefix, rawUrl) => {
        const trailing = rawUrl.match(/[)\].,!?:;]+$/)?.[0] || "";
        const cleanUrl = rawUrl.slice(0, rawUrl.length - trailing.length);
        const safeHref = safeLinkHref(cleanUrl);
        if (!safeHref) return match;

        return `${prefix}${reserve(linkHtml(safeHref, cleanUrl))}${trailing}`;
      });
    }

    function formatInlineMarkdown(value) {
      const placeholders = [];
      const reserve = (html) => {
        const token = `HTMARKDOWNPLACEHOLDER${placeholders.length}TOKEN`;
        placeholders.push(html);
        return token;
      };

      let text = String(value || "")
        .replace(/\[([^\]\n]+)\]\(\s*([^\)\s]+)\s*\)/g, (match, label, href) => {
          const safeHref = safeLinkHref(href);
          return safeHref ? reserve(linkHtml(safeHref, label)) : match;
        })
        .replace(/`([^`]+)`/g, (_match, code) => {
          const safeHref = safeLinkHref(code);
          return safeHref ? reserve(linkHtml(safeHref, code)) : reserve(`<code>${escapeHtml(code)}</code>`);
        });

      text = autolinkPlainUrls(text, reserve);

      let html = escapeHtml(text)
        .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
        .replace(/__([^_]+)__/g, "<strong>$1</strong>")
        .replace(/(^|[^*])\*([^*\n]+)\*/g, "$1<em>$2</em>")
        .replace(/(^|[^_])_([^_\n]+)_/g, "$1<em>$2</em>");

      return html.replace(/HTMARKDOWNPLACEHOLDER(\d+)TOKEN/g, (_match, index) => placeholders[Number(index)] || "");
    }

    function formatText(value) {
      const lines = String(value || "").replace(/\r\n/g, "\n").split("\n");
      const blocks = [];
      let paragraph = [];
      let listItems = [];
      let listType = null;

      function flushParagraph() {
        if (!paragraph.length) return;

        blocks.push(`<p>${paragraph.map(formatInlineMarkdown).join("<br>")}</p>`);
        paragraph = [];
      }

      function flushList() {
        if (!listItems.length) return;

        blocks.push(`<${listType}>${listItems.map((item) => `<li>${formatInlineMarkdown(item)}</li>`).join("")}</${listType}>`);
        listItems = [];
        listType = null;
      }

      lines.forEach((line) => {
        const trimmed = line.trim();
        if (!trimmed) {
          flushParagraph();
          flushList();
          return;
        }

        const unordered = trimmed.match(/^[-*]\s+(.+)$/);
        const ordered = trimmed.match(/^\d+[.)]\s+(.+)$/);
        const nextListType = ordered ? "ol" : unordered ? "ul" : null;

        if (nextListType) {
          flushParagraph();
          if (listType && listType !== nextListType) flushList();

          listType = nextListType;
          listItems.push((ordered || unordered)[1]);
          return;
        }

        flushList();
        paragraph.push(trimmed);
      });

      flushParagraph();
      flushList();

      return blocks.join("") || "<p>No pude generar una respuesta con formato válido.</p>";
    }

    function scrollToBottom(behavior = "smooth") {
      requestAnimationFrame(() => {
        scroll.scrollTo({ top: scroll.scrollHeight, behavior });
      });
    }

    function showToast(message) {
      toastText.textContent = message;
      toast.classList.add("is-visible");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove("is-visible"), 2600);
    }

    function setSubmitState() {
      submit.disabled = responding || !input.value.trim();
    }

    function prepareConversation() {
      const welcome = messages.querySelector("[data-admin-ai-welcome]");
      if (welcome) {
        welcome.remove();
        messages.classList.add("has-conversation");
        suggestions?.classList.remove("is-hidden");
      }
    }

    function addUserMessage(question) {
      prepareConversation();

      const row = document.createElement("div");
      row.className = "admin-ai-message admin-ai-message-user";
      row.innerHTML = `
        <div>
          <div class="admin-ai-bubble-user">${escapeHtml(question)}</div>
          <div class="admin-ai-message-meta">Ahora</div>
        </div>
      `;
      messages.appendChild(row);
      scrollToBottom();
    }

    function addTyping() {
      const row = document.createElement("div");
      row.className = "admin-ai-message admin-ai-message-assistant";
      row.dataset.typing = "true";
      row.innerHTML = `
        <span class="admin-ai-orb admin-ai-small-orb" aria-hidden="true">${icons.sparkles}</span>
        <div class="min-w-0">
          <div class="admin-ai-bubble-assistant">
            <div class="admin-ai-typing"><span></span><span></span><span></span></div>
          </div>
        </div>
      `;
      messages.appendChild(row);
      scrollToBottom();
    }

    function removeTyping() {
      root.querySelector("[data-typing='true']")?.remove();
    }

    function addAssistantMessage(answer) {
      removeTyping();

      const row = document.createElement("div");
      row.className = "admin-ai-message admin-ai-message-assistant";
      row.innerHTML = `
        <span class="admin-ai-orb admin-ai-small-orb" aria-hidden="true">${icons.sparkles}</span>
        <div class="min-w-0">
          <div class="admin-ai-bubble-assistant">${formatText(answer)}</div>
          <div class="admin-ai-assistant-footer">
            <span class="admin-ai-message-meta">Cita.pet IA · Ahora</span>
            <button type="button" class="admin-ai-copy-button" data-copy-answer title="Copiar respuesta" aria-label="Copiar respuesta">${icons.copy}</button>
            <button type="button" class="admin-ai-copy-button" data-helpful-answer title="Respuesta útil" aria-label="Respuesta útil">${icons.thumbsUp}</button>
          </div>
        </div>
      `;
      messages.appendChild(row);

      row.querySelector("[data-copy-answer]")?.addEventListener("click", async () => {
        const text = row.querySelector(".admin-ai-bubble-assistant")?.innerText || "";
        try {
          await navigator.clipboard.writeText(text);
          showToast("Respuesta copiada");
        } catch (_) {
          showToast("Respuesta lista para copiar");
        }
      });

      row.querySelector("[data-helpful-answer]")?.addEventListener("click", () => showToast("Gracias. Registramos tu feedback."));
      scrollToBottom();
    }

    function openFaq() {
      faqDrawer.classList.add("is-open");
      faqDrawer.setAttribute("aria-hidden", "false");
    }

    function closeFaq() {
      faqDrawer.classList.remove("is-open");
      faqDrawer.setAttribute("aria-hidden", "true");
    }

    function openClearModal() {
      if (messages.querySelector("[data-admin-ai-welcome]")) {
        showToast("La conversación ya está vacía");
        return;
      }

      clearModal.classList.add("is-open");
      clearModal.setAttribute("aria-hidden", "false");
    }

    function closeClearModal() {
      clearModal.classList.remove("is-open");
      clearModal.setAttribute("aria-hidden", "true");
    }

    function resetConversation() {
      messages.innerHTML = initialWelcome;
      messages.classList.remove("has-conversation");
      suggestions?.classList.add("is-hidden");
      history.length = 0;
      responding = false;
      input.value = "";
      input.style.height = "auto";
      setSubmitState();
      scrollToBottom("auto");
      input.focus();
    }

    async function submitQuestion(rawQuestion) {
      const question = rawQuestion.trim();
      if (!question || responding) return;

      responding = true;
      setSubmitState();
      addUserMessage(question);
      addTyping();

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: {
            "Accept": "application/json",
            "Content-Type": "application/json",
            "X-CSRF-Token": csrfToken()
          },
          body: JSON.stringify({
            question,
            history: history.slice(-8)
          })
        });

        const payload = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(payload.error || "No pude responder ahora.");

        const answer = payload.answer || "No pude encontrar una respuesta para esa consulta.";
        history.push({ role: "user", content: question });
        history.push({ role: "assistant", content: answer });
        addAssistantMessage(answer);
      } catch (error) {
        addAssistantMessage(error.message || "No pude responder ahora. Probá de nuevo en unos segundos.");
      } finally {
        responding = false;
        setSubmitState();
        input.focus();
      }
    }

    root.addEventListener("click", (event) => {
      const faqOpener = event.target.closest("[data-admin-ai-faq-open]");
      if (faqOpener && root.contains(faqOpener)) {
        openFaq();
        return;
      }

      const button = event.target.closest("[data-question]");
      if (!button || !root.contains(button)) return;

      closeFaq();
      submitQuestion(button.dataset.question || "");
    });

    root.querySelectorAll("[data-admin-ai-faq-close]").forEach((button) => button.addEventListener("click", closeFaq));
    root.querySelector("[data-admin-ai-clear]")?.addEventListener("click", openClearModal);
    root.querySelectorAll("[data-admin-ai-clear-cancel]").forEach((button) => button.addEventListener("click", closeClearModal));
    root.querySelector("[data-admin-ai-clear-confirm]")?.addEventListener("click", () => {
      closeClearModal();
      resetConversation();
      showToast("Conversación eliminada");
    });
    root.querySelector("[data-admin-ai-new-chat]")?.addEventListener("click", () => {
      resetConversation();
      showToast("Nueva conversación iniciada");
    });
    root.querySelector("[data-admin-ai-attachment]")?.addEventListener("click", () => {
      showToast("La carga de archivos se conectará más adelante.");
    });

    input.addEventListener("input", () => {
      input.style.height = "auto";
      input.style.height = `${Math.min(input.scrollHeight, 144)}px`;
      setSubmitState();
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const question = input.value;
      input.value = "";
      input.style.height = "auto";
      setSubmitState();
      submitQuestion(question);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (clearModal.classList.contains("is-open")) {
        closeClearModal();
      } else if (faqDrawer.classList.contains("is-open")) {
        closeFaq();
      }
    });

    setSubmitState();
    scrollToBottom("auto");
  })();
</script>
