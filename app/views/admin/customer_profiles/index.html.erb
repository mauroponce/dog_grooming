<% content_for :admin_full_bleed, true %>
<% content_for :admin_section_title, "Clientes" %>
<% content_for :title, "Clientes · Dog Grooming" %>

<% can_edit_customers = current_user.admin? || current_user.super_admin? || current_employee_membership&.can?("can_edit_customers") %>
<% total_customers = @customer_query.customers_scope.count %>
<% filtered_customers = @pagy.respond_to?(:count) ? @pagy.count : @customers.size %>
<% customer_icons = {
  search: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5" stroke-linecap="round"/></svg>',
  plus: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>',
  user_search: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="9.5" cy="7" r="4"/><path d="m17 17 4 4M19 19a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/></svg>',
  chevron: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  pencil: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m4 20 4.5-1 10-10a2.1 2.1 0 0 0-3-3l-10 10L4 20Z" stroke-linejoin="round"/><path d="m13.5 7.5 3 3" stroke-linecap="round"/></svg>',
  trash: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M10 11v5M14 11v5M9 7l1-3h4l1 3M6 7l1 13h10l1-13" stroke-linecap="round" stroke-linejoin="round"/></svg>'
} %>

<style>
  .customers-workspace {
    height: 100%;
    min-height: 0;
    overflow-y: auto;
    background:
      radial-gradient(circle at 85% 0%, rgba(255, 222, 212, .055), transparent 32rem),
      #f7f7f9;
    color: #0f172a;
  }

  .customers-container {
    box-sizing: border-box;
    width: min(var(--admin-content-max-width, 1600px), calc(100% - var(--admin-content-horizontal-space, 48px)));
    margin: 0 auto;
    padding: 34px 0 44px;
  }

  .customers-page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 26px;
  }

  .customers-title-row {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 12px;
  }

  .customers-title-row h1 {
    margin: 0;
    color: #0f172a;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -.04em;
    line-height: 1.08;
  }

  .customers-count {
    display: grid;
    min-width: 30px;
    height: 30px;
    place-items: center;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    background: #fff;
    padding: 0 8px;
    color: #334155;
    font-size: 12px;
    font-weight: 700;
    box-shadow: 0 1px 2px rgba(15,23,42,.04);
  }

  .customers-page-copy {
    max-width: 760px;
    margin: 9px 0 0;
    color: #64748b;
    font-size: 14px;
    font-weight: 650;
    line-height: 1.65;
  }

  .customers-primary-button,
  .customers-page-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border-radius: 18px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: .16s ease;
  }

  .customers-primary-button {
    min-height: 48px;
    border: 0;
    background: #05080a;
    padding: 0 20px;
    color: #fff;
    box-shadow: 0 16px 34px rgba(15,23,42,.12);
  }

  .customers-primary-button:hover {
    background: var(--admin-brand-700);
    transform: translateY(-1px);
  }

  .customers-shell-card {
    overflow: visible;
    border: 1px solid rgba(226,232,240,.88);
    border-radius: 26px;
    background: #fff;
    box-shadow: 0 10px 32px rgba(255, 222, 212, .055);
  }

  .customers-toolbar {
    border-bottom: 1px solid rgba(226,232,240,.7);
    padding: 18px;
  }

  .customers-toolbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .customers-toolbar-form {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .customers-search {
    position: relative;
    display: block;
    flex: 1;
    width: min(560px, 100%);
  }

  .customers-search svg {
    position: absolute;
    left: 18px;
    top: 50%;
    width: 18px;
    height: 18px;
    transform: translateY(-50%);
    color: #94a3b8;
  }

  .customers-search input {
    box-sizing: border-box;
    width: 100%;
    height: 48px;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    background: rgba(248,250,252,.82);
    padding: 0 50px 0 48px;
    color: #0f172a;
    font-size: 14px;
    font-weight: 700;
    outline: none;
    transition: .16s ease;
  }

  .customers-search input::placeholder {
    color: #94a3b8;
    font-weight: 650;
  }

  .customers-search input:focus {
    border-color: var(--admin-brand-200);
    background: #fff;
    box-shadow: 0 0 0 4px rgba(255, 222, 212, .12);
  }

  .customers-toolbar-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 9px;
  }

  .customers-sort-field {
    position: relative;
    display: grid;
    min-width: 196px;
  }

  .customers-sort-input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .customers-sort-select {
    display: flex;
    width: 100%;
    min-height: 42px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #fff;
    padding: 0 18px 0 13px;
    color: #334155;
    font-size: 13px;
    font-weight: 700;
    text-align: left;
    outline: none;
    cursor: pointer;
    transition: .16s ease;
  }

  .customers-sort-select:hover,
  .customers-sort-select:focus,
  .customers-sort-select[aria-expanded="true"] {
    border-color: var(--admin-brand-200);
    box-shadow: 0 0 0 4px rgba(255, 222, 212, .12);
  }

  .customers-sort-chevron {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-left: 8px;
  }

  .customers-sort-select[aria-expanded="true"] .customers-sort-chevron {
    transform: rotate(180deg);
  }

  .customers-sort-options {
    position: absolute;
    z-index: 20;
    top: calc(100% + 8px);
    right: 0;
    left: 0;
    display: grid;
    gap: 3px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #fff;
    padding: 6px;
    box-shadow: 0 14px 30px rgba(15,23,42,.14);
  }

  .customers-sort-options[hidden] {
    display: none;
  }

  .customers-sort-option {
    width: 100%;
    min-height: 38px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    padding: 0 12px;
    color: #334155;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    text-align: left;
    cursor: pointer;
  }

  .customers-sort-option:hover,
  .customers-sort-option:focus-visible {
    background: #ffded4;
    color: var(--admin-brand-700);
    outline: none;
  }

  .customers-sort-option.is-selected {
    background: #ffded4;
    color: var(--admin-brand-700);
  }

  .customers-primary-button svg,
  .customers-contact svg {
    width: 17px;
    height: 17px;
  }

  .customers-table-desktop {
    display: block;
  }

  .customers-table-head,
  .customers-row {
    display: grid;
    grid-template-columns:
      minmax(165px, 1.12fr)
      minmax(170px, 1.1fr)
      minmax(150px, .95fr)
      minmax(110px, .62fr)
      minmax(75px, .38fr)
      minmax(148px, .72fr);
    align-items: center;
    gap: 16px;
  }

  .customers-table-head {
    border-bottom: 1px solid rgba(226,232,240,.7);
    background: rgba(248,250,252,.52);
    padding: 14px 22px;
  }

  .customers-table-head p {
    margin: 0;
    color: #94a3b8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .customers-table-head p:last-child {
    text-align: right;
  }

  .customers-row {
    position: relative;
    min-height: 96px;
    padding: 19px 22px;
    border-bottom: 1px solid rgba(226,232,240,.7);
    cursor: pointer;
    transition: background-color .18s ease, box-shadow .18s ease;
  }

  .customers-row:last-child {
    border-bottom: 0;
  }

  .customers-row:hover {
    background: #ffded4;
    box-shadow: inset 3px 0 0 var(--admin-brand-500);
  }

  .customers-person {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 15px;
  }

  .customers-avatar {
    display: grid;
    width: 58px;
    height: 58px;
    flex: 0 0 auto;
    place-items: center;
    overflow: hidden;
    border: 3px solid var(--customer-avatar-color, #ffded4);
    border-radius: 999px;
    background: var(--customer-avatar-color, #ffded4);
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    box-shadow: 0 1px 0 rgba(255,255,255,.9), 0 10px 24px rgba(15,23,42,.08);
  }

  .customers-avatar.is-violet {
    --customer-avatar-color: var(--admin-brand-500);
  }

  .customers-copy {
    min-width: 0;
  }

  .customers-cell {
    min-width: 0;
  }

  .customers-line-primary {
    margin: 0;
    color: #0f172a;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.35;
  }

  .customers-line-secondary {
    margin: 5px 0 0;
    color: #475569;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.35;
  }

  .customers-name-row {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .customers-name {
    display: block;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 0;
    overflow: hidden;
    color: #0f172a;
    cursor: pointer;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .customers-name:hover {
    color: var(--admin-brand-700);
  }

  .customers-subtitle {
    margin: 5px 0 0;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.35;
  }

  .customers-contact {
    display: grid;
    min-width: 0;
    gap: 7px;
  }

  .customers-contact a,
  .customers-contact span {
    display: block;
    min-width: 0;
    overflow: hidden;
    color: #475569;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .customers-contact .customers-phone-link {
    color: #334155;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .customers-contact a:hover {
    color: var(--admin-brand-700);
  }

  .customers-contact svg {
    flex: 0 0 auto;
    color: #94a3b8;
  }

  .customers-contact-value {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .customers-money {
    justify-self: start;
    color: #1e293b;
    font-size: 13px;
    font-weight: 700;
    text-align: left;
  }

  .customers-action-cell {
    display: flex;
    min-width: 0;
    justify-self: end;
  }

  .customers-row-actions {
    position: relative;
  }

  .customers-action-button {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border: 1px solid #dbe3ee;
    border-radius: 18px;
    background: #fff;
    padding: 0 16px;
    color: #1e293b;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 1px 2px rgba(15,23,42,.04);
    transition: .16s ease;
    cursor: pointer;
    list-style: none;
  }

  .customers-action-button::-webkit-details-marker {
    display: none;
  }

  .customers-action-button svg {
    width: 16px;
    height: 16px;
    transition: transform .16s ease;
  }

  .customers-row-actions[open] .customers-action-button,
  .customers-action-button:hover,
  .customers-action-button:focus-visible {
    border-color: var(--admin-brand-200);
    background: var(--admin-brand-50);
    color: var(--admin-brand-700);
    outline: none;
  }

  .customers-row-actions[open] .customers-action-button svg {
    transform: rotate(180deg);
  }

  .customers-actions-menu {
    position: absolute;
    z-index: 30;
    top: calc(100% + 8px);
    right: 0;
    display: grid;
    width: 220px;
    gap: 3px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #fff;
    padding: 6px;
    box-shadow: 0 16px 34px rgba(15,23,42,.16);
  }

  .customers-actions-menu a {
    display: flex;
    min-height: 38px;
    align-items: center;
    gap: 9px;
    border-radius: 10px;
    padding: 0 10px;
    color: #334155;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .customers-actions-menu a:hover {
    background: #ffded4;
    color: var(--admin-brand-700);
  }

  .customers-actions-menu a svg {
    width: 16px;
    height: 16px;
  }

  .customers-actions-menu .is-danger {
    color: #be123c;
  }

  .customers-actions-menu .is-danger:hover {
    background: #fff1f2;
    color: #be123c;
  }

  .customers-card .customers-action-cell,
  .customers-card .customers-row-actions,
  .customers-card .customers-action-button {
    width: 100%;
  }

  .customers-mobile-list {
    display: none;
  }

  .customers-card {
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    background: #fff;
    padding: 16px;
  }

  .customers-card-top {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .customers-card-body {
    margin-top: 14px;
    border-radius: 18px;
    background: #f8fafc;
    padding: 12px;
  }

  .customers-card-section {
    margin-top: 14px;
  }

  .customers-card-section-title {
    margin: 0;
    color: #94a3b8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .customers-card-section-copy {
    margin: 6px 0 0;
    color: #334155;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.55;
  }

  .customers-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    border-top: 1px solid rgba(226,232,240,.7);
    background: rgba(248,250,252,.52);
    padding: 14px 18px;
  }

  .customers-footer p {
    margin: 0;
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
  }

  .customers-footer strong {
    color: #334155;
    font-weight: 700;
  }

  .customers-empty {
    padding: 58px 24px;
    text-align: center;
  }

  .customers-empty-icon {
    display: grid;
    width: 58px;
    height: 58px;
    margin: 0 auto;
    place-items: center;
    border-radius: 20px;
    background: #f1f5f9;
    color: #64748b;
  }

  .customers-empty-icon svg {
    width: 25px;
    height: 25px;
  }

  .customers-empty h2 {
    margin: 15px 0 0;
    color: #0f172a;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -.02em;
  }

  .customers-empty p {
    max-width: 360px;
    margin: 8px auto 0;
    color: #64748b;
    font-size: 14px;
    font-weight: 650;
    line-height: 1.6;
  }

  .customers-pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .customers-page-button {
    min-height: 38px;
    border: 1px solid #e2e8f0;
    background: #fff;
    padding: 0 13px;
    color: #334155;
  }

  .customers-page-button.is-current {
    border-color: #05080a;
    background: #05080a;
    color: #fff;
  }

  .customers-page-button.is-disabled {
    color: #94a3b8;
  }

  @media (max-width: 1180px) {
    .customers-container {
      width: min(100% - 32px, 720px);
      padding: 24px 0 36px;
    }

    .customers-page-header,
    .customers-toolbar-inner,
    .customers-footer {
      align-items: stretch;
      flex-direction: column;
    }

    .customers-toolbar-form {
      align-items: stretch;
      flex-direction: column;
    }

    .customers-primary-button {
      width: 100%;
    }

    .customers-toolbar-actions {
      width: 100%;
    }

    .customers-sort-field,
    .customers-sort-select {
      width: 100%;
    }

    .customers-table-desktop {
      display: none;
    }

    .customers-mobile-list {
      display: grid;
      gap: 12px;
      padding: 14px;
    }

    .customers-avatar {
      width: 52px;
      height: 52px;
      font-size: 16px;
    }
  }
</style>

<div class="customers-workspace">
  <div class="customers-container">
    <section class="customers-page-header">
      <div>
        <div class="customers-title-row">
          <h1>Lista de clientes</h1>
          <span class="customers-count"><%= total_customers %></span>
        </div>
        <p class="customers-page-copy">Administrá tus clientes, sus datos de contacto, historial y link privado de turnos.</p>
      </div>

      <% if can_edit_customers %>
        <%= link_to new_admin_customer_profile_path, class: "customers-primary-button", data: { turbo_frame: "_top" } do %>
          <%= customer_icons.fetch(:plus).html_safe %>
          Añadir cliente
        <% end %>
      <% end %>
    </section>

    <section class="customers-shell-card"
      data-controller="customers-results-loader"
      data-action="turbo:before-fetch-request->customers-results-loader#start turbo:frame-load->customers-results-loader#stop turbo:fetch-request-error->customers-results-loader#stop">
      <div class="customers-toolbar">
        <div class="customers-toolbar-inner">
          <%= form_with url: admin_customer_profiles_path, method: :get, class: "customers-toolbar-form", data: { controller: "auto-submit", auto_submit_delay_value: 350, turbo_frame: "customers_results", customers_results_loader_target: "form" } do |form| %>
            <%= hidden_field_tag :filter, @customer_query.filter if @customer_query.filter.present? && @customer_query.filter != "all" %>
            <div class="customers-search">
              <%= customer_icons.fetch(:search).html_safe %>
              <%= form.search_field :q,
                value: @customer_query.query,
                placeholder: "Buscar por nombre, email o teléfono",
                autocomplete: "off",
                data: { action: "input->auto-submit#schedule input->customers-results-loader#start search->auto-submit#schedule search->customers-results-loader#start" } %>
            </div>

            <div class="customers-toolbar-actions">
              <div class="customers-sort-field" data-controller="customer-sort">
                <%= select_tag :sort,
                  options_for_select(Customers::InboxQuery::SORT_OPTIONS.map { |value, label| [ label, value ] }, @customer_query.sort),
                  class: "customers-sort-input",
                  tabindex: -1,
                  aria: { hidden: true },
                  data: { customer_sort_target: "input", action: "change->auto-submit#submit" } %>

                <button type="button"
                  class="customers-sort-select"
                  aria-label="Ordenar clientes"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-controls="customers-sort-options"
                  data-customer-sort-target="trigger"
                  data-action="click->customer-sort#toggle keydown->customer-sort#keydown">
                  <span data-customer-sort-target="label"><%= Customers::InboxQuery::SORT_OPTIONS.fetch(@customer_query.sort) %></span>
                  <svg class="customers-sort-chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>

                <div id="customers-sort-options" class="customers-sort-options" role="listbox" aria-label="Ordenar clientes" data-customer-sort-target="menu" hidden>
                  <% Customers::InboxQuery::SORT_OPTIONS.each do |value, label| %>
                    <button type="button"
                      class="customers-sort-option <%= "is-selected" if value == @customer_query.sort %>"
                      role="option"
                      aria-selected="<%= value == @customer_query.sort %>"
                      data-customer-sort-target="option"
                      data-customer-sort-value="<%= value %>"
                      data-customer-sort-label="<%= label %>"
                      data-action="click->customer-sort#choose">
                      <%= label %>
                    </button>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%= turbo_frame_tag "customers_results" do %>
        <% if @customers.any? %>
          <div class="customers-table-desktop">
            <div class="customers-table-head">
              <p>Cliente</p>
              <p>Próximo / Último turno</p>
              <p>Contacto</p>
              <p>Estado del turno</p>
              <p>Valor</p>
              <p>Acciones</p>
            </div>

            <% @customers.each do |customer| %>
              <% profile = @customer_presenters_by_id.fetch(customer.id) %>
              <% turn_status = customer_directory_turn_status(profile) %>
              <article id="customer_<%= customer.id %>" class="customers-row" role="link" tabindex="0" data-customer-row-url="<%= edit_admin_customer_profile_path(customer) %>" aria-label="Editar cliente <%= profile.name %>">
                <div class="customers-person">
                  <span class="customers-avatar is-violet"><%= profile.initials %></span>

                  <div class="customers-copy">
                    <div class="customers-name-row">
                      <%= link_to profile.name, edit_admin_customer_profile_path(customer), class: "customers-name", data: { turbo_frame: "_top" } %>
                    </div>
                    <p class="customers-line-secondary"><%= customer_directory_client_summary(profile, customer) %></p>
                  </div>
                </div>

                <div class="customers-cell">
                  <p class="customers-line-primary"><%= customer_directory_turn_label(profile) %></p>
                  <p class="customers-line-secondary"><%= customer_directory_turn_service(profile) %></p>
                </div>

                <div class="customers-contact">
                  <% if customer.phone.present? %>
                    <%= link_to customer.phone, PhoneNumber.whatsapp_link(customer.phone), target: "_blank", rel: "noopener", class: "customers-phone-link" %>
                  <% else %>
                    <span>Sin WhatsApp</span>
                  <% end %>

                  <% if customer.email.present? %>
                    <%= mail_to customer.email, customer.email %>
                  <% else %>
                    <span>Sin email</span>
                  <% end %>
                </div>

                <div class="customers-cell">
                  <p class="customers-line-primary"><%= turn_status.first %></p>
                  <p class="customers-line-secondary"><%= turn_status.second %></p>
                </div>

                <div class="customers-cell">
                  <div class="customers-money"><%= customer_directory_sales_label(profile) %></div>
                  <p class="customers-line-secondary"><%= customer_directory_turn_count_label(profile) %></p>
                </div>

                <div class="customers-action-cell">
                  <% if can_edit_customers %>
                    <%= render "admin/customer_profiles/customer_actions", customer:, customer_icons: %>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>

          <div class="customers-mobile-list">
            <% @customers.each do |customer| %>
              <% profile = @customer_presenters_by_id.fetch(customer.id) %>
              <% turn_status = customer_directory_turn_status(profile) %>
              <article id="mobile_customer_<%= customer.id %>" class="customers-card" role="link" tabindex="0" data-customer-row-url="<%= edit_admin_customer_profile_path(customer) %>" aria-label="Editar cliente <%= profile.name %>">
                <div class="customers-card-top">
                  <span class="customers-avatar is-violet"><%= profile.initials %></span>

                  <div class="customers-copy" style="flex:1">
                    <div class="customers-name-row">
                      <%= link_to profile.name, edit_admin_customer_profile_path(customer), class: "customers-name", data: { turbo_frame: "_top" } %>
                    </div>
                    <p class="customers-line-secondary"><%= customer_directory_client_summary(profile, customer) %></p>
                  </div>
                </div>

                <div class="customers-card-section">
                  <p class="customers-card-section-title">Próximo / Último turno</p>
                  <p class="customers-card-section-copy"><%= customer_directory_turn_label(profile) %></p>
                  <p class="customers-line-secondary"><%= customer_directory_turn_service(profile) %></p>
                </div>

                <div class="customers-card-section">
                  <p class="customers-card-section-title">Contacto</p>
                  <div class="customers-contact">
                    <% if customer.phone.present? %>
                      <%= link_to customer.phone, PhoneNumber.whatsapp_link(customer.phone), target: "_blank", rel: "noopener", class: "customers-phone-link" %>
                    <% else %>
                      <span>Sin WhatsApp</span>
                    <% end %>

                    <% if customer.email.present? %>
                      <%= mail_to customer.email, customer.email %>
                    <% else %>
                      <span>Sin email</span>
                    <% end %>
                  </div>
                </div>

                <div class="customers-card-section">
                  <p class="customers-card-section-title">Estado del turno</p>
                  <p class="customers-card-section-copy"><%= turn_status.first %></p>
                  <p class="customers-line-secondary"><%= turn_status.second %></p>
                </div>

                <div class="customers-card-section">
                  <p class="customers-card-section-title">Valor</p>
                  <p class="customers-card-section-copy"><%= customer_directory_sales_label(profile) %></p>
                  <p class="customers-line-secondary"><%= customer_directory_turn_count_label(profile) %></p>
                </div>

                <div class="customers-card-section">
                  <% if can_edit_customers %>
                    <div class="customers-action-cell">
                      <%= render "admin/customer_profiles/customer_actions", customer:, customer_icons: %>
                    </div>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>

          <div class="customers-footer">
            <p>
              Mostrando
              <strong><%= @pagy.from %>-<%= @pagy.to %></strong>
              de
              <strong><%= filtered_customers %></strong>
              <%= filtered_customers == 1 ? "cliente" : "clientes" %>
            </p>

            <% if @pagy.present? && @pagy.last > 1 %>
              <% previous_page = @pagy.page > 1 ? @pagy.page - 1 : nil %>
              <% next_page = @pagy.page < @pagy.last ? @pagy.page + 1 : nil %>
              <nav class="customers-pagination" aria-label="Paginación">
                <% if previous_page.present? %>
                  <%= link_to "Anterior", @pagy.page_url(previous_page), class: "customers-page-button", rel: "prev" %>
                <% else %>
                  <span class="customers-page-button is-disabled" aria-disabled="true">Anterior</span>
                <% end %>

                <% @pagy.send(:series).each do |item| %>
                  <% if item == :gap %>
                    <span class="customers-page-button is-disabled" aria-hidden="true">&hellip;</span>
                  <% elsif item.is_a?(String) %>
                    <span class="customers-page-button is-current" aria-current="page"><%= item %></span>
                  <% else %>
                    <%= link_to item, @pagy.page_url(item), class: "customers-page-button" %>
                  <% end %>
                <% end %>

                <% if next_page.present? %>
                  <%= link_to "Siguiente", @pagy.page_url(next_page), class: "customers-page-button", rel: "next" %>
                <% else %>
                  <span class="customers-page-button is-disabled" aria-disabled="true">Siguiente</span>
                <% end %>
              </nav>
            <% end %>
          </div>
        <% else %>
          <div class="customers-empty">
            <span class="customers-empty-icon"><%= customer_icons.fetch(:user_search).html_safe %></span>
            <h2>No hay clientes para mostrar</h2>
            <p>Probá con otra búsqueda o añadí el primer cliente de este negocio.</p>
            <% if can_edit_customers %>
              <%= link_to new_admin_customer_profile_path, class: "customers-primary-button", style: "margin-top:18px;box-shadow:none", data: { turbo_frame: "_top" } do %>
                <%= customer_icons.fetch(:plus).html_safe %>
                Añadir cliente
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <span class="customers-results-loader admin-results-loader" data-customers-results-loader-target="indicator" aria-hidden="true">
        <span class="customers-results-loader-ring admin-results-loader-ring"></span>
      </span>
    </section>
  </div>
</div>

<script>
  (() => {
    if (window.DogGroomingCustomerRowsBound) return;
    window.DogGroomingCustomerRowsBound = true;

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : event.target.parentElement;
      const row = target?.closest("[data-customer-row-url]");
      if (!row || target.closest("a, button, input, select, textarea, summary, details")) return;
      window.location.href = row.dataset.customerRowUrl;
    });

    document.addEventListener("keydown", (event) => {
      if (!["Enter", " "].includes(event.key)) return;
      const target = event.target instanceof Element ? event.target : event.target.parentElement;
      const row = target?.closest("[data-customer-row-url]");
      if (!row || target.closest("a, button, input, select, textarea, summary, details")) return;
      event.preventDefault();
      window.location.href = row.dataset.customerRowUrl;
    });
  })();
</script>
