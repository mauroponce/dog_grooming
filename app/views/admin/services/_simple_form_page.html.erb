<% employee_memberships = Array(local_assigns[:employee_memberships] || @employee_memberships) %>
<% selected_employee_ids = service.employee_membership_ids %>
<% all_team_selected = selected_employee_ids.blank? %>
<% selected_team_count = all_team_selected ? employee_memberships.size : selected_employee_ids.size %>
<% page_mode = service.persisted? ? "Editar servicio" : "Nuevo servicio" %>
<% page_title = service.persisted? ? service.name.presence || title : "Crear servicio" %>
<% public_service_url = service.persisted? ? admin_public_service_url(service) : "" %>
<% requested_service_tab = params[:tab].presence || params[:return_tab].presence %>
<% active_service_tab = %w[basic team images availability].include?(requested_service_tab.to_s) ? requested_service_tab.to_s : "basic" %>
<% service_availability_weekdays = [ [ 0, "Domingo" ], [ 1, "Lunes" ], [ 2, "Martes" ], [ 3, "Miércoles" ], [ 4, "Jueves" ], [ 5, "Viernes" ], [ 6, "Sábado" ] ] %>
<% service_availability_rules_by_weekday = service.service_availability_rules.active.order(:weekday, :start_time).group_by(&:weekday) %>
<% service_availability_time_options = (0..23).flat_map { |hour| (0..55).step(5).map { |minute| time = format("%02d:%02d", hour, minute); [ time, time ] } } %>
<% service_availability_time_value = ->(value) { value.respond_to?(:strftime) ? value.strftime("%H:%M") : value.to_s.presence } %>
<% payment_accounts = service.business.payment_accounts.active.ordered.to_a %>
<% payment_account_options = [ [ "Usar cuenta principal", "" ] ] + payment_accounts.map { |account| [ account.display_name, account.id ] } %>
<% enabled_payment_methods = service.business.enabled_payment_methods %>
<% mercado_pago_enabled = enabled_payment_methods.include?("mercado_pago") %>
<% manual_transfer_enabled = enabled_payment_methods.include?("manual_transfer") %>
<% only_mercado_pago_enabled = mercado_pago_enabled && enabled_payment_methods.one? %>
<% show_manual_payment_account_selector = manual_transfer_enabled && payment_accounts.many? %>

