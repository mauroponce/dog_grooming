  }

  .service-row-actions-menu {
    width: 250px;
  }

  .services-category-menu-item,
  .service-row-action {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 11px;
    border: 0;
    border-radius: 13px;
    background: transparent;
    color: #334155;
    cursor: pointer;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    padding: 11px 12px;
    text-align: left;
    text-decoration: none;
  }

  .services-category-menu-item:hover,
  .service-row-action:hover {
    background: #f8fafc;
    color: var(--admin-brand-700);
  }

  .services-category-menu-item.is-danger,
  .service-row-action.is-danger {
    color: #e11d48;
  }

  .services-category-menu-item.is-danger:hover,
  .service-row-action.is-danger:hover {
    background: #fff1f2;
    color: #be123c;
  }

  .services-category-menu-item svg,
  .service-row-action svg {
    width: 17px;
    height: 17px;
  }

  .service-row-actions-menu form {
    margin: 0;
  }

  .services-row-stack {
    display: grid;
    gap: 12px;
  }

  .service-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px;
    align-items: center;
    overflow: visible;
    border: 1px solid rgba(226,232,240,.88);
    border-radius: 26px;
    background: #fff;
    padding: 18px;
    box-shadow: 0 10px 32px rgba(255, 222, 212, .055);
    color: inherit;
    text-decoration: none;
    transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
  }

  .service-row:hover {
    transform: translateY(-2px);
    border-color: var(--admin-brand-200);
    box-shadow: 0 16px 36px rgba(255, 222, 212, .08);
  }

  .service-row.is-selected {
    border-color: var(--admin-brand-300, #ffded4);
    box-shadow: 0 0 0 4px rgba(255, 222, 212, .12), 0 16px 36px rgba(255, 222, 212, .08);
  }

  .service-row-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .service-row-link:focus-visible {
    outline: 3px solid var(--admin-brand-500);
    outline-offset: 3px;
  }

  .service-row-main {
    display: flex;
    min-width: 0;
    align-items: flex-start;
    gap: 16px;
  }

  .service-row-icon {
    display: grid;
    width: 56px;
    height: 56px;
    place-items: center;
    flex-shrink: 0;
    border: 1px solid var(--admin-brand-100);
    border-radius: 20px;
    background: linear-gradient(135deg, #fff, var(--admin-brand-50));
    color: var(--admin-brand-700);
  }

  .service-row-icon svg {
    width: 24px;
    height: 24px;
  }

  .service-row-copy {
    min-width: 0;
    flex: 1;
  }

  .service-row-heading {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .service-row-title {
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #0f172a;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -.02em;
  }

  .service-row-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 5px 9px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .04em;
    line-height: 1;
  }

  .service-row-badge.is-public {
    background: #ecfdf5;
    color: #047857;
  }

  .service-row-badge.is-link {
    background: var(--admin-brand-50);
    color: var(--admin-brand-700);
  }

  .service-row-badge.is-muted {
    background: #f1f5f9;
    color: #64748b;
  }

  .service-row-badge.is-no-deposit {
    background: #f1f5f9;
    color: #64748b;
  }

  .service-row-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 16px;
    margin: 10px 0 0;
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.35;
  }

  .service-row-meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .service-row-meta svg {
    width: 15px;
    height: 15px;
    color: #94a3b8;
  }

  .service-row-description {
    display: -webkit-box;
    max-width: 720px;
    margin: 12px 0 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: #64748b;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.55;
  }

  .service-row-side {
    position: relative;
    z-index: 2;
    display: grid;
    min-width: 150px;
    justify-items: end;
    gap: 12px;
    border-left: 1px solid #f1f5f9;
    padding-left: 18px;
  }

  .service-row-price-label {
    margin: 0;
    color: #94a3b8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
    text-align: right;
    text-transform: uppercase;
  }

  .service-row-price {
    margin: 2px 0 0;
    color: #0f172a;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -.03em;
    white-space: nowrap;
  }

  .service-row-actions {
    position: relative;
  }

  .service-row-actions[open] {
    z-index: 2147483300;
  }

  .service-row-menu {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #fff;
    color: #64748b;
    text-decoration: none;
    transition: .16s ease;
  }

  .service-row-menu:hover,
  .service-row-actions[open] .service-row-menu {
    border-color: var(--admin-brand-200);
    background: var(--admin-brand-50);
    color: var(--admin-brand-700);
  }

  .service-row-menu svg {
    width: 18px;
    height: 18px;
  }

  .services-summary-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 14px;
    border: 1px solid rgba(226,232,240,.78);
    border-radius: 20px;
    background: rgba(255,255,255,.72);
    padding: 12px 16px;
  }

  .services-summary-strip p {
    margin: 0;
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.45;
  }

  .services-summary-strip strong {
    color: #334155;
    font-weight: 700;
  }

  .services-summary-note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .services-summary-note svg {
    width: 16px;
    height: 16px;
    color: #94a3b8;
  }

  .services-empty {
    border: 1px dashed #cbd5e1;
    border-radius: 26px;
    background: #fff;
    padding: 52px 28px;
    text-align: center;
    box-shadow: 0 10px 32px rgba(255, 222, 212, .055);
  }

  .services-empty-icon {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    margin: 0 auto;
    border-radius: 20px;
    background: #f1f5f9;
    color: #64748b;
  }

  .services-empty-icon svg {
    width: 26px;
    height: 26px;
  }

  .services-empty h2 {
    margin: 16px 0 0;
    color: #0f172a;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -.03em;
  }

  .services-empty p {
    max-width: 440px;
    margin: 8px auto 0;
    color: #64748b;
    font-size: 14px;
    font-weight: 650;
    line-height: 1.55;
  }

  .services-modal {
    width: min(520px, calc(100vw - 32px));
    border: 0;
    border-radius: 28px;
    background: #fff;
    color: #0f172a;
    padding: 0;
    box-shadow: 0 28px 80px rgba(15,23,42,.24);
  }

  .services-modal[open] {
    position: fixed;
    top: 50%;
    left: 50%;
    margin: 0;
    transform: translate(-50%, -50%);
  }

  .services-extra-modal {
    width: min(680px, calc(100vw - 32px));
  }

  .services-extra-modal .services-modal-inner {
    padding: 34px;
  }

  .services-extra-modal textarea.services-category-input {
    height: 180px;
    padding: 14px 16px;
    line-height: 1.55;
    resize: vertical;
  }

  .services-modal::backdrop {
    background: rgba(15,23,42,.46);
    backdrop-filter: blur(4px);
  }

  .services-modal-inner {
    padding: 26px;
  }

  .services-modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .services-modal-title {
    margin: 0;
    color: #0f172a;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -.04em;
  }

  .services-modal-copy {
    margin: 8px 0 0;
    color: #64748b;
    font-size: 14px;
    font-weight: 650;
    line-height: 1.55;
  }

  .services-category-image-modal {
    width: min(980px, calc(100vw - 32px));
    max-height: min(860px, calc(100vh - 32px));
  }

  .services-category-image-modal .services-modal-inner {
    display: flex;
    max-height: inherit;
    flex-direction: column;
  }

  .services-category-image-preview-body {
    display: grid;
    min-height: 0;
    place-items: center;
    margin-top: 20px;
    overflow: hidden;
    border-radius: 20px;
    background: #f8fafc;
  }

  .services-category-image-preview-image {
    display: block;
    width: 100%;
    max-height: min(680px, calc(100vh - 180px));
    object-fit: contain;
  }

  .services-modal-close {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    flex-shrink: 0;
    border: 1px solid #e2e8f0;
    border-radius: 15px;
    background: #fff;
    color: #64748b;
    cursor: pointer;
  }

  .services-modal-close svg {
    width: 19px;
    height: 19px;
  }

  .services-modal-form {
    display: grid;
    gap: 12px;
    margin-top: 22px;
  }

  .services-category-input {
    box-sizing: border-box;
    width: 100%;
    height: 50px;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    background: #fff;
    color: #0f172a;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    outline: 0;
    padding: 0 16px;
  }

  .services-category-input:focus {
    border-color: var(--admin-brand-500);
    box-shadow: 0 0 0 4px rgba(255, 222, 212, .14);
  }

  .services-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 22px;
  }

  .services-modal-secondary,
  .services-modal-primary,
  .services-modal-danger {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    cursor: pointer;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    padding: 0 18px;
  }

  .services-modal-secondary {
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #334155;
  }

  .services-modal-primary {
    border: 0;
    background: #05080a;
    color: #fff;
  }

  .services-modal-danger {
    border: 0;
    background: #e11d48;
    color: #fff;
  }

  .services-category-delete-form {
    display: contents;
  }

  @media (max-width: 1180px) {
    .services-menu-container {
      width: calc(100% - 40px);
    }

    .services-layout {
      grid-template-columns: 1fr;
    }

    .services-category-panel {
      position: static;
      max-height: none;
    }

    .services-category-list {
      overflow-y: visible;
    }
  }

  @media (max-width: 760px) {
    .services-menu-container {
      width: calc(100% - 28px);
      padding-block: 24px 38px;
    }

    .services-menu-header,
    .services-toolbar-inner,
    .services-category-section-header,
    .services-summary-strip {
      align-items: stretch;
      flex-direction: column;
    }

    .services-menu-actions,
    .services-menu-primary,
    .services-search,
    .services-filter-button {
      width: 100%;
    }

    .service-row {
      grid-template-columns: 1fr;
      padding: 16px;
    }

    .service-row-main {
      gap: 13px;
    }

    .service-row-icon {
      width: 48px;
      height: 48px;
      border-radius: 18px;
    }

    .service-row-side {
      grid-template-columns: 1fr auto;
      align-items: center;
      justify-items: start;
      min-width: 0;
      border-left: 0;
      border-top: 1px solid #f1f5f9;
      padding: 14px 0 0;
    }

    .service-row-price-label,
    .service-row-price {
      text-align: left;
    }

    .service-row-actions {
      justify-self: end;
    }

    .service-row-actions-menu {
      right: 0;
    }

    .services-modal-actions {
      display: grid;
    }
  }
</style>

<div class="services-menu-shell" data-services-index>
  <div class="services-menu-container">
    <header class="services-menu-header">
      <div>
        <div class="services-menu-title-row">
          <h1 class="services-menu-title">Catálogo de servicios</h1>
          <span class="services-menu-count-pill">
            <%= service_icons.fetch(:sparkles).html_safe %>
            <%= pluralize(active_services_count, "servicio activo", plural: "servicios activos") %>
          </span>
        </div>
        <p class="services-menu-copy">
          Configurá los servicios que pueden reservar tus clientes, sus precios, duración, visibilidad y categoría.
          <span class="services-menu-link">Más información</span>
        </p>
      </div>

      <div class="services-menu-actions">
        <%= link_to new_admin_service_path(service_category_id: selected_category&.id), class: "services-menu-primary" do %>
          <%= service_icons.fetch(:plus).html_safe %>
          Añadir servicio
        <% end %>
      </div>
    </header>

    <section class="services-toolbar">
      <div class="services-toolbar-inner">
        <%= form_with url: admin_services_path, method: :get, class: "services-search-row", data: { services_search_form: true } do |form| %>
          <label class="services-search">
            <%= service_icons.fetch(:search).html_safe %>
            <%= form.search_field :q,
              value: @service_query.query,
              placeholder: "Buscar por nombre de servicio",
              autocomplete: "off",
              data: { services_search_input: true } %>
          </label>
          <% if selected_category.present? %>
            <%= hidden_field_tag :service_category_id, selected_category.id %>
          <% end %>
        <% end %>

        <button type="button" class="services-filter-button" data-services-filter-button>
          <%= service_icons.fetch(:sliders).html_safe %>
          Filtros
        </button>
      </div>
    </section>

    <section class="services-layout">
      <aside class="services-category-panel" aria-label="Categorías de servicios">
        <div class="services-category-panel-header">
          <div>
            <h2 class="services-category-title">Categorías</h2>
            <p class="services-category-subtitle">Organizá tu menú</p>
          </div>
          <button type="button" class="services-category-icon-button" data-services-add-category-open aria-label="Añadir categoría">
            <%= service_icons.fetch(:plus).html_safe %>
          </button>
        </div>

        <div class="services-category-list">
          <%= link_to admin_services_path, class: "services-category-link #{selected_category.blank? ? "is-active" : ""}" do %>
            <span class="services-category-link-icon"><%= service_icons.fetch(:grid).html_safe %></span>
            <span class="services-category-link-label">Todas las categorías</span>
            <span class="services-category-count"><%= all_services_count %></span>
          <% end %>

          <% visible_categories.each do |category| %>
            <% active = selected_category_id == category.id.to_s %>
            <% category_count = services_count_by_category_id.fetch(category.id, 0) %>
            <%= link_to admin_services_path(service_category_id: category.id), class: "services-category-link #{active ? "is-active" : ""}" do %>
              <%= render "admin/services/category_icon", category: category, fallback_icon: service_icons.fetch(:folder), css_class: "services-category-link-icon" %>
              <span class="services-category-link-label"><%= render "admin/services/category_sidebar_name", category: category %></span>
              <span class="services-category-count"><%= category_count %></span>
            <% end %>
          <% end %>
        </div>

        <div class="services-add-category-footer">
          <button type="button" class="services-add-category-button" data-services-add-category-open>
            <%= service_icons.fetch(:folder_plus).html_safe %>
            Añadir categoría
          </button>
          <%= link_to admin_services_path(panel: "extras"), class: "services-add-category-button mt-3 #{'is-active' if @show_extras}" do %>
            <%= service_icons.fetch(:sparkles).html_safe %>
            Extras
          <% end %>
        </div>
      </aside>

      <div class="services-content">
        <% if @show_extras %>
          <section class="services-category-section">
            <div class="services-category-section-header">
              <div class="services-category-title-block"><span class="services-category-heading-icon"><%= service_icons.fetch(:sparkles).html_safe %></span><div><h2 class="services-category-heading">Extras</h2><p class="services-category-section-count"><%= pluralize(@extras.size, "extra disponible", plural: "extras disponibles") %></p></div></div>
              <button type="button" class="services-menu-primary" data-services-add-extra-open>+ Añadir Extra</button>
            </div>
            <div class="services-row-stack">
              <% @extras.each do |extra| %>
                <article class="service-row" data-services-edit-extra data-extra-id="<%= extra.id %>" data-extra-title="<%= extra.title %>" data-extra-description="<%= extra.description %>" data-extra-price="<%= extra.price.to_i %>" data-extra-public-visible="<%= extra.public_visible? %>"><button type="button" class="service-row-link" aria-label="Editar <%= extra.title %>"><span class="sr-only">Editar</span></button><div class="service-row-main"><div class="service-row-icon"><%= service_icons.fetch(:sparkles).html_safe %></div><div class="service-row-copy"><div class="service-row-heading"><h3 class="service-row-title"><%= extra.title %></h3><span class="service-row-badge <%= extra.public_visible? ? 'is-public' : 'is-muted' %>"><%= extra.public_visible? ? 'Visible en reservas' : 'Oculto' %></span></div><p class="service-row-description"><%= extra.description.presence || 'Sin descripción cargada.' %></p></div></div><div class="service-row-side"><p class="service-row-price"><%= price_cents_label(extra.price_cents) %></p></div></article>
              <% end %>
            </div>
            <% if @extras.empty? %><section class="services-empty"><h2>No hay extras para mostrar</h2><p>Creá un adicional para ofrecerlo al momento de reservar.</p></section><% end %>
          </section>
        <% else %>
        <% if selected_category.present? && @services.empty? %>
          <section class="services-category-section">
            <div class="services-category-section-header">
              <div class="services-category-title-block">
                <%= render "admin/services/category_icon", category: selected_category, fallback_icon: service_icons.fetch(:folder), css_class: "services-category-heading-icon" %>
                <div class="min-w-0">
                  <%= render "admin/services/category_heading_editor", category: selected_category %>
                  <p class="services-category-section-count">0 servicios disponibles</p>
                </div>
              </div>
            </div>
          </section>
        <% end %>

        <% if @services.any? %>
          <% grouped_category_names.each do |category_name| %>
            <% services = @services_by_category_name.fetch(category_name, []) %>
            <% next if services.blank? %>
            <% category = visible_categories.find { |row| row.name == category_name } %>

            <section class="services-category-section" data-services-category-section>
              <div class="services-category-section-header">
                <div class="services-category-title-block">
                  <% if category.present? %>
                    <%= render "admin/services/category_icon", category: category, fallback_icon: service_icons.fetch(:folder), css_class: "services-category-heading-icon" %>
                  <% else %>
                    <span class="services-category-heading-icon"><%= service_icons.fetch(:folder).html_safe %></span>
                  <% end %>
                  <div class="min-w-0">
                    <% if category.present? %>
                      <%= render "admin/services/category_heading_editor", category: category %>
                    <% else %>
                      <h2 class="services-category-heading"><%= category_name %></h2>
                    <% end %>
                    <p class="services-category-section-count"><%= pluralize(services.size, "servicio disponible", plural: "servicios disponibles") %></p>
                  </div>
                </div>

                <% if category.present? %>
                  <details class="services-category-actions" data-services-category-actions>
                    <summary class="services-small-button">
                      Acciones
                      <%= service_icons.fetch(:chevron_down).html_safe %>
                    </summary>
                    <div class="services-category-menu">
                      <%= link_to new_admin_service_path(service_category_id: category.id), class: "services-category-menu-item" do %>
                        <%= service_icons.fetch(:plus).html_safe %>
                        Agregar servicio
                      <% end %>
                    </div>
                  </details>
                <% end %>
              </div>

              <div class="services-row-stack">
                <% services.each do |service| %>
                  <% service_search_text = service.name %>
                  <% public_state_label = service_public_state_label(service) %>
                  <% public_state_class = if service.public?
                    "is-public"
                  elsif service.link_only?
                    "is-link"
                  else
                    "is-muted"
                  end %>
                  <% service_price_label = @show_financials ? service.display_price.sub("Sin precio", "$0") : public_state_label %>
                  <article class="service-row <%= "is-selected" if selected_service_id == service.id.to_s %>"
                           data-services-service-row
                           data-services-search="<%= service_search_text %>">
                    <%= link_to edit_admin_service_path(service), class: "service-row-link", aria: { label: "Editar #{service.name}" } do %>
                      <span class="sr-only">Editar <%= service.name %></span>
                    <% end %>

                    <div class="service-row-main">
                      <div class="service-row-icon"><%= service_icons.fetch(:sparkles).html_safe %></div>
                      <div class="service-row-copy">
                        <div class="service-row-heading">
                          <h3 class="service-row-title"><%= service.name.presence || "Servicio sin nombre" %></h3>
                          <span class="service-row-badge <%= public_state_class %>"><%= public_state_label %></span>
                          <% if service.deposit_required? %>
                            <span class="service-row-badge is-link">Seña: <%= service_money(service.expected_deposit_amount_cents) %></span>
                          <% else %>
                            <span class="service-row-badge is-no-deposit">No requiere seña</span>
                          <% end %>
                        </div>

                        <p class="service-row-meta">
                          <span><%= service_icons.fetch(:clock).html_safe %><%= service_duration_label(service.duration_minutes) %></span>
                          <span><%= service_icons.fetch(:folder).html_safe %><%= service.service_category&.name.presence || service.category_label %></span>
                          <span><%= service_icons.fetch(:users).html_safe %><%= service_team_label(service, @business) %></span>
                        </p>

                        <% if service.description.present? %>
                          <p class="service-row-description"><%= service.description %></p>
                        <% else %>
                          <p class="service-row-description">Sin descripción cargada.</p>
                        <% end %>
                      </div>
                    </div>

                    <div class="service-row-side">
                      <div>
                        <p class="service-row-price-label"><%= @show_financials ? "Precio" : "Estado" %></p>
                        <p class="service-row-price"><%= service_price_label %></p>
                      </div>

                      <details class="service-row-actions" data-service-row-actions>
                        <summary class="service-row-menu" aria-label="Acciones para <%= service.name %>" title="Acciones">
                          <%= service_icons.fetch(:more).html_safe %>
                        </summary>
                        <div class="service-row-actions-menu">
                          <%= link_to edit_admin_service_path(service), class: "service-row-action" do %>
                            <%= service_icons.fetch(:pencil).html_safe %>
                            Editar
                          <% end %>
                          <%= button_to duplicate_admin_service_path(service), method: :post, form: { class: "contents" }, class: "service-row-action" do %>
                            <%= service_icons.fetch(:copy).html_safe %>
                            Duplicar
                          <% end %>
                          <%= link_to short_public_service_path(service.business.slug, service.slug), target: "_blank", rel: "noopener", class: "service-row-action" do %>
                            <%= service_icons.fetch(:eye).html_safe %>
                            Enlace de reserva rápida
                          <% end %>
                          <%= button_to admin_service_path(service), method: :delete, form: { class: "contents", data: { turbo_confirm: "¿Querés archivar este servicio?" } }, class: "service-row-action" do %>
                            <%= service_icons.fetch(:archive).html_safe %>
                            Archivar
                          <% end %>
                          <%= button_to permanently_destroy_admin_service_path(service), method: :delete, form: { class: "contents", data: { turbo_confirm: "¿Eliminar este servicio permanentemente? Esta acción no se puede deshacer." } }, class: "service-row-action is-danger" do %>
                            <%= service_icons.fetch(:trash).html_safe %>
                            Eliminar permanentemente
                          <% end %>
                        </div>
                      </details>
                    </div>
                  </article>
                <% end %>
              </div>

            </section>
          <% end %>

          <section id="services-search-empty" class="services-empty" hidden>
            <span class="services-empty-icon"><%= service_icons.fetch(:search_x).html_safe %></span>
            <h2>No encontramos servicios</h2>
            <p>Probá buscar con otro nombre o limpiá la búsqueda.</p>
            <button type="button" class="services-small-button mt-5" data-services-clear-search>Limpiar búsqueda</button>
          </section>

          <div class="services-summary-strip">
            <p>Mostrando <strong data-services-visible-count><%= visible_services_count %></strong> de <%= visible_services_count %> servicios en esta vista.</p>
            <p class="services-summary-note"><%= service_icons.fetch(:eye).html_safe %>Los servicios públicos aparecen en la página de reservas.</p>
          </div>
        <% else %>
          <section class="services-empty">
            <span class="services-empty-icon"><%= service_icons.fetch(:folder_plus).html_safe %></span>
            <h2>No hay servicios para mostrar</h2>
            <p>Creá un servicio o limpiá la búsqueda actual.</p>
            <%= link_to new_admin_service_path(service_category_id: selected_category&.id), class: "services-menu-primary mt-5" do %>
              <%= service_icons.fetch(:plus).html_safe %>
              Añadir servicio
            <% end %>
          </section>
        <% end %>
        <% end %>
      </div>
    </section>
  </div>

  <% visible_categories.each do |category| %>
    <% category_service_count = category.services.size %>
    <% category_pack_count = @service_pack_counts_by_category_id.fetch(category.id, 0) %>

    <dialog id="service-category-delete-modal-<%= category.id %>" class="services-modal services-category-modal">
      <div class="services-modal-inner">
        <div class="services-modal-header">
          <div>
            <h2 class="services-modal-title">Eliminar categoría permanentemente</h2>
            <p class="services-modal-copy">
              <% if category_service_count.positive? || category_pack_count.positive? %>
                Se eliminarán <%= pluralize(category_service_count, "servicio", plural: "servicios") %> y <%= pluralize(category_pack_count, "paquete", plural: "paquetes") %> vinculados a esta categoría.
              <% else %>
                Esta categoría no tiene servicios vinculados.
              <% end %>
              Esta acción no se puede deshacer.
            </p>
          </div>
          <button type="button" class="services-modal-close" data-service-category-modal-close aria-label="Cerrar">
            <%= service_icons.fetch(:x).html_safe %>
          </button>
        </div>

        <div class="services-modal-actions">
          <button type="button" class="services-modal-secondary" data-service-category-modal-close>Cancelar</button>
          <%= button_to "Eliminar categoría", admin_service_category_path(category), method: :delete, form: { class: "services-category-delete-form" }, class: "services-modal-danger" %>
        </div>
      </div>
    </dialog>
  <% end %>

  <dialog id="services-add-category-modal" class="services-modal">
    <div class="services-modal-inner">
      <div class="services-modal-header">
        <div>
          <h2 class="services-modal-title">Añadir categoría</h2>
          <p class="services-modal-copy">Agrupá servicios similares para que tus clientes encuentren más rápido lo que quieren reservar.</p>
        </div>
        <button type="button" class="services-modal-close" data-services-add-category-close aria-label="Cerrar">
          <%= service_icons.fetch(:x).html_safe %>
        </button>
      </div>

      <%= form_with model: [ :admin, ServiceCategory.new ], class: "services-modal-form" do |form| %>
        <%= form.text_field :name, required: true, placeholder: "Nombre de categoría", class: "services-category-input", data: { services_add_category_input: true } %>
        <label class="services-category-image-field">
          Imagen para Web Completa <span class="services-category-image-help">Opcional · se mostrará en las tarjetas de categorías.</span>
          <%= form.file_field :cover_image, accept: "image/png,image/jpeg,image/webp" %>
        </label>
        <div class="services-modal-actions">
          <button type="button" class="services-modal-secondary" data-services-add-category-close>Cancelar</button>
          <%= form.submit "Crear categoría", class: "services-modal-primary" %>
        </div>
      <% end %>
    </div>
  </dialog>

  <dialog id="services-add-extra-modal" class="services-modal services-extra-modal">
    <div class="services-modal-inner"><div class="services-modal-header"><div><h2 class="services-modal-title" data-services-extra-modal-title>Añadir Extra</h2><p class="services-modal-copy">Los extras se pueden sumar a un servicio y no agregan duración ni seña.</p></div><button type="button" class="services-modal-close" data-services-add-extra-close aria-label="Cerrar"><%= service_icons.fetch(:x).html_safe %></button></div>
      <%= form_with url: admin_service_extras_path, method: :post, class: "services-modal-form", data: { services_extra_form: true } do |form| %>
        <%= form.text_field :title, required: true, placeholder: "Ej. Corte de uñas", class: "services-category-input", name: "extra[title]", data: { services_extra_field: true } %>
        <%= form.text_area :description, rows: 3, placeholder: "Descripción", class: "services-category-input", name: "extra[description]", data: { services_extra_field: true } %>
        <label class="text-sm font-bold text-zinc-700">Precio</label><div class="services-category-input flex items-center gap-3"><span class="text-lg font-bold text-zinc-500">$</span><%= form.text_field :price, inputmode: "numeric", pattern: "[0-9]*", autocomplete: "off", required: true, placeholder: "Ej. 30000", class: "min-w-0 flex-1 bg-transparent font-semibold outline-none", name: "extra[price]", data: { services_extra_field: true } %></div>
        <label class="text-sm font-bold text-zinc-700"><%= form.check_box :public_visible, name: "extra[public_visible]", data: { services_extra_field: true } %> Visible en la página de reservas</label>
        <%= form.hidden_field :active, value: true, name: "extra[active]" %><div class="services-modal-actions"><button type="button" class="services-modal-secondary" data-services-add-extra-close>Cerrar</button><%= form.submit "Crear extra", class: "services-modal-primary", data: { services_extra_submit: true } %></div>
      <% end %>
    </div>
  </dialog>

  <dialog id="services-category-image-preview-modal" class="services-modal services-category-image-modal">
    <div class="services-modal-inner">
      <div class="services-modal-header">
        <div>
          <h2 class="services-modal-title" data-category-image-preview-title>Imagen de categoría</h2>
          <p class="services-modal-copy">Vista ampliada de la imagen de portada.</p>
        </div>
        <button type="button" class="services-modal-close" data-category-image-preview-close aria-label="Cerrar imagen ampliada">
          <%= service_icons.fetch(:x).html_safe %>
        </button>
      </div>
      <div class="services-category-image-preview-body">
        <img class="services-category-image-preview-image" data-category-image-preview-image alt="">
      </div>
    </div>
  </dialog>
</div>

<script>
  (() => {
    const root = document.querySelector("[data-services-index]");
    if (!root) return;

    const form = root.querySelector("[data-services-search-form]");
    const input = root.querySelector("[data-services-search-input]");
    const sections = Array.from(root.querySelectorAll("[data-services-category-section]"));
    const emptyState = root.querySelector("#services-search-empty");
    const visibleCountTarget = root.querySelector("[data-services-visible-count]");
    const selectedRow = root.querySelector(".service-row.is-selected");
    const categoryImagePreviewDialog = root.querySelector("#services-category-image-preview-modal");
    const categoryImagePreviewImage = categoryImagePreviewDialog?.querySelector("[data-category-image-preview-image]");
    const categoryImagePreviewTitle = categoryImagePreviewDialog?.querySelector("[data-category-image-preview-title]");
    const extraDialog = root.querySelector("#services-add-extra-modal");
    const extraForm = extraDialog?.querySelector("[data-services-extra-form]");
    const extraTitle = extraDialog?.querySelector("[name='extra[title]']");
    const extraDescription = extraDialog?.querySelector("[name='extra[description]']");
    const extraPrice = extraDialog?.querySelector("[name='extra[price]']");
    const extraVisible = extraDialog?.querySelector("input[type='checkbox'][name='extra[public_visible]']");
    const extraSubmit = extraDialog?.querySelector("[data-services-extra-submit]");
    const extraModalTitle = extraDialog?.querySelector("[data-services-extra-modal-title]");
    let extraInitial = "";
    const extraState = () => JSON.stringify([extraTitle?.value, extraDescription?.value, extraPrice?.value, extraVisible?.checked]);
    const updateExtraSubmit = () => { if (extraSubmit) extraSubmit.hidden = extraInitial && extraState() === extraInitial; };
    const openExtraDialog = (row = null) => {
      if (!extraDialog || !extraForm) return;
      if (row) {
        extraModalTitle.textContent = "Editar Extra";
        extraForm.action = `/admin/servicios/extras/${row.dataset.extraId}`;
        extraForm.querySelector("input[name='_method']")?.remove();
        extraForm.insertAdjacentHTML("beforeend", '<input type="hidden" name="_method" value="patch">');
        extraTitle.value = row.dataset.extraTitle || ""; extraDescription.value = row.dataset.extraDescription || ""; extraPrice.value = row.dataset.extraPrice || ""; extraVisible.checked = row.dataset.extraPublicVisible === "true";
        extraSubmit.value = "Guardar";
      } else {
        extraModalTitle.textContent = "Añadir Extra"; extraForm.action = "<%= admin_service_extras_path %>";
        extraForm.querySelector("input[name='_method']")?.remove(); extraForm.reset(); extraSubmit.value = "Crear extra";
      }
      extraInitial = row ? extraState() : ""; updateExtraSubmit(); extraDialog.showModal(); extraTitle.focus();
    };
    extraDialog?.querySelectorAll("[data-services-extra-field]").forEach((field) => field.addEventListener("input", updateExtraSubmit));
    extraDialog?.querySelectorAll("[data-services-extra-field]").forEach((field) => field.addEventListener("change", updateExtraSubmit));
    const normalize = (value) => value.toString().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();

    const actionMenus = () => Array.from(root.querySelectorAll("[data-services-category-actions], [data-service-row-actions]"));
    const closeActionMenus = (except = null) => {
      actionMenus().forEach((menu) => {
        if (menu !== except) menu.removeAttribute("open");
      });
    };

    const openCategoryImagePreview = (trigger) => {
      if (!categoryImagePreviewDialog || !categoryImagePreviewImage) return;

      const name = trigger.dataset.categoryImagePreviewName || "Categoría";
      const imageUrl = trigger.dataset.categoryImagePreviewUrl;
      if (!imageUrl) return;

      categoryImagePreviewImage.src = imageUrl;
      categoryImagePreviewImage.alt = `Imagen de ${name}`;
      if (categoryImagePreviewTitle) categoryImagePreviewTitle.textContent = name;
      categoryImagePreviewDialog.showModal();
    };

    const applyLocalSearch = () => {
      if (!input) return;

      const query = normalize(input.value);
      let visibleCount = 0;

      sections.forEach((section) => {
        let sectionHasMatches = false;
        const rows = Array.from(section.querySelectorAll("[data-services-service-row]"));

        rows.forEach((row) => {
          const matches = query.length === 0 || normalize(row.dataset.servicesSearch || row.textContent || "").includes(query);
          row.hidden = !matches;

          if (matches) {
            visibleCount += 1;
            sectionHasMatches = true;
          }
        });

        section.hidden = !sectionHasMatches;
      });

      if (emptyState) {
        emptyState.hidden = query.length === 0 || visibleCount > 0;
      }

      if (visibleCountTarget) {
        visibleCountTarget.textContent = visibleCount;
      }
    };

    if (form) {
      form.addEventListener("submit", (event) => event.preventDefault());
    }

    if (input) {
      input.addEventListener("input", applyLocalSearch);
      input.addEventListener("search", applyLocalSearch);
      applyLocalSearch();
    }

    root.addEventListener("change", (event) => {
      const categoryImageInput = event.target.closest("[data-category-image-input]");
      if (!categoryImageInput?.files?.length) return;

      categoryImageInput.closest("[data-category-image-form]")?.requestSubmit();
    });

    root.querySelectorAll("[data-services-clear-search]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!input) return;
        input.value = "";
        applyLocalSearch();
        input.focus();
      });
    });

    if (selectedRow) {
      requestAnimationFrame(() => {
        selectedRow.scrollIntoView({ block: "center", behavior: "smooth" });
      });
    }

    root.addEventListener("click", (event) => {
      const categoryImagePreviewTrigger = event.target.closest("[data-category-image-preview]");
      if (categoryImagePreviewTrigger) {
        event.preventDefault();
        event.stopPropagation();
        openCategoryImagePreview(categoryImagePreviewTrigger);
        return;
      }

      const summary = event.target.closest("[data-services-category-actions] summary, [data-service-row-actions] summary");
      if (summary) {
        const details = summary.closest("[data-services-category-actions], [data-service-row-actions]");
        const willOpen = !details.open;
        closeActionMenus(details);
        if (!willOpen) return;
        return;
      }

      const inlineEditButton = event.target.closest("[data-category-inline-edit]");
      if (inlineEditButton) {
        event.preventDefault();
        closeActionMenus();
        const editor = inlineEditButton.closest("[data-category-inline-editor]");
        const inlineInput = editor?.querySelector("[data-category-inline-input]");
        if (!editor || !inlineInput) return;

        inlineInput.value = editor.dataset.categoryInlineCurrentName || inlineInput.value;
        editor.classList.add("is-editing");
        requestAnimationFrame(() => {
          inlineInput.focus();
          inlineInput.select();
        });
        return;
      }

      const inlineCancelButton = event.target.closest("[data-category-inline-cancel]");
      if (inlineCancelButton) {
        event.preventDefault();
        const editor = inlineCancelButton.closest("[data-category-inline-editor]");
        const inlineInput = editor?.querySelector("[data-category-inline-input]");
        if (!editor || !inlineInput) return;

        inlineInput.value = editor.dataset.categoryInlineCurrentName || "";
        editor.classList.remove("is-editing");
        return;
      }

      const modalTrigger = event.target.closest("[data-service-category-modal]");
      if (modalTrigger) {
        event.preventDefault();
        closeActionMenus();
        const dialog = document.getElementById(modalTrigger.dataset.serviceCategoryModal);
        if (dialog) dialog.showModal();
        return;
      }

      const deleteModalClose = event.target.closest("[data-service-category-modal-close]");
      if (deleteModalClose) {
        const dialog = deleteModalClose.closest("dialog");
        if (dialog) dialog.close();
        return;
      }

      const categoryImagePreviewClose = event.target.closest("[data-category-image-preview-close]");
      if (categoryImagePreviewClose) {
        categoryImagePreviewDialog?.close();
        return;
      }

      const addCategoryOpen = event.target.closest("[data-services-add-category-open]");
      if (addCategoryOpen) {
        event.preventDefault();
        closeActionMenus();
        const dialog = root.querySelector("#services-add-category-modal");
        const categoryInput = dialog?.querySelector("[data-services-add-category-input]");
        if (!dialog) return;
        dialog.showModal();
        requestAnimationFrame(() => categoryInput?.focus());
        return;
      }

      const addCategoryClose = event.target.closest("[data-services-add-category-close]");
      if (addCategoryClose) {
        const dialog = addCategoryClose.closest("dialog");
        if (dialog) dialog.close();
        return;
      }

      const addExtraOpen = event.target.closest("[data-services-add-extra-open]");
      if (addExtraOpen) {
        event.preventDefault();
        openExtraDialog();
        return;
      }

      const editExtra = event.target.closest("[data-services-edit-extra]");
      if (editExtra) {
        event.preventDefault();
        openExtraDialog(editExtra);
        return;
      }

      const addExtraClose = event.target.closest("[data-services-add-extra-close]");
      if (addExtraClose) {
        addExtraClose.closest("dialog")?.close();
        return;
      }

      if (event.target.closest("[data-services-filter-button]")) {
        event.preventDefault();
        if (input) input.focus();
      }
    });

    root.querySelectorAll(".services-modal").forEach((dialog) => {
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    });

    document.addEventListener("click", (event) => {
      if (!event.target.closest("[data-services-category-actions], [data-service-row-actions]")) {
        closeActionMenus();
      }
    });

    document.addEventListener("keydown", (event) => {
      const categoryImagePreviewTrigger = event.target.closest?.("[data-category-image-preview]");
      if (categoryImagePreviewTrigger && [ "Enter", " " ].includes(event.key)) {
        event.preventDefault();
        openCategoryImagePreview(categoryImagePreviewTrigger);
        return;
      }

      if (event.key === "Escape") closeActionMenus();
    });
  })();
</script>
