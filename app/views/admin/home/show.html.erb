<%= turbo_stream_from(*LiveStreams.admin_appointments(@business)) %>

<section class="admin-home" data-admin-home data-controller="home-appointments">
  <div class="admin-home-topbar">
    <div>
      <span class="admin-home-health"><%= dashboard.status_label %></span>
      <h1 class="admin-home-title">Buen día, <%= dashboard.greeting_name %>.</h1>
      <p class="admin-home-subtitle"><%= dashboard.hero_intro_copy %>.</p>
    </div>

    <div class="admin-home-actions">
      <%= link_to admin_calendar_path, class: "admin-home-button", data: { turbo_frame: "_top" } do %>
        <%= icons.fetch(:calendar).html_safe %>
        Abrir calendario
      <% end %>
      <%= link_to admin_calendar_path, class: "admin-home-dark-button", data: { turbo_frame: "_top" } do %>
        <%= icons.fetch(:plus).html_safe %>
        Nuevo turno
      <% end %>
    </div>
  </div>

  <section class="admin-home-summary">
    <div class="admin-home-summary-grid">
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <span class="admin-home-pill"><%= icons.fetch(:sparkles).html_safe %> Resumen de Cita.pet</span>
          <span class="admin-home-updated">Actualizado ahora</span>
        </div>

        <p class="admin-home-kicker"><%= dashboard.opportunity_summary_kicker %></p>
        <h2 class="admin-home-summary-title"><%= dashboard.opportunity_summary_title %></h2>
        <p class="admin-home-summary-copy"><%= dashboard.opportunity_summary_copy %></p>

        <div class="admin-home-hero-actions">
          <%= link_to admin_calendar_path(date: dashboard.date.iso8601), class: "admin-home-primary-hero-button", data: { turbo_frame: "_top" } do %>
            Abrir calendario
            <%= icons.fetch(:arrow).html_safe %>
          <% end %>
          <button type="button" class="admin-home-secondary-hero-button" data-admin-home-refresh>
            Actualizar
            <%= icons.fetch(:refresh).html_safe %>
          </button>
        </div>
      </div>

      <% summary_metrics = dashboard.opportunity_summary_metrics %>
      <div class="admin-home-summary-metrics">
        <% summary_metrics.first(2).each do |metric| %>
          <article class="admin-home-summary-metric">
            <p class="admin-home-summary-label"><%= metric.label %></p>
            <p class="admin-home-summary-value"><%= metric.value %></p>
            <p class="admin-home-summary-hint"><%= metric.hint %></p>
          </article>
        <% end %>

        <% summary_metric = summary_metrics.last %>
        <article class="admin-home-summary-metric admin-home-summary-metric-wide">
          <div class="admin-home-summary-wide-row">
            <div>
              <p class="admin-home-summary-label" style="color: var(--brand-600);"><%= summary_metric.label %></p>
              <p class="admin-home-summary-value" style="color: var(--brand-900);"><%= summary_metric.value %></p>
              <p class="admin-home-summary-hint" style="color: var(--brand-700);"><%= summary_metric.hint %></p>
            </div>
            <span class="admin-home-summary-icon"><%= icons.fetch(summary_metric.label == "Próximo hueco" ? :calendar : :dollar).html_safe %></span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <div class="admin-home-main-grid">
    <section class="admin-home-panel"
      data-controller="customers-results-loader"
      data-customers-results-loader-frame-id-value="home_upcoming_appointments"
      data-customers-results-loader-preserve-scroll-value="true"
      data-action="turbo:before-fetch-request->customers-results-loader#start turbo:frame-load->customers-results-loader#stop turbo:fetch-request-error->customers-results-loader#stop">
      <div class="admin-home-panel-header">
        <div>
          <h2 class="admin-home-panel-title">Próximos turnos</h2>
          <p class="admin-home-section-copy">Los próximos turnos agendados.</p>
        </div>
        <%= link_to "Ver calendario", admin_calendar_path, class: "admin-home-panel-link", data: { turbo_frame: "_top" } %>
      </div>

      <%= render "admin/home/upcoming_appointments",
        dashboard: dashboard,
        upcoming_appointments: @upcoming_appointments,
        upcoming_appointments_pagy: @upcoming_appointments_pagy,
        icons: icons %>

      <span class="admin-results-loader" data-customers-results-loader-target="indicator" aria-hidden="true">
        <span class="admin-results-loader-ring"></span>
      </span>
    </section>

  </div>

  <section class="admin-home-assistant-strip">
    <span class="admin-home-assistant-icon"><%= icons.fetch(:sparkles).html_safe %></span>
    <div>
      <p class="text-xs font-bold uppercase tracking-[.14em] text-brand-700">Resumen diario</p>
      <h2 class="mt-1 text-xl font-bold tracking-tight text-slate-950">Revisá las prioridades de hoy.</h2>
      <p class="mt-1 text-sm font-bold leading-6 text-slate-500">Consultá turnos, clientes y pendientes operativos de <%= @business.name %>.</p>
    </div>
    <%= link_to admin_calendar_path, class: "admin-home-dark-button" do %>
      Ver calendario
      <%= icons.fetch(:arrow).html_safe %>
    <% end %>
  </section>

  <div class="admin-home-appointment-overlay" data-home-appointments-target="overlay" data-action="click->home-appointments#close"></div>
  <aside class="admin-home-appointment-drawer" data-home-appointments-target="drawer" aria-hidden="true">
    <button type="button" class="admin-home-icon-button" style="position:absolute;right:20px;top:18px;z-index:1" data-action="click->home-appointments#close" aria-label="Cerrar detalle del turno">
      <%= icons.fetch(:x).html_safe %>
    </button>
    <div class="admin-home-appointment-drawer-content" data-home-appointments-target="content"></div>
  </aside>
</section>

<script>
  (() => {
    function bindAdminHome() {
      const root = document.querySelector("[data-admin-home]");
      if (!root || root.dataset.adminHomeReady === "true") return;

      root.dataset.adminHomeReady = "true";

      root.querySelector("[data-admin-home-refresh]")?.addEventListener("click", event => {
        const button = event.currentTarget;
        button.style.opacity = ".65";
        setTimeout(() => window.location.reload(), 220);
      });
    }

    document.addEventListener("turbo:load", bindAdminHome);
    bindAdminHome();
  })();
</script>
