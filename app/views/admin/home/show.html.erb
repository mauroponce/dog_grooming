<style>
  .admin-home {
    --brand-50: #fff8f6;
    --brand-100: #ffede8;
    --brand-200: #ffded4;
    --brand-300: #ffc4b2;
    --brand-500: #e96d4d;
    --brand-600: #bf482f;
    --brand-700: #a63826;
    --brand-900: #69251c;
    --ink: #0f172a;
    display: grid;
    gap: 24px;
  }

  .admin-home svg {
    width: 1em;
    height: 1em;
  }

  .admin-home-topbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }

  .admin-home-health {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #008768;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .admin-home-health::before {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #10b981;
    box-shadow: 0 0 0 7px rgba(16, 185, 129, .13);
    content: "";
  }

  .admin-home-title {
    margin: 12px 0 0;
    color: #071014;
    font-size: clamp(30px, 3.2vw, 42px);
    font-weight: 700;
    letter-spacing: -.05em;
    line-height: 1.04;
  }

  .admin-home-subtitle {
    margin-top: 8px;
    max-width: 720px;
    color: #64748b;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.6;
  }

  .admin-home-actions,
  .admin-home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .admin-home-actions {
    justify-content: flex-end;
  }

  .admin-home-button,
  .admin-home-dark-button,
  .admin-home-link-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border-radius: 16px;
    padding: 0 16px;
    border: 1px solid rgba(226, 232, 240, .95);
    background: #fff;
    color: #0f172a;
    font-size: 14px;
    font-weight: 700;
    box-shadow: 0 10px 24px rgba(15, 23, 42, .06);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease, background-color .18s ease, color .18s ease;
  }

  .admin-home-button:hover,
  .admin-home-link-button:hover {
    transform: translateY(-1px);
    border-color: rgba(255, 222, 212, .35);
    color: var(--brand-700);
    box-shadow: 0 18px 38px rgba(15, 23, 42, .1);
  }

  .admin-home-dark-button {
    border-color: #071014;
    background: #071014;
    color: #fff;
  }

  .admin-home-dark-button:hover {
    transform: translateY(-1px);
    background: var(--brand-700);
  }

  .admin-home-summary {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(226, 232, 240, .88);
    border-radius: 30px;
    background:
      radial-gradient(circle at 100% 0%, rgba(255, 222, 212, .48), transparent 22rem),
      linear-gradient(180deg, #ffffff 0%, #fdfcff 100%);
    padding: 26px;
    box-shadow: 0 20px 60px rgba(255, 222, 212, .07);
  }

  .admin-home-summary::after {
    position: absolute;
    right: -95px;
    bottom: -125px;
    width: 280px;
    height: 280px;
    border-radius: 999px;
    background: rgba(255, 222, 212, .055);
    pointer-events: none;
    content: "";
  }

  .admin-home-summary-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr);
    gap: 30px;
    align-items: center;
  }

  .admin-home-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--brand-200);
    border-radius: 999px;
    background: var(--brand-50);
    padding: 7px 11px;
    color: var(--brand-700);
    font-size: 12px;
    font-weight: 700;
  }

  .admin-home-updated {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 700;
  }

  .admin-home-updated::before {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #10b981;
    box-shadow: 0 0 0 5px rgba(16, 185, 129, .14);
    content: "";
  }

  .admin-home-kicker {
    margin-top: 24px;
    color: var(--brand-700);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .admin-home-summary-title {
    margin: 8px 0 0;
    max-width: 780px;
    color: #071014;
    font-size: clamp(25px, 2.6vw, 34px);
    font-weight: 700;
    letter-spacing: -.055em;
    line-height: 1.1;
  }

  .admin-home-summary-copy {
    margin-top: 12px;
    max-width: 740px;
    color: #64748b;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.65;
  }

  .admin-home-hero-actions {
    margin-top: 24px;
  }

  .admin-home-primary-hero-button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border-radius: 16px;
    border: 0;
    background: var(--brand-600);
    color: #fff;
    padding: 0 18px;
    font-size: 14px;
    font-weight: 700;
    box-shadow: 0 18px 36px rgba(255, 222, 212, .16);
    transition: transform .18s ease, background-color .18s ease;
  }

  .admin-home-primary-hero-button:hover {
    transform: translateY(-1px);
    background: var(--brand-700);
  }

  .admin-home-secondary-hero-button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border-radius: 16px;
    border: 1px solid var(--brand-200);
    background: #fff;
    color: var(--brand-700);
    padding: 0 18px;
    font-size: 14px;
    font-weight: 700;
    transition: transform .18s ease, background-color .18s ease;
  }

  .admin-home-secondary-hero-button:hover {
    transform: translateY(-1px);
    background: var(--brand-50);
  }

  .admin-home-summary-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 13px;
  }

  .admin-home-summary-metric {
    min-height: 112px;
    border: 1px solid #e2e8f0;
    border-radius: 23px;
    background: #fff;
    padding: 17px;
  }

  .admin-home-summary-metric-wide {
    grid-column: 1 / -1;
    background: rgba(255, 222, 212, .72);
    border-color: var(--brand-100);
  }

  .admin-home-summary-label {
    color: #94a3b8;
    font-size: 12px;
    font-weight: 700;
  }

  .admin-home-summary-value {
    margin-top: 9px;
    color: #071014;
    font-size: 31px;
    font-weight: 700;
    letter-spacing: -.045em;
  }

  .admin-home-summary-hint {
    margin-top: 4px;
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
  }

  .admin-home-summary-wide-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
  }

  .admin-home-summary-icon {
    display: inline-flex;
    width: 46px;
    height: 46px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background: #fff;
    color: var(--brand-700);
    box-shadow: 0 10px 24px rgba(255, 222, 212, .06);
  }

  .admin-home-panel,
  .admin-home-assistant-strip {
    border: 1px solid rgba(226, 232, 240, .88);
    background: rgba(255, 255, 255, .94);
    box-shadow: 0 12px 36px rgba(255, 222, 212, .055);
  }

  .admin-home-action-icon {
    display: inline-flex;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    font-size: 20px;
  }

  .admin-home-tone-violet { background: #ffded4; color: #A63826; }
  .admin-home-tone-amber { background: #fff7e6; color: #b45309; }
  .admin-home-tone-emerald { background: #eafff6; color: #008768; }
  .admin-home-tone-blue { background: #eff6ff; color: #2563eb; }
  .admin-home-tone-pink { background: #fdf2f8; color: #be185d; }
  .admin-home-tone-rose { background: #fff1f2; color: #e11d48; }

  .admin-home-section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }

  .admin-home-section-kicker {
    color: var(--brand-700);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .admin-home-section-title {
    margin-top: 8px;
    color: #071014;
    font-size: 25px;
    font-weight: 700;
    letter-spacing: -.045em;
  }

  .admin-home-section-copy {
    margin-top: 5px;
    color: #64748b;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.45;
  }

  .admin-home-panel-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 14px;
    padding: 9px 11px;
    color: var(--brand-700);
    font-size: 13px;
    font-weight: 700;
    transition: background-color .18s ease;
  }

  .admin-home-panel-link:hover {
    background: var(--brand-50);
  }

  .admin-home-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .admin-home-card-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .admin-home-card-title {
    color: #071014;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -.03em;
  }

  .admin-home-card-meta {
    margin-top: 5px;
    color: #334155;
    font-size: 14px;
    font-weight: 700;
  }

  .admin-home-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 5px 8px;
    background: #ecfdf5;
    color: #047857;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .admin-home-card-dismiss {
    display: inline-flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 13px;
    background: transparent;
    color: #94a3b8;
    cursor: pointer;
    transition: background-color .18s ease, color .18s ease;
  }

  .admin-home-card-dismiss:hover {
    background: #f1f5f9;
    color: #334155;
  }

  .admin-home-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .admin-home-mini-label {
    color: #94a3b8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .admin-home-chip {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: #f1f5f9;
    padding: 6px 10px;
    color: #475569;
    font-size: 10px;
    font-weight: 700;
  }

  .admin-home-candidates-box {
    margin-top: 18px;
    border-radius: 18px;
    border: 1px solid var(--brand-100);
    background: rgba(255, 222, 212, .72);
    padding: 15px;
  }

  .admin-home-candidates-title {
    color: var(--brand-900);
    font-size: 14px;
    font-weight: 700;
  }

  .admin-home-candidates-copy {
    margin-top: 4px;
    color: var(--brand-700);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
  }

  .admin-home-opportunity-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 18px;
  }

  .admin-home-opportunity-empty {
    display: grid;
    place-items: center;
    gap: 16px;
    min-height: 260px;
    border: 1px dashed #d8dce6;
    border-radius: 28px;
    background: rgba(255, 255, 255, .8);
    padding: 34px;
    text-align: center;
  }

  .admin-home-empty-icon {
    display: inline-flex;
    width: 62px;
    height: 62px;
    align-items: center;
    justify-content: center;
    border-radius: 22px;
    background: var(--brand-50);
    color: var(--brand-700);
    font-size: 28px;
  }

  .admin-home-main-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
    align-items: start;
  }

  .admin-home-panel {
    overflow: hidden;
    border-radius: 28px;
  }

  .admin-home-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    border-bottom: 1px solid #eef2f7;
    padding: 20px 22px;
  }

  .admin-home-panel-title {
    color: #071014;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -.04em;
  }

  .admin-home-list {
    display: grid;
  }

  .admin-home-upcoming-table-wrap {
    overflow-x: auto;
  }

  .admin-home-upcoming-table {
    border-collapse: collapse;
    min-width: 720px;
    width: 100%;
  }

  .admin-home-upcoming-table th {
    border-bottom: 1px solid #eef2f7;
    color: #94a3b8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
    padding: 13px 22px;
    text-align: left;
    text-transform: uppercase;
  }

  .admin-home-upcoming-table td {
    border-bottom: 1px solid #eef2f7;
    padding: 14px 22px;
    vertical-align: middle;
  }

  .admin-home-upcoming-row {
    cursor: pointer;
    outline: none;
    transition: background-color .18s ease;
  }

  .admin-home-upcoming-row:hover,
  .admin-home-upcoming-row:focus-visible {
    background: #ffded4;
  }

  .admin-home-upcoming-row:focus-visible {
    box-shadow: inset 3px 0 0 var(--brand-600);
  }

  .admin-home-upcoming-professional {
    color: #475569;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }

  .admin-home-upcoming-footer {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: space-between;
    padding: 16px 22px;
  }

  .admin-home-upcoming-footer > p {
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
  }

  .admin-home-upcoming-pagination {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .admin-home-upcoming-page {
    align-items: center;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    color: #475569;
    display: inline-flex;
    font-size: 12px;
    font-weight: 700;
    height: 34px;
    justify-content: center;
    min-width: 34px;
    padding: 0 10px;
    text-decoration: none;
  }

  .admin-home-upcoming-page:not(.is-disabled):not(.is-current):hover {
    border-color: var(--brand-300);
    color: var(--brand-700);
  }

  .admin-home-upcoming-page.is-current {
    border-color: var(--brand-600);
    background: var(--brand-600);
    color: #fff;
  }

  .admin-home-upcoming-page.is-disabled {
    color: #cbd5e1;
  }

  .admin-home-appointment {
    display: flex;
    gap: 16px;
    align-items: center;
    border-bottom: 1px solid #eef2f7;
    padding: 18px 22px;
    transition: background-color .18s ease, transform .18s ease;
  }

  .admin-home-appointment:last-child {
    border-bottom: 0;
  }

  .admin-home-appointment:hover {
    background: #ffded4;
    transform: translateX(2px);
  }

  .admin-home-time {
    display: grid;
    min-width: 72px;
    min-height: 54px;
    place-items: center;
    border-radius: 17px;
    background: var(--brand-50);
    color: var(--brand-700);
    font-weight: 700;
    line-height: 1.1;
    padding: 8px;
    text-align: center;
  }

  .admin-home-time-day {
    font-size: 11px;
  }

  .admin-home-time-hour {
    font-size: 14px;
  }

  .admin-home-appointment-service {
    color: #0f172a;
    font-size: 16px;
    font-weight: 700;
  }

