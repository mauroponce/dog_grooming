  .admin-sidebar-business,
  .admin-sidebar-ai-title,
  .admin-sidebar-ai-status,
  .admin-sidebar-plan-title,
  .admin-sidebar-plan-copy,
  .admin-sidebar-ai-status { display: block; }

  .admin-sidebar-product {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -.025em;
    white-space: nowrap;
  }

