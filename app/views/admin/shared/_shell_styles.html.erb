    max-width: 170px;
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    transition:
      max-width .24s ease,
      opacity .15s ease,
      transform .24s ease,
      visibility .15s ease;
  }

  .admin-main-sidebar.is-collapsed .admin-sidebar-collapsible-content {
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-8px);
