  }

  body:has(.admin-impersonation-bar) .admin-shell-app {
    --admin-impersonation-offset: 37px;
  }

  .admin-shell-app > aside {
    position: relative;
    z-index: 2147483645;
    overflow: visible;
  }

  .admin-shell-content {
    min-height: 0;
    flex: 1;
    overflow-y: auto;
    background: #f7f7f8;
  }

  .admin-shell-content-inner {
    width: min(var(--admin-content-max-width), calc(100% - var(--admin-content-horizontal-space)));
