    top: 0;
    right: 0;
    z-index: 2147483600;
    display: flex;
    width: min(560px, calc(100vw - 24px));
    height: 100dvh;
    flex-direction: column;
    overflow: hidden;
    border-left: 1px solid rgba(226,232,240,.9);
    background: #fff;
    box-shadow: -24px 0 70px rgba(15,23,42,.18);
    transform: translateX(110%);
