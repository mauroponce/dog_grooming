    transition: width .24s cubic-bezier(.22, .61, .36, 1);
  }

  .admin-main-sidebar.is-collapsed {
    width: var(--admin-sidebar-collapsed);
  }

  .admin-sidebar-brand {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 48px;
  }

  .admin-sidebar-logo-link {
    display: flex;
