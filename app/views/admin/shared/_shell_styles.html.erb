    background: transparent;
    padding: 0;
    box-shadow: none;
  }

  .admin-main-sidebar.is-collapsed .admin-sidebar-plan-row {
    justify-content: center;
  }

  .admin-main-sidebar.is-collapsed .admin-sidebar-plan-icon {
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }

  .admin-sidebar-tooltip {
    position: fixed;
    z-index: 2147483647;
    max-width: 230px;
    padding: 9px 12px;
    border-radius: 11px;
    color: #fff;
    background: var(--admin-slate-900);
    box-shadow: 0 12px 30px rgba(15, 23, 42, .18);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.25;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-5px, -50%) scale(.98);
    transition:
      opacity .13s ease,
      transform .13s ease,
      visibility .13s ease;
  }

  .admin-sidebar-tooltip.visible {
    opacity: 1;
    visibility: visible;
    transform: translate(0, -50%) scale(1);
  }

  .admin-sidebar-tooltip::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -5px;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--admin-slate-900);
    transform: translateY(-50%) rotate(45deg);
  }

  @media (max-height: 760px) {
    .admin-sidebar-product {
      font-size: 15px;
    }

    .admin-sidebar-logo {
      width: 38px;
      height: 38px;
      border-radius: 14px;
