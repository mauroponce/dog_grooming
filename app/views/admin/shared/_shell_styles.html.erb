    color: var(--admin-slate-600);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    text-align: left;
    transition:
      color .18s ease,
      background-color .18s ease,
      box-shadow .18s ease,
      transform .18s ease;
  }

  .admin-sidebar-link:hover {
