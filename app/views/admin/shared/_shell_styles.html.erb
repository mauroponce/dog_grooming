    min-width: 0;
    flex: 1 1 auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .admin-sidebar-badge {
    display: grid;
    flex: 0 0 auto;
    min-width: 21px;
    height: 21px;
    margin-left: auto;
    place-items: center;
    border-radius: 999px;
    background: var(--admin-slate-100);
    padding: 0 6px;
    color: var(--admin-slate-500);
    font-size: 10px;
    font-weight: 700;
    transition:
      top .2s ease,
      right .2s ease,
      width .2s ease,
      height .2s ease,
      font-size .2s ease;
  }

  .admin-sidebar-link.is-active .admin-sidebar-badge {
    background: #fff;
    color: var(--admin-brand-700);
    box-shadow: 0 4px 12px rgba(255, 222, 212, .07);
  }

