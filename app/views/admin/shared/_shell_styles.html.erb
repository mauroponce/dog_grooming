    height: 38px;
    place-items: center;
    border: 1px solid var(--admin-brand-100);
    border-radius: 13px;
    background: #fff;
    color: var(--admin-brand-700);
    box-shadow: 0 4px 12px rgba(255, 222, 212, .06);
  }

  .admin-sidebar-plan-title {
    margin: 0;
    color: var(--admin-slate-900);
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }

  .admin-sidebar-plan-copy {
    display: block;
    margin-top: 4px;
    color: var(--admin-slate-500);
    font-size: 10px;
    font-weight: 700;
    white-space: nowrap;
  }

  .admin-sidebar-plan-button {
