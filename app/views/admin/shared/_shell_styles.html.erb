    .admin-sidebar-link-icon svg,
    .admin-sidebar-ai-icon svg,
    .admin-sidebar-plan-icon svg {
      width: 18px;
      height: 18px;
    }

    .admin-sidebar-eyebrow {
      margin-bottom: 6px;
    }

    .admin-sidebar-ai-icon,
    .admin-sidebar-plan-icon {
      width: 32px;
      height: 32px;
      border-radius: 13px;
    }
  }

  @media (max-height: 680px) {
    .admin-sidebar-plan-copy {
      display: none;
    }

    .admin-sidebar-ai-status {
      margin-top: 2px;
      padding-block: 1px;
    }
  }

  .admin-shell-header {
    position: relative;
    z-index: 2147483000;
    padding-left: 28px !important;
    padding-right: 28px !important;
    background:
      linear-gradient(90deg, rgba(255,255,255,.72), rgba(255,255,255,.52)),
      radial-gradient(circle at 78% 0%, rgba(255, 222, 212, .24), transparent 26rem) !important;
    border-color: rgba(255,255,255,.82) !important;
    box-shadow: 0 1px 0 rgba(255,255,255,.65), 0 12px 36px rgba(255, 222, 212, .04);
    backdrop-filter: blur(22px) saturate(150%);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
  }

  .admin-mobile-menu-button {
    display: none;
  }

  .admin-header-date {
    color: #94a3b8;
    font-size: 12px;
    font-weight: 700;
  }

  .admin-header-title {
    color: #334155;
    font-size: 14px;
    font-weight: 700;
  }

  .admin-header-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    background: #fff;
    padding: 0 16px;
    color: #334155;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(15,23,42,.04);
    transition: .16s ease;
  }

  .admin-header-action:hover {
    border-color: var(--admin-brand-200);
    color: var(--admin-brand-700);
    transform: translateY(-1px);
  }

  .admin-header-action svg {
    width: 16px;
    height: 16px;
  }

