    box-shadow: 0 1px 2px rgba(15,23,42,.04);
    transition: .16s ease;
  }

  .admin-mobile-sidebar-backdrop {
    position: fixed;
    inset: var(--admin-impersonation-offset, 0px) 0 0;
    z-index: 2147483400;
    background: rgba(15, 23, 42, .38);
    opacity: 0;
    transition: opacity .18s ease;
  }

  .admin-mobile-sidebar-backdrop.is-open {
    opacity: 1;
  }

  .admin-mobile-sidebar-backdrop[hidden] {
    display: none !important;
  }

  html.admin-mobile-menu-open,
  html.admin-mobile-menu-open body {
    overflow: hidden;
  }

  .admin-header-icon-button:hover,
  .admin-header-icon-button[aria-expanded="true"] {
    border-color: var(--admin-brand-200);
    color: var(--admin-brand-700);
    transform: translateY(-1px);
  }

  .admin-shell-header button svg {
    width: 20px;
    height: 20px;
  }

  .admin-profile-dropdown {
    z-index: 2147483646;
  }

  .admin-notifications-backdrop {
    position: fixed;
    inset: 0;
    z-index: 2147483500;
    background: rgba(15,23,42,.18);
    opacity: 0;
    transition: opacity .18s ease;
  }

