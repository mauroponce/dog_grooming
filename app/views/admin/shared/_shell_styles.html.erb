    --admin-sidebar-collapsed: 78px;
    --admin-sidebar-width: var(--admin-sidebar-expanded);
    --sidebar-width: var(--admin-sidebar-width);
    --topbar-height: 76px;
    --toolbar-height: 58px;
    --resource-height: 104px;
    --slot-height: 56px;
    --time-col-width: 70px;
    --admin-content-max-width: 1600px;
    --admin-content-horizontal-space: 48px;
    --admin-brand-50: #ffded4;
    --admin-brand-100: #ffded4;
    --admin-brand-200: #ffded4;
    --admin-brand-500: #ffded4;
    --admin-brand-600: #ffded4;
    --admin-brand-700: #ffded4;
    --admin-slate-50: #f8fafc;
    --admin-slate-100: #f1f5f9;
    --admin-slate-200: #e2e8f0;
    --admin-slate-300: #cbd5e1;
    --admin-slate-400: #94a3b8;
