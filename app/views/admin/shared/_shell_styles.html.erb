  }

  .admin-notifications-eyebrow {
    margin: 0 0 6px;
    color: var(--admin-brand-700);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .admin-notifications-header h2 {
