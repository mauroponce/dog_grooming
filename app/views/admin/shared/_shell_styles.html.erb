  .admin-main-sidebar {
    position: relative;
    z-index: 2147483645;
    display: flex;
    width: var(--admin-sidebar-width);
    height: 100%;
    min-height: 0;
    flex-shrink: 0;
    flex-direction: column;
    border-right: 1px solid rgba(226, 232, 240, .85);
    background: rgba(255, 255, 255, .98);
