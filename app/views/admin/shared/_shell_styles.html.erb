    border-radius: 12px;
    background: #fff;
    color: var(--admin-brand-700);
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(255, 222, 212, .05);
    transition:
