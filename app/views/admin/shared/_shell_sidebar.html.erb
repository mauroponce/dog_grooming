<% business_policy = policy(@business) %>
<% nav_items = [] %>
<% nav_items << { label: "Calendario", path: admin_calendar_path, controllers: %w[calendar appointments availability_blocks], icon: :calendar } if business_policy.appointments? %>
<% nav_items << { label: "Servicios", path: admin_services_path, controllers: %w[services service_categories], icon: :book, badge: @business.services_count.to_i } if business_policy.services? %>
<% nav_items << { label: "Clientes", path: admin_customer_profiles_path, controllers: %w[customer_profiles client_notes customer_reminders], icon: :users, badge: @business.customer_profiles.count } if business_policy.customers? %>
<% nav_items << { label: "Equipo", path: admin_employee_memberships_path, controllers: %w[employee_memberships], icon: :contact, badge: @business.employee_memberships_count.to_i } if business_policy.employees? %>
<% nav_items << { label: "Configuración", path: admin_settings_path, controllers: %w[settings], icon: :cog } if business_policy.settings? %>
<% nav_items << { label: "Tutoriales", path: admin_tutorials_path, controllers: %w[tutorials], icon: :book } if business_policy.tutorials? %>
<% active_link = ->(entry) { Array(entry[:controllers]).include?(controller_name) || current_page?(entry[:path]) } %>
<% icons = {
  chevron_left: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 18-6-6 6-6" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  x: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/></svg>',
  dashboard: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="7" height="8" rx="2" stroke="currentColor" stroke-width="2"/><rect x="14" y="3" width="7" height="5" rx="2" stroke="currentColor" stroke-width="2"/><rect x="14" y="12" width="7" height="9" rx="2" stroke="currentColor" stroke-width="2"/><rect x="3" y="15" width="7" height="6" rx="2" stroke="currentColor" stroke-width="2"/></svg>',
  calendar: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 2v4M16 2v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><rect x="3" y="4" width="18" height="18" rx="3" stroke="currentColor" stroke-width="2"/><path d="M3 10h18" stroke="currentColor" stroke-width="2"/><path d="M8 15h.01M12 15h.01M16 15h.01" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>',
  book: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M8 6h8M8 10h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  users: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="9.5" cy="7" r="4" stroke="currentColor" stroke-width="2"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  contact: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="9.5" cy="7" r="4" stroke="currentColor" stroke-width="2"/><path d="M19 8v6M16 11h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  cog: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.04.04a2.05 2.05 0 0 1-2.9 2.9l-.04-.04a1.7 1.7 0 0 0-1.88-.34 1.7 1.7 0 0 0-1.03 1.56V21a2.05 2.05 0 0 1-4.1 0v-.06a1.7 1.7 0 0 0-1.03-1.56 1.7 1.7 0 0 0-1.88.34l-.04.04a2.05 2.05 0 0 1-2.9-2.9l.04-.04A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.56-1.03H3a2.05 2.05 0 0 1 0-4.1h.06A1.7 1.7 0 0 0 4.6 8.8a1.7 1.7 0 0 0-.34-1.88l-.04-.04a2.05 2.05 0 0 1 2.9-2.9l.04.04A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1.03-1.56V3a2.05 2.05 0 0 1 4.1 0v.06A1.7 1.7 0 0 0 15.2 4.6a1.7 1.7 0 0 0 1.88-.34l.04-.04a2.05 2.05 0 0 1 2.9 2.9l-.04.04A1.7 1.7 0 0 0 19.4 9c.13.53.54.94 1.07 1.03H21a2.05 2.05 0 0 1 0 4.1h-.06A1.7 1.7 0 0 0 19.4 15Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  bot: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 8V4M8 4h8M6 10h12a3 3 0 0 1 3 3v4a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-4a3 3 0 0 1 3-3Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M9 15h.01M15 15h.01" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>',
  sparkles: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 9.8 8.8 4 11l5.8 2.2L12 19l2.2-5.8L20 11l-5.8-2.2L12 3ZM5 3v4M3 5h4M19 17v4M17 19h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>'
} %>

<aside id="admin-main-sidebar" class="admin-main-sidebar" data-admin-sidebar aria-label="Navegación principal">
  <div class="admin-sidebar-brand">
    <%= link_to(business_policy.dashboard? ? admin_home_path : admin_calendar_path, class: "admin-sidebar-logo-link", data: { admin_sidebar_tooltip_source: true, tooltip: "Cita.pet · #{@business.name}" }) do %>
      <span class="admin-sidebar-logo">
        <%= image_tag "/icon.png?v=4", alt: "", class: "admin-sidebar-logo-image" %>
      </span>
      <span class="admin-sidebar-brand-copy admin-sidebar-collapsible-content">
        <span class="admin-sidebar-product">Cita.pet</span>
        <span class="admin-sidebar-business"><%= @business.name %></span>
      </span>
    <% end %>

    <button type="button" class="admin-sidebar-collapse-button" data-admin-sidebar-collapse aria-label="Colapsar barra lateral" aria-expanded="true">
      <%= icons.fetch(:chevron_left).html_safe %>
    </button>

    <button type="button" class="admin-sidebar-mobile-close" data-admin-mobile-menu-close aria-label="Cerrar menú">
      <%= icons.fetch(:x).html_safe %>
    </button>
  </div>

  <nav class="admin-sidebar-nav">
    <% nav_items.each do |entry| %>
      <%= link_to entry[:path],
        class: "admin-sidebar-link #{'is-active' if active_link.call(entry)}",
        data: { admin_sidebar_tooltip_source: true, tooltip: entry[:label] },
        aria: { label: entry[:label], current: active_link.call(entry) ? "page" : nil } do %>
        <span class="admin-sidebar-link-icon"><%= icons.fetch(entry[:icon]).html_safe %></span>
        <span class="admin-sidebar-link-label admin-sidebar-collapsible-content"><%= entry[:label] %></span>
        <% if entry[:badge].present? %>
          <span class="admin-sidebar-badge"><%= entry[:badge] %></span>
        <% end %>
      <% end %>
    <% end %>
  </nav>

</aside>

<div class="admin-mobile-sidebar-backdrop" data-admin-mobile-sidebar-backdrop hidden></div>
<div class="admin-sidebar-tooltip" data-admin-sidebar-tooltip role="tooltip"></div>

<script>
  (() => {
    const storageKey = "dog-grooming-sidebar-collapsed-v2";
    const desktopQuery = window.matchMedia("(min-width: 1024px)");
    let tooltipTimeout = null;

    function sidebar() {
      return document.querySelector("[data-admin-sidebar]");
    }

    function collapseButton() {
      return document.querySelector("[data-admin-sidebar-collapse]");
    }

    function mobileToggleButton() {
      return document.querySelector("[data-admin-mobile-menu-toggle]");
    }

    function mobileCloseButton() {
      return document.querySelector("[data-admin-mobile-menu-close]");
    }

    function mobileBackdrop() {
      return document.querySelector("[data-admin-mobile-sidebar-backdrop]");
    }

    function tooltip() {
      return document.querySelector("[data-admin-sidebar-tooltip]");
    }

    function isDesktop() {
      return desktopQuery.matches;
    }

    function savedCollapsed() {
      try {
        return window.localStorage.getItem(storageKey) === "1";
      } catch (_) {
        return false;
      }
    }

    function persistCollapsed(collapsed) {
      try {
        window.localStorage.setItem(storageKey, collapsed ? "1" : "0");
      } catch (_) {
        // La sidebar sigue funcionando si localStorage no está disponible.
      }
    }

    function syncSidebarWidthVariable(collapsed) {
      if (!isDesktop()) {
        document.documentElement.style.setProperty("--admin-sidebar-width", "0px");
        document.documentElement.style.setProperty("--sidebar-width", "0px");
        return;
      }

      document.documentElement.style.setProperty("--admin-sidebar-width", collapsed ? "78px" : "248px");
      document.documentElement.style.setProperty("--sidebar-width", collapsed ? "78px" : "248px");
    }

    function hideTooltip() {
      window.clearTimeout(tooltipTimeout);
      tooltip()?.classList.remove("visible");
    }

    function setCollapsed(collapsed, persist = true) {
      const currentSidebar = sidebar();
      const currentButton = collapseButton();
      if (!currentSidebar || !currentButton) return;

      if (!isDesktop()) {
        currentSidebar.classList.remove("is-collapsed");
        currentButton.setAttribute("aria-expanded", "true");
        syncSidebarWidthVariable(false);
        return;
      }

      currentSidebar.classList.toggle("is-collapsed", collapsed);
      currentButton.setAttribute("aria-expanded", String(!collapsed));
      currentButton.setAttribute("aria-label", collapsed ? "Expandir barra lateral" : "Colapsar barra lateral");
      syncSidebarWidthVariable(collapsed);
      hideTooltip();

      if (persist) persistCollapsed(collapsed);
    }

    function setMobileOpen(open) {
      const currentSidebar = sidebar();
      const currentToggle = mobileToggleButton();
      const currentBackdrop = mobileBackdrop();
      const shouldOpen = open && !isDesktop();
      if (!currentSidebar || !currentToggle || !currentBackdrop) return;

      currentSidebar.classList.toggle("is-mobile-open", shouldOpen);
      currentToggle.setAttribute("aria-expanded", String(shouldOpen));
      currentToggle.setAttribute("aria-label", shouldOpen ? "Cerrar menú de administración" : "Abrir menú de administración");
      document.documentElement.classList.toggle("admin-mobile-menu-open", shouldOpen);

      if (shouldOpen) {
        currentBackdrop.hidden = false;
        requestAnimationFrame(() => currentBackdrop.classList.add("is-open"));
      } else {
        currentBackdrop.classList.remove("is-open");
        window.setTimeout(() => {
          if (!currentBackdrop.classList.contains("is-open")) currentBackdrop.hidden = true;
        }, 180);
      }
    }

    function showTooltip(target) {
      const currentSidebar = sidebar();
      const currentTooltip = tooltip();
      if (!currentSidebar || !currentTooltip) return;
      if (!isDesktop() || !currentSidebar.classList.contains("is-collapsed")) return;

      const label = target.getAttribute("data-tooltip");
      if (!label) return;

      window.clearTimeout(tooltipTimeout);
      tooltipTimeout = window.setTimeout(() => {
        const rect = target.getBoundingClientRect();
        currentTooltip.textContent = label;
        currentTooltip.style.left = `${Math.round(rect.right + 13)}px`;
        currentTooltip.style.top = `${Math.round(rect.top + rect.height / 2)}px`;
        currentTooltip.classList.add("visible");
      }, 120);
    }

    function bindSidebar() {
      const currentSidebar = sidebar();
      const currentButton = collapseButton();
      if (!currentSidebar || !currentButton) return;

      if (currentSidebar.dataset.adminSidebarReady !== "true") {
        currentSidebar.dataset.adminSidebarReady = "true";

        currentButton.addEventListener("click", (event) => {
          event.preventDefault();
          event.stopPropagation();
          setCollapsed(!currentSidebar.classList.contains("is-collapsed"));
        });

        mobileCloseButton()?.addEventListener("click", (event) => {
          event.preventDefault();
          setMobileOpen(false);
        });

        currentSidebar.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setMobileOpen(false));
        });

        document.querySelectorAll("[data-admin-sidebar-tooltip-source]").forEach((element) => {
          element.addEventListener("mouseenter", () => showTooltip(element));
          element.addEventListener("mouseleave", hideTooltip);
          element.addEventListener("focus", () => showTooltip(element));
          element.addEventListener("blur", hideTooltip);
        });

        setCollapsed(savedCollapsed(), false);
      }

      const currentMobileToggle = mobileToggleButton();
      if (currentMobileToggle && currentMobileToggle.dataset.adminMobileMenuReady !== "true") {
        currentMobileToggle.dataset.adminMobileMenuReady = "true";
        currentMobileToggle.addEventListener("click", (event) => {
          event.preventDefault();
          event.stopPropagation();
          setMobileOpen(!currentSidebar.classList.contains("is-mobile-open"));
        });
      }

      const currentBackdrop = mobileBackdrop();
      if (currentBackdrop && currentBackdrop.dataset.adminMobileBackdropReady !== "true") {
        currentBackdrop.dataset.adminMobileBackdropReady = "true";
        currentBackdrop.addEventListener("click", () => setMobileOpen(false));
      }
    }

    if (!window.AdminSidebarDesktopListenerBound) {
      window.AdminSidebarDesktopListenerBound = true;
      desktopQuery.addEventListener("change", () => {
        hideTooltip();
        setMobileOpen(false);
        setCollapsed(savedCollapsed(), false);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          hideTooltip();
          setMobileOpen(false);
        }
      });
    }

    if (!window.AdminSidebarTurboListenerBound) {
      window.AdminSidebarTurboListenerBound = true;
      document.addEventListener("turbo:load", bindSidebar);
    }

    if (!window.AdminSidebarDomListenerBound) {
      window.AdminSidebarDomListenerBound = true;
      document.addEventListener("DOMContentLoaded", bindSidebar);
    }

    bindSidebar();
  })();
</script>
