<%= form_with model: [ :admin, employee ], class: "rounded-lg border border-zinc-200 bg-white p-5 shadow-sm sm:p-6" do |form| %>
  <% if employee.errors.any? %>
    <div class="mb-5 rounded-lg border border-rose-200 bg-rose-50 p-4 text-sm font-semibold text-rose-800">
      <%= employee.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid gap-5 md:grid-cols-2">
    <div>
      <%= form.label :first_name, "Nombre", class: "mb-2 block text-sm font-bold text-zinc-800" %>
      <%= form.text_field :first_name, required: true, class: "h-12 w-full rounded-lg border border-zinc-200 bg-white px-4 text-sm font-semibold outline-none transition focus:border-brand-400 focus:ring-4 focus:ring-brand-100" %>
    </div>
    <div>
      <%= form.label :last_name, "Apellido", class: "mb-2 block text-sm font-bold text-zinc-800" %>
      <%= form.text_field :last_name, required: true, class: "h-12 w-full rounded-lg border border-zinc-200 bg-white px-4 text-sm font-semibold outline-none transition focus:border-brand-400 focus:ring-4 focus:ring-brand-100" %>
    </div>
    <div>
      <%= form.label :email_address, "Correo electrónico", class: "mb-2 block text-sm font-bold text-zinc-800" %>
      <%= form.email_field :email_address, required: true, class: "h-12 w-full rounded-lg border border-zinc-200 bg-white px-4 text-sm font-semibold outline-none transition focus:border-brand-400 focus:ring-4 focus:ring-brand-100" %>
    </div>
    <div>
      <%= form.label :phone, "Teléfono", class: "mb-2 block text-sm font-bold text-zinc-800" %>
      <%= form.telephone_field :phone, class: "h-12 w-full rounded-lg border border-zinc-200 bg-white px-4 text-sm font-semibold outline-none transition focus:border-brand-400 focus:ring-4 focus:ring-brand-100" %>
    </div>
  </div>

  <fieldset class="mt-6 rounded-lg border border-zinc-200 bg-zinc-50 p-4">
    <legend class="px-1 text-sm font-bold text-zinc-950">Color del calendario</legend>
    <div class="mt-3 flex flex-wrap gap-3">
      <% EmployeeMembership::CALENDAR_COLORS.each do |color, label| %>
        <label class="grid h-10 w-10 cursor-pointer place-items-center rounded-full bg-white" title="<%= label %>">
          <%= form.radio_button :calendar_color, color, checked: (employee.calendar_color.presence || EmployeeMembership::CALENDAR_COLORS.keys.first) == color, class: "peer sr-only" %>
          <span class="h-8 w-8 rounded-full ring-2 ring-transparent transition peer-checked:ring-zinc-950 peer-checked:ring-offset-2" style="background-color: <%= color %>"></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="mt-6 rounded-lg border border-zinc-200 bg-zinc-50 p-4">
    <p class="text-sm font-bold text-zinc-950">Permisos</p>
    <div class="mt-3 grid gap-2 md:grid-cols-2">
      <% EmployeeMembership::PERMISSIONS.each do |key, label| %>
        <label class="flex items-center gap-3 rounded-lg border border-zinc-200 bg-white px-4 py-3 text-sm font-bold text-zinc-700">
          <%= check_box_tag "employee_membership[permission_keys][]", key, employee.permission_keys.include?(key), class: "h-4 w-4 rounded border-zinc-300 text-brand-600 focus:ring-brand-500" %>
          <%= label %>
        </label>
      <% end %>
    </div>
  </div>

  <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-between">
    <%= link_to "Volver", admin_employee_memberships_path, class: "inline-flex h-11 items-center justify-center rounded-lg border border-zinc-200 bg-white px-4 text-sm font-bold text-zinc-700 hover:bg-zinc-50" %>
    <%= form.submit employee.persisted? ? "Guardar permisos" : "Enviar invitación", class: "inline-flex h-11 cursor-pointer items-center justify-center rounded-lg bg-zinc-950 px-4 text-sm font-bold text-white shadow-lg shadow-zinc-900/15 transition hover:-translate-y-0.5 hover:bg-zinc-800" %>
  </div>
<% end %>
