<section class="mx-auto max-w-2xl p-6">
  <%= link_to "← Volver al equipo", admin_employee_memberships_path, class: "text-sm font-bold text-zinc-600" %>
  <h1 class="mt-5 text-3xl font-bold text-zinc-950"><%= employee.persisted? ? "Editar integrante" : "Invitar integrante" %></h1>
  <p class="mt-2 text-zinc-600">Las personas invitadas pueden gestionar turnos, clientes, mascotas y señas. La configuración queda a cargo del administrador.</p>

  <%= form_with model: [ :admin, employee ], class: "mt-6 space-y-5 rounded-xl border border-zinc-200 bg-white p-6 shadow-sm" do |form| %>
    <% if employee.errors.any? %>
      <p class="rounded-lg bg-rose-50 p-3 text-sm font-semibold text-rose-700"><%= employee.errors.full_messages.to_sentence %></p>
    <% end %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><%= form.label :first_name, "Nombre", class: "mb-1 block text-sm font-bold" %><%= form.text_field :first_name, required: true, class: "w-full rounded-lg border-zinc-300" %></div>
      <div><%= form.label :last_name, "Apellido", class: "mb-1 block text-sm font-bold" %><%= form.text_field :last_name, required: true, class: "w-full rounded-lg border-zinc-300" %></div>
    </div>
    <div><%= form.label :email_address, "Correo electrónico", class: "mb-1 block text-sm font-bold" %><%= form.email_field :email_address, required: true, class: "w-full rounded-lg border-zinc-300" %></div>
    <div><%= form.label :phone, "Teléfono", class: "mb-1 block text-sm font-bold" %><%= form.telephone_field :phone, class: "w-full rounded-lg border-zinc-300" %></div>
    <%= form.submit employee.persisted? ? "Guardar" : "Enviar invitación", class: "rounded-lg bg-zinc-950 px-4 py-2 font-bold text-white" %>
  <% end %>
</section>
