<% content_for :title, "Rangos de mascota" %>

<div class="mx-auto max-w-4xl px-4 py-8 sm:px-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm font-bold text-brand-700">Configuración de servicios</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-950">Rangos por peso</h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-zinc-600">Estos rangos se comparten entre todos los servicios. Cambiar sus nombres o límites no modifica los precios cargados.</p>
    </div>
    <%= link_to "Volver a servicios", admin_services_path, class: "inline-flex h-11 items-center rounded-full border border-zinc-200 bg-white px-5 text-sm font-bold text-zinc-950" %>
  </div>

  <%= form_with url: admin_pet_size_bands_path, method: :patch, class: "mt-8 space-y-4" do %>
    <% @pet_size_bands.each do |band| %>
      <section class="grid gap-4 rounded-2xl border border-zinc-200 bg-white p-5 sm:grid-cols-3">
        <div>
          <%= label_tag "pet_size_bands_#{band.id}_name", "Nombre", class: "mb-2 block text-sm font-bold" %>
          <%= text_field_tag "pet_size_bands[#{band.id}][name]", band.name, id: "pet_size_bands_#{band.id}_name", required: true, class: "h-11 w-full rounded-xl border border-zinc-200 px-3" %>
        </div>
        <div>
          <%= label_tag "pet_size_bands_#{band.id}_minimum", "Peso mínimo (kg)", class: "mb-2 block text-sm font-bold" %>
          <%= number_field_tag "pet_size_bands[#{band.id}][minimum_weight_kg]", band.minimum_weight_kg, id: "pet_size_bands_#{band.id}_minimum", min: 0, step: 0.1, required: true, class: "h-11 w-full rounded-xl border border-zinc-200 px-3" %>
        </div>
        <div>
          <%= label_tag "pet_size_bands_#{band.id}_maximum", "Peso máximo (kg)", class: "mb-2 block text-sm font-bold" %>
          <%= number_field_tag "pet_size_bands[#{band.id}][maximum_weight_kg]", band.maximum_weight_kg, id: "pet_size_bands_#{band.id}_maximum", min: 0, step: 0.1, placeholder: "Sin límite", class: "h-11 w-full rounded-xl border border-zinc-200 px-3" %>
        </div>
      </section>
    <% end %>
    <div class="flex justify-end">
      <%= submit_tag "Guardar rangos", class: "h-12 cursor-pointer rounded-full bg-zinc-950 px-7 text-sm font-bold text-white" %>
    </div>
  <% end %>
</div>
