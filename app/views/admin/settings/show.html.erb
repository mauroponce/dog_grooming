<% content_for :admin_full_bleed, true %>
<% content_for :title, "Configuración · Dog Grooming" %>

<% business_values = @settings_business_values || {} %>
<% business_search_address = Business.new(address: business_values[:address], neighborhood: business_values[:neighborhood], city: business_values[:city], province: business_values[:province]).location_search_address %>
<% instagram_handle = business_values[:instagram_url].to_s.sub(/\Ahttps?:\/\/(www\.)?instagram\.com\//i, "").sub(/\A@/, "").sub(/\/+\z/, "") %>
<% availability_rules = @settings_availability_rules || [] %>
<% non_working_periods = @settings_non_working_periods || [] %>
<% time_options = @settings_time_options || [] %>
<% payment_accounts = @settings_payment_accounts || [] %>
<% primary_payment_account = payment_accounts.find(&:primary_account?) || payment_accounts.first %>
<% payment_preferences = (@settings_payment_preferences || { "enabled_payment_methods" => @business.enabled_payment_methods }).with_indifferent_access %>
<% booking_page_preferences = (@settings_booking_page_preferences || { "allow_professional_selection" => @business.public_booking_allow_professional_selection?, "show_team_members" => @business.public_booking_show_team_members?, "assignment_strategy" => @business.public_booking_assignment_strategy, "rescheduling_notice_hours" => @business.rescheduling_notice_hours }).with_indifferent_access %>
<% mercado_pago_connection = @settings_mercado_pago_connection || @business.mercado_pago_connection %>
<% mercado_pago_configured = MercadoPago::OAuthClient.configured? %>
<% enabled_payment_methods = payment_preferences.key?(:enabled_payment_methods) ? Business.normalize_enabled_payment_methods(payment_preferences[:enabled_payment_methods]) : @business.enabled_payment_methods %>
<% mercado_pago_method_enabled = enabled_payment_methods.include?("mercado_pago") %>
<% manual_transfer_method_enabled = enabled_payment_methods.include?("manual_transfer") %>
<% allow_professional_selection = ActiveModel::Type::Boolean.new.cast(booking_page_preferences[:allow_professional_selection]) %>
<% show_team_members = ActiveModel::Type::Boolean.new.cast(booking_page_preferences[:show_team_members]) %>
<% booking_assignment_strategy = Business.normalize_public_booking_assignment_strategy(booking_page_preferences[:assignment_strategy]) %>
<% rescheduling_notice_hours = booking_page_preferences[:rescheduling_notice_hours].presence || @business.rescheduling_notice_hours %>
<% public_site_mode = business_values[:public_site_mode].presence_in(Business::PUBLIC_SITE_MODES.keys) || @business.public_site_mode %>
<% public_custom_html = business_values[:public_custom_html] %>
<% public_category_custom_html = business_values[:public_category_custom_html] %>
<% public_slug_prefix = "#{current_public_link_host}/" %>
