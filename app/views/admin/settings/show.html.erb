                </div>

                <div>
                  <label class="settings-field-label" for="business_account_owner_name">Nombre del dueño</label>
                  <%= text_field_tag "business_account[owner_name]", business_values[:owner_name], id: "business_account_owner_name", required: true, autocomplete: "name", class: "settings-input" %>
                  <p class="settings-field-hint">Se usa para el usuario dueño y su miembro de equipo.</p>
                </div>

                <div>
                  <label class="settings-field-label" for="business_account_owner_email">Email de acceso del dueño</label>
                  <%= email_field_tag "business_account[owner_email]", business_values[:owner_email], id: "business_account_owner_email", required: true, autocomplete: "email", class: "settings-input" %>
                  <p class="settings-field-hint">El dueño puede ingresar con el enlace mágico enviado a su email.</p>
                </div>

                <div>
                  <label class="settings-field-label" for="business_account_contact_phone">WhatsApp del negocio</label>
                  <%= telephone_field_tag "business_account[contact_phone]", business_values[:contact_phone], id: "business_account_contact_phone", required: true, autocomplete: "tel", class: "settings-input" %>
                  <p class="settings-field-hint">Se usa como contacto público y para las alertas operativas del negocio.</p>
                </div>
                </div>
              </section>

              <section class="settings-block">
                <div class="settings-block-header">
                  <span class="settings-block-icon is-purple"><%= settings_icons.fetch(:globe).html_safe %></span>
                  <div>
                    <h3 class="settings-block-title">Perfil público</h3>
                    <p class="settings-block-copy">Dirección web, Instagram y texto de presentación.</p>
                  </div>
                </div>

                <div class="settings-form-grid">

                <div>
                  <label class="settings-field-label" for="business_account_slug">Link público</label>
                  <div class="settings-prefixed-input">
                    <span class="settings-input-prefix"><%= public_slug_prefix %></span>
                    <%= text_field_tag "business_account[slug]", business_values[:slug], id: "business_account_slug", autocomplete: "off", data: { public_slug_input: true } %>
                  </div>
                  <p class="settings-field-hint">Debe ser único. Si cambiás este valor, cambia el link público del centro.</p>
                </div>

                <div>
                  <label class="settings-field-label" for="business_account_instagram_url">Instagram del negocio</label>
                  <div class="settings-prefixed-input">
                    <span class="settings-input-prefix">instagram.com/</span>
                    <%= text_field_tag "business_account[instagram_url]", instagram_handle, id: "business_account_instagram_url", autocomplete: "off", data: { instagram_handle_input: true } %>
                  </div>
                  <p class="settings-field-hint">Guardamos la URL completa con https.</p>
                </div>

                <div class="settings-form-field-full">
                  <label class="settings-field-label" for="business_account_slogan">Slogan</label>
                  <%= text_field_tag "business_account[slogan]", business_values[:slogan], id: "business_account_slogan", maxlength: 90, class: "settings-input", placeholder: "Ej. Tu momento de bienestar empieza acá" %>
                  <p class="settings-field-hint">Se muestra como título principal en el banner del perfil público.</p>
                </div>

                </div>
              </section>

              <section class="settings-block">
                <div class="settings-block-header">
                  <span class="settings-block-icon is-purple"><%= settings_icons.fetch(:image).html_safe %></span>
                  <div>
                    <h3 class="settings-block-title">Marca e imágenes</h3>
                    <p class="settings-block-copy">Logo y portada del perfil público.</p>
                  </div>
                </div>

                <div class="settings-form-grid">

                <div>
                  <label class="settings-field-label" for="business_account_logo">Logo</label>
                  <div class="settings-image-preview <%= "hidden" unless @business.logo.attached? %>" data-logo-preview>
                    <% if @business.logo.attached? %>
                      <%= image_tag @business.logo.variant(resize_to_fill: [ 72, 72 ]), class: "h-16 w-16 rounded-2xl object-cover", alt: "Logo actual", data: { logo_preview_image: true } %>
                    <% else %>
                      <img src="" class="h-16 w-16 rounded-2xl object-cover" alt="Logo seleccionado" data-logo-preview-image hidden>
                    <% end %>
                    <div>
                      <p class="text-sm font-bold text-zinc-950" data-logo-preview-title><%= @business.logo.attached? ? "Logo actual" : "Logo seleccionado" %></p>
                      <p class="settings-field-hint" data-logo-preview-hint><%= @business.logo.attached? ? "Seleccioná otro archivo para reemplazarlo." : "Se mostrará al guardar los cambios." %></p>
                    </div>
                  </div>
                  <%= file_field_tag "business_account[logo]", id: "business_account_logo", accept: "image/png,image/jpeg,image/webp", class: "settings-file-input", data: { logo_input: true } %>
                </div>
              </div>
              </section>

              <div class="settings-location-card">
                <div class="settings-block-header">
                  <span class="settings-block-icon is-rose"><%= settings_icons.fetch(:map_pin).html_safe %></span>
                  <div>
                    <p class="settings-content-eyebrow">Ubicación</p>
                    <h3 class="settings-block-title">Dirección del negocio</h3>
                    <p class="settings-block-copy">Se muestra en el perfil público para que los clientes puedan llegar.</p>
                  </div>
                </div>

                <div class="mt-5">
                  <label class="settings-field-label" for="business_account_search_address">Dirección del negocio</label>
                  <div class="relative" data-branch-location-target="searchWrapper">
                    <%= text_field_tag "business_account[search_address]", business_search_address, id: "business_account_search_address", autocomplete: "street-address", placeholder: "Ej. Bynnon, Castelar, Buenos Aires, Argentina", class: "settings-input", data: { branch_location_target: "search", action: "input->branch-location#searchChanged keydown->branch-location#keydown" } %>
                    <div class="settings-address-suggestions hidden rounded-[20px] border border-zinc-200 bg-white shadow-card" data-branch-location-target="suggestions"></div>
                  </div>
                </div>

                <%= hidden_field_tag "business_account[latitude]", business_values[:latitude], data: { branch_location_target: "latitude" } %>
                <%= hidden_field_tag "business_account[longitude]", business_values[:longitude], data: { branch_location_target: "longitude" } %>
                <%= hidden_field_tag "business_account[country]", "Argentina", data: { branch_location_target: "country" } %>
                <%= hidden_field_tag "business_account[address]", business_values[:address], data: { branch_location_target: "address" } %>
                <%= hidden_field_tag "business_account[city]", business_values[:city], data: { branch_location_target: "city" } %>
                <%= hidden_field_tag "business_account[province]", business_values[:province], data: { branch_location_target: "province" } %>
                <%= text_field_tag "business_account[neighborhood]", business_values[:neighborhood], class: "hidden", data: { branch_location_target: "neighborhood" } %>

                <div class="mt-5 grid gap-4 md:grid-cols-2">
                  <div>
                    <%= label_tag "business_account_address_details", "Piso / departamento", class: "settings-field-label" %>
                    <%= text_field_tag "business_account[address_details]", business_values[:address_details], id: "business_account_address_details", autocomplete: "address-line2", placeholder: "Ej. Piso 3, Depto B", class: "settings-input" %>
                    <p class="mt-2 text-xs font-semibold leading-5 text-zinc-500">No afecta el mapa; se muestra junto a la dirección para que el cliente llegue al lugar exacto.</p>
                  </div>
                </div>

                <div data-branch-location-target="mapContainer" class="hidden">
                  <div class="settings-map-shell">
                    <div class="border-b border-zinc-100 px-4 py-3">
                      <p class="text-xs font-bold uppercase tracking-[.14em] text-zinc-400">Mapa</p>
                    </div>
                    <div class="relative" style="height: 340px; min-height: 340px;">
                      <div data-branch-location-target="map" class="h-full w-full" style="height: 100%; min-height: 340px; width: 100%;"></div>
                      <div data-branch-location-target="mapPanel" class="pointer-events-none absolute inset-x-4 bottom-4 rounded-[20px] bg-white/95 p-3 shadow-card backdrop-blur">
                        <p class="text-xs font-bold uppercase tracking-[.12em] text-zinc-400">Estado</p>
                        <p class="mt-1 text-sm font-semibold leading-6 text-zinc-600">Buscá una dirección para ubicar el negocio en el mapa.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="settings-card settings-section-panel" id="pagina-de-reservas" data-settings-panel="pagina-de-reservas" <%= "hidden" unless @settings_active_tab == "pagina-de-reservas" %>>
            <div class="settings-panel-header">
              <span class="settings-panel-header-icon is-purple"><%= settings_icons.fetch(:globe).html_safe %></span>
              <div>
                <p class="settings-content-eyebrow">Reservas</p>
                <h2 class="settings-panel-title">Página de reservas</h2>
                <p class="settings-panel-copy">
                  Definí cómo se asignan los turnos cuando los clientes reservan desde la página pública.
                </p>
              </div>
            </div>

            <div class="settings-card-body is-spacious">
              <section class="settings-block" data-public-site-mode-settings>
                <div class="settings-block-header">
                  <span class="settings-block-icon is-purple"><%= settings_icons.fetch(:globe).html_safe %></span>
                  <div>
                    <h3 class="settings-block-title">Modo de página pública</h3>
                    <p class="settings-block-copy">Elegí si compartís un link de reserva directo o una web completa con categorías y páginas propias.</p>
                  </div>
                </div>

                <div class="settings-payment-toggle-options mt-4">
                  <label class="settings-payment-toggle-option">
                    <%= radio_button_tag "business_account[public_site_mode]", "booking_link", public_site_mode == "booking_link", id: "business_account_public_site_mode_booking_link", data: { public_site_mode_input: true } %>
                    <span>
                      <span class="settings-payment-toggle-title">Link de reserva</span>
                      <span class="settings-payment-toggle-copy">Mantiene la página actual: categorías en filtros y acceso inmediato al flujo de turnos.</span>
                    </span>
                  </label>

                  <label class="settings-payment-toggle-option">
                    <%= radio_button_tag "business_account[public_site_mode]", "full_website", public_site_mode == "full_website", id: "business_account_public_site_mode_full_website", data: { public_site_mode_input: true } %>
                    <span>
                      <span class="settings-payment-toggle-title">Web completa</span>
                      <span class="settings-payment-toggle-copy">Muestra una portada con diseño elegido, categorías navegables y una página para cada una.</span>
                    </span>
                  </label>
                </div>

                <div class="settings-booking-notice mt-4" data-full-website-notice <%= "hidden" unless public_site_mode == "full_website" %>>
                  <%= settings_icons.fetch(:info).html_safe %>
                  <p class="m-0 text-sm font-bold leading-6">Al activar este modo aparece la pestaña Diseño web. Cada categoría tendrá una URL propia y los servicios abrirán directamente el paso de día y horario.</p>
                </div>
              </section>

              <section class="settings-block" data-booking-assignment-settings>
                <div class="settings-block-header">
                  <span class="settings-block-icon is-purple"><%= settings_icons.fetch(:clock).html_safe %></span>
                  <div>
                    <h3 class="settings-block-title">Asignación de turnos</h3>
                    <p class="settings-block-copy">Elegí si el tutor puede seleccionar profesional o si Dog Grooming asigna automáticamente el mejor disponible.</p>
                  </div>
                </div>

                <%= hidden_field_tag "booking_page_preferences[allow_professional_selection]", "0" %>
                <label class="settings-payment-toggle-option">
                  <%= check_box_tag "booking_page_preferences[allow_professional_selection]", "1", allow_professional_selection, id: "booking_page_preferences_allow_professional_selection", data: { booking_professional_selection_toggle: true } %>
                  <span>
                    <span class="settings-payment-toggle-title">Permitir que el cliente elija profesional</span>
                    <span class="settings-payment-toggle-copy">Si está activo, la página pública muestra el paso Profesional antes de elegir día y hora.</span>
                  </span>
                </label>

                <div class="settings-booking-notice" data-booking-professional-selection-notice <%= "hidden" unless allow_professional_selection %>>
                  <%= settings_icons.fetch(:info).html_safe %>
                  <p class="m-0 text-sm font-bold leading-6">
                    El cliente va a poder seleccionar qué profesional lo atiende. Por defecto, la opción seleccionada será "primer profesional libre".
                  </p>
                </div>

                <div class="settings-payment-toggle-options settings-assignment-options mt-4" data-booking-assignment-strategies <%= "hidden" if allow_professional_selection %>>
                  <% Business::PUBLIC_BOOKING_ASSIGNMENT_STRATEGY_LABELS.each do |strategy, label| %>
                    <label class="settings-payment-toggle-option">
                      <%= radio_button_tag "booking_page_preferences[assignment_strategy]", strategy, booking_assignment_strategy == strategy, id: "booking_page_preferences_assignment_strategy_#{strategy}" %>
                      <span>
                        <span class="settings-payment-toggle-title"><%= label %></span>
                        <span class="settings-payment-toggle-copy">
                          <% case strategy %>
                          <% when "first_available" %>
                            Asigna el primer profesional libre según el orden configurado del equipo.
                          <% when "balanced_rotation" %>
                            Reparte turnos priorizando a quienes tienen menos reservas asignadas.
                          <% when "least_daily_load" %>
                            Elige al profesional disponible con menos turnos en ese día.
                          <% when "habitual_professional" %>
                            Si el cliente ya tuvo turnos, intenta asignarle su profesional habitual.
                          <% end %>
                        </span>
                      </span>
                    </label>
                  <% end %>
                </div>
              </section>

              <section class="settings-block">
                <div class="settings-block-header">
                  <span class="settings-block-icon is-purple"><%= settings_icons.fetch(:id_card).html_safe %></span>
                  <div>
                    <h3 class="settings-block-title">Equipo en la web pública</h3>
                    <p class="settings-block-copy">Definí si la página pública muestra el menú y la sección de miembros del equipo.</p>
                  </div>
                </div>

                <%= hidden_field_tag "booking_page_preferences[show_team_members]", "0" %>
                <label class="settings-payment-toggle-option">
                  <%= check_box_tag "booking_page_preferences[show_team_members]", "1", show_team_members, id: "booking_page_preferences_show_team_members" %>
                  <span>
                    <span class="settings-payment-toggle-title">Mostrar miembros del equipo</span>
                    <span class="settings-payment-toggle-copy">Si está activo, la web pública muestra la pestaña Equipo y las tarjetas de profesionales. Por defecto queda oculto.</span>
                  </span>
                </label>
              </section>

              <section class="settings-block">
                <div class="settings-block-header">
                  <span class="settings-block-icon is-purple"><%= settings_icons.fetch(:clock).html_safe %></span>
                  <div>
                    <h3 class="settings-block-title">Reprogramaciones</h3>
                    <p class="settings-block-copy">Definí hasta cuántas horas antes del turno el cliente puede reprogramar online desde su portal.</p>
                  </div>
                </div>

                <div class="max-w-sm">
                  <label class="settings-field-label" for="booking_page_preferences_rescheduling_notice_hours">Anticipación mínima</label>
                  <%= number_field_tag "booking_page_preferences[rescheduling_notice_hours]", rescheduling_notice_hours, id: "booking_page_preferences_rescheduling_notice_hours", min: 0, max: 168, step: 1, required: true, class: "settings-input" %>
                  <p class="settings-field-hint">Horas antes del turno para permitir reprogramaciones online. El valor predeterminado es 24 hs.</p>
                </div>
              </section>
            </div>
          </section>

          <section class="settings-card settings-section-panel" id="diseno-web" data-settings-panel="diseno-web" data-web-design-panel <%= "hidden" unless @settings_active_tab == "diseno-web" %>>
            <div class="settings-panel-header">
              <span class="settings-panel-header-icon is-purple"><%= settings_icons.fetch(:image).html_safe %></span>
              <div>
                <p class="settings-content-eyebrow">Web completa</p>
                <h2 class="settings-panel-title">Diseño web</h2>
                <p class="settings-panel-copy">Definí por separado el HTML de la portada y el de cada página de categoría, con estilos e imágenes propios.</p>
              </div>
            </div>

            <div class="settings-card-body is-spacious">
              <section class="settings-block">
                <div class="settings-block-header">
                  <span class="settings-block-icon is-purple"><%= settings_icons.fetch(:globe).html_safe %></span>
                  <div>
                    <h3 class="settings-block-title">Página de inicio</h3>
                    <p class="settings-block-copy">Pegá el HTML completo de la portada. Usá el marcador de categorías para que el sistema muestre las categorías reales en esa posición.</p>
                  </div>
                </div>

                <div class="settings-code-actions">
                  <p class="settings-code-action-copy">Los valores entre llaves se completan solos desde tu configuración: nombre, logo, contacto, dirección y enlaces.</p>
                  <button type="button" class="settings-button settings-button-secondary" data-public-custom-html-starter>Insertar estructura base</button>
                </div>

                <label class="settings-field-label mt-5" for="business_account_public_custom_html">HTML de inicio</label>
                <%= text_area_tag "business_account[public_custom_html]", public_custom_html, id: "business_account_public_custom_html", rows: 20, maxlength: Business::PUBLIC_CUSTOM_HTML_MAX_LENGTH, class: "settings-textarea font-mono text-xs", data: { public_custom_html_input: true }, placeholder: "<section>\n  <h1>{{business_name}}</h1>\n  <p>{{business_intro}}</p>\n</section>\n\n<div data-dog-grooming-slot=\"categories\"></div>" %>
                <p class="settings-field-hint">Usá &lt;div data-dog-grooming-slot="categories"&gt;&lt;/div&gt; para insertar las categorías reales. Máximo 50.000 caracteres; scripts, formularios, iframes y estilos inline no se publican.</p>

                <div class="settings-code-preview">
                  <div class="settings-code-preview-header">
                    <span>Vista previa de inicio</span>
                    <span>Se actualiza al escribir</span>
                  </div>
                  <iframe class="settings-code-preview-frame" title="Vista previa de la página de inicio" sandbox data-public-custom-html-preview></iframe>
                </div>

                <details class="mt-4 text-sm text-slate-600">
                  <summary class="cursor-pointer font-bold text-slate-800">Variables dinámicas disponibles</summary>
                  <pre class="settings-code-example"><code>&lt;style&gt;
.ht-about { background: #f2ede3; color: #2b211b; }
.ht-about__image { min-height: 340px; object-fit: cover; }
&lt;/style&gt;

&lt;section class="ht-section ht-about"&gt;
  &lt;div class="ht-section__inner"&gt;
    &lt;img class="ht-about__image" src="{{business_logo_url}}" alt="{{business_name}}"&gt;
    &lt;div&gt;
      &lt;h2&gt;{{business_name}}&lt;/h2&gt;
      &lt;p&gt;{{business_intro}}&lt;/p&gt;
      &lt;a href="{{business_whatsapp_url}}"&gt;{{business_phone}}&lt;/a&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/section&gt;

{{business_name}} {{business_slogan}} {{business_intro}}
{{business_logo_url}} {{business_phone}} {{business_email}}
{{business_address}} {{business_instagram_url}} {{business_instagram_handle}} {{business_whatsapp_url}}
{{home_url}} {{services_url}} {{current_year}}</code></pre>
                </details>
              </section>

              <section class="settings-block mt-8">
                <div class="settings-block-header">
                  <span class="settings-block-icon is-purple"><%= settings_icons.fetch(:image).html_safe %></span>
                  <div>
                    <h3 class="settings-block-title">Páginas de categorías</h3>
                    <p class="settings-block-copy">Este HTML se usa en cada categoría. El título y la descripción se adaptan a la categoría visitada, y el marcador inserta sus servicios reales.</p>
                  </div>
                </div>

                <div class="settings-code-actions">
                  <p class="settings-code-action-copy">Variables de categoría: {{category_name}}, {{category_name_uppercase}}, {{category_description}}, {{category_service_count}} y {{category_url}}.</p>
                  <button type="button" class="settings-button settings-button-secondary" data-public-category-custom-html-starter>Insertar estructura base</button>
                </div>

                <label class="settings-field-label mt-5" for="business_account_public_category_custom_html">HTML de páginas de categorías</label>
                <%= text_area_tag "business_account[public_category_custom_html]", public_category_custom_html, id: "business_account_public_category_custom_html", rows: 20, maxlength: Business::PUBLIC_CUSTOM_HTML_MAX_LENGTH, class: "settings-textarea font-mono text-xs", data: { public_category_custom_html_input: true }, placeholder: "<section>\n  <h1>{{category_name_uppercase}}</h1>\n  <p>{{category_description}}</p>\n</section>\n\n<section>\n  <h2>Servicios para mascotas</h2>\n  <div data-dog-grooming-slot=\"services\"></div>\n</section>" %>
                <p class="settings-field-hint">Usá &lt;div data-dog-grooming-slot="services"&gt;&lt;/div&gt; para listar únicamente los servicios de la categoría actual. Si no usás el marcador, los servicios se agregan al final.</p>

                <div class="settings-code-preview">
                  <div class="settings-code-preview-header">
                    <span>Vista previa de categoría</span>
                    <span>Se actualiza al escribir</span>
                  </div>
                  <iframe class="settings-code-preview-frame" title="Vista previa de la página de categoría" sandbox data-public-category-custom-html-preview></iframe>
                </div>
              </section>
            </div>
          </section>

          <section class="settings-card settings-section-panel" id="cuentas-de-cobro" data-settings-panel="cuentas-de-cobro" data-payment-accounts <%= "hidden" unless @settings_active_tab == "cuentas-de-cobro" %>>
            <div class="settings-panel-header">
              <span class="settings-panel-header-icon is-green"><%= settings_icons.fetch(:landmark).html_safe %></span>
              <div>
                <p class="settings-content-eyebrow">Pagos</p>
                <h2 class="settings-panel-title">Cuentas de cobro</h2>
                <p class="settings-panel-copy">
                  Configurá Mercado Pago o los datos bancarios para abonar la seña o el el total de un servicio que requiera pago previo.
                </p>
              </div>
            </div>

            <div class="settings-card-body is-spacious">
              <section class="settings-block" data-payment-method-toggles>
                <div class="settings-block-header">
                  <div>
                    <h3 class="settings-block-title">Métodos de pago habilitados</h3>
                    <p class="settings-block-copy">Elegí como se puede abonar la seña o el total al reservar un turno. Luego podés configurarlo por cada servicio.</p>
                  </div>
                </div>

                <div class="settings-payment-toggle-options">
                  <%= hidden_field_tag "payment_preferences[enabled_payment_methods][]", "" %>
                  <label class="settings-payment-toggle-option">
                    <%= check_box_tag "payment_preferences[enabled_payment_methods][]", "mercado_pago", mercado_pago_method_enabled, id: "payment_preferences_enabled_payment_methods_mercado_pago", data: { payment_method_toggle: "mercado-pago" } %>
                    <span>
                      <span class="settings-payment-toggle-title">MercadoPago</span>
                      <span class="settings-payment-toggle-copy">Permite cobrar señas o pagos completos con confirmación automática.</span>
                    </span>
                  </label>

                  <label class="settings-payment-toggle-option">
                    <%= check_box_tag "payment_preferences[enabled_payment_methods][]", "manual_transfer", manual_transfer_method_enabled, id: "payment_preferences_enabled_payment_methods_manual_transfer", data: { payment_method_toggle: "manual-transfer" } %>
                    <span>
                      <span class="settings-payment-toggle-title">Transferencia por Alias / CBU</span>
