<style>
  .settings-shell {
    background: #f7f7f8;
    color: #071014;
    height: 100%;
    min-height: 0;
    overflow-y: auto;
  }

  .settings-container {
    margin: 0 auto;
    padding: 38px 0 64px;
    width: min(var(--admin-content-max-width, 1600px), calc(100% - var(--admin-content-horizontal-space, 48px)));
  }

  .settings-header {
    align-items: flex-start;
    display: flex;
    gap: 24px;
    justify-content: space-between;
    margin-bottom: 34px;
  }

  .settings-save-footer {
    border-top: 1px solid #e4e4e7;
    display: flex;
    justify-content: flex-end;
    margin-top: 28px;
    padding-top: 24px;
  }

  .settings-eyebrow,
  .settings-content-eyebrow {
    color: #A63826;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .14em;
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
  }

  .settings-title {
    color: #111;
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -.04em;
    line-height: 1.05;
    margin: 10px 0 0;
  }

  .settings-copy {
    color: #71717a;
    font-size: 15px;
    font-weight: 650;
    line-height: 1.55;
    margin: 12px 0 0;
    max-width: 760px;
  }

  .settings-button {
    align-items: center;
    border-radius: 16px;
    display: inline-flex;
    font-size: 15px;
    font-weight: 700;
    height: 48px;
    justify-content: center;
    padding: 0 22px;
    white-space: nowrap;
  }

  .settings-button-primary {
    background: #111;
    border: 1px solid #111;
    color: #fff;
  }

  .settings-layout {
    align-items: start;
    display: grid;
    gap: 28px;
    grid-template-columns: 360px minmax(0, 1fr);
  }

  .settings-sidebar {
    background: #fff;
    border: 1px solid #e4e4e7;
    border-radius: 12px;
    padding: 20px;
    position: sticky;
    top: 24px;
  }

  .settings-sidebar-nav {
    display: grid;
    gap: 8px;
  }

  .settings-tab {
    align-items: center;
    background: transparent;
    border: 0;
    border-radius: 8px;
    color: #18181b;
    display: flex;
    font-size: 16px;
    font-weight: 700;
    min-height: 56px;
    justify-content: space-between;
    padding: 0 18px;
    text-decoration: none;
    width: 100%;
  }

  .settings-tab:hover {
    background: #ffded4;
    color: #A63826;
  }

  .settings-tab.is-active {
    background: #ffded4;
    color: #A63826;
  }

  .settings-sections {
    display: grid;
    gap: 28px;
    min-width: 0;
  }

  .settings-section-panel[hidden] {
    display: none !important;
  }

  .settings-card {
    background: #fff;
    border: 1px solid #fff;
    border-radius: 28px;
    box-shadow: 0 20px 55px rgba(17, 17, 20, .08);
    overflow: hidden;
  }

  .settings-card-body {
    padding: 32px;
  }

  .settings-form-grid {
    display: grid;
    gap: 22px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 28px;
  }

  .settings-block .settings-form-grid {
    margin-top: 0;
  }

  .settings-form-field-full {
    grid-column: 1 / -1;
  }

  .settings-field-label {
    color: #09090b;
    display: block;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
  }

  .settings-field-hint {
    color: #71717a;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.45;
    margin-top: 8px;
  }

  .settings-input,
  .settings-textarea {
    background: #fff;
    border: 1px solid #d4d4d8;
    border-radius: 16px;
    color: #09090b;
    font-size: 14px;
    font-weight: 700;
    margin-top: 10px;
    outline: none;
    width: 100%;
  }

  .settings-input {
    height: 50px;
    padding: 0 16px;
  }

  .settings-textarea {
    line-height: 1.6;
    min-height: 132px;
    padding: 14px 16px;
    resize: vertical;
  }

  .settings-input:focus,
  .settings-textarea:focus {
    border-color: #A63826;
    box-shadow: 0 0 0 4px rgba(255, 222, 212, .12);
  }

  .settings-code-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: space-between;
    margin-top: 18px;
  }

  .settings-code-action-copy {
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.45;
    margin: 0;
  }

  .settings-code-preview {
    background: #fff;
    border: 1px solid #dbe1ea;
    border-radius: 18px;
    margin-top: 16px;
    overflow: hidden;
  }

  .settings-code-preview-header {
    align-items: center;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    color: #475569;
    display: flex;
    font-size: 12px;
    font-weight: 700;
    justify-content: space-between;
    padding: 11px 14px;
  }

  .settings-code-preview-frame {
    background: #fff;
    border: 0;
    display: block;
    height: 420px;
    width: 100%;
  }

  .settings-code-example {
    background: #0f172a;
    border-radius: 14px;
    color: #e2e8f0;
    font-size: 12px;
    line-height: 1.55;
    margin: 12px 0 0;
    overflow-x: auto;
    padding: 14px;
    white-space: pre;
  }

  .settings-prefixed-input {
    align-items: stretch;
    background: #fff;
    border: 1px solid #d4d4d8;
    border-radius: 16px;
    display: flex;
    height: 50px;
    margin-top: 10px;
    overflow: hidden;
  }

  .settings-prefixed-input:focus-within {
    border-color: #A63826;
    box-shadow: 0 0 0 4px rgba(255, 222, 212, .12);
  }

  .settings-input-prefix {
    align-items: center;
    background: #fafafa;
    border-right: 1px solid #e4e4e7;
    color: #71717a;
    display: inline-flex;
    flex: 0 0 auto;
    font-size: 14px;
    font-weight: 700;
    padding: 0 16px;
  }

  .settings-prefixed-input input {
    border: 0;
    flex: 1 1 auto;
    font-size: 14px;
    font-weight: 700;
    min-width: 0;
    outline: none;
    padding: 0 16px;
  }

  .settings-image-preview {
    align-items: center;
    background: #fafafa;
    border: 1px solid #e4e4e7;
    border-radius: 18px;
    display: flex;
    gap: 14px;
    margin-top: 10px;
    overflow: hidden;
    padding: 12px;
  }

  .settings-file-input {
    background: #fff;
    border: 1px solid #d4d4d8;
    border-radius: 16px;
    color: #52525b;
    display: block;
    font-size: 13px;
    font-weight: 700;
    margin-top: 10px;
    padding: 12px 14px;
    width: 100%;
  }

  .settings-file-input::file-selector-button {
    background: #111;
    border: 0;
    border-radius: 12px;
    color: #fff;
    cursor: pointer;
    font-size: 12px;
    font-weight: 700;
    margin-right: 14px;
    padding: 9px 14px;
  }

  .settings-location-card {
    background: #fafafa;
    border: 1px solid #f4f4f5;
    border-radius: 26px;
    margin-top: 30px;
    padding: 24px;
  }

  .settings-address-suggestions {
    left: 0;
    overflow: hidden;
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 40;
  }

  .settings-map-shell {
    background: #fff;
    border: 1px solid #e4e4e7;
    border-radius: 24px;
    box-shadow: 0 8px 28px rgba(15, 23, 42, .08);
    margin-top: 18px;
    overflow: hidden;
  }

  .settings-schedule-heading {
    color: #111;
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -.04em;
    line-height: 1.1;
    margin: 8px 0 0;
  }

  .settings-schedule-copy {
    color: #52525b;
    font-size: 17px;
    font-weight: 650;
    line-height: 1.55;
    margin: 12px 0 0;
    max-width: 770px;
  }

  .settings-schedule-day-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 34px;
  }

  .settings-schedule-pill {
    align-items: center;
    background: #fff;
    border: 1px solid #e4e4e7;
    border-radius: 999px;
    box-shadow: 0 14px 34px rgba(24, 24, 27, .06);
    color: #18181b;
    display: inline-flex;
    font-size: 16px;
    font-weight: 700;
    height: 64px;
    justify-content: center;
    transition: background-color .15s ease, border-color .15s ease, box-shadow .15s ease, color .15s ease, transform .15s ease;
    width: 64px;
  }

  .settings-schedule-pill:hover {
    border-color: #A63826;
    box-shadow: 0 18px 42px rgba(255, 222, 212, .12);
    transform: translateY(-1px);
  }

  .settings-schedule-pill.is-active {
    background: #BF482F;
    border-color: #A63826;
    box-shadow: 0 18px 38px rgba(255, 222, 212, .25);
    color: #fff;
  }

  .settings-schedule-rows {
    display: grid;
    gap: 18px;
    margin-top: 42px;
    max-width: 780px;
  }

  .settings-schedule-row {
    align-items: start;
    display: grid;
    gap: 24px;
    grid-template-columns: 240px minmax(0, 1fr);
  }

  .settings-schedule-row.hidden,
  .settings-schedule-period.hidden,
  .settings-schedule-copy-prompt.hidden {
    display: none !important;
  }

  .settings-schedule-day-button {
    color: #09090b;
    display: block;
    text-align: left;
  }

  .settings-schedule-day-name {
    display: block;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
  }

  .settings-schedule-status {
    color: #a1a1aa;
    display: block;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    margin-top: 4px;
  }

  .settings-schedule-status.is-active {
    color: #059669;
  }

  .settings-schedule-periods {
    display: grid;
    gap: 16px;
  }

  .settings-schedule-period {
    align-items: center;
    display: grid;
    gap: 16px;
    grid-template-columns: 144px 44px 144px 44px;
  }

  .settings-schedule-select {
    appearance: none;
    background-color: #fff;
    background-image: url("data:image/svg+xml,%3Csvg width='22' height='22' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M7 10l5 5 5-5' stroke='%23111111' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-position: right 14px center;
    background-repeat: no-repeat;
    background-size: 22px 22px;
    border: 1px solid #d4d4d8;
    border-radius: 12px;
    color: #09090b;
    font-size: 16px;
    font-weight: 700;
    height: 48px;
    outline: none;
    padding: 0 46px 0 16px;
    width: 144px;
  }

  .settings-schedule-select:focus {
    border-color: #A63826;
    box-shadow: 0 0 0 4px rgba(255, 222, 212, .12);
  }

  .settings-schedule-until {
    color: #52525b;
    font-size: 16px;
    font-weight: 650;
    text-align: center;
  }

  .settings-schedule-icon-button {
    align-items: center;
    border-radius: 999px;
    color: #71717a;
    display: inline-flex;
    font-size: 32px;
    font-weight: 300;
    height: 44px;
    justify-content: center;
    line-height: 1;
    width: 44px;
  }

  .settings-schedule-icon-button:hover {
    background: #f4f4f5;
    color: #18181b;
  }

  .settings-schedule-icon-button.remove {
    color: #e11d48;
  }

  .settings-schedule-icon-button.remove:hover {
    background: #fff1f2;
    color: #e11d48;
  }

  .settings-schedule-copy-prompt {
    background: #ffded4;
    border: 1px solid #ffded4;
    border-radius: 12px;
    color: #18181b;
    max-width: 404px;
    padding: 16px 18px;
  }

  .settings-schedule-copy-prompt-inner {
    align-items: center;
    display: flex;
    gap: 16px;
    justify-content: space-between;
  }

  .settings-schedule-copy-prompt p {
    color: #A63826;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.35;
  }

  .settings-schedule-copy-button {
    background: #18181b;
    border: 1px solid #18181b;
    border-radius: 999px;
    color: #fff;
    flex: 0 0 auto;
    font-size: 14px;
    font-weight: 700;
    height: 40px;
    padding: 0 16px;
  }

  .settings-schedule-copy-button:hover {
    background: #000;
  }

  .settings-non-working-form {
    align-items: end;
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    margin-top: 28px;
    max-width: 780px;
  }

  .settings-non-working-form .settings-input {
    margin-top: 8px;
  }

  .settings-date-input {
    margin-top: 8px;
    position: relative;
  }

  .settings-non-working-form .settings-date-input .settings-input {
    margin-top: 0;
  }

  .settings-date-picker-display {
    caret-color: transparent;
    cursor: pointer;
    padding-right: 48px;
  }

  .settings-date-picker-button {
    align-items: center;
    color: #475569;
    display: inline-flex;
    height: 38px;
    justify-content: center;
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    width: 38px;
  }

  .settings-date-picker-button svg {
    height: 18px;
    width: 18px;
  }

  .settings-date-picker-calendar {
    background: #fff;
    border: 1px solid #dbe1ea;
    border-radius: 18px;
    box-shadow: 0 22px 50px rgba(15, 23, 42, .18);
    padding: 12px;
  }

  .settings-date-picker-calendar[hidden] {
    display: none;
  }

  .settings-date-picker-header {
    align-items: center;
    display: grid;
    grid-template-columns: 36px 1fr 36px;
    gap: 8px;
    margin-bottom: 8px;
  }

  .settings-date-picker-title {
    color: #0f172a;
    font-size: 14px;
    font-weight: 700;
    margin: 0;
    text-align: center;
  }

  .settings-date-picker-nav {
    align-items: center;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    color: #334155;
    display: inline-flex;
    font-size: 24px;
    font-weight: 700;
    height: 36px;
    justify-content: center;
    line-height: 1;
    width: 36px;
  }

  .settings-date-picker-nav:hover {
    background: #ffded4;
    border-color: #A63826;
    color: #A63826;
  }

  .settings-date-picker-weekdays,
