        </aside>

        <main class="settings-sections">
          <section
            class="settings-card settings-section-panel"
            id="datos-generales"
            data-settings-panel="datos-generales"
            data-settings-general
            data-controller="branch-location"
            data-branch-location-photon-url-value="https://photon.komoot.io/api/"
            <%= "hidden" unless @settings_active_tab == "datos-generales" %>
          >
            <div class="settings-panel-header">
              <span class="settings-panel-header-icon is-purple"><%= settings_icons.fetch(:building).html_safe %></span>
              <div>
                <p class="settings-content-eyebrow">Cuenta</p>
                <h2 class="settings-panel-title">Datos Generales</h2>
                <p class="settings-panel-copy">
                  Actualizá la información pública y de contacto del centro. Estos datos se usan para el perfil público, el link de reservas y el usuario dueño.
                </p>
              </div>
            </div>

            <div class="settings-card-body is-spacious">
              <section class="settings-block">
                <div class="settings-block-header">
                  <span class="settings-block-icon is-blue"><%= settings_icons.fetch(:id_card).html_safe %></span>
                  <div>
                    <h3 class="settings-block-title">Identidad y contacto</h3>
                    <p class="settings-block-copy">Datos principales del centro y su propietario.</p>
                  </div>
                </div>

                <div class="settings-form-grid">
                <div>
                  <label class="settings-field-label" for="business_account_business_name">Nombre del centro</label>
