                  <div>
                    <h3 class="settings-block-title">Mercado Pago</h3>
                    <p class="settings-block-copy">
                    Conectá tu cuenta para procesar pagos automáticamente.
                    <a href="https://www.mercadopago.com.ar/ayuda/costo-recibir-pagos-con-checkout_33399" target="_blank" rel="noopener noreferrer" class="text-blue-600 underline underline-offset-2 hover:text-blue-700">Más información</a>
                    </p>
                  </div>
                </div>

                <div class="settings-integration-card">
                  <div>
                    <% if mercado_pago_connection&.connected? %>
                      <% if mercado_pago_connection.requires_production_reconnection? %>
                        <span class="settings-status-pill is-disconnected">Requiere reconexión</span>
                        <p class="mt-3 text-sm font-bold text-zinc-950">La cuenta está conectada en modo prueba.</p>
                        <p class="mt-1 text-xs font-semibold text-zinc-500">Desconectala y volvé a conectarla para autorizar la cuenta productiva y cobrar pagos reales.</p>
                      <% else %>
                        <span class="settings-status-pill is-connected">Conectado</span>
                        <p class="mt-3 text-sm font-bold text-zinc-950">Mercado Pago listo para cobrar reservas online.</p>
                        <p class="mt-1 text-xs font-semibold text-zinc-500">
                          <% if mercado_pago_connection.mercado_pago_account_label.present? %>
                            Cuenta MP: <%= mercado_pago_connection.mercado_pago_account_label %>.
                          <% end %>
                          <% if mercado_pago_connection.connected_at.present? %>
                            Conectado el <%= format_ar_datetime(mercado_pago_connection.connected_at) %>.
                          <% end %>
                        </p>
                      <% end %>
                    <% else %>
                      <span class="settings-status-pill is-disconnected">Sin conectar</span>
                      <p class="mt-3 text-sm font-bold text-zinc-950">Conectá Mercado Pago antes de usarlo como método de cobro.</p>
                      <p class="mt-1 text-xs font-semibold text-zinc-500">Sin conexión, los servicios pueden seguir usando comprobante manual.</p>
                    <% end %>
                  </div>

                  <div class="flex shrink-0 flex-col gap-2" data-mercado-pago-connection-actions>
                    <% if mercado_pago_connection&.connected? %>
                      <%= link_to "Desconectar", admin_mercado_pago_connection_path, data: { turbo_method: :delete, turbo_confirm: "¿Desconectar Mercado Pago?" }, class: "settings-payment-remove text-center" %>
                    <% elsif mercado_pago_configured %>
                      <%= link_to "Conectar", connect_admin_mercado_pago_connection_path, class: "settings-button settings-button-primary" %>
                    <% else %>
                      <span class="settings-button settings-button-secondary opacity-60">OAuth no configurado</span>
                    <% end %>
                  </div>
                </div>

                <% unless mercado_pago_configured %>
                  <p class="mt-4 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm font-semibold leading-6 text-amber-900">
                    Faltan las variables de OAuth de Mercado Pago para el entorno <%= MercadoPago::Credentials.environment_label %>.
                    Podés usar <code>MERCADO_PAGO_CLIENT_ID</code> y <code>MERCADO_PAGO_CLIENT_SECRET</code>, o separarlas con
                    <code>MERCADO_PAGO_TEST_CLIENT_ID</code> / <code>MERCADO_PAGO_TEST_CLIENT_SECRET</code> y
                    <code>MERCADO_PAGO_PRODUCTION_CLIENT_ID</code> / <code>MERCADO_PAGO_PRODUCTION_CLIENT_SECRET</code>.
                    En producción también configurá <code>MERCADO_PAGO_WEBHOOK_SECRET</code> si querés validar la firma del webhook.
                  </p>
                <% end %>
              </section>

              <section class="settings-block" data-payment-method-section="manual-transfer" <%= "hidden" unless manual_transfer_method_enabled %>>
                <div class="settings-block-header">
                  <span class="settings-block-icon is-green"><%= settings_icons.fetch(:landmark).html_safe %></span>
                  <div>
                    <h3 class="settings-block-title">Alias / CBU</h3>
                    <p class="settings-block-copy">Pegá los datos tal como querés que los vea el cliente cuando tenga que subir un comprobante.</p>
                  </div>
                </div>

              <div class="settings-payment-list" data-payment-account-list>
                <% payment_accounts.each_with_index do |account, index| %>
                  <% account_key = account.persisted? ? account.id.to_s : "new_#{index}" %>
                  <% is_primary = primary_payment_account == account %>
                  <article class="settings-payment-card" data-payment-account-row>
                    <%= hidden_field_tag "payment_accounts[items][#{account_key}][id]", account.id if account.persisted? %>
                    <%= hidden_field_tag "payment_accounts[items][#{account_key}][_destroy]", "0", data: { payment_account_destroy: true } %>

                    <div class="settings-payment-card-header">
                      <label class="settings-payment-primary">
                        <%= radio_button_tag "payment_accounts[primary_key]", account_key, is_primary, data: { payment_account_primary: true } %>
                        Usar como cuenta principal
                        <span class="settings-payment-primary-badge" data-payment-account-primary-badge <%= "hidden" unless is_primary %>>Principal</span>
                      </label>
                      <button type="button" class="settings-payment-remove" data-payment-account-remove>Eliminar</button>
                    </div>

                    <div class="settings-payment-body">
                      <div>
                        <label class="settings-field-label" for="payment_account_<%= account_key %>_name">Nombre de la cuenta</label>
                        <%= text_field_tag "payment_accounts[items][#{account_key}][name]", account.name, id: "payment_account_#{account_key}_name", class: "settings-input", placeholder: "Ej. BBVA principal" %>
                        <p class="settings-field-hint">Este nombre lo verá el admin y ayuda a elegir la cuenta desde cada servicio.</p>
                      </div>

                      <div>
                        <label class="settings-field-label" for="payment_account_<%= account_key %>_details">Datos de cuenta</label>
                        <%= text_area_tag "payment_accounts[items][#{account_key}][details]", account.details, id: "payment_account_#{account_key}_details", rows: 8, class: "settings-textarea" %>
                        <p class="settings-field-hint">Se muestra como texto en el link de comprobante. No subas imagen: pegá los datos completos acá.</p>
                      </div>
                    </div>
                  </article>
                <% end %>
              </div>

              <div class="settings-payment-empty <%= "hidden" if payment_accounts.any? %>" data-payment-account-empty>
                Todavía no hay cuentas de cobro configuradas. Agregá la principal para que los servicios con seña puedan pedir comprobante.
              </div>

              <div class="settings-payment-actions">
                <button type="button" class="settings-button settings-button-secondary settings-payment-add" data-payment-account-add>
                  <%= settings_icons.fetch(:plus).html_safe %>
                  Agregar cuenta
                </button>
              </div>

              <template data-payment-account-template>
                <article class="settings-payment-card" data-payment-account-row>
                  <input type="hidden" name="payment_accounts[items][__KEY__][_destroy]" value="0" data-payment-account-destroy>

                  <div class="settings-payment-card-header">
                    <label class="settings-payment-primary">
                      <input type="radio" name="payment_accounts[primary_key]" value="__KEY__" data-payment-account-primary>
                      Usar como cuenta principal
                      <span class="settings-payment-primary-badge" data-payment-account-primary-badge hidden>Principal</span>
                    </label>
                    <button type="button" class="settings-payment-remove" data-payment-account-remove>Eliminar</button>
                  </div>

                  <div class="settings-payment-body">
                    <div>
                      <label class="settings-field-label" for="payment_account___KEY___name">Nombre de la cuenta</label>
                      <input type="text" name="payment_accounts[items][__KEY__][name]" id="payment_account___KEY___name" class="settings-input" placeholder="Ej. BBVA principal">
                      <p class="settings-field-hint">Este nombre lo verá el admin y ayuda a elegir la cuenta desde cada servicio.</p>
                    </div>

                    <div>
                      <label class="settings-field-label" for="payment_account___KEY___details">Datos de cuenta</label>
                      <textarea name="payment_accounts[items][__KEY__][details]" id="payment_account___KEY___details" rows="8" class="settings-textarea" placeholder="Ej.&#10;Banco: BBVA&#10;Alias: XXX.XXX.XXX&#10;CBU: 999999999999999999&#10;Titular: Juan Pérez&#10;CUIT/CUIL: 2099999999-9"></textarea>
                      <p class="settings-field-hint">Se muestra como texto en el link de comprobante. No subas imagen: pegá los datos completos acá.</p>
                    </div>
                  </div>
                </article>
              </template>
              </section>
            </div>
          </section>

          <section class="settings-card settings-section-panel" id="horarios-de-atencion" data-settings-panel="horarios-de-atencion" data-settings-schedule <%= "hidden" unless @settings_active_tab == "horarios-de-atencion" %>>
            <div class="settings-card-body">
            <p class="settings-content-eyebrow">Horarios</p>
            <h2 class="settings-schedule-heading">Horarios de atención</h2>
            <p class="settings-schedule-copy">
              Informá a los clientes el horario habitual del centro. Se mostrará en el perfil público y se usará como base para calcular disponibilidad.
            </p>

            <div class="settings-schedule-day-pills">
              <% availability_rules.each do |rule| %>
                <% short_name = rule.fetch(:day_name).first(3) %>
                <button type="button" class="settings-schedule-pill <%= "is-active" if rule.fetch(:active) %>" data-schedule-day-pill="<%= rule.fetch(:weekday) %>">
                  <%= short_name %>
                </button>
              <% end %>
            </div>

            <% first_active_weekday = availability_rules.find { |rule| rule.fetch(:active) }&.fetch(:weekday) %>
            <div class="settings-schedule-rows">
              <% availability_rules.each do |rule| %>
                <% weekday = rule.fetch(:weekday) %>
                <% has_second_period = rule[:break_start_time].present? && rule[:break_end_time].present? %>
                <% show_copy_prompt = has_second_period && weekday == first_active_weekday %>
                <% first_period_end = has_second_period ? rule[:break_start_time] : rule[:end_time] %>
                <% second_period_start = rule[:break_end_time].presence || "15:00" %>
                <div class="settings-schedule-row <%= "hidden" unless rule.fetch(:active) %>" data-schedule-day-row="<%= weekday %>">
                  <div>
                    <button type="button" class="settings-schedule-day-button" data-schedule-day-toggle>
                      <span class="settings-schedule-day-name"><%= rule.fetch(:day_name) %></span>
                      <span class="settings-schedule-status <%= "is-active" if rule.fetch(:active) %>" data-schedule-status>
                        <%= rule.fetch(:active) ? "Abierto" : "Cerrado" %>
                      </span>
                    </button>
                  </div>

                  <div class="settings-schedule-periods" data-schedule-periods>
                    <%= hidden_field_tag "availability_rules[#{weekday}][active]", rule.fetch(:active) ? "1" : "0", data: { schedule_active_field: true } %>
                    <%= hidden_field_tag "availability_rules[#{weekday}][start_time]", rule[:start_time], data: { schedule_start_field: true } %>
                    <%= hidden_field_tag "availability_rules[#{weekday}][end_time]", rule[:end_time], data: { schedule_end_field: true } %>
                    <%= hidden_field_tag "availability_rules[#{weekday}][break_start_time]", rule[:break_start_time], data: { schedule_break_start_field: true } %>
                    <%= hidden_field_tag "availability_rules[#{weekday}][break_end_time]", rule[:break_end_time], data: { schedule_break_end_field: true } %>

                    <div class="settings-schedule-period" data-schedule-period="0">
                      <%= select_tag nil, options_for_select(time_options, rule[:start_time]), class: "settings-schedule-select", data: { schedule_period_start: true } %>
                      <span class="settings-schedule-until">Hasta</span>
                      <%= select_tag nil, options_for_select(time_options, first_period_end), class: "settings-schedule-select", data: { schedule_period_end: true } %>
                      <button type="button" class="settings-schedule-icon-button" data-schedule-add-period aria-label="Agregar otra franja">+</button>
                    </div>

                    <div class="settings-schedule-period <%= "hidden" unless has_second_period %>" data-schedule-extra-period data-schedule-period="1">
                      <%= select_tag nil, options_for_select(time_options, second_period_start), class: "settings-schedule-select", data: { schedule_period_start: true } %>
                      <span class="settings-schedule-until">Hasta</span>
                      <%= select_tag nil, options_for_select(time_options, rule[:end_time]), class: "settings-schedule-select", data: { schedule_period_end: true } %>
                      <button type="button" class="settings-schedule-icon-button remove" data-schedule-remove-period aria-label="Quitar franja">×</button>
                    </div>

                    <div class="settings-schedule-copy-prompt <%= "hidden" unless show_copy_prompt %>" data-schedule-copy-prompt>
                      <div class="settings-schedule-copy-prompt-inner">
                        <p>¿Deseas copiar este horario laboral a los demás días?</p>
                        <button type="button" class="settings-schedule-copy-button" data-schedule-copy-open-days>
                          Sí, copiar
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
            </div>
          </section>

          <section class="settings-card settings-section-panel" id="fechas-no-laborables" data-settings-panel="fechas-no-laborables" <%= "hidden" unless @settings_active_tab == "fechas-no-laborables" %>>
            <div class="settings-card-body">
              <p class="settings-content-eyebrow">Disponibilidad</p>
              <h2 class="settings-schedule-heading">Fechas no laborables</h2>
              <p class="settings-schedule-copy">
                Bloqueá períodos completos en los que el negocio no tomará reservas. Se verán como no disponibles en el calendario y no se ofrecerán turnos online.
              </p>

              <div class="settings-non-working-form">
                <div>
                  <label class="settings-field-label" for="non_working_period_starts_on_display">Fecha desde</label>
                  <div class="settings-date-input" data-controller="date-picker">
                    <%= hidden_field_tag "non_working_period[starts_on]", nil, id: "non_working_period_starts_on", form: "non-working-period-form", data: { date_picker_target: "value", non_working_date_input: true } %>
                    <%= tag.input type: "text",
                      id: "non_working_period_starts_on_display",
                      class: "settings-input settings-date-picker-display",
                      placeholder: "dd/mm/aaaa",
                      autocomplete: "off",
                      inputmode: "none",
                      aria: { haspopup: "dialog", expanded: "false", readonly: "true" },
                      data: {
                        date_picker_target: "display",
                        non_working_date_display: true,
                        action: "click->date-picker#open focus->date-picker#open keydown->date-picker#keydown beforeinput->date-picker#preventManualInput paste->date-picker#preventManualInput"
                      } %>
                    <button type="button" class="settings-date-picker-button" aria-label="Abrir calendario" data-action="date-picker#toggle" tabindex="-1"><%= settings_icons.fetch(:calendar).html_safe %></button>
                    <div class="settings-date-picker-calendar" role="dialog" aria-label="Calendario" data-date-picker-target="calendar" hidden></div>
                  </div>
                </div>
                <div>
                  <label class="settings-field-label" for="non_working_period_ends_on_display">Fecha hasta</label>
                  <div class="settings-date-input" data-controller="date-picker">
                    <%= hidden_field_tag "non_working_period[ends_on]", nil, id: "non_working_period_ends_on", form: "non-working-period-form", data: { date_picker_target: "value", non_working_date_input: true } %>
                    <%= tag.input type: "text",
                      id: "non_working_period_ends_on_display",
                      class: "settings-input settings-date-picker-display",
                      placeholder: "dd/mm/aaaa",
                      autocomplete: "off",
                      inputmode: "none",
                      aria: { haspopup: "dialog", expanded: "false", readonly: "true" },
                      data: {
                        date_picker_target: "display",
                        non_working_date_display: true,
                        action: "click->date-picker#open focus->date-picker#open keydown->date-picker#keydown beforeinput->date-picker#preventManualInput paste->date-picker#preventManualInput"
                      } %>
                    <button type="button" class="settings-date-picker-button" aria-label="Abrir calendario" data-action="date-picker#toggle" tabindex="-1"><%= settings_icons.fetch(:calendar).html_safe %></button>
                    <div class="settings-date-picker-calendar" role="dialog" aria-label="Calendario" data-date-picker-target="calendar" hidden></div>
                  </div>
                </div>
                <button type="submit" form="non-working-period-form" class="settings-non-working-add">Añadir nueva</button>
              </div>

              <% if non_working_periods.any? %>
                <div class="settings-non-working-list">
                  <% non_working_periods.each do |period| %>
                    <% starts_on = period.starts_at.to_date %>
                    <% ends_on = period.ends_at.to_date - 1.day %>
                    <article class="settings-non-working-period">
                      <div class="settings-non-working-period-copy">
                        <p class="settings-non-working-period-title">
                          <%= starts_on == ends_on ? "Día no laborable" : "Período no laborable" %>
                        </p>
                        <p>
                          <%= starts_on == ends_on ? l(starts_on, format: :short) : "#{l(starts_on, format: :short)} al #{l(ends_on, format: :short)}" %>
                        </p>
                      </div>
                      <%= link_to "Eliminar", admin_non_working_period_path(period), class: "settings-non-working-remove", data: { turbo_method: :delete, turbo_confirm: "¿Eliminar este período no laborable?" } %>
                    </article>
                  <% end %>
                </div>
              <% else %>
                <p class="settings-non-working-empty">Todavía no agregaste fechas no laborables.</p>
              <% end %>
            </div>
          </section>
        </main>
      </div>
      <div class="settings-save-footer">
        <button type="submit" class="settings-button settings-button-primary">
          Guardar cambios
        </button>
      </div>
    </div>
  <% end %>
</section>

<script>
  (() => {
    const form = document.getElementById("admin-settings-form");
    const activeSettingsTabInput = form?.querySelector("[data-settings-active-tab]");
    const navLinks = Array.from(document.querySelectorAll("[data-settings-nav-link]"));
    const settingsPanels = Array.from(document.querySelectorAll("[data-settings-panel]"));
    const businessNameInput = form?.querySelector("[data-business-name-source]");
    const slugInput = form?.querySelector("[data-public-slug-input]");
    const instagramInput = form?.querySelector("[data-instagram-handle-input]");
    const logoInput = form?.querySelector("[data-logo-input]");
    const logoPreview = form?.querySelector("[data-logo-preview]");
    const logoPreviewImage = form?.querySelector("[data-logo-preview-image]");
    const logoPreviewTitle = form?.querySelector("[data-logo-preview-title]");
    const logoPreviewHint = form?.querySelector("[data-logo-preview-hint]");
    const paymentMethodToggles = Array.from(document.querySelectorAll("[data-payment-method-toggle]"));
    const bookingProfessionalSelectionToggle = form?.querySelector("[data-booking-professional-selection-toggle]");
    const bookingProfessionalSelectionNotice = form?.querySelector("[data-booking-professional-selection-notice]");
    const bookingAssignmentStrategies = form?.querySelector("[data-booking-assignment-strategies]");
    const publicSiteModeInputs = Array.from(document.querySelectorAll("[data-public-site-mode-input]"));
    const webDesignNavigation = Array.from(document.querySelectorAll("[data-web-design-navigation]"));
    const webDesignPanel = document.querySelector("[data-web-design-panel]");
    const fullWebsiteNotice = form?.querySelector("[data-full-website-notice]");
    const publicCustomHtmlInput = form?.querySelector("[data-public-custom-html-input]");
    const publicCustomHtmlPreview = document.querySelector("[data-public-custom-html-preview]");
    const publicCustomHtmlStarter = document.querySelector("[data-public-custom-html-starter]");
    const publicCategoryCustomHtmlInput = form?.querySelector("[data-public-category-custom-html-input]");
    const publicCategoryCustomHtmlPreview = document.querySelector("[data-public-category-custom-html-preview]");
    const publicCategoryCustomHtmlStarter = document.querySelector("[data-public-category-custom-html-starter]");
    let slugWasEdited = Boolean(slugInput?.value.trim());
    let logoPreviewUrl = null;

    const slugify = (value) => value
      .toString()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");

    const cleanInstagramHandle = (value) => value
      .toString()
      .trim()
      .replace(/^https?:\/\/(www\.)?instagram\.com\//i, "")
      .replace(/^@/, "")
      .replace(/\/+$/g, "");

    const customSectionsPreviewCss = `
      * { box-sizing: border-box; }
      body { margin: 0; color: #17202a; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
      .ht-custom-sections { overflow: clip; }
      .ht-section { padding: clamp(2.5rem, 8vw, 5rem) 1.25rem; }
      .ht-section__inner { width: min(100%, 72rem); margin-inline: auto; }
      .ht-section__eyebrow { margin: 0 0 .75rem; font-size: .72rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; opacity: .7; }
      .ht-section h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1.05; }
      .ht-section p { line-height: 1.7; }
      .ht-section img { display: block; max-width: 100%; }
      .ht-about__image { width: 100%; border-radius: 1.5rem; object-fit: cover; }
      @media (min-width: 768px) {
        .ht-about .ht-section__inner { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); align-items: center; gap: clamp(2.5rem, 6vw, 6rem); }
      }
    `;

    const previewTemplateValues = {
      "{{business_name}}": "Tu centro",
      "{{business_slogan}}": "Tu momento de bienestar empieza acá",
      "{{business_intro}}": "Contá acá la propuesta de tu centro.",
      "{{business_phone}}": "+54 9 11 0000-0000",
      "{{business_email}}": "hola@tucentro.com",
      "{{business_address}}": "Tu dirección, Ciudad",
      "{{business_instagram_url}}": "https://instagram.com/tucentro",
      "{{business_instagram_handle}}": "@tucentro",
      "{{business_whatsapp_url}}": "https://wa.me/5491100000000",
      "{{business_logo_url}}": "https://images.example.com/logo.png",
      "{{home_url}}": "/tu-centro",
      "{{services_url}}": "/tu-centro#servicios",
      "{{current_year}}": new Date().getFullYear().toString(),
      "{{category_name}}": "Experiencias de spa",
      "{{category_name_uppercase}}": "EXPERIENCIAS DE SPA",
      "{{category_description}}": "Una selección de tratamientos para disfrutar y relajarte.",
      "{{category_url}}": "/tu-centro/experiencias-de-spa",
      "{{category_service_count}}": "3"
    };

    const previewHtml = (html) => Object.entries(previewTemplateValues).reduce(
      (renderedHtml, [placeholder, value]) => renderedHtml.split(placeholder).join(value),
      html
    );

    const syncCustomSectionsPreview = (input, preview, emptyMessage) => {
      if (!preview) return;

      const html = input?.value.trim() || `<div style="display:grid;min-height:100%;place-items:center;padding:2rem;text-align:center;color:#64748b;font-weight:700">${emptyMessage}</div>`;
      preview.srcdoc = `<!doctype html>
        <html lang="es">
          <head>
            <meta charset="utf-8">
            <meta name="viewport" content="width=device-width, initial-scale=1">
            <style>${customSectionsPreviewCss}</style>
          </head>
          <body><div class="ht-custom-sections">${previewHtml(html)}</div></body>
        </html>`;
    };

    const syncHomeCustomHtmlPreview = () => syncCustomSectionsPreview(
      publicCustomHtmlInput,
      publicCustomHtmlPreview,
      "Pegá o escribí el HTML de inicio para verlo acá."
    );

    const syncCategoryCustomHtmlPreview = () => syncCustomSectionsPreview(
      publicCategoryCustomHtmlInput,
      publicCategoryCustomHtmlPreview,
      "Pegá o escribí el HTML de categorías para verlo acá."
    );

    const starterCustomSectionHtml = `<style>
.ht-about { background: #f2ede3; color: #2b211b; }
.ht-about__image { min-height: 340px; object-fit: cover; }
</style>

<section class="ht-section ht-about">
  <div class="ht-section__inner">
    <div>
      <p class="ht-section__eyebrow">Quiénes somos</p>
      <h2>{{business_name}}</h2>
      <p>{{business_intro}}</p>
    </div>
  </div>
</section>

<div data-dog-grooming-slot="categories"></div>`;

    const starterCategoryCustomSectionHtml = `<style>
.ht-category-hero { background: #0b1957; color: #fff; padding: 5rem 1.25rem; text-align: center; }
.ht-category-hero h1 { margin: 0; font-size: clamp(2.5rem, 7vw, 5rem); }
.ht-category-services { padding: 4rem 1.25rem; }
.ht-category-services__inner { width: min(100%, 72rem); margin: auto; }
</style>

<section class="ht-category-hero">
  <p>Servicios de {{business_name}}</p>
  <h1>{{category_name_uppercase}}</h1>
  <p>{{category_description}}</p>
</section>

<section class="ht-category-services">
  <div class="ht-category-services__inner">
  <h2>Servicios para mascotas</h2>
  <div data-dog-grooming-slot="services"></div>
  </div>
</section>`;

    const panelIdForLink = (link) => link.dataset.settingsPanelLink || link.getAttribute("href")?.replace(/^#/, "");

    const showSettingsPanel = (panelId, updateHash = false) => {
      if (!panelId || !settingsPanels.some((panel) => panel.id === panelId)) return;

      if (activeSettingsTabInput) activeSettingsTabInput.value = panelId;
      settingsPanels.forEach((panel) => {
        panel.hidden = panel.id !== panelId;
      });
      navLinks.forEach((link) => {
        link.classList.toggle("is-active", panelIdForLink(link) === panelId);
      });

      if (form) {
        const formUrl = new URL(form.action, window.location.origin);
        formUrl.searchParams.set("settings_tab", panelId);
        form.action = `${formUrl.pathname}${formUrl.search}`;
      }

      if (updateHash && window.history?.replaceState) {
        window.history.replaceState(null, "", `#${panelId}`);
      }
    };

    navLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        showSettingsPanel(panelIdForLink(link), true);
      });
    });

    const settingsPanelFromHash = () => window.location.hash.replace(/^#/, "");

    window.addEventListener("hashchange", () => {
      showSettingsPanel(settingsPanelFromHash());
    });

    const fullWebsiteSelected = () => publicSiteModeInputs.some((input) => input.checked && input.value === "full_website");

    const syncPublicSiteMode = () => {
      const fullWebsite = fullWebsiteSelected();
      webDesignNavigation.forEach((link) => { link.hidden = !fullWebsite; });
      if (fullWebsiteNotice) fullWebsiteNotice.hidden = !fullWebsite;
      if (!fullWebsite && !webDesignPanel?.hidden) showSettingsPanel("pagina-de-reservas", true);
    };

    publicSiteModeInputs.forEach((input) => input.addEventListener("change", syncPublicSiteMode));
    syncPublicSiteMode();

    publicCustomHtmlInput?.addEventListener("input", syncHomeCustomHtmlPreview);
    publicCustomHtmlStarter?.addEventListener("click", () => {
      if (!publicCustomHtmlInput) return;
      if (publicCustomHtmlInput.value.trim() && !window.confirm("Esto reemplazará el HTML actual de las secciones. ¿Querés continuar?")) return;

      publicCustomHtmlInput.value = starterCustomSectionHtml;
      syncHomeCustomHtmlPreview();
      publicCustomHtmlInput.focus();
    });
    publicCategoryCustomHtmlInput?.addEventListener("input", syncCategoryCustomHtmlPreview);
    publicCategoryCustomHtmlStarter?.addEventListener("click", () => {
      if (!publicCategoryCustomHtmlInput) return;
      if (publicCategoryCustomHtmlInput.value.trim() && !window.confirm("Esto reemplazará el HTML actual de las páginas de categorías. ¿Querés continuar?")) return;

      publicCategoryCustomHtmlInput.value = starterCategoryCustomSectionHtml;
      syncCategoryCustomHtmlPreview();
      publicCategoryCustomHtmlInput.focus();
    });
    syncHomeCustomHtmlPreview();
    syncCategoryCustomHtmlPreview();

    const requestedSettingsPanel = window.location.hash.replace(/^#/, "") || activeSettingsTabInput?.value || "datos-generales";
    showSettingsPanel(requestedSettingsPanel === "diseno-web" && !fullWebsiteSelected() ? "pagina-de-reservas" : requestedSettingsPanel);

    const settingsUrl = new URL(window.location.href);
    const activeSettingsPanel = activeSettingsTabInput?.value;
    if (settingsUrl.searchParams.has("settings_tab") && activeSettingsPanel && window.history?.replaceState) {
      settingsUrl.searchParams.delete("settings_tab");
      settingsUrl.hash = activeSettingsPanel;
      window.history.replaceState(null, "", `${settingsUrl.pathname}${settingsUrl.search}${settingsUrl.hash}`);
    }

    const nonWorkingPeriodForm = document.getElementById("non-working-period-form");
    const nonWorkingPeriodStartsOn = document.getElementById("non_working_period_starts_on");
    const nonWorkingPeriodEndsOn = document.getElementById("non_working_period_ends_on");
    const nonWorkingPeriodStartsOnDisplay = document.getElementById("non_working_period_starts_on_display");
    const nonWorkingPeriodEndsOnDisplay = document.getElementById("non_working_period_ends_on_display");

    const nextDateValue = (value) => {
      if (!value) return "";

      const date = new Date(`${value}T12:00:00`);
      date.setDate(date.getDate() + 1);
      return date.toISOString().slice(0, 10);
    };

    const validateNonWorkingPeriod = () => {
      if (!nonWorkingPeriodStartsOn || !nonWorkingPeriodEndsOn) return true;

      const startsOn = nonWorkingPeriodStartsOn.value;
      const endsOn = nonWorkingPeriodEndsOn.value;
      nonWorkingPeriodEndsOn.min = nextDateValue(startsOn);
      nonWorkingPeriodStartsOnDisplay?.setCustomValidity(startsOn ? "" : "Seleccioná la fecha desde.");
      nonWorkingPeriodEndsOnDisplay?.setCustomValidity(endsOn ? "" : "Seleccioná la fecha hasta.");

      if (startsOn && endsOn && endsOn <= startsOn) {
        nonWorkingPeriodEndsOnDisplay?.setCustomValidity("La fecha hasta debe ser posterior a la fecha desde.");
      }

      return Boolean(startsOn && endsOn && endsOn > startsOn);
    };

    nonWorkingPeriodStartsOn?.addEventListener("change", validateNonWorkingPeriod);
    nonWorkingPeriodEndsOn?.addEventListener("change", validateNonWorkingPeriod);
    nonWorkingPeriodForm?.addEventListener("submit", (event) => {
      if (validateNonWorkingPeriod()) return;

      event.preventDefault();
      if (!nonWorkingPeriodStartsOn.value) {
        nonWorkingPeriodStartsOnDisplay?.reportValidity();
      } else {
        nonWorkingPeriodEndsOnDisplay?.reportValidity();
      }
    });

    businessNameInput?.addEventListener("input", () => {
      if (!slugWasEdited && slugInput) slugInput.value = slugify(businessNameInput.value);
    });

    slugInput?.addEventListener("input", () => {
      slugWasEdited = true;
      slugInput.value = slugify(slugInput.value);
    });

    instagramInput?.addEventListener("input", () => {
      instagramInput.value = cleanInstagramHandle(instagramInput.value);
    });

    logoInput?.addEventListener("change", () => {
      const file = logoInput.files?.[0];
      if (logoPreviewUrl) URL.revokeObjectURL(logoPreviewUrl);
      logoPreviewUrl = null;

      if (!file || !logoPreview || !logoPreviewImage) return;

      logoPreviewUrl = URL.createObjectURL(file);
      logoPreviewImage.src = logoPreviewUrl;
      logoPreviewImage.hidden = false;
      logoPreviewImage.alt = `Logo seleccionado: ${file.name}`;
      logoPreview.classList.remove("hidden");
      if (logoPreviewTitle) logoPreviewTitle.textContent = "Logo seleccionado";
      if (logoPreviewHint) logoPreviewHint.textContent = "Vista previa antes de guardar los cambios.";
    });

    const syncPaymentMethodSections = (changedToggle = null) => {
      if (changedToggle?.checked) {
        paymentMethodToggles.forEach((toggle) => {
          if (toggle !== changedToggle) toggle.checked = false;
        });
      }

      paymentMethodToggles.forEach((toggle) => {
        const section = document.querySelector(`[data-payment-method-section="${toggle.dataset.paymentMethodToggle}"]`);
        if (section) section.hidden = !toggle.checked;
      });
    };

    paymentMethodToggles.forEach((toggle) => toggle.addEventListener("change", () => syncPaymentMethodSections(toggle)));
    syncPaymentMethodSections();

    const syncBookingAssignmentSettings = () => {
      const allowSelection = Boolean(bookingProfessionalSelectionToggle?.checked);
      if (bookingProfessionalSelectionNotice) bookingProfessionalSelectionNotice.hidden = !allowSelection;
      if (bookingAssignmentStrategies) bookingAssignmentStrategies.hidden = allowSelection;
    };

    bookingProfessionalSelectionToggle?.addEventListener("change", syncBookingAssignmentSettings);
    syncBookingAssignmentSettings();

    const scheduleRoot = document.querySelector("[data-settings-schedule]");
    const scheduleRows = scheduleRoot ? Array.from(scheduleRoot.querySelectorAll("[data-schedule-day-row]")) : [];

    const hasVisibleSecondPeriod = (row) => {
      const secondPeriod = row.querySelector("[data-schedule-extra-period]");
      return Boolean(secondPeriod && !secondPeriod.classList.contains("hidden"));
    };

    const updateScheduleCopyPrompts = () => {
      const firstActiveRow = scheduleRows.find((row) => row.dataset.scheduleActive === "1");

      scheduleRows.forEach((row) => {
        const prompt = row.querySelector("[data-schedule-copy-prompt]");
        prompt?.classList.toggle("hidden", row !== firstActiveRow || !hasVisibleSecondPeriod(row));
      });
    };

    const syncScheduleRow = (row) => {
      const activeField = row.querySelector("[data-schedule-active-field]");
      const startField = row.querySelector("[data-schedule-start-field]");
      const endField = row.querySelector("[data-schedule-end-field]");
      const breakStartField = row.querySelector("[data-schedule-break-start-field]");
      const breakEndField = row.querySelector("[data-schedule-break-end-field]");
      const firstPeriod = row.querySelector("[data-schedule-period='0']");
      const secondPeriod = row.querySelector("[data-schedule-extra-period]");
      const hasSecondPeriod = secondPeriod && !secondPeriod.classList.contains("hidden");

      if (!activeField || !startField || !endField || !breakStartField || !breakEndField || !firstPeriod) return;

      const firstStart = firstPeriod.querySelector("[data-schedule-period-start]")?.value || "10:00";
      const firstEnd = firstPeriod.querySelector("[data-schedule-period-end]")?.value || "19:00";
      const secondStart = secondPeriod?.querySelector("[data-schedule-period-start]")?.value || "15:00";
      const secondEnd = secondPeriod?.querySelector("[data-schedule-period-end]")?.value || "19:00";

      startField.value = firstStart;
      endField.value = hasSecondPeriod ? secondEnd : firstEnd;
      breakStartField.value = hasSecondPeriod ? firstEnd : "";
      breakEndField.value = hasSecondPeriod ? secondStart : "";
      activeField.value = row.dataset.scheduleActive === "1" ? "1" : "0";
    };

    const setScheduleActive = (row, active) => {
      row.dataset.scheduleActive = active ? "1" : "0";
      const weekday = row.dataset.scheduleDayRow;
      const pill = scheduleRoot?.querySelector(`[data-schedule-day-pill="${weekday}"]`);
      const status = row.querySelector("[data-schedule-status]");

      row.classList.toggle("hidden", !active);
      if (status) {
        status.textContent = active ? "Abierto" : "Cerrado";
        status.classList.toggle("is-active", active);
      }
      pill?.classList.toggle("is-active", active);
      syncScheduleRow(row);
      updateScheduleCopyPrompts();
    };

    scheduleRows.forEach((row) => {
      const active = row.querySelector("[data-schedule-active-field]")?.value === "1";
      setScheduleActive(row, active);

      row.querySelector("[data-schedule-day-toggle]")?.addEventListener("click", () => {
        setScheduleActive(row, row.dataset.scheduleActive !== "1");
      });

      scheduleRoot?.querySelector(`[data-schedule-day-pill="${row.dataset.scheduleDayRow}"]`)?.addEventListener("click", () => {
        setScheduleActive(row, row.dataset.scheduleActive !== "1");
      });

      row.querySelector("[data-schedule-add-period]")?.addEventListener("click", () => {
        row.querySelector("[data-schedule-extra-period]")?.classList.remove("hidden");
        syncScheduleRow(row);
        updateScheduleCopyPrompts();
      });

      row.querySelector("[data-schedule-remove-period]")?.addEventListener("click", () => {
        row.querySelector("[data-schedule-extra-period]")?.classList.add("hidden");
        syncScheduleRow(row);
        updateScheduleCopyPrompts();
      });

      row.querySelectorAll("[data-schedule-period-start], [data-schedule-period-end]").forEach((select) => {
        select.addEventListener("change", () => syncScheduleRow(row));
      });
    });

    scheduleRoot?.querySelectorAll("[data-schedule-copy-open-days]").forEach((button) => button.addEventListener("click", () => {
      const sourceRow = button.closest("[data-schedule-day-row]");
      if (!sourceRow) return;

      const sourcePeriods = Array.from(sourceRow.querySelectorAll("[data-schedule-period]"));
      const sourceHasSecond = !sourceRow.querySelector("[data-schedule-extra-period]")?.classList.contains("hidden");
      scheduleRows.filter((row) => row !== sourceRow && row.dataset.scheduleActive === "1").forEach((row) => {
        const periods = Array.from(row.querySelectorAll("[data-schedule-period]"));
        periods.forEach((period, index) => {
          const source = sourcePeriods[index];
          if (!source) return;

          period.querySelector("[data-schedule-period-start]").value = source.querySelector("[data-schedule-period-start]").value;
          period.querySelector("[data-schedule-period-end]").value = source.querySelector("[data-schedule-period-end]").value;
        });
        row.querySelector("[data-schedule-extra-period]")?.classList.toggle("hidden", !sourceHasSecond);
        syncScheduleRow(row);
      });
      updateScheduleCopyPrompts();
    }));

    const paymentAccountsRoot = document.querySelector("[data-payment-accounts]");
    const paymentAccountList = paymentAccountsRoot?.querySelector("[data-payment-account-list]");
    const paymentAccountTemplate = paymentAccountsRoot?.querySelector("[data-payment-account-template]");
    const paymentAccountEmpty = paymentAccountsRoot?.querySelector("[data-payment-account-empty]");
    const paymentAccountAdd = paymentAccountsRoot?.querySelector("[data-payment-account-add]");
    const paymentAccountCountBadge = document.querySelector("[data-payment-account-count-badge]");

    const visiblePaymentAccountRows = () => Array.from(paymentAccountList?.querySelectorAll("[data-payment-account-row]") || [])
      .filter((row) => !row.classList.contains("is-destroyed"));

    const syncPaymentAccountState = () => {
      const rows = visiblePaymentAccountRows();
      paymentAccountEmpty?.classList.toggle("hidden", rows.length > 0);
      if (paymentAccountCountBadge) paymentAccountCountBadge.textContent = rows.length;

      if (rows.length > 0 && !rows.some((row) => row.querySelector("[data-payment-account-primary]")?.checked)) {
        const firstRadio = rows[0].querySelector("[data-payment-account-primary]");
        if (firstRadio) firstRadio.checked = true;
      }

      rows.forEach((row) => {
        const radio = row.querySelector("[data-payment-account-primary]");
        row.querySelector("[data-payment-account-primary-badge]")?.toggleAttribute("hidden", !radio?.checked);
      });
    };

    const setupPaymentAccountRow = (row) => {
      row.querySelector("[data-payment-account-primary]")?.addEventListener("change", syncPaymentAccountState);
      row.querySelector("[data-payment-account-remove]")?.addEventListener("click", () => {
        const destroyField = row.querySelector("[data-payment-account-destroy]");
        const radio = row.querySelector("[data-payment-account-primary]");

        if (destroyField) destroyField.value = "1";
        if (radio) radio.checked = false;
        row.classList.add("is-destroyed");
        syncPaymentAccountState();
      });
    };

    paymentAccountList?.querySelectorAll("[data-payment-account-row]").forEach(setupPaymentAccountRow);
    paymentAccountAdd?.addEventListener("click", () => {
      if (!paymentAccountTemplate || !paymentAccountList) return;

      const key = `new_${Date.now()}_${Math.random().toString(16).slice(2)}`;
      const wrapper = document.createElement("div");
      wrapper.innerHTML = paymentAccountTemplate.innerHTML.replaceAll("__KEY__", key);
      const row = wrapper.firstElementChild;
      if (!row) return;

      paymentAccountList.appendChild(row);
      setupPaymentAccountRow(row);
      syncPaymentAccountState();
      row.querySelector(".settings-input")?.focus();
      row.scrollIntoView({ behavior: "smooth", block: "center" });
    });
    syncPaymentAccountState();

    form?.addEventListener("submit", () => {
      if (instagramInput) {
        const handle = cleanInstagramHandle(instagramInput.value);
        instagramInput.value = handle ? `https://www.instagram.com/${handle}` : "";
      }
      scheduleRows.forEach(syncScheduleRow);
    });
  })();
</script>
