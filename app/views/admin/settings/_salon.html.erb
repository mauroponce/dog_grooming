<section class="my-6 rounded-2xl bg-white p-5">
  <h2 class="mb-4 text-xl font-bold">Cupos y automatización</h2>
  <%= form_with url: admin_settings_path, method: :patch do %>
    <%= render "shared/salon_configuration", business: @business %>
    <% Business::DAYS.each do |day, name| %>
      <div class="mb-3"><%= label_tag "agenda_times_#{day}", "#{name}: tandas", class: "block text-sm font-semibold" %><%= text_field_tag "agenda_times[#{day}]", Array(@business.arrival_times[day.to_s]).join(", "), id: "agenda_times_#{day}", placeholder: "09:00, 12:00, 15:00", class: "rounded-md border-slate-300" %></div>
    <% end %>
    <%= submit_tag "Guardar cupos", class: "rounded-xl bg-slate-950 px-4 py-3 font-bold text-white" %>
  <% end %>
</section>
