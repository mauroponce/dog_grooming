<section class="my-6 rounded-2xl bg-white p-5">
  <h2 class="text-xl font-bold">WhatsApp Business</h2>
  <p class="mt-2 text-sm text-slate-600">Conectá tu número existente y seguí usando WhatsApp Business en tu celular. La automatización queda desactivada hasta completar las pruebas.</p>
  <p class="mt-2 text-sm text-slate-600">Conexión oficial mediante WhatsApp Business App Coexistence.</p>
  <% connection = @business.whatsapp_connection %>
  <% if connection&.connected? %>
    <p class="my-3 font-semibold">WhatsApp conectado<%= " · Coexistence verificado" if connection.coexistence? %></p>
    <p class="text-sm text-slate-600">Automatización: <%= connection.automation_enabled? && WhatsApp.automation_enabled?(connection.business) ? "habilitada" : "desactivada" %></p>
    <% expiration = [connection.token_expires_at, connection.data_access_expires_at].compact.min %>
    <% if expiration %>
      <p class="text-sm text-slate-600">Credenciales válidas hasta <%= l(expiration.to_date) %>. Renovación mediante reconexión segura con Meta.</p>
    <% end %>
    <% if connection.reconnect_soon? %>
      <p class="mt-2 text-sm text-amber-800">Las credenciales están por vencer. Volvé a conectar tu cuenta.</p>
    <% end %>
    <% if connection.sync_metadata.values.any? { |sync| sync.is_a?(Hash) && sync["state"].in?(%w[unknown failed]) } %>
      <p class="mt-2 text-sm text-amber-800">La sincronización inicial requiere revisión. No habilites el bot todavía.</p>
    <% end %>
    <%= button_to "Verificar conexión", admin_whatsapp_connection_path, method: :patch, class: "my-2 rounded-xl border px-4 py-2" %>
    <%= button_to "Desconectar automatización", admin_whatsapp_connection_path, method: :delete, class: "rounded-xl border px-4 py-2" %>
  <% elsif connection %>
    <p class="my-3 text-sm text-amber-800">WhatsApp desconectado o autorización vencida. Volvé a conectar tu cuenta.</p>
  <% end %>
  <% if WhatsApp::SignupConfiguration.configured? && WhatsApp::SignupConfiguration.v4_confirmed? %>
    <p class="mt-3 text-sm text-slate-600">Elegí conectar tu aplicación WhatsApp Business existente. Si Meta propone migrar o eliminar el número de la app, cancelá: ese flujo no está permitido.</p>
    <div data-controller="whatsapp-signup" data-whatsapp-signup-app-id-value="<%= ENV.fetch('META_APP_ID') %>" data-whatsapp-signup-config-id-value="<%= ENV.fetch('META_CONFIG_ID') %>" data-whatsapp-signup-version-value="<%= WhatsApp::SignupConfiguration.graph_version %>">
      <button type="button" disabled data-whatsapp-signup-target="button" data-action="whatsapp-signup#login" class="mt-4 rounded-xl bg-emerald-700 px-4 py-3 font-bold text-white"><%= connection ? "Volver a conectar WhatsApp Business" : "Conectar WhatsApp Business" %></button>
      <p data-whatsapp-signup-target="status" role="status"></p>
      <%= form_with url: admin_whatsapp_connection_path, data: { whatsapp_signup_target: "form", turbo: false } do %>
        <%= hidden_field_tag :state, @whatsapp_signup_state %>
        <%= hidden_field_tag :code, nil, data: { whatsapp_signup_target: "code" } %>
        <%= hidden_field_tag :signup_event, nil, data: { whatsapp_signup_target: "event" } %>
        <%= hidden_field_tag :waba_id, nil, data: { whatsapp_signup_target: "waba" } %>
        <%= hidden_field_tag :phone_number_id, nil, data: { whatsapp_signup_target: "phone" } %>
      <% end %>
    </div>
  <% else %>
    <button type="button" disabled class="mt-4 rounded-xl border px-4 py-3">Conectar WhatsApp Business</button>
    <p class="mt-3 text-sm text-amber-800">Conexión pendiente de habilitación: CitaPet debe confirmar la configuración v4 de Meta, sus productos y permisos avanzados antes de abrir Coexistence. No se iniciará un flujo antiguo.</p>
  <% end %>
</section>
