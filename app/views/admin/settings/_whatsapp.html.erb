<section class="my-6 rounded-2xl bg-white p-5">
  <h2 class="text-xl font-bold">WhatsApp Business</h2>
  <p class="mt-2 text-sm text-slate-600">Conectá tu línea para recibir reservas automáticas y seguir respondiendo desde tu app de WhatsApp Business.</p>
  <% connection = @business.whatsapp_connection %>
  <% if connection&.connected? %>
    <p class="my-3 font-semibold">Conectado · <%= connection.templates_approved? ? "Plantillas PRO aprobadas" : "Plantillas PRO pendientes" %></p>
    <%= button_to "Verificar plantillas de Meta", admin_whatsapp_connection_path, method: :patch, class: "my-2 rounded-xl border px-4 py-2" %>
    <%= button_to "Desconectar automatización", admin_whatsapp_connection_path, method: :delete, class: "rounded-xl border px-4 py-2" %>
  <% elsif ENV["META_APP_ID"].present? && ENV["META_SIGNUP_CONFIG_ID"].present? %>
    <% session[:whatsapp_signup_state] = SecureRandom.urlsafe_base64(24) %>
    <div data-controller="whatsapp-signup" data-whatsapp-signup-app-id-value="<%= ENV.fetch('META_APP_ID') %>" data-whatsapp-signup-config-id-value="<%= ENV.fetch('META_SIGNUP_CONFIG_ID') %>" data-whatsapp-signup-version-value="<%= ENV.fetch('META_GRAPH_VERSION', 'v25.0') %>">
      <button type="button" data-whatsapp-signup-target="button" data-action="whatsapp-signup#login" class="mt-4 rounded-xl bg-emerald-700 px-4 py-3 font-bold text-white">Conectar WhatsApp Business</button>
      <p data-whatsapp-signup-target="status" role="status"></p>
      <%= form_with url: admin_whatsapp_connection_path, data: { whatsapp_signup_target: "form", turbo: false } do %>
        <%= hidden_field_tag :state, session[:whatsapp_signup_state] %>
        <%= hidden_field_tag :code, nil, data: { whatsapp_signup_target: "code" } %>
        <%= hidden_field_tag :waba_id, nil, data: { whatsapp_signup_target: "waba" } %>
        <%= hidden_field_tag :phone_number_id, nil, data: { whatsapp_signup_target: "phone" } %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-3 text-sm text-slate-600">La conexión estará disponible cuando Cita.pet complete la habilitación con Meta.</p>
  <% end %>
</section>
