<% content_for :title, "Extras · Cita.pet" %>
<div class="mx-auto max-w-6xl">
  <div class="mb-7 flex items-end justify-between"><div><p class="text-xs font-bold uppercase tracking-[.14em] text-brand-700">Menú</p><h1 class="mt-2 text-3xl font-bold text-zinc-950">Extras</h1><p class="mt-2 text-sm font-semibold text-zinc-600">Opcionales sin duración ni seña.</p></div><%= link_to "+ Añadir Extra", new_admin_extra_path, class: "inline-flex h-11 items-center rounded-2xl bg-zinc-950 px-5 text-sm font-bold text-white" %></div>
  <div class="grid gap-4 md:grid-cols-2">
    <% @extras.each do |extra| %><article class="rounded-3xl border border-zinc-200 bg-white p-5 shadow-sm"><div class="flex items-start justify-between gap-4"><div><h2 class="font-bold text-zinc-950"><%= extra.title %></h2><p class="mt-2 text-sm font-semibold text-zinc-600"><%= extra.description.presence || "Sin descripción." %></p></div><p class="font-bold text-zinc-950"><%= price_cents_label(extra.price_cents) %></p></div><div class="mt-5 flex items-center justify-between"><span class="rounded-full bg-<%= extra.public_visible? ? 'emerald' : 'zinc' %>-50 px-3 py-1 text-xs font-bold text-<%= extra.public_visible? ? 'emerald' : 'zinc' %>-700"><%= extra.public_visible? ? "Visible en reservas" : "Oculto" %></span><%= link_to "Editar", edit_admin_extra_path(extra), class: "font-bold text-brand-700" %></div></article><% end %>
  </div>
  <% if @extras.empty? %><div class="rounded-3xl border border-dashed border-zinc-300 bg-white p-12 text-center text-sm font-semibold text-zinc-600">Todavía no hay extras.</div><% end %>
</div>
