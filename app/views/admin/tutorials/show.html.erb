<% content_for :admin_full_bleed, true %>
<% content_for :title, "Tutoriales · Dog Grooming" %>

<% tutorial_icons = {
  book: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M8 6h8M8 10h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>'
} %>

<style>
  .tutorials-shell { box-sizing: border-box; height: 100%; min-height: 0; overflow-y: auto; overscroll-behavior: contain; background: radial-gradient(circle at 88% 0%, rgba(255, 222, 212, .09), transparent 30rem), #f7f7f8; color: #111114; }
  .tutorials-container { box-sizing: border-box; width: min(var(--admin-content-max-width, 1600px), calc(100% - var(--admin-content-horizontal-space, 48px))); margin: 0 auto; padding: 28px 0 64px; }
  .tutorials-title { margin: 0; color: #111114; font-size: 44px; font-weight: 700; letter-spacing: -.045em; line-height: 1.05; }
  .tutorials-layout { display: grid; grid-template-columns: 310px minmax(0, 1fr); align-items: start; gap: 28px; margin-top: 22px; }
  .tutorials-content-card, .tutorials-navigation { border: 1px solid rgba(228, 228, 231, .95); background: #fff; box-shadow: 0 20px 55px rgba(17, 17, 20, .08); }
  .tutorials-content-card { min-height: 0; overflow: hidden; border-radius: 30px; padding: 24px; }
  .tutorials-video-player { width: 100%; height: min(60dvh, 580px); overflow: hidden; border-radius: 18px; background: #18181b; }
  .tutorials-video-frame { display: block; width: 100%; height: 100%; border: 0; }
  .tutorials-navigation { position: sticky; top: 24px; border-radius: 24px; padding: 18px; }
  .tutorials-navigation-heading { display: flex; align-items: center; gap: 10px; padding: 4px 5px 15px; border-bottom: 1px solid #f0f0f2; }
  .tutorials-navigation-heading svg { width: 18px; height: 18px; color: #A63826; }
  .tutorials-navigation-heading p { margin: 0; color: #18181b; font-size: 13px; font-weight: 700; }
  .tutorials-navigation-list { display: grid; gap: 7px; margin-top: 14px; }
  .tutorials-navigation-link { display: block; border-radius: 14px; padding: 13px 14px; color: #52525b; font-size: 13px; font-weight: 700; line-height: 1.4; text-decoration: none; }
  .tutorials-navigation-link:hover { background: #ffded4; color: #A63826; }
  .tutorials-navigation-link.is-active { background: #ffded4; color: #A63826; font-weight: 700; }
  .tutorials-empty { display: grid; min-height: 430px; place-items: center; padding: 34px; text-align: center; }
  .tutorials-empty-icon { display: grid; width: 58px; height: 58px; place-items: center; border-radius: 20px; background: #ffded4; color: #A63826; }
  .tutorials-empty-icon svg { width: 28px; height: 28px; }
  .tutorials-empty h2 { margin: 17px 0 0; color: #18181b; font-size: 21px; font-weight: 700; letter-spacing: -.025em; }
  .tutorials-empty p { max-width: 420px; margin: 8px 0 0; color: #71717a; font-size: 14px; font-weight: 650; line-height: 1.55; }
  .tutorials-navigation-empty { margin: 14px 5px 4px; color: #a1a1aa; font-size: 13px; font-weight: 700; line-height: 1.5; }
  @media (max-width: 960px) { .tutorials-layout { grid-template-columns: minmax(0, 1fr); } .tutorials-navigation { position: static; } .tutorials-navigation-list { display: flex; overflow-x: auto; padding-bottom: 2px; } .tutorials-navigation-link { min-width: min(230px, 72vw); } }
  @media (max-width: 680px) { .tutorials-container { width: min(100% - 32px, var(--admin-content-max-width, 1600px)); padding: 26px 0 58px; } .tutorials-title { font-size: 34px; } .tutorials-layout { gap: 18px; margin-top: 20px; } .tutorials-content-card { padding: 16px; } .tutorials-video-player { height: auto; aspect-ratio: 16 / 9; } }
</style>

<section class="tutorials-shell">
  <div class="tutorials-container">
    <header>
      <h1 class="tutorials-title">Tutoriales</h1>
    </header>

    <div class="tutorials-layout">
      <aside class="tutorials-navigation" aria-label="Navegación de tutoriales">
        <div class="tutorials-navigation-heading">
          <%= tutorial_icons.fetch(:book).html_safe %>
          <p>Todos los tutoriales</p>
        </div>
        <% if @tutorials.any? %>
          <nav class="tutorials-navigation-list">
            <% @tutorials.each do |tutorial| %>
              <%= link_to tutorial.title, admin_tutorials_path(tutorial_id: tutorial.id), class: "tutorials-navigation-link #{'is-active' if tutorial == @selected_tutorial}", aria: { current: tutorial == @selected_tutorial ? "page" : nil } %>
            <% end %>
          </nav>
        <% else %>
          <p class="tutorials-navigation-empty">Todavía no hay tutoriales publicados.</p>
        <% end %>
      </aside>

      <main class="tutorials-content-card">
        <% if @selected_tutorial.present? %>
          <div class="tutorials-video-player">
            <iframe
              class="tutorials-video-frame"
              src="<%= @selected_tutorial.embed_url %>"
              title="<%= @selected_tutorial.title %>"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen>
            </iframe>
          </div>
        <% else %>
          <div class="tutorials-empty">
            <div>
              <span class="tutorials-empty-icon"><%= tutorial_icons.fetch(:book).html_safe %></span>
              <h2>Próximamente habrá tutoriales acá</h2>
              <p>Cuando el equipo de Dog Grooming publique una guía, la vas a encontrar en este espacio.</p>
            </div>
          </div>
        <% end %>
      </main>

    </div>
  </div>
</section>
