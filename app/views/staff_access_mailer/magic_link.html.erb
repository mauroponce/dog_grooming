<% content_for :email_preheader, "Entrá a tu panel de Cita.pet con este enlace seguro." %>
<% content_for :email_badge, "Acceso" %>
<% content_for :email_status, "Enlace seguro" %>
<% content_for :email_footer_note, "Este email fue enviado porque se solicitó acceso a una cuenta de Cita.pet." %>

<h1>Acceso a Cita.pet</h1>
<p>Entrá a tu panel desde este enlace seguro:</p>
<p><%= link_to "Ingresar a Cita.pet", @url, class: "email-button button" %></p>
<p>Este enlace vence en 20 minutos.</p>

<p>Si el botón no funciona, copiá y pegá este enlace en tu navegador:</p>
<p><%= link_to @url, @url, class: "email-link" %></p>
