<header class="border-b border-slate-100 bg-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-5 sm:px-6 lg:px-8">
    <%= link_to root_path, class: "flex items-center gap-3", aria: { label: "Volver a Cita.pet" } do %>
      <%= image_tag "/icon.png?v=4", alt: "", class: "h-10 w-10 rounded-2xl shadow-sm shadow-brand-600/20" %>
      <span class="text-lg font-bold tracking-tight text-slate-900">Cita.pet</span>
    <% end %>
    <nav class="flex gap-4 text-xs font-bold text-slate-500 sm:gap-6" aria-label="Páginas legales">
      <%= link_to "Privacidad", privacy_policy_path, class: "hover:text-brand-700" %>
      <%= link_to "Eliminación de datos", data_deletion_path, class: "hover:text-brand-700" %>
    </nav>
  </div>
</header>
