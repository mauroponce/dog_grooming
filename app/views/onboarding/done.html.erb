<div class="mx-auto max-w-2xl rounded-lg border border-emerald-200 bg-white p-8 text-center shadow-sm" data-controller="copy-text">
  <p class="text-sm font-medium text-emerald-700">Agenda en línea</p>
  <h1 class="mt-2 text-3xl font-semibold">Tu agenda ya está en línea</h1>
  <p class="mt-3 text-slate-600">Este es tu enlace único para recibir reservas.</p>

  <div class="mt-6 rounded-md border border-slate-200 bg-slate-50 px-4 py-3 font-medium" data-copy-text-target="source">
    <%= @business.public_url %>
  </div>

  <div class="mt-6 flex justify-center gap-3">
    <%= link_to "Abrir enlace", public_business_path(@business.slug), class: "rounded-md border border-slate-300 px-4 py-2" %>
    <button type="button" data-action="copy-text#copy" data-copy-text-target="button" class="rounded-md border border-slate-300 px-4 py-2">Copiar enlace</button>
    <%= link_to "Ir al panel", admin_root_path, class: "rounded-md bg-slate-950 px-4 py-2 text-white" %>
  </div>
</div>
