<% content_for :email_preheader, "#{@entry.client_name} se sumó a la lista de espera." %>
<% content_for :email_badge, "Lista de espera" %>
<% content_for :email_status, "Nueva solicitud" %>
<% content_for :email_footer_note, "Este email fue enviado porque un cliente se sumó a la lista de espera." %>

<h1>Nueva clienta en lista de espera</h1>

<div class="email-card" style="margin-top:24px;">
  <div class="email-card-inner">
    <div class="email-card-title">Preferencias</div>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top:10px;">
      <tr class="email-detail-row">
        <td class="email-detail-label">Clienta</td>
        <td class="email-detail-value"><%= @entry.client_name %></td>
      </tr>
      <tr class="email-detail-row">
        <td class="email-detail-label">Teléfono</td>
        <td class="email-detail-value"><%= @entry.client_phone %></td>
      </tr>
      <tr class="email-detail-row">
        <td class="email-detail-label">Servicio</td>
        <td class="email-detail-value"><%= @entry.service.name %></td>
      </tr>
      <tr>
        <td class="email-detail-label">Fecha preferida</td>
        <td class="email-detail-value"><%= CustomerDateFormatter.date_label(@entry.desired_date) %></td>
      </tr>
    </table>
  </div>
</div>

<p><%= link_to "Abrir panel", @url, class: "email-button button" %></p>
