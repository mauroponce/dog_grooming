<% content_for :email_preheader, "Tenés #{@reminders.size} seguimiento(s) pendiente(s)." %>
<% content_for :email_badge, "Clientes" %>
<% content_for :email_status, "Seguimientos" %>
<% content_for :email_footer_note, "Este email fue enviado porque tenés seguimientos pendientes en Dog Grooming." %>

<h1>Clientas para contactar esta semana</h1>
<p>Hay <strong><%= @reminders.size %></strong> seguimiento(s) pendiente(s).</p>

<ul>
  <% @reminders.first(5).each do |reminder| %>
    <li>
      <strong><%= reminder.customer_profile.name.presence || reminder.customer_profile.phone %></strong>
      <% if reminder.service.present? %>
        · <%= reminder.service.name %>
      <% end %>
      · <%= reminder.body %>
    </li>
  <% end %>
</ul>

<p><%= link_to "Abrir panel", @url, class: "email-button button" %></p>
