<% content_for :full_width, true %>
<% connect_body = @connect_response&.dig(:body).is_a?(Hash) ? @connect_response[:body] : {} %>
<% setup_body = @setup_response&.dig(:body).is_a?(Hash) ? @setup_response[:body] : {} %>
<% qr_response_body = connect_body.presence || setup_body %>
<% qr_base64 = qr_response_body["base64"].presence || qr_response_body.dig("qrcode", "base64").presence || qr_response_body.dig("data", "base64").presence %>
<% qr_src = qr_base64.present? && qr_base64.start_with?("data:image") ? qr_base64 : ("data:image/png;base64,#{qr_base64}" if qr_base64.present?) %>
<% pairing_code = qr_response_body["pairingCode"].presence || qr_response_body.dig("qrcode", "pairingCode").presence || qr_response_body.dig("data", "pairingCode").presence %>
<% technical_qr_code = qr_response_body["code"].presence || qr_response_body.dig("qrcode", "code").presence || qr_response_body.dig("data", "code").presence %>
<% qr_count = qr_response_body["count"] || qr_response_body.dig("qrcode", "count") || qr_response_body.dig("data", "count") %>
<% rows = @dashboard.all_rows %>
<% metrics = @dashboard.metrics %>
<% mrr_metric = metrics.second %>
<% business_count = rows.count %>

<div class="min-h-screen bg-[#F7F7FA] font-sans text-zinc-950 antialiased">
  <header class="sticky top-0 z-50 border-b border-zinc-200 bg-white/95 px-4 py-3 backdrop-blur xl:hidden">
    <div class="flex items-center justify-between gap-3">
      <div class="flex min-w-0 items-center gap-3">
        <div class="h-10 w-10 shrink-0 overflow-hidden rounded-2xl shadow-lg shadow-brand-300/30">
          <%= image_tag "/icon.png?v=3", alt: "", class: "h-full w-full object-cover" %>
        </div>
        <div class="min-w-0">
          <p class="truncate text-sm font-bold">Superadmin</p>
          <p class="truncate text-xs font-semibold text-zinc-500"><%= business_count %> negocios · <%= mrr_metric.value %> MRR</p>
        </div>
      </div>
      <%= link_to "Negocios", super_admin_businesses_path, class: "rounded-2xl bg-ink px-4 py-2 text-sm font-bold text-white" %>
    </div>
  </header>

  <div class="mx-auto grid max-w-[1680px] gap-6 px-4 py-5 sm:px-6 lg:px-8 xl:grid-cols-[250px_1fr] xl:py-8">
    <aside class="hidden xl:block">
      <div class="sticky top-8 flex min-h-[calc(100vh-4rem)] flex-col rounded-[32px] border border-white bg-white p-4 shadow-card">
        <%= link_to super_admin_root_path, class: "flex items-center gap-3 border-b border-zinc-100 pb-4" do %>
          <span class="block h-12 w-12 shrink-0 overflow-hidden rounded-2xl shadow-lg shadow-brand-300/30">
            <%= image_tag "/icon.png?v=3", alt: "", class: "h-full w-full object-cover" %>
          </span>
          <span class="min-w-0">
            <span class="block truncate font-bold">Dog Grooming</span>
            <span class="mt-1 block truncate text-xs font-semibold text-zinc-500">Panel superadmin</span>
          </span>
        <% end %>

        <nav class="mt-4 space-y-1">
          <%= link_to super_admin_businesses_path, class: "flex items-center justify-between rounded-2xl px-4 py-3 text-sm font-bold text-zinc-600 hover:bg-zinc-50" do %>
            <span class="flex items-center gap-3">
              <span class="grid h-7 w-7 place-items-center rounded-xl bg-zinc-100">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 13h6V4H4v9Zm10 7h6V4h-6v16ZM4 20h6v-4H4v4Z" /></svg>
              </span>
              Negocios
            </span>
            <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-[10px] font-bold text-zinc-600"><%= business_count %></span>
          <% end %>

          <%= link_to super_admin_billing_path, class: "flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-bold text-zinc-600 hover:bg-zinc-50" do %>
            <span class="grid h-7 w-7 place-items-center rounded-xl bg-zinc-100">$</span>
            Cobros
          <% end %>

          <%= link_to super_admin_whatsapp_path, class: "flex items-center gap-3 rounded-2xl bg-ink px-4 py-3 text-sm font-bold text-white" do %>
            <span class="grid h-7 w-7 place-items-center rounded-xl bg-white/10">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.4-4.3A8 8 0 1 1 20 11.5Z" /><path d="M9 9h.01M12 9h.01M15 9h.01" /></svg>
            </span>
            WhatsApp API
          <% end %>

          <%= link_to super_admin_tutorials_path, class: "flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-bold text-zinc-600 hover:bg-zinc-50" do %>
            <span class="grid h-7 w-7 place-items-center rounded-xl bg-zinc-100">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m10 9 5 3-5 3V9Z" /></svg>
            </span>
            Tutoriales
          <% end %>

          <%= link_to super_admin_usage_path, class: "flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-bold text-zinc-600 hover:bg-zinc-50" do %>
            <span class="grid h-7 w-7 place-items-center rounded-xl bg-zinc-100">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19V5M4 19h16M8 16v-5M12 16V8M16 16v-9" /></svg>
            </span>
            Uso
          <% end %>
        </nav>

        <div class="mt-auto space-y-3 pt-6">
          <%= button_to "Salir", session_path, method: :delete, class: "w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm font-bold text-zinc-700 hover:bg-zinc-50" %>
        </div>
      </div>
    </aside>

    <main class="min-w-0 overflow-x-hidden">
      <header class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <%= link_to "Superadmin", super_admin_root_path, class: "rounded-full bg-ink px-3 py-1.5 text-xs font-bold text-white" %>
            <span class="rounded-full bg-brand-50 px-3 py-1.5 text-xs font-bold text-brand-700">WhatsApp dueño/admin</span>
          </div>
          <h1 class="mt-4 text-4xl font-bold tracking-tight text-zinc-950">Evolution API</h1>
          <p class="mt-2 max-w-3xl text-sm font-semibold leading-6 text-zinc-500">
            Panel interno para administrar la instancia usada por Dog Grooming. No se muestra la API key.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <%= button_to "Crear/configurar instancia", setup_evolution_super_admin_whatsapp_path, method: :post, form: { data: { turbo: false } }, class: "h-12 rounded-2xl bg-ink px-5 text-sm font-bold text-white shadow-lg shadow-zinc-900/15" %>
          <%= button_to "Actualizar estado", refresh_status_super_admin_whatsapp_path, method: :post, form: { data: { turbo: false } }, class: "h-12 rounded-2xl border border-zinc-200 bg-white px-5 text-sm font-bold text-zinc-800 shadow-sm" %>
        </div>
      </header>

    <section class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      <article class="rounded-[30px] border border-white bg-white p-5 shadow-card">
        <p class="text-xs font-bold uppercase tracking-[.14em] text-zinc-400">Provider actual</p>
        <p class="mt-3 text-2xl font-bold text-zinc-950"><%= @provider %></p>
      </article>
      <article class="rounded-[30px] border border-white bg-white p-5 shadow-card">
        <p class="text-xs font-bold uppercase tracking-[.14em] text-zinc-400">Instancia</p>
        <p class="mt-3 text-2xl font-bold text-zinc-950"><%= @instance_name %></p>
      </article>
      <article class="rounded-[30px] border border-white bg-white p-5 shadow-card">
        <p class="text-xs font-bold uppercase tracking-[.14em] text-zinc-400">Estado</p>
        <p class="mt-3 text-2xl font-bold text-zinc-950">
          <%= @status_response&.dig(:body, "instance", "state").presence || @status_response&.dig(:sanitized_body, "instance", "state").presence || (@configured ? "sin estado" : "sin configurar") %>
        </p>
      </article>
      <article class="rounded-[30px] border border-white bg-white p-5 shadow-card">
        <p class="text-xs font-bold uppercase tracking-[.14em] text-zinc-400">Número usado</p>
        <p class="mt-3 break-all text-2xl font-bold text-zinc-950"><%= @current_whatsapp_number.presence || "No disponible" %></p>
        <% if @current_whatsapp_profile_name.present? %>
          <p class="mt-1 truncate text-sm font-semibold text-zinc-500"><%= @current_whatsapp_profile_name %></p>
        <% elsif @configured %>
          <p class="mt-1 text-sm font-semibold text-zinc-500">Evolution no informó el número.</p>
        <% end %>
      </article>
    </section>

    <% unless @configured %>
      <section class="mt-6 rounded-[28px] border border-amber-200 bg-amber-50 p-5">
        <p class="text-sm font-bold text-amber-900">Faltan variables de entorno para Evolution.</p>
        <p class="mt-1 text-sm font-semibold text-amber-800">Configurá `EVOLUTION_API_KEY`, `EVOLUTION_API_BASE_URL`, `EVOLUTION_INSTANCE_NAME` y `WHATSAPP_PROVIDER=evolution`.</p>
      </section>
    <% end %>

    <section class="mt-6 grid gap-6 xl:grid-cols-[.9fr_1.1fr]">
      <div class="space-y-6">
        <section class="rounded-[34px] border border-white bg-white p-5 shadow-card">
          <h2 class="text-2xl font-bold tracking-tight text-zinc-950">Obtener QR / pairing code</h2>
          <p class="mt-2 text-sm font-semibold leading-6 text-zinc-500">
            Para QR, dejá el campo vacío y tocá el botón. Después abrí WhatsApp en tu celular, entrá a Dispositivos vinculados y escaneá el QR.
            El número solo se usa si querés pedir pairing code.
          </p>

          <%= form_with url: connect_super_admin_whatsapp_path, method: :post, data: { turbo: false }, class: "mt-5 space-y-3" do |form| %>
            <%= form.telephone_field :number, placeholder: "Opcional: 54911... solo para pairing code", class: "h-12 w-full rounded-2xl border border-zinc-200 bg-white px-4 text-sm font-semibold outline-none focus:border-brand-300 focus:ring-4 focus:ring-brand-100" %>
            <%= form.submit "Generar QR", class: "h-12 w-full cursor-pointer rounded-2xl bg-brand-600 px-5 text-sm font-bold text-white shadow-glow" %>
          <% end %>

          <% if @connect_response.present? || @setup_response.present? %>
            <div class="mt-5 rounded-[24px] bg-zinc-50 p-4">
              <% if qr_src.present? %>
                <%= image_tag qr_src, alt: "QR de conexión de WhatsApp", class: "mx-auto h-64 w-64 rounded-2xl bg-white object-contain p-3" %>
                <p class="mt-3 text-center text-sm font-semibold text-zinc-600">Escaneá este QR desde WhatsApp → Dispositivos vinculados.</p>
              <% end %>
              <% if pairing_code.present? %>
                <p class="mt-4 text-xs font-bold uppercase tracking-[.14em] text-zinc-400">Pairing code</p>
                <p class="mt-2 break-all rounded-2xl bg-white px-4 py-3 text-2xl font-bold tracking-widest text-zinc-950"><%= pairing_code %></p>
              <% end %>
              <% if qr_src.blank? && pairing_code.blank? %>
                <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm font-semibold text-amber-900">
                  Evolution respondió sin QR<%= " (count: #{qr_count})" if qr_count.present? %>. Tocá “Crear/configurar instancia” y después “Generar QR”. Si sigue igual, reiniciá Evolution API.
                </div>
              <% end %>
              <% if technical_qr_code.present? %>
                <details class="mt-4 rounded-2xl border border-zinc-200 bg-white p-4">
                  <summary class="cursor-pointer text-sm font-bold text-zinc-700">Ver código técnico del QR</summary>
                  <p class="mt-3 max-h-32 overflow-y-auto break-all rounded-xl bg-zinc-50 p-3 text-xs font-semibold leading-5 text-zinc-500"><%= technical_qr_code %></p>
                </details>
              <% end %>
              <details class="mt-4 rounded-2xl border border-zinc-200 bg-white p-4">
                <summary class="cursor-pointer text-sm font-bold text-zinc-700">Ver respuesta técnica</summary>
                <pre class="mt-3 max-h-80 max-w-full overflow-auto whitespace-pre-wrap break-words rounded-2xl bg-zinc-950 p-4 text-xs font-semibold text-zinc-100"><%= JSON.pretty_generate((@connect_response || @setup_response)[:sanitized_body] || {}) %></pre>
              </details>
            </div>
          <% end %>
        </section>

        <% [ [ "Setup", @setup_response ], [ "Estado", @status_response ] ].each do |label, response| %>
          <% next if response.blank? %>
          <section class="rounded-[30px] border border-white bg-white p-5 shadow-card">
            <h3 class="text-lg font-bold text-zinc-950"><%= label %></h3>
            <% if response[:error].present? %>
              <p class="mt-2 text-sm font-semibold text-rose-700"><%= response[:error] %></p>
            <% end %>
            <pre class="mt-4 max-h-80 overflow-auto rounded-2xl bg-zinc-950 p-4 text-xs font-semibold text-zinc-100"><%= JSON.pretty_generate(response[:sanitized_body] || {}) %></pre>
          </section>
        <% end %>
      </div>

      <div class="space-y-6">
        <section class="rounded-[34px] border border-white bg-white shadow-card">
          <div class="border-b border-zinc-100 p-5">
            <h2 class="text-2xl font-bold tracking-tight text-zinc-950">Últimos envíos</h2>
            <p class="mt-1 text-sm font-semibold text-zinc-500">Últimos 20 `NotificationDelivery`.</p>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[760px] text-left text-sm">
              <thead class="bg-zinc-50 text-xs font-bold uppercase tracking-[.12em] text-zinc-400">
                <tr>
                  <th class="px-5 py-4">Fecha</th>
                  <th class="px-5 py-4">Negocio</th>
                  <th class="px-5 py-4">Canal</th>
                  <th class="px-5 py-4">Template</th>
                  <th class="px-5 py-4">Estado</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-100">
                <% @deliveries.each do |delivery| %>
                  <tr>
                    <td class="px-5 py-4 font-semibold text-zinc-500"><%= l(delivery.created_at, format: :short) %></td>
                    <td class="px-5 py-4 font-bold text-zinc-950"><%= delivery.business&.name %></td>
                    <td class="px-5 py-4 font-semibold text-zinc-700"><%= delivery.channel %></td>
                    <td class="px-5 py-4 font-semibold text-zinc-700"><%= delivery.template %></td>
                    <td class="px-5 py-4"><span class="rounded-full bg-zinc-100 px-3 py-1 text-xs font-bold text-zinc-600"><%= delivery.status %></span></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>

        <section class="rounded-[34px] border border-white bg-white shadow-card">
          <div class="border-b border-zinc-100 p-5">
            <h2 class="text-2xl font-bold tracking-tight text-zinc-950">Eventos entrantes</h2>
            <p class="mt-1 text-sm font-semibold text-zinc-500">Últimos 20 `IncomingWhatsAppEvent`.</p>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[760px] text-left text-sm">
              <thead class="bg-zinc-50 text-xs font-bold uppercase tracking-[.12em] text-zinc-400">
                <tr>
                  <th class="px-5 py-4">Fecha</th>
                  <th class="px-5 py-4">Instancia</th>
                  <th class="px-5 py-4">Tipo</th>
                  <th class="px-5 py-4">Remitente</th>
                  <th class="px-5 py-4">Mensaje</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-100">
                <% @incoming_events.each do |event| %>
                  <tr>
                    <td class="px-5 py-4 font-semibold text-zinc-500"><%= l(event.created_at, format: :short) %></td>
                    <td class="px-5 py-4 font-semibold text-zinc-700"><%= event.instance_name %></td>
                    <td class="px-5 py-4 font-semibold text-zinc-700"><%= event.event_type %></td>
                    <td class="px-5 py-4 font-semibold text-zinc-700"><%= event.sender %></td>
                    <td class="px-5 py-4 font-semibold text-zinc-500"><%= truncate(event.message.to_s, length: 80) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </section>
    </main>
  </div>
</div>
