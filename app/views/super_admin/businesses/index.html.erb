<% content_for :full_width, true %>
<% selected = @dashboard.selected_row %>
<% rows = @business_rows || @dashboard.all_rows %>
<% metrics = @dashboard.metrics %>
<% mrr_metric = metrics.second %>
<% business_count = rows.count %>

<div class="min-h-screen bg-[#F7F7FA] font-sans text-zinc-950 antialiased">
  <header class="sticky top-0 z-50 border-b border-zinc-200 bg-white/95 px-4 py-3 backdrop-blur xl:hidden">
    <div class="flex items-center justify-between gap-3">
      <div class="flex min-w-0 items-center gap-3">
        <div class="h-10 w-10 shrink-0 overflow-hidden rounded-2xl shadow-lg shadow-brand-300/30">
          <%= image_tag "/icon.png?v=3", alt: "", class: "h-full w-full object-cover" %>
        </div>
        <div class="min-w-0">
          <p class="truncate text-sm font-bold">Superadmin</p>
          <p class="truncate text-xs font-semibold text-zinc-500"><%= business_count %> negocios · <%= mrr_metric.value %> MRR</p>
        </div>
      </div>
      <%= link_to "Crear", new_super_admin_business_path, class: "rounded-2xl bg-ink px-4 py-2 text-sm font-bold text-white" %>
    </div>
  </header>

  <div class="mx-auto grid max-w-[1680px] gap-6 px-4 py-5 sm:px-6 lg:px-8 xl:grid-cols-[250px_1fr] xl:py-8">
    <aside class="hidden xl:block">
      <div class="sticky top-8 flex min-h-[calc(100vh-4rem)] flex-col rounded-[32px] border border-white bg-white p-4 shadow-card">
        <%= link_to super_admin_root_path, class: "flex items-center gap-3 border-b border-zinc-100 pb-4" do %>
          <span class="block h-12 w-12 shrink-0 overflow-hidden rounded-2xl shadow-lg shadow-brand-300/30">
            <%= image_tag "/icon.png?v=3", alt: "", class: "h-full w-full object-cover" %>
          </span>
          <span class="min-w-0">
            <span class="block truncate font-bold">Dog Grooming</span>
            <span class="mt-1 block truncate text-xs font-semibold text-zinc-500">Panel superadmin</span>
          </span>
        <% end %>

        <nav class="mt-4 space-y-1">
          <%= link_to super_admin_businesses_path, class: "flex items-center justify-between rounded-2xl bg-ink px-4 py-3 text-sm font-bold text-white" do %>
            <span class="flex items-center gap-3">
              <span class="grid h-7 w-7 place-items-center rounded-xl bg-white/10">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 13h6V4H4v9Zm10 7h6V4h-6v16ZM4 20h6v-4H4v4Z" /></svg>
              </span>
              Negocios
            </span>
            <span class="rounded-full bg-white/10 px-2 py-0.5 text-[10px] font-bold text-white"><%= business_count %></span>
          <% end %>

          <%= link_to super_admin_billing_path, class: "flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-bold text-zinc-600 hover:bg-zinc-50" do %>
            <span class="grid h-7 w-7 place-items-center rounded-xl bg-zinc-100">$</span>
            Cobros
          <% end %>

          <%= link_to super_admin_whatsapp_path, class: "flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-bold text-zinc-600 hover:bg-zinc-50" do %>
            <span class="grid h-7 w-7 place-items-center rounded-xl bg-zinc-100">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.4-4.3A8 8 0 1 1 20 11.5Z" /><path d="M9 9h.01M12 9h.01M15 9h.01" /></svg>
            </span>
            WhatsApp API
          <% end %>

          <%= link_to super_admin_tutorials_path, class: "flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-bold text-zinc-600 hover:bg-zinc-50" do %>
            <span class="grid h-7 w-7 place-items-center rounded-xl bg-zinc-100">▶</span>
            Tutoriales
          <% end %>

          <%= link_to super_admin_usage_path, class: "flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-bold text-zinc-600 hover:bg-zinc-50" do %>
            <span class="grid h-7 w-7 place-items-center rounded-xl bg-zinc-100">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19V5M4 19h16M8 16v-5M12 16V8M16 16v-9" /></svg>
            </span>
            Uso
          <% end %>
        </nav>

        <div class="mt-auto space-y-3 pt-6">
          <%= button_to "Salir", session_path, method: :delete, class: "w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm font-bold text-zinc-700 hover:bg-zinc-50" %>
        </div>
      </div>
    </aside>

    <main class="min-w-0">
      <section class="rounded-[30px] border border-white bg-white p-4 shadow-card">
        <label class="relative block">
          <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-zinc-400">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          </span>
          <input type="search" data-business-search-input placeholder="Buscar por nombre o slug del negocio..." class="h-11 w-full rounded-2xl border border-zinc-200 bg-zinc-50 pl-11 pr-4 text-sm font-semibold outline-none focus:border-brand-300 focus:bg-white focus:ring-4 focus:ring-brand-100">
        </label>
      </section>

      <section class="mt-5 hidden rounded-[34px] border border-white bg-white shadow-card lg:block">
        <div class="flex flex-col gap-4 border-b border-zinc-100 px-5 py-5 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <h2 class="text-2xl font-bold tracking-tight">Negocios registrados</h2>
          </div>
          <%= link_to "Nueva cuenta", new_super_admin_business_path, class: "w-fit rounded-2xl bg-brand-600 px-5 py-3 text-sm font-bold text-white shadow-glow" %>
        </div>

        <div class="overflow-x-auto overflow-y-visible">
          <table class="w-full min-w-[920px] table-auto text-left">
            <thead class="bg-zinc-50 text-xs font-bold uppercase tracking-[.12em] text-zinc-400">
              <tr>
                <th class="w-full px-5 py-4">Negocio</th>
                <th class="w-px whitespace-nowrap px-4 py-4 text-right">Admin</th>
                <th class="w-px whitespace-nowrap px-4 py-4 text-right">Registro</th>
                <th class="w-px whitespace-nowrap px-4 py-4 text-right">Estado</th>
                <th class="w-px whitespace-nowrap px-5 py-4 text-right">Acciones</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-zinc-100 text-sm">
              <% rows.each do |row| %>
                <tr data-business-search-target data-business-search-text="<%= [row.name, row.slug].join(" ").downcase %>" class="hover:bg-zinc-50/60 <%= selected&.id == row.id ? 'bg-brand-50/60 shadow-[inset_4px_0_0_#ffded4]' : '' %>">
                  <td class="px-5 py-4 align-middle">
                    <div class="flex items-center gap-3">
                      <div class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-brand-600 text-xs font-bold text-white"><%= row.business.initials %></div>
                      <div class="min-w-0">
                        <p class="truncate font-bold"><%= row.name %></p>
                        <p class="mt-1 truncate text-xs font-semibold text-zinc-500">
                          <%= link_to "/#{row.slug}", super_admin_public_business_url(row.business), target: "_blank", rel: "noopener", class: "text-brand-700 underline decoration-brand-200 underline-offset-2 hover:text-brand-900" %>
                          <span> · <%= row.city %></span>
                        </p>
                      </div>
                    </div>
                  </td>
                  <td class="w-px whitespace-nowrap px-4 py-4 text-right align-middle">
                    <div class="ml-auto max-w-[240px]">
                      <p class="truncate font-bold"><%= row.admin_email %></p>
                      <p class="mt-1 text-xs font-semibold text-zinc-500"><%= super_admin_time_ago(row.last_activity_at) %></p>
                    </div>
                  </td>
                  <td class="w-px whitespace-nowrap px-4 py-4 text-right align-middle">
                    <p class="font-bold"><%= super_admin_registration_date(row.business.created_at) %></p>
                  </td>
                  <td class="w-px whitespace-nowrap px-4 py-4 text-right align-middle">
                    <span class="rounded-full px-3 py-1.5 text-[11px] font-bold <%= super_admin_status_classes(row) %>"><%= row.status_label %></span>
                  </td>
                  <td class="w-px whitespace-nowrap px-5 py-4 text-right align-middle">
                    <details data-business-actions-menu class="relative ml-auto w-fit">
                      <summary class="flex h-9 cursor-pointer list-none items-center rounded-xl border border-zinc-200 bg-white px-3 text-xs font-bold text-zinc-800 hover:bg-zinc-50">
                        Acciones
                      </summary>
                      <div data-business-actions-panel class="fixed z-[2147483646] w-40 overflow-hidden rounded-2xl border border-zinc-200 bg-white p-1 shadow-card" style="z-index: 2147483646;">
                        <%= button_to "Entrar", impersonate_super_admin_business_path(row.business), method: :post, form: { class: "contents", data: { turbo: false } }, class: "flex w-full items-center justify-start rounded-xl px-3 py-2 text-left text-xs font-bold text-zinc-800 hover:bg-zinc-50" %>
                        <%= link_to "Editar", edit_super_admin_business_path(row.business), class: "flex w-full items-center justify-start rounded-xl px-3 py-2 text-left text-xs font-bold text-zinc-800 hover:bg-zinc-50" %>
                        <div class="my-1 border-t border-zinc-100"></div>
                        <%= button_to "Eliminar", super_admin_business_path(row.business), method: :delete, form: { class: "contents", data: { turbo_confirm: "¿Seguro que querés eliminar #{row.name}? Esta acción no se puede deshacer." } }, class: "flex w-full items-center justify-start rounded-xl px-3 py-2 text-left text-xs font-bold text-rose-700 hover:bg-rose-50" %>
                      </div>
                    </details>
                  </td>
                </tr>
              <% end %>

              <% if rows.blank? %>
                <tr>
                  <td colspan="5" class="px-5 py-12 text-center">
                    <p class="text-sm font-bold text-zinc-700">No hay negocios cargados.</p>
                  </td>
                </tr>
              <% end %>

              <tr data-business-search-empty class="hidden">
                <td colspan="5" class="px-5 py-12 text-center">
                  <p class="text-sm font-bold text-zinc-700">No hay negocios para esa búsqueda.</p>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="mt-5 grid gap-4 lg:hidden">
        <% rows.each do |row| %>
          <article data-business-search-target data-business-search-text="<%= [row.name, row.slug].join(" ").downcase %>" class="relative rounded-[30px] border border-white bg-white p-5 shadow-card">
            <div class="flex items-start justify-between gap-4">
              <div class="flex min-w-0 items-center gap-3">
                <div class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-brand-600 text-xs font-bold text-white"><%= row.business.initials %></div>
                <div class="min-w-0">
                  <h3 class="truncate font-bold"><%= row.name %></h3>
                  <p class="mt-1 truncate text-xs font-semibold text-zinc-500">
                    <%= row.status_label %> ·
                    <%= link_to "/#{row.slug}", super_admin_public_business_url(row.business), target: "_blank", rel: "noopener", class: "text-brand-700 underline decoration-brand-200 underline-offset-2" %>
                  </p>
                </div>
              </div>
              <span class="shrink-0 rounded-full px-3 py-1.5 text-[11px] font-bold <%= super_admin_status_classes(row) %>"><%= row.status_label %></span>
            </div>

            <div class="mt-4 grid gap-2 rounded-2xl bg-zinc-50 p-3 text-sm font-semibold text-zinc-600">
              <p><span class="font-bold text-zinc-950">Admin:</span> <%= row.admin_email %></p>
              <p><span class="font-bold text-zinc-950">Registro:</span> <%= super_admin_registration_date(row.business.created_at) %></p>
            </div>

            <div class="mt-5 flex justify-end">
              <details data-business-actions-menu class="relative">
                <summary class="flex h-11 cursor-pointer list-none items-center rounded-2xl border border-zinc-200 bg-white px-4 text-sm font-bold text-zinc-800">
                  Acciones
                </summary>
                <div data-business-actions-panel class="fixed z-[2147483646] w-44 overflow-hidden rounded-2xl border border-zinc-200 bg-white p-1 shadow-card" style="z-index: 2147483646;">
                  <%= button_to "Entrar", impersonate_super_admin_business_path(row.business), method: :post, form: { class: "contents", data: { turbo: false } }, class: "flex w-full items-center justify-start rounded-xl px-3 py-2 text-left text-sm font-bold text-zinc-800 hover:bg-zinc-50" %>
                  <%= link_to "Editar", edit_super_admin_business_path(row.business), class: "flex w-full items-center justify-start rounded-xl px-3 py-2 text-left text-sm font-bold text-zinc-800 hover:bg-zinc-50" %>
                  <div class="my-1 border-t border-zinc-100"></div>
                  <%= button_to "Eliminar", super_admin_business_path(row.business), method: :delete, form: { class: "contents", data: { turbo_confirm: "¿Seguro que querés eliminar #{row.name}? Esta acción no se puede deshacer." } }, class: "flex w-full items-center justify-start rounded-xl px-3 py-2 text-left text-sm font-bold text-rose-700 hover:bg-rose-50" %>
                </div>
              </details>
            </div>
          </article>
        <% end %>

        <% if rows.blank? %>
          <div class="rounded-[30px] border border-white bg-white p-8 text-center shadow-card">
            <p class="text-sm font-bold text-zinc-700">No hay negocios cargados.</p>
          </div>
        <% end %>

        <div data-business-search-empty class="hidden rounded-[30px] border border-white bg-white p-8 text-center shadow-card">
          <p class="text-sm font-bold text-zinc-700">No hay negocios para esa búsqueda.</p>
        </div>
      </section>

      <div class="h-20 xl:hidden"></div>
    </main>
  </div>
</div>

<script>
  (() => {
    const input = document.querySelector("[data-business-search-input]");
    if (!input) return;

    const targets = Array.from(document.querySelectorAll("[data-business-search-target]"));
    const emptyStates = Array.from(document.querySelectorAll("[data-business-search-empty]"));

    const normalize = (value) => value.toString().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();

    const applySearch = () => {
      const query = normalize(input.value);
      let visibleCount = 0;

      targets.forEach((target) => {
        const matches = query === "" || normalize(target.dataset.businessSearchText || "").includes(query);
        target.classList.toggle("hidden", !matches);
        if (matches) visibleCount += 1;
      });

      emptyStates.forEach((emptyState) => {
        emptyState.classList.toggle("hidden", query === "" || visibleCount > 0);
      });
    };

    input.addEventListener("input", applySearch);
    applySearch();
  })();

  (() => {
    const menus = Array.from(document.querySelectorAll("[data-business-actions-menu]"));
    if (!menus.length) return;

    const panelFor = (menu) => {
      if (menu.businessActionsPanel) return menu.businessActionsPanel;

      const panel = menu.querySelector("[data-business-actions-panel]");
      menu.businessActionsPanel = panel;
      if (panel) panel.businessActionsMenu = menu;
      return panel;
    };

    const restorePanel = (menu) => {
      const panel = panelFor(menu);
      if (!panel || panel.parentElement === menu) return;

      panel.removeAttribute("hidden");
      panel.style.left = "";
      panel.style.top = "";
      menu.appendChild(panel);
    };

    const portalPanel = (menu) => {
      const panel = panelFor(menu);
      if (!panel) return;

      panel.businessActionsMenu = menu;
      panel.removeAttribute("hidden");
      panel.style.position = "fixed";
      panel.style.zIndex = "2147483646";
      document.body.appendChild(panel);
    };

    const positionMenu = (menu) => {
      const summary = menu.querySelector("summary");
      const panel = panelFor(menu);
      if (!summary || !panel) return;

      const gap = 8;
      const viewportPadding = 16;
      const summaryRect = summary.getBoundingClientRect();
      const panelWidth = panel.offsetWidth || 176;
      const panelHeight = panel.offsetHeight || 144;
      const left = Math.min(
        window.innerWidth - panelWidth - viewportPadding,
        Math.max(viewportPadding, summaryRect.right - panelWidth)
      );
      const preferredTop = summaryRect.bottom + gap;
      const top = preferredTop + panelHeight > window.innerHeight - viewportPadding
        ? Math.max(viewportPadding, summaryRect.top - panelHeight - gap)
        : preferredTop;

      panel.style.left = `${left}px`;
      panel.style.top = `${top}px`;
    };

    const closeMenusExcept = (activeMenu) => {
      menus.forEach((menu) => {
        if (menu === activeMenu) return;

        menu.removeAttribute("open");
        restorePanel(menu);
      });
    };

    const positionOpenMenus = () => {
      menus.forEach((menu) => {
        if (menu.open) positionMenu(menu);
      });
    };

    menus.forEach((menu) => {
      menu.addEventListener("toggle", () => {
        if (!menu.open) {
          restorePanel(menu);
          return;
        }

        closeMenusExcept(menu);
        portalPanel(menu);
        requestAnimationFrame(() => positionMenu(menu));
      });
    });

    document.addEventListener("click", (event) => {
      const activeMenu = event.target.closest("[data-business-actions-menu]") ||
        event.target.closest("[data-business-actions-panel]")?.businessActionsMenu;
      closeMenusExcept(activeMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenusExcept(null);
    });

    window.addEventListener("resize", positionOpenMenus);
    window.addEventListener("scroll", positionOpenMenus, true);
  })();
</script>
