<% content_for :full_width, true %>
<% content_for :title, "Nuevo tutorial · Dog Grooming" %>

<section class="min-h-screen bg-[#F7F7FA] px-4 py-8 sm:px-6 lg:px-8">
  <div class="mx-auto w-full max-w-3xl">
    <%= link_to "‹ Volver a tutoriales", super_admin_tutorials_path, class: "text-sm font-bold text-zinc-600 hover:text-brand-700" %>
    <div class="mt-5 rounded-[32px] border border-white bg-white p-6 shadow-card sm:p-8">
      <p class="text-xs font-bold uppercase tracking-[.14em] text-brand-700">Contenido para administradores</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-zinc-950">Nuevo tutorial</h1>
      <p class="mt-2 text-sm font-semibold leading-6 text-zinc-500">El título y el enlace se mostrarán en el panel de cada administrador.</p>
      <div class="mt-8"><%= render "form", tutorial: @tutorial %></div>
    </div>
  </div>
</section>
