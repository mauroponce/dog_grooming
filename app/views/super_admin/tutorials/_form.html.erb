<%= form_with model: [:super_admin, tutorial], class: "space-y-6" do |form| %>
  <% if tutorial.errors.any? %>
    <div class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-800">
      <%= tutorial.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Título", class: "text-sm font-bold text-zinc-900" %>
    <%= form.text_field :title, required: true, maxlength: 180, autofocus: true, class: "mt-2 h-12 w-full rounded-2xl border border-zinc-200 bg-white px-4 text-sm font-semibold text-zinc-900 outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100", placeholder: "Ej. Cómo configurar las cuentas de cobro" %>
    <p class="mt-2 text-xs font-semibold text-zinc-500">Es el título que verá el admin en el panel de navegación.</p>
  </div>

  <div>
    <%= form.label :video_url, "Link al video", class: "text-sm font-bold text-zinc-900" %>
    <%= form.url_field :video_url, required: true, maxlength: 2048, class: "mt-2 h-12 w-full rounded-2xl border border-zinc-200 bg-white px-4 text-sm font-semibold text-zinc-900 outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100", placeholder: "https://www.youtube.com/watch?v=..." %>
    <p class="mt-2 text-xs font-semibold text-zinc-500">Usá una URL pública con http:// o https://. Para Loom, pegá el link de compartir: se reproducirá dentro del panel del admin.</p>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-zinc-100 pt-6 sm:flex-row sm:justify-end">
    <%= link_to "Cancelar", super_admin_tutorials_path, class: "inline-flex h-12 items-center justify-center rounded-2xl border border-zinc-200 bg-white px-5 text-sm font-bold text-zinc-700 hover:bg-zinc-50" %>
    <%= form.submit tutorial.persisted? ? "Guardar cambios" : "Publicar tutorial", class: "h-12 cursor-pointer rounded-2xl bg-ink px-5 text-sm font-bold text-white shadow-lg shadow-zinc-900/15 hover:bg-zinc-800" %>
  </div>
<% end %>
