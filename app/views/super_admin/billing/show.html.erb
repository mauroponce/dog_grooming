<% content_for :full_width, true %>
<% rows = SuperAdmin::Dashboard.new(params: ActionController::Parameters.new).all_rows %>

<div class="min-h-screen bg-[#F7F7FA] font-sans text-zinc-950 antialiased">
  <div class="mx-auto grid max-w-[1680px] gap-6 px-4 py-5 sm:px-6 lg:px-8 xl:grid-cols-[250px_1fr] xl:py-8">
    <aside class="hidden xl:block">
      <div class="sticky top-8 flex min-h-[calc(100vh-4rem)] flex-col rounded-[32px] border border-white bg-white p-4 shadow-card">
        <%= link_to super_admin_root_path, class: "flex items-center gap-3 border-b border-zinc-100 pb-4" do %>
          <span class="block h-12 w-12 shrink-0 overflow-hidden rounded-2xl shadow-lg shadow-brand-300/30"><%= image_tag "/icon.png?v=4", alt: "", class: "h-full w-full object-cover" %></span>
          <span><span class="block font-bold">Cita.pet</span><span class="mt-1 block text-xs font-semibold text-zinc-500">Panel superadmin</span></span>
        <% end %>

        <nav class="mt-4 space-y-1">
          <%= link_to super_admin_businesses_path, class: "flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-bold text-zinc-600 hover:bg-zinc-50" do %>
            <span class="grid h-7 w-7 place-items-center rounded-xl bg-zinc-100">⌘</span> Negocios
          <% end %>
          <%= link_to super_admin_billing_path, class: "flex items-center gap-3 rounded-2xl bg-ink px-4 py-3 text-sm font-bold text-white" do %>
            <span class="grid h-7 w-7 place-items-center rounded-xl bg-white/10">$</span> Cobros
            <% if @pending_payment_proofs.any? %><span class="ml-auto rounded-full bg-white/15 px-2 py-0.5 text-[10px]"><%= @pending_payment_proofs.count %></span><% end %>
          <% end %>
          <%= link_to super_admin_tutorials_path, class: "flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-bold text-zinc-600 hover:bg-zinc-50" do %>
            <span class="grid h-7 w-7 place-items-center rounded-xl bg-zinc-100">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m10 9 5 3-5 3V9Z" /></svg>
            </span> Tutoriales
          <% end %>
          <%= link_to super_admin_usage_path, class: "flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-bold text-zinc-600 hover:bg-zinc-50" do %>
            <span class="grid h-7 w-7 place-items-center rounded-xl bg-zinc-100">↗</span> Uso
          <% end %>
        </nav>

        <div class="mt-auto pt-6"><%= button_to "Salir", session_path, method: :delete, class: "w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm font-bold text-zinc-700 hover:bg-zinc-50" %></div>
      </div>
    </aside>

    <main class="min-w-0">
      <header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <span class="rounded-full bg-brand-50 px-3 py-1.5 text-xs font-bold text-brand-700">Facturación interna</span>
          <h1 class="mt-4 text-4xl font-bold tracking-tight text-zinc-950">Cobros y comprobantes</h1>
          <p class="mt-2 max-w-3xl text-sm font-semibold leading-6 text-zinc-500">Configurá la cuenta receptora y revisá desde un solo lugar los comprobantes de suscripción cargados por los negocios.</p>
        </div>
        <%= link_to "Negocios", super_admin_businesses_path, class: "w-fit rounded-2xl border border-zinc-200 bg-white px-4 py-2 text-sm font-bold text-zinc-800 hover:bg-zinc-50" %>
      </header>

      <section class="mt-6 grid gap-6 xl:grid-cols-[.9fr_1.1fr]">
        <article class="rounded-[30px] border border-white bg-white p-5 shadow-card sm:p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-xl font-bold tracking-tight">Cuenta para recibir pagos</h2>
              <p class="mt-1 text-sm font-semibold leading-6 text-zinc-500">Estos datos se muestran en la suscripción y se incluyen en los recordatorios por email.</p>
            </div>
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-brand-50 text-lg font-bold text-brand-700">$</span>
          </div>

          <%= form_with model: @billing_account, url: super_admin_billing_path, method: :patch, class: "mt-6 space-y-4" do |form| %>
            <% if @billing_account.errors.any? %>
              <div class="rounded-2xl bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-800"><%= @billing_account.errors.full_messages.to_sentence %></div>
            <% end %>
            <div class="grid gap-4 sm:grid-cols-2">
              <div><%= form.label :transfer_alias, "Alias", class: "text-sm font-bold text-zinc-800" %><%= form.text_field :transfer_alias, autocomplete: "off", class: "mt-2 h-11 w-full rounded-xl border border-zinc-200 px-3 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100", placeholder: "mi.alias" %></div>
              <div><%= form.label :cbu, "CBU / CVU", class: "text-sm font-bold text-zinc-800" %><%= form.text_field :cbu, inputmode: "numeric", autocomplete: "off", class: "mt-2 h-11 w-full rounded-xl border border-zinc-200 px-3 font-mono text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100", placeholder: "0000000000000000000000" %></div>
              <div><%= form.label :account_holder, "Titular", class: "text-sm font-bold text-zinc-800" %><%= form.text_field :account_holder, autocomplete: "name", class: "mt-2 h-11 w-full rounded-xl border border-zinc-200 px-3 text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100" %></div>
              <div><%= form.label :tax_id, "CUIT / CUIL", class: "text-sm font-bold text-zinc-800" %><%= form.text_field :tax_id, inputmode: "numeric", autocomplete: "off", class: "mt-2 h-11 w-full rounded-xl border border-zinc-200 px-3 font-mono text-sm font-semibold outline-none focus:border-brand-400 focus:ring-4 focus:ring-brand-100" %></div>
            </div>
            <p class="text-xs font-semibold leading-5 text-zinc-500">Completá al menos Alias o CBU/CVU. La cuenta nunca se expone fuera del flujo de cobro de suscripción.</p>
            <%= form.submit "Guardar datos de cobro", class: "cursor-pointer rounded-2xl bg-ink px-5 py-3 text-sm font-bold text-white shadow-lg shadow-zinc-900/15 hover:bg-zinc-800" %>
          <% end %>
        </article>

        <article class="rounded-[30px] border border-white bg-white p-5 shadow-card sm:p-6">
          <p class="text-xs font-bold uppercase tracking-[.14em] text-zinc-400">Pendientes de revisión</p>
          <p class="mt-2 text-4xl font-bold tracking-tight"><%= @pending_payment_proofs.count %></p>
          <p class="mt-2 text-sm font-semibold leading-6 text-zinc-500">Cada comprobante queda asociado a su factura, negocio y persona que lo cargó. Los archivos se mantienen privados en Active Storage/R2.</p>
          <div class="mt-5 rounded-2xl bg-zinc-50 p-4 text-sm font-semibold text-zinc-600">
            <p><span class="font-bold text-zinc-950">Negocios con facturación:</span> <%= rows.count { |row| row.business.billing_enabled? } %></p>
            <p class="mt-2"><span class="font-bold text-zinc-950">Destino actual:</span> <%= @billing_account.transfer_alias.presence || @billing_account.cbu.presence || "Pendiente de configurar" %></p>
          </div>
        </article>
      </section>

      <section class="mt-6 overflow-hidden rounded-[30px] border border-white bg-white shadow-card">
        <div class="border-b border-zinc-100 p-5 sm:p-6">
          <h2 class="text-xl font-bold tracking-tight">Comprobantes para revisar</h2>
          <p class="mt-1 text-sm font-semibold text-zinc-500">Abrí el archivo sin descargarlo y aprobá o rechazá el pago desde esta misma pantalla.</p>
        </div>

        <div class="divide-y divide-zinc-100">
          <% @pending_payment_proofs.each do |proof| %>
            <% invoice = proof.subscription_invoice %>
            <article class="grid gap-5 p-5 lg:grid-cols-[132px_1fr_auto] lg:items-center sm:p-6">
              <div class="overflow-hidden rounded-2xl bg-zinc-100">
                <% if proof.file.attached? && proof.file.content_type.to_s.start_with?("image/") %>
                  <%= image_tag rails_blob_path(proof.file, disposition: "inline"), alt: "Comprobante de #{proof.business.name}", class: "h-28 w-full object-cover" %>
                <% else %>
                  <div class="grid h-28 place-items-center text-sm font-bold text-zinc-500">PDF</div>
                <% end %>
              </div>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2"><h3 class="text-lg font-bold"><%= proof.business.name %></h3><span class="rounded-full bg-amber-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-amber-700">En revisión</span></div>
                <p class="mt-2 text-sm font-semibold text-zinc-600"><%= invoice.amount_label %> · vence <%= l(invoice.due_on, format: :long) %> · <span class="font-mono text-xs"><%= invoice.reference_code %></span></p>
                <p class="mt-1 text-xs font-semibold text-zinc-500">Cargado <%= l(proof.uploaded_at, format: :short) %><% if proof.uploaded_by.present? %> por <%= proof.uploaded_by.email_address %><% end %></p>
                <% if proof.file.attached? %><%= link_to "Abrir comprobante", rails_blob_path(proof.file, disposition: "inline"), target: "_blank", rel: "noopener", class: "mt-3 inline-block text-sm font-bold text-brand-700 underline decoration-brand-200 underline-offset-2" %><% end %>
              </div>
              <div class="flex flex-wrap gap-2 lg:justify-end">
                <%= button_to "Aprobar", approve_payment_proof_super_admin_billing_path(proof_id: proof.id), method: :patch, class: "rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-emerald-700" %>
                <%= form_with url: reject_payment_proof_super_admin_billing_path(proof_id: proof.id), method: :patch, class: "flex gap-2" do |form| %>
                  <%= form.text_field :reason, placeholder: "Motivo (opcional)", class: "h-10 w-40 rounded-xl border border-zinc-200 px-3 text-xs font-semibold outline-none focus:border-rose-400" %>
                  <%= form.submit "Rechazar", class: "cursor-pointer rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-bold text-rose-700 hover:bg-rose-100" %>
                <% end %>
              </div>
            </article>
          <% end %>

          <% if @pending_payment_proofs.blank? %>
            <div class="p-10 text-center"><p class="text-sm font-bold text-zinc-800">No hay comprobantes pendientes.</p><p class="mt-1 text-sm font-semibold text-zinc-500">Cuando un negocio cargue uno, aparecerá acá para revisarlo.</p></div>
          <% end %>
        </div>
      </section>
    </main>
  </div>
</div>
