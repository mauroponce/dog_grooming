<% content_for :full_width, true %>
<div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
  <%= link_to "← Negocios", super_admin_businesses_path, class: "text-sm font-bold text-brand-700" %>
  <h1 class="mt-4 text-4xl font-bold tracking-tight">Cobros de Cita.pet</h1>
  <p class="mt-2 text-slate-600">Las suscripciones se cobran por transferencia. Mercado Pago queda reservado para las señas que cobran las peluquerías.</p>

  <section class="mt-7 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-bold">Cuenta para recibir transferencias</h2>
    <%= form_with model: @transfer_account, url: super_admin_billing_path, method: :patch, multipart: true, class: "mt-5 grid gap-4 sm:grid-cols-2" do |form| %>
      <div><%= form.label :transfer_alias, "Alias", class: "text-sm font-bold" %><%= form.text_field :transfer_alias, class: "mt-1 w-full rounded-xl border-slate-300" %></div>
      <div><%= form.label :cbu, "CBU/CVU", class: "text-sm font-bold" %><%= form.text_field :cbu, class: "mt-1 w-full rounded-xl border-slate-300" %></div>
      <div><%= form.label :account_holder, "Titular", class: "text-sm font-bold" %><%= form.text_field :account_holder, class: "mt-1 w-full rounded-xl border-slate-300" %></div>
      <div><%= form.label :tax_id, "CUIT/CUIL", class: "text-sm font-bold" %><%= form.text_field :tax_id, class: "mt-1 w-full rounded-xl border-slate-300" %></div>
      <div class="sm:col-span-2"><%= form.label :account_proof, "Constancia bancaria (opcional)", class: "text-sm font-bold" %><%= form.file_field :account_proof, accept: BillingTransferAccount::ACCOUNT_PROOF_CONTENT_TYPES.join(","), class: "mt-1 block text-sm" %></div>
      <div class="sm:col-span-2"><%= form.submit "Guardar datos bancarios", class: "rounded-xl bg-brand-600 px-4 py-3 text-sm font-bold text-white" %></div>
    <% end %>
    <% if @transfer_account.account_proof.attached? %>
      <div class="mt-4 flex items-center gap-4 text-sm"><%= link_to "Descargar constancia", rails_blob_path(@transfer_account.account_proof, disposition: "attachment"), class: "font-bold text-brand-700" %><%= button_to "Eliminar constancia", remove_account_proof_super_admin_billing_path, method: :delete, class: "font-bold text-rose-700" %></div>
    <% end %>
  </section>

  <section class="mt-7 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-bold">Comprobantes pendientes</h2>
    <% if @pending_invoices.any? %>
      <div class="mt-4 space-y-4">
        <% @pending_invoices.each do |invoice| %>
          <% proof = invoice.current_proof %>
          <article id="payment-<%= invoice.id %>" class="rounded-2xl border border-slate-100 p-4">
            <p class="font-bold"><%= invoice.business.name %> · <%= invoice.amount_label %></p>
            <p class="mt-1 text-sm text-slate-500">Período: <%= l(invoice.period_start, format: :long) %>. Subido <%= l(proof.uploaded_at, format: :short) if proof %>.</p>
            <% if proof&.file&.attached? %><%= link_to "Ver comprobante", rails_blob_path(proof.file, disposition: "attachment"), class: "mt-3 inline-block text-sm font-bold text-brand-700" %><% end %>
            <div class="mt-4 flex flex-wrap gap-3">
              <%= button_to "Aprobar pago", approve_invoice_super_admin_billing_path(invoice_id: invoice.id), method: :patch, class: "rounded-xl bg-emerald-600 px-4 py-2 text-sm font-bold text-white" %>
              <%= form_with url: reject_invoice_super_admin_billing_path, method: :patch, class: "flex gap-2" do |form| %><%= form.hidden_field :invoice_id, value: invoice.id %><%= form.text_field :reason, placeholder: "Motivo del rechazo", class: "rounded-xl border-slate-300 text-sm" %><%= form.submit "Rechazar", class: "rounded-xl border border-rose-200 px-3 py-2 text-sm font-bold text-rose-700" %><% end %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="mt-3 text-slate-600">No hay comprobantes pendientes.</p>
    <% end %>
  </section>
</div>
