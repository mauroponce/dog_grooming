<% content_for :full_width, true %>
<div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
  <%= link_to "← Negocios", super_admin_businesses_path, class: "text-sm font-bold text-brand-700" %>
  <h1 class="mt-4 text-4xl font-bold tracking-tight">Cobros de Cita.pet</h1>
  <p class="mt-2 text-slate-600">Esta cuenta cobra las suscripciones mensuales. Las cuentas Mercado Pago de cada peluquería siguen siendo independientes y sólo cobran sus señas.</p>

  <section class="mt-7 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-bold">Cuenta de Mercado Pago de Cita.pet</h2>
    <% if @mercado_pago_connection.connected? %>
      <p class="mt-2 text-emerald-700">Conectada: <strong><%= @mercado_pago_connection.mercado_pago_email.presence || @mercado_pago_connection.mercado_pago_nickname || @mercado_pago_connection.mercado_pago_user_id %></strong></p>
      <%= button_to "Desvincular cuenta", super_admin_mercado_pago_connection_path, method: :delete, class: "mt-5 rounded-xl border border-rose-200 px-4 py-2 font-bold text-rose-700" %>
    <% else %>
      <p class="mt-2 text-slate-600">Conectá la cuenta que recibirá los pagos de suscripción mediante Checkout Pro.</p>
      <%= link_to "Conectar Mercado Pago", connect_super_admin_mercado_pago_connection_path, class: "mt-5 inline-block rounded-xl bg-sky-500 px-4 py-3 font-bold text-white" %>
    <% end %>
  </section>

  <section class="mt-7 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-bold">Checkouts pendientes</h2>
    <% if @pending_checkout_payments.any? %>
      <div class="mt-4 divide-y"><% @pending_checkout_payments.each do |payment| %><div class="flex flex-wrap justify-between gap-2 py-3"><span><strong><%= payment.business.name %></strong> · <%= payment.subscription_invoice.amount_label %></span><span class="text-slate-500">vence <%= l(payment.expires_at.to_date, format: :long) %></span></div><% end %></div>
    <% else %><p class="mt-3 text-slate-600">No hay checkouts pendientes.</p><% end %>
  </section>
</div>
