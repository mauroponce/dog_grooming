<% content_for :full_width, true %>
<% storage = @usage.storage_snapshot %>
<% r2 = @usage.r2_snapshot %>

<div class="min-h-screen bg-[#F7F7FA] px-4 py-6 text-zinc-950 sm:px-6 lg:px-8">
  <main class="mx-auto max-w-6xl">
    <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[.14em] text-brand-600">Superadmin · Infraestructura</p>
        <h1 class="mt-2 text-4xl font-bold tracking-tight">Uso y costos</h1>
        <p class="mt-2 max-w-3xl text-sm font-semibold leading-6 text-zinc-500">
          Estado de Active Storage y métricas oficiales de Cloudflare R2 cuando la integración de analíticas está configurada.
        </p>
      </div>
      <div class="flex gap-2">
        <%= link_to "Negocios", super_admin_businesses_path, class: "rounded-2xl border border-zinc-200 bg-white px-4 py-2 text-sm font-bold text-zinc-700" %>
        <%= button_to "Salir", session_path, method: :delete, class: "rounded-2xl bg-ink px-4 py-2 text-sm font-bold text-white" %>
      </div>
    </header>

    <section class="mt-6 grid gap-4 md:grid-cols-3">
      <article class="rounded-[30px] border border-white bg-white p-5 shadow-card">
        <p class="text-xs font-bold uppercase tracking-[.14em] text-zinc-400">Almacenamiento conocido</p>
        <p class="mt-3 text-3xl font-bold"><%= number_to_human_size(storage.fetch(:total_bytes)) %></p>
      </article>
      <article class="rounded-[30px] border border-white bg-white p-5 shadow-card">
        <p class="text-xs font-bold uppercase tracking-[.14em] text-zinc-400">Objetos</p>
        <p class="mt-3 text-3xl font-bold"><%= number_with_delimiter(storage.fetch(:total_objects)) %></p>
      </article>
      <article class="rounded-[30px] border border-white bg-white p-5 shadow-card">
        <p class="text-xs font-bold uppercase tracking-[.14em] text-zinc-400">Sin adjuntar</p>
        <p class="mt-3 text-3xl font-bold"><%= number_with_delimiter(storage.fetch(:unattached_objects)) %></p>
      </article>
    </section>

    <section class="mt-6 rounded-[34px] border border-white bg-white shadow-card">
      <div class="flex flex-col gap-3 border-b border-zinc-100 p-5 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-[.14em] text-brand-600">Cloudflare R2</p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight">Buckets y almacenamiento</h2>
        </div>
        <span class="w-fit rounded-full px-3 py-1.5 text-xs font-bold <%= r2.fetch(:configured) ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
          <%= r2.fetch(:configured) ? "Cloudflare conectado" : "Cloudflare no conectado" %>
        </span>
      </div>
      <div class="p-5">
        <% if r2.fetch(:error).present? %>
          <p class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm font-semibold text-amber-900"><%= r2.fetch(:error) %></p>
        <% end %>
        <div class="mt-4 grid gap-3">
          <% r2.fetch(:buckets).each do |bucket| %>
            <article class="rounded-2xl border border-zinc-200 p-4">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <p class="font-bold"><%= bucket.name %></p>
                  <p class="mt-1 text-xs font-semibold text-zinc-500"><%= bucket.measured_at.present? ? "Medido #{l(bucket.measured_at, format: :short)}" : "Sin medición reciente" %></p>
                </div>
                <p class="text-lg font-bold"><%= number_to_human_size(bucket.payload_bytes + bucket.metadata_bytes) %></p>
              </div>
              <p class="mt-3 text-sm font-semibold text-zinc-600">
                <%= number_with_delimiter(bucket.object_count) %> objetos · <%= number_with_delimiter(bucket.requests_24h) %> requests en 24 h
              </p>
            </article>
          <% end %>
          <% if r2.fetch(:buckets).blank? && r2.fetch(:configured) %>
            <p class="rounded-2xl bg-zinc-50 p-4 text-sm font-semibold text-zinc-500">No se pudieron leer buckets desde Cloudflare.</p>
          <% end %>
        </div>
      </div>
    </section>

    <section class="mt-6 grid gap-6 lg:grid-cols-2">
      <%= render "storage_table", title: "Active Storage por servicio", columns: ["Servicio", "Objetos", "Tamaño"], rows: storage.fetch(:services), values: ->(row) { [row.name, number_with_delimiter(row.objects), number_to_human_size(row.bytes)] } %>
      <%= render "storage_table", title: "Active Storage por tipo", columns: ["Tipo", "Adjuntos", "Tamaño"], rows: storage.fetch(:record_types), values: ->(row) { [row.name, number_with_delimiter(row.attachments), number_to_human_size(row.bytes)] } %>
    </section>
  </main>
</div>
