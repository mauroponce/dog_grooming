<% content_for :title, "Ingresar a Cita.pet" %>
<% content_for :full_width, true %>
<% content_for :head do %>
  <style>
    .login-bg-grid {
      background-image:
        linear-gradient(rgba(255, 222, 212, 0.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 222, 212, 0.08) 1px, transparent 1px);
      background-size: 34px 34px;
    }

    .login-glass {
      background: rgba(255, 255, 255, 0.82);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
    }
  </style>
<% end %>

<% commercial_whatsapp_url = PhoneNumber.whatsapp_link(ENV.fetch("COMMERCIAL_WHATSAPP_PHONE", "5491112345678"), text: "Hola, quiero activar mi cuenta de Cita.pet.") %>

<div class="relative min-h-screen overflow-hidden bg-white text-slate-900">
  <div class="absolute inset-0 bg-gradient-to-br from-white via-brand-50 to-brand-100"></div>
  <div class="absolute inset-0 login-bg-grid opacity-70"></div>

  <section class="relative z-10 flex min-h-screen items-center justify-center px-5 py-8 sm:px-6">
    <div class="grid w-full max-w-6xl items-center gap-10 lg:grid-cols-[1fr_460px]">
      <aside class="hidden lg:block">
        <%= link_to root_path, class: "inline-flex items-center gap-3", aria: { label: "Ir al inicio de Cita.pet" } do %>
          <div class="h-12 w-12 overflow-hidden rounded-2xl shadow-lg shadow-brand-300/40">
            <%= image_tag "/icon.png?v=4", alt: "", class: "h-full w-full object-cover" %>
          </div>
          <span class="text-2xl font-bold tracking-tight text-slate-950">Cita.pet</span>
        <% end %>

        <div class="mt-16 max-w-xl">
          <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white/75 px-4 py-2 text-sm font-bold text-brand-700 shadow-sm backdrop-blur">
            <span class="h-2 w-2 rounded-full bg-brand-500"></span>
            Acceso privado para centros
          </div>

          <h1 class="text-5xl font-bold leading-tight tracking-tight text-slate-950">
            Entrá a tu panel.
            <span class="block bg-gradient-to-r from-brand-800 via-brand-600 to-brand-500 bg-clip-text text-transparent">
              Con tu email y contraseña.
            </span>
          </h1>

          <p class="mt-6 text-lg leading-8 text-slate-600">
            Las cuentas de Cita.pet son creadas por nuestro equipo. Si tu peluquería canina ya está activada, usá las credenciales que te informamos para entrar al panel.
          </p>

          <div class="mt-10 grid max-w-lg gap-4">
            <div class="flex items-start gap-4 rounded-3xl border border-white/80 bg-white/70 p-5 shadow-sm backdrop-blur">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-brand-100 text-brand-700">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5"/>
                </svg>
              </div>
              <div>
                <h2 class="font-bold text-slate-950">Solo cuentas autorizadas</h2>
                <p class="mt-1 text-sm leading-6 text-slate-600">
                  No hay registro público. Si el email no está activado, no se crea una cuenta nueva automáticamente.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 rounded-3xl border border-white/80 bg-white/70 p-5 shadow-sm backdrop-blur">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-brand-100 text-brand-700">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              </div>
              <div>
                <h2 class="font-bold text-slate-950">Acceso con contraseña</h2>
                <p class="mt-1 text-sm leading-6 text-slate-600">
                  Ingresá con el email de tu cuenta y la contraseña que te comunicó el equipo de Cita.pet.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 rounded-3xl border border-white/80 bg-white/70 p-5 shadow-sm backdrop-blur">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-brand-100 text-brand-700">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M8 7V3m8 4V3M4 11h16M5 5h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"/>
                </svg>
              </div>
              <div>
                <h2 class="font-bold text-slate-950">Pensado para operar rápido</h2>
                <p class="mt-1 text-sm leading-6 text-slate-600">
                  Después de entrar, el centro puede gestionar turnos, servicios, comprobantes y avisos importantes.
                </p>
              </div>
            </div>
          </div>
        </div>
      </aside>

      <section class="mx-auto w-full max-w-md">
        <div class="mb-8 text-center lg:hidden">
        <%= link_to root_path, class: "inline-flex items-center justify-center gap-3", aria: { label: "Ir al inicio de Cita.pet" } do %>
            <div class="h-12 w-12 overflow-hidden rounded-2xl shadow-lg shadow-brand-300/40">
              <%= image_tag "/icon.png?v=4", alt: "", class: "h-full w-full object-cover" %>
            </div>
            <span class="text-2xl font-bold tracking-tight text-slate-950">Cita.pet</span>
          <% end %>
        </div>

        <div class="login-glass rounded-[2rem] border border-white/80 p-6 shadow-soft sm:p-8">
          <div class="mb-8">
            <div class="mb-4 inline-flex rounded-full bg-brand-100 px-3 py-1 text-xs font-bold uppercase tracking-wide text-brand-700">
              Panel de administración
            </div>

            <h2 class="text-3xl font-bold tracking-tight text-slate-950">Ingresar</h2>

            <p class="mt-3 text-sm leading-6 text-slate-600">
              Acceso exclusivo para peluquerías caninas ya activadas por Cita.pet. Usá el email que nos pasaste al crear tu cuenta.
            </p>
          </div>

          <%= form_with url: session_path, class: "space-y-4" do |form| %>
            <div>
              <%= form.label :email_address, "Email de acceso", class: "mb-2 block text-sm font-bold text-slate-800" %>
              <%= form.email_field :email_address,
                required: true,
                autocomplete: "email",
                inputmode: "email",
                placeholder: "tunegocio@gmail.com",
                class: "w-full rounded-2xl border border-slate-200 bg-white px-4 py-4 text-sm font-semibold text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-brand-400 focus:ring-4 focus:ring-brand-100" %>
            </div>

            <div>
              <%= form.label :password, "Contraseña", class: "mb-2 block text-sm font-bold text-slate-800" %>
              <div class="relative" data-controller="password-visibility" data-password-visibility-show-label-value="Mostrar contraseña" data-password-visibility-hide-label-value="Ocultar contraseña">
                <%= form.password_field :password,
                  required: true,
                  autocomplete: "off",
                  placeholder: "Tu contraseña",
                  class: "w-full rounded-2xl border border-slate-200 bg-white px-4 py-4 pr-12 text-sm font-semibold text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-brand-400 focus:ring-4 focus:ring-brand-100",
                  data: { password_visibility_target: "input" } %>
                <button type="button" class="absolute inset-y-0 right-0 grid w-12 place-items-center rounded-r-2xl text-slate-400 transition hover:text-slate-700 focus:outline-none" data-password-visibility-target="button" data-action="password-visibility#toggle" aria-label="Mostrar contraseña" aria-controls="password" aria-pressed="false" title="Mostrar contraseña">
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-password-visibility-target="icon"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" /><circle cx="12" cy="12" r="2.75" /></svg>
                </button>
              </div>
            </div>

            <%= form.submit "Ingresar",
              class: "flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-brand-700 to-brand-600 px-5 py-4 text-sm font-bold text-white shadow-glow transition hover:-translate-y-0.5 hover:shadow-lg active:translate-y-0 focus:outline-none focus:ring-4 focus:ring-brand-200" %>
          <% end %>

          <div class="mt-6 rounded-2xl border border-brand-100 bg-brand-50 p-4">
            <div class="flex gap-3">
              <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-white text-brand-700">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M12 16v-4"/>
                  <path d="M12 8h.01"/>
                </svg>
              </div>
              <p class="text-xs leading-5 text-brand-900">
                ¿Todavía no tenés acceso? Las cuentas se crean manualmente para cada centro. Escribinos y te ayudamos a activarla.
              </p>
            </div>
          </div>

          <p class="mt-6 text-center text-xs leading-5 text-slate-500">
            Al continuar aceptás los
            <a href="#" class="font-bold text-brand-700 hover:text-brand-800">Términos</a>
            y la
            <a href="#" class="font-bold text-brand-700 hover:text-brand-800">Política de privacidad</a>.
          </p>
        </div>

        <p class="mt-6 text-center text-sm text-slate-600">
          ¿Necesitás activar tu cuenta?
          <%= link_to "Escribinos por WhatsApp", commercial_whatsapp_url, target: "_blank", rel: "noopener", class: "font-bold text-brand-700 hover:text-brand-800" %>
        </p>

        <p class="mt-4 text-center text-xs text-slate-400">© 2026 Cita.pet</p>
      </section>
    </div>
  </section>
</div>
