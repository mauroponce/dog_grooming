<div
  class="chat-shell fixed z-50"
  data-controller="chat-widget"
  data-chat-widget-url-value="<%= center_chat_path(@business.slug) %>"
  data-chat-widget-business-name-value="<%= @business.name %>"
  data-chat-widget-services-detail-value="<%= @business.public_chat_services_detail %>"
  data-chat-widget-initials-value="<%= @business.initials %>">
  <%= render "public_booking/chat_contact_card", center: @business %>

  <section data-chat-widget-target="panel" class="chat-panel hidden overflow-hidden rounded-[30px] border border-white/90 bg-white shadow-soft backdrop-blur-xl" aria-label="Asistente virtual de <%= @business.name %>">
    <header class="relative overflow-hidden border-b border-zinc-100 bg-white">
      <div class="absolute inset-x-0 top-0 h-20 bg-gradient-to-r from-brand-600 via-brand-500 to-brand-500"></div>
      <div class="relative p-4">
        <div class="flex items-start justify-between gap-3">
          <div class="flex min-w-0 items-center gap-3">
            <div class="relative grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-ink text-sm font-bold text-white shadow-lg shadow-zinc-900/20">
              <%= @business.initials %>
              <span class="absolute -bottom-0.5 -right-0.5 h-3.5 w-3.5 rounded-full border-2 border-white bg-emerald-500"></span>
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <h2 class="truncate text-sm font-bold text-white"><%= @business.name %></h2>
                <span class="hidden rounded-full bg-white/20 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide text-white/90 sm:inline">En línea</span>
              </div>
              <p class="mt-0.5 truncate text-xs font-semibold text-white/80">Reservas, servicios y horarios</p>
            </div>
          </div>
          <button type="button" data-action="chat-widget#close" class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-white/15 text-white transition hover:bg-white/25" aria-label="Cerrar chat">
            <%= public_icon("close", css: "h-5 w-5") %>
          </button>
        </div>

        <div class="mt-4 rounded-3xl border border-white/60 bg-white/95 p-4 shadow-lg shadow-brand-900/10 backdrop-blur">
          <div class="flex items-start gap-3">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-brand-50 text-brand-700">
              <%= public_icon("spark", css: "h-5 w-5") %>
            </span>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-bold leading-5 text-zinc-950">Hola, soy el asistente de <%= @business.name %>.</p>
              <p class="mt-1 text-xs leading-5 text-zinc-500">Puedo ayudarte a reservar, consultar precios o encontrar un horario disponible.</p>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div data-chat-widget-target="messages" class="hide-scrollbar min-h-0 flex-1 overflow-y-auto bg-[#FAFAFC] px-4 py-4"></div>

    <footer class="border-t border-zinc-100 bg-white p-3">
      <form data-chat-widget-target="form" data-action="submit->chat-widget#submit" class="flex items-end gap-2">
        <label class="min-w-0 flex-1 rounded-2xl border border-zinc-200 bg-white px-3.5 py-2.5 transition focus-within:border-brand-400 focus-within:ring-4 focus-within:ring-brand-100">
          <span class="sr-only">Consulta</span>
          <textarea data-chat-widget-target="input" data-action="input->chat-widget#resizeInput keydown.enter->chat-widget#submitOnEnter" rows="1" class="max-h-24 min-h-6 w-full resize-none bg-transparent text-sm font-semibold leading-6 outline-none placeholder:text-zinc-400" placeholder="Escribí tu consulta..."></textarea>
        </label>
        <button type="submit" class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-ink text-white shadow-button transition hover:-translate-y-0.5 hover:bg-zinc-800" aria-label="Enviar mensaje">
          <%= public_icon("arrow_right", css: "h-5 w-5") %>
        </button>
      </form>
      <div class="mt-2 flex items-center justify-between px-1">
        <button type="button" data-action="chat-widget#requestHuman" class="inline-flex items-center gap-1.5 text-[11px] font-bold text-zinc-400 transition hover:text-zinc-700">
          <%= public_icon("message", css: "h-3.5 w-3.5") %>
          Hablar con una persona
        </button>
        <% unless business.custom_domain_active? %>
          <span class="text-[11px] font-semibold text-zinc-300">Dog Grooming</span>
        <% end %>
      </div>
    </footer>
  </section>

  <button type="button" data-chat-widget-target="launcher" data-action="chat-widget#toggle" aria-expanded="false" class="chat-fab ml-auto flex h-14 items-center gap-3 rounded-2xl bg-ink px-4 text-white shadow-button transition hover:-translate-y-0.5 hover:bg-zinc-800" aria-label="Abrir chat">
    <span class="relative grid h-9 w-9 place-items-center rounded-xl bg-white/10">
      <%= public_icon("message", css: "h-5 w-5") %>
      <span class="absolute -right-1 -top-1 h-3 w-3 rounded-full border-2 border-ink bg-emerald-500"></span>
    </span>
    <span class="pr-1 text-sm font-bold">Consultar por chat</span>
  </button>
</div>
