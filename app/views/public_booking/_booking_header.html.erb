<% show_banner = local_assigns.fetch(:show_banner, true) %>
<% fixed = local_assigns.fetch(:fixed, false) %>
<% hours_status = public_business_hours_status(business) %>
<% hours_state = hours_status.fetch(:state) %>
<% is_open_now = hours_state == "Abierto" %>
<% is_closed_now = hours_state == "Cerrado" %>
<% hours_label = is_open_now ? "Abierto ahora" : hours_state %>
<% hours_icon_class = is_open_now ? "text-emerald-600" : (is_closed_now ? "text-red-500" : "text-brand-600") %>
<% hours_state_class = is_open_now ? "text-emerald-600" : (is_closed_now ? "text-red-500" : "text-zinc-700") %>
<% hours_detail_class = is_closed_now ? "font-bold text-zinc-800" : "text-zinc-600" %>

<header class="<%= fixed ? "fixed inset-x-0 top-0 z-[70]" : "relative z-20" %> border-b border-white/70 bg-white/55 backdrop-blur-xl" data-public-booking-header>
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-4 py-4 sm:px-7 lg:px-10">
    <%= link_to public_business_path(business.slug), class: "min-w-0", data: { turbo_frame: "_top" }, aria: { label: business.name } do %>
      <%= render "public_booking/business_brand",
        business: business,
        logo_size: "h-10 w-10",
        logo_image_size: [ 80, 80 ],
        name_class: "block truncate text-sm font-bold tracking-tight sm:text-base",
        subtitle: business.public_city,
        subtitle_class: "block truncate text-[11px] font-semibold text-zinc-500",
        logo_shadow_class: "shadow-lg shadow-zinc-900/15",
        logo_fallback_class: "grid place-items-center rounded-2xl bg-ink text-white shadow-lg shadow-zinc-900/15" %>
    <% end %>

    <div class="flex shrink-0 items-center gap-2">
      <% if business.contact_phone.present? %>
        <%= link_to "Contactar por WhatsApp", "https://wa.me/#{business.contact_phone.to_s.gsub(/\D/, '')}", class: "inline-flex h-10 items-center justify-center rounded-full border border-white bg-white/80 px-3.5 text-xs font-bold text-zinc-700 shadow-sm transition hover:bg-white", target: "_blank", rel: "noopener" %>
      <% end %>
      <div class="hidden items-center gap-2 rounded-full border border-white bg-white/80 px-3.5 py-2 text-xs font-bold text-zinc-600 shadow-sm sm:flex">
        <%= public_icon("shield", css: "h-4 w-4 text-emerald-600") %>
        Reserva en línea segura
      </div>
    </div>
  </div>
</header>

<% if show_banner %>
  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 pt-7 sm:px-7 sm:pt-10 lg:px-10">
  <section class="mb-6 overflow-hidden rounded-[28px] border border-white/90 bg-white/85 shadow-soft backdrop-blur-xl">
    <div class="grid lg:grid-cols-[1fr_340px]">
      <div class="p-5 sm:p-7 lg:p-8">
        <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <% if business.booking_available? %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-bold text-emerald-700">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                  Turnos disponibles
                </span>
              <% else %>
                <span class="inline-flex rounded-full bg-amber-50 px-2.5 py-1 text-[11px] font-bold text-amber-700">Agenda pausada</span>
              <% end %>
            </div>

            <h1 class="mt-3 text-2xl font-bold tracking-[-.035em] text-zinc-950 sm:text-3xl" data-public-business-title>
              <%= business.name %>
            </h1>
            <% if business.slogan.present? %>
              <p class="mt-2 text-base font-semibold leading-6 text-zinc-500 sm:text-lg"><%= business.slogan %></p>
            <% end %>

            <% directions_url = business.google_maps_directions_url %>
            <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs font-semibold text-zinc-500">
              <% if business.public_location_configured? %>
                <% if directions_url.present? %>
                  <%= link_to directions_url, target: "_blank", rel: "noopener", class: "inline-flex items-center gap-1.5 transition hover:text-brand-700" do %>
                    <%= public_icon("pin", css: "h-4 w-4 text-brand-600") %>
                    <%= business.public_location %>
                  <% end %>
                <% else %>
                  <span class="inline-flex items-center gap-1.5">
                    <%= public_icon("pin", css: "h-4 w-4 text-brand-600") %>
                    <%= business.public_location %>
                  </span>
                <% end %>
              <% end %>
              <span class="inline-flex items-center gap-1.5">
                <%= public_icon("clock", css: "h-4 w-4 #{hours_icon_class}") %>
                <span data-public-hours-status>
                  <span data-public-hours-state class="font-bold <%= hours_state_class %>"><%= hours_label %></span>
                  <% if hours_status.fetch(:detail).present? %>
                    <span class="text-zinc-300">-</span>
                    <span data-public-hours-detail class="<%= hours_detail_class %>"><%= hours_status.fetch(:detail) %></span>
                  <% end %>
                </span>
              </span>
            </div>
        </div>
      </div>

      <div class="relative hidden min-h-[190px] overflow-hidden border-l border-white/80 bg-gradient-to-br from-brand-100 via-brand-50 to-rose-100 lg:block">
        <div class="absolute bottom-[-20px] right-8 h-36 w-36 rotate-12 rounded-[38px] bg-gradient-to-br from-brand-500 to-brand-500 shadow-glow"></div>
        <div class="absolute right-28 top-8 grid h-16 w-16 place-items-center rounded-3xl bg-white/85 text-brand-700 shadow-lg backdrop-blur">
          <%= public_icon("spark", css: "h-8 w-8") %>
        </div>
        <div class="absolute bottom-8 left-10 max-w-[220px] rounded-2xl border border-white bg-white/80 px-4 py-3 shadow-lg backdrop-blur">
          <div class="flex items-start gap-3">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-emerald-50 text-emerald-600">
              <%= public_icon("calendar", css: "h-4 w-4") %>
            </span>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[.14em] text-zinc-400">Reserva en línea</p>
              <p class="mt-1 text-sm font-bold leading-tight text-zinc-900">Confirmación inmediata</p>
              <p class="mt-1 text-[10px] font-semibold leading-4 text-zinc-500">Elegí servicio, fecha y horario.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  </div>
<% end %>
