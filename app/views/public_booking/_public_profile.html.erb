<% show_team_members = business.public_booking_show_team_members? %>
<% professionals = show_team_members ? business.employee_memberships.available_for_booking.with_attached_profile_photo.includes(:branch, user: { profile_photo_attachment: :blob }).order(:sort_order, :name).limit(12).to_a : [] %>
<% osm_embed_url = public_business_osm_embed_url(business) %>
<% location_configured = business.public_location_configured? %>
<% hours_rows = public_business_hours_rows(business) %>
<% professional_services_for = lambda do |professional|
  services.select { |service| service.employee_memberships.blank? || service.employee_memberships.include?(professional) }
end %>
<% selected_professional = professionals.find { |professional| professional.id.to_s == params[:professional_id].to_s } if show_team_members && params[:professional_id].present? %>
<% selected_professional_services = selected_professional.present? ? professional_services_for.call(selected_professional) : [] %>
<% selected_professional_photo = public_professional_photo(selected_professional) if selected_professional.present? %>
<% service_detail = local_assigns[:service_detail] %>
<% selected_service_category = params[:category].presence_in(categories) || categories.first %>

<style>
  .public-page-shell {
    background:
      radial-gradient(circle at 8% 0%, rgba(255, 222, 212, .08), transparent 34%),
      radial-gradient(circle at 92% 8%, rgba(236, 72, 153, .07), transparent 30%),
      #F7F7FA;
  }

  .public-hairline {
    background: linear-gradient(90deg, transparent, rgba(17, 17, 20, .13), transparent);
  }

  .public-services-fade {
    -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 88%, transparent 100%);
    mask-image: linear-gradient(90deg, #000 0%, #000 88%, transparent 100%);
  }

  .public-classic-card {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, .96), rgba(255, 255, 255, .90)),
      #fff;
  }

  .public-hours-section {
    max-width: min(100%, 560px);
  }

  .public-hours-map-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .public-hours-map-grid {
      grid-template-columns: minmax(260px, 420px) minmax(0, 1fr);
      align-items: stretch;
    }
  }

</style>

<main class="public-page-shell relative min-h-screen overflow-x-hidden text-ink antialiased">
  <div class="pointer-events-none absolute left-[-160px] top-[120px] h-[360px] w-[360px] rounded-full bg-brand-100 opacity-60 blur-3xl"></div>
  <div class="pointer-events-none absolute right-[-180px] top-[180px] h-[440px] w-[440px] rounded-full bg-brand-100 opacity-50 blur-3xl"></div>

  <%= render "public_booking/booking_header", business: business %>

  <div class="pointer-events-none fixed inset-x-0 top-0 z-40 -translate-y-full border-b border-zinc-200 bg-white/95 pt-[env(safe-area-inset-top)] opacity-0 shadow-[0_12px_30px_rgba(17,17,20,.06)] backdrop-blur transition duration-200 ease-out" data-controller="public-section-nav" data-public-section-nav-title-selector-value="[data-public-business-title]">
    <div class="mx-auto flex max-w-7xl flex-col px-4 sm:px-7 lg:h-16 lg:flex-row lg:items-center lg:justify-between lg:px-10">
      <div class="flex h-12 min-w-0 items-center gap-3 lg:h-16">
        <%= link_to root_path, class: "grid h-10 w-10 shrink-0 place-items-center rounded-full text-zinc-950 lg:hidden", aria: { label: "Volver" } do %>
          <%= public_icon("arrow_left", css: "h-5 w-5") %>
        <% end %>

        <%= render "public_booking/business_brand",
          business: business,
          logo_size: "h-9 w-9 lg:h-10 lg:w-10",
          logo_image_size: [ 80, 80 ],
          name_class: "truncate text-[17px] font-bold tracking-[-0.02em] lg:text-lg",
          logo_shadow_class: "shadow-sm shadow-zinc-900/10",
          logo_fallback_class: "grid place-items-center rounded-full bg-gradient-to-br from-brand-700 via-brand-600 to-brand-600 text-[11px] font-bold text-white shadow-sm shadow-zinc-900/10" %>
      </div>

      <nav class="hide-scrollbar flex gap-7 overflow-x-auto text-[13px] font-semibold lg:gap-8 lg:overflow-visible lg:text-sm" aria-label="Navegación del perfil público">
        <a href="#services-section" data-public-section-nav-target="link" class="shrink-0 border-b-2 border-transparent pb-3 pt-2 text-zinc-500 transition lg:py-5">
          Servicios
        </a>
        <% if show_team_members %>
          <a href="#team-section" data-public-section-nav-target="link" class="shrink-0 border-b-2 border-transparent pb-3 pt-2 text-zinc-500 transition lg:py-5">
            Equipo
          </a>
        <% end %>
        <a href="#hours-section" data-public-section-nav-target="link" class="shrink-0 border-b-2 border-transparent pb-3 pt-2 text-zinc-500 transition lg:py-5">
          Horarios
        </a>
      </nav>
    </div>
  </div>

  <section class="relative z-10 mx-auto w-full max-w-7xl px-4 pb-10 sm:px-7 sm:pb-12 lg:px-10">
    <section class="grid gap-10 lg:items-start">
      <div class="min-w-0">
        <section id="services-section" class="scroll-mt-24" data-controller="public-services" data-public-services-initial-category-value="<%= selected_service_category %>" data-public-services-persist-category-value="true">
          <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_390px] lg:items-start">
            <div class="min-w-0">
              <h2 class="mb-6 text-4xl font-bold tracking-tight">Seleccionar servicio</h2>

              <div class="public-mobile-pill-rail" data-public-services-target="rail" role="region" aria-label="Categorías de servicios" tabindex="0">
                <% categories.each do |category| %>
                  <% active_category = category == selected_service_category %>
                  <button type="button" data-public-services-target="tab" data-action="public-services#selectCategory" data-category="<%= category %>" class="rounded-full px-4 py-2 text-sm font-bold <%= active_category ? "bg-zinc-950 text-white" : "border border-zinc-200 bg-white text-zinc-800 hover:border-zinc-950" %>"><%= category %></button>
                <% end %>
              </div>

              <% active_category = selected_service_category %>
              <div class="mt-8 space-y-4">
                <h2 class="text-lg font-bold" data-public-services-target="heading"><%= active_category.presence || "Servicio" %></h2>
                <% services.each do |service| %>
                  <%= render "public_booking/service_card",
                    business: business,
                    service: service,
                    detail_path: public_business_path(business.slug, category: service.category_label, service_detail: service.slug, anchor: "services-section"),
                    action_path: short_public_service_path(business.slug, service.slug),
                    action_label: "Reservar" %>
                <% end %>
              </div>

              <div data-public-services-target="empty" class="mt-5 hidden rounded-2xl border border-dashed border-zinc-200 bg-zinc-50 p-10 text-center">
                <p class="font-bold text-zinc-800">No hay servicios en esta categoría</p>
              </div>
            </div>

            <%= render "public_booking/public_service_summary", business: business %>
          </div>
        </section>

        <% if show_team_members %>
          <section id="team-section" class="mt-12 scroll-mt-24">
            <div class="flex items-center justify-between gap-4">
              <div>
                <h2 class="text-3xl font-bold tracking-[-.04em]">Equipo</h2>
                <div class="public-hairline mt-4 h-px w-32"></div>
              </div>
              <% if professionals.many? %>
                <a href="#team-section" class="text-sm font-bold text-brand-700">Ver todo</a>
              <% end %>
            </div>

            <% if professionals.any? %>
              <div class="hide-scrollbar mt-7 flex gap-10 overflow-x-auto pb-2">
                <% professionals.each do |professional| %>
                  <% professional_photo = public_professional_photo(professional) %>
                  <%= link_to public_business_path(business.slug, professional_id: professional.id, anchor: "team-section"), class: "w-28 shrink-0 text-center" do %>
                    <div class="mx-auto grid place-items-center overflow-hidden rounded-full bg-zinc-100 text-xl font-bold text-zinc-600 shadow-sm ring-1 ring-zinc-200" style="width: 96px; height: 96px; border-radius: 9999px;">
                      <% if professional_photo.present? %>
                        <%= image_tag professional_photo.variant(resize_to_fill: [ 192, 192 ]), alt: professional.name, class: "h-full w-full object-cover" %>
                      <% else %>
                        <%= professional.initials.presence || business.initials %>
                      <% end %>
                    </div>
                    <h3 class="mt-3 truncate text-base font-bold"><%= professional.name %></h3>
                    <p class="mt-1 truncate text-sm font-semibold text-[#6f6a65]"><%= professional.specialty.presence || professional.specialty_label %></p>
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <p class="mt-5 rounded-[26px] border border-[#e7e2da] bg-white/85 p-5 text-sm font-semibold leading-6 text-[#6f6a65]">El equipo se informa al reservar.</p>
            <% end %>
          </section>
        <% end %>

        <section id="hours-section" class="mt-14 scroll-mt-24">
          <h2 class="text-3xl font-bold tracking-[-.04em]">Horarios</h2>
          <div class="public-hairline mt-4 h-px w-32"></div>

          <div class="<%= location_configured ? "public-hours-map-grid mt-10" : "mt-10" %>">
            <div class="public-hours-section lg:pt-1">
              <div class="space-y-4">
                <% hours_rows.each do |row| %>
                  <div class="flex items-center gap-4 text-base">
                    <span class="h-3 w-3 rounded-full <%= row[:open] ? "bg-emerald-500" : "bg-zinc-300" %>"></span>
                    <span class="min-w-0 flex-1 font-semibold text-[#6f6a65]"><%= row[:label] %></span>
                    <span class="font-semibold text-zinc-800"><%= row[:time] %></span>
                  </div>
                <% end %>
              </div>

              <% if location_configured %>
                <p class="mt-8 text-base leading-7 text-zinc-950 lg:hidden">
                  <%= business.public_location %>
                  <% if business.google_maps_directions_url.present? %>
                    <%= link_to "Cómo llegar", business.google_maps_directions_url, target: "_blank", rel: "noopener", class: "font-bold text-brand-700" %>
                  <% end %>
                </p>
              <% end %>
            </div>

            <% if location_configured %>
              <div>
              <% if osm_embed_url.present? %>
                <div class="overflow-hidden rounded-[24px] border border-[#e7e2da] bg-white shadow-[0_14px_34px_rgba(17,17,20,.07)]">
                  <iframe src="<%= osm_embed_url %>" title="Mapa de <%= business.name %>" class="w-full border-0" style="height: 360px;" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
              <% end %>

                <p class="<%= "mt-4" if osm_embed_url.present? %> hidden text-base leading-7 text-zinc-950 lg:block">
                  <%= business.public_location %>
                  <% if business.google_maps_directions_url.present? %>
                    <%= link_to "Cómo llegar", business.google_maps_directions_url, target: "_blank", rel: "noopener", class: "font-bold text-brand-700" %>
                  <% end %>
                </p>
              </div>
            <% end %>
          </div>
        </section>
      </div>
    </section>
  </section>

  <footer class="relative z-10 border-t border-white/70 bg-white/55 backdrop-blur-xl">
    <div class="mx-auto w-full max-w-7xl px-4 py-5 text-center sm:px-7 lg:px-10">
      <% unless business.custom_domain_active? %>
        <p class="text-xs font-semibold text-zinc-500">
          Reservas online con
          <%= link_to "Cita.pet", "https://cita.pet", target: "_blank", rel: "noopener", class: "font-bold text-brand-700 underline decoration-brand-300 underline-offset-4 hover:text-brand-800" %>
        </p>
      <% end %>
    </div>
  </footer>

  <% if service_detail.present? %>
    <%= render "public_booking/service_detail_modal",
      business: business,
      service: service_detail,
      close_path: public_business_path(business.slug, category: selected_service_category, anchor: "services-section"),
      reserve_path: short_public_service_path(business.slug, service_detail.slug) %>
  <% end %>

  <% if selected_professional.present? %>
    <div class="fixed inset-0 z-50 overflow-y-auto bg-zinc-950/45 px-4 py-6 backdrop-blur-sm" data-public-professional-modal>
      <div class="mx-auto flex min-h-full items-start justify-center">
        <div class="relative flex w-full max-w-[720px] flex-col overflow-hidden rounded-[30px] bg-white shadow-2xl" style="max-height: calc(100dvh - 48px);" data-public-professional-dialog>
          <div class="overflow-y-auto">
            <section class="relative px-8 pb-8 pt-10 sm:px-12">
              <%= link_to public_business_path(business.slug), class: "absolute right-7 top-8 grid h-10 w-10 place-items-center rounded-full text-zinc-950 hover:bg-zinc-100", aria: { label: "Cerrar perfil" } do %>
                <%= public_icon("close", css: "h-5 w-5") %>
              <% end %>

              <div class="text-center">
                <div class="mx-auto grid place-items-center overflow-hidden rounded-full bg-zinc-100 text-4xl font-bold text-zinc-600 shadow-sm ring-1 ring-zinc-200" style="width: 188px; height: 188px; border-radius: 9999px;">
                  <% if selected_professional_photo.present? %>
                    <%= image_tag selected_professional_photo.variant(resize_to_fill: [ 376, 376 ]), alt: selected_professional.name, class: "h-full w-full object-cover" %>
                  <% else %>
                    <%= selected_professional.initials %>
                  <% end %>
                </div>
                <h3 class="mt-5 text-[26px] font-bold leading-tight tracking-[-0.03em]"><%= selected_professional.name %></h3>
                <p class="mt-1 text-base font-semibold text-zinc-700"><%= selected_professional.specialty.presence || selected_professional.specialty_label %></p>
              </div>
            </section>

            <section class="bg-zinc-100 px-8 py-8 sm:px-12">
              <h3 class="text-xl font-bold">Servicios</h3>
              <% if selected_professional_services.any? %>
                <div class="mt-5 space-y-3">
                  <% selected_professional_services.each do |service| %>
                    <article class="rounded-2xl border border-zinc-200 bg-white p-5">
                      <div class="flex items-center justify-between gap-5">
                        <div class="min-w-0">
                          <h4 class="text-base font-semibold leading-6"><%= service.name %></h4>
                          <p class="mt-1 text-sm text-zinc-500"><%= public_service_duration_label(service.duration_minutes) %></p>
                          <p class="mt-4 text-sm font-bold"><%= public_service_price_ars(service) %></p>
                        </div>
                        <%= link_to "Reservar", short_public_service_path(business.slug, service.slug, step: "schedule", professional_mode: "single", employee_membership_id: selected_professional.id), class: "shrink-0 rounded-full border border-zinc-300 bg-white px-5 py-3 text-sm font-bold hover:border-black" %>
                      </div>
                    </article>
                  <% end %>
                </div>
              <% else %>
                <p class="mt-5 rounded-2xl border border-zinc-200 bg-white p-5 text-sm font-semibold text-zinc-500">Este miembro del equipo todavía no tiene servicios públicos asignados.</p>
              <% end %>
            </section>
          </div>

          <% if selected_professional_services.first.present? %>
            <div class="border-t border-zinc-200 bg-white px-8 py-4 sm:px-12">
              <%= link_to "Reservar ahora", short_public_service_path(business.slug, selected_professional_services.first.slug, step: "schedule", professional_mode: "single", employee_membership_id: selected_professional.id), class: "flex h-12 w-full items-center justify-center rounded-full bg-zinc-950 text-sm font-bold text-white" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</main>
