<template data-chat-widget-target="contactTemplate">
  <article class="grid gap-3 rounded-3xl border border-zinc-100 bg-white p-3">
    <% maps_url = center.google_maps_directions_url %>
    <div>
      <p class="text-[10px] font-bold uppercase tracking-[.13em] text-brand-700">Ubicación y contacto</p>
      <h3 class="mt-1 text-base font-bold text-zinc-950"><%= center.name %></h3>
      <% if center.public_location_configured? %>
        <% if maps_url.present? %>
          <%= link_to maps_url, target: "_blank", rel: "noopener", class: "mt-1 inline-flex text-left text-[11px] font-semibold leading-5 text-zinc-500 underline decoration-zinc-300 underline-offset-4 transition hover:text-zinc-900", aria: { label: "Abrir ubicación en Google Maps" } do %>
            <%= center.public_location %>
          <% end %>
        <% else %>
          <p class="mt-1 text-[11px] font-semibold leading-5 text-zinc-500"><%= center.public_location %></p>
        <% end %>
      <% end %>
    </div>

    <p class="flex min-h-11 items-center justify-center gap-2 rounded-2xl bg-emerald-600 px-3 py-2 text-center text-xs font-bold text-white shadow-lg shadow-emerald-600/15"><%= center.public_phone %></p>

    <% if center.geocoded? %>
      <div class="relative overflow-hidden rounded-2xl border border-zinc-100 bg-zinc-50">
        <div
          data-chat-map
          data-latitude="<%= center.latitude.to_f %>"
          data-longitude="<%= center.longitude.to_f %>"
          class="h-48 w-full rounded-2xl bg-zinc-100"
          aria-label="Mapa de <%= center.name %>">
        </div>

        <a href="<%= maps_url %>" target="_blank" rel="noopener" class="absolute inset-0 z-10" aria-label="Abrir navegación en Google Maps">
          <span class="sr-only">Abrir navegación en Google Maps</span>
        </a>

        <a href="<%= maps_url %>" target="_blank" rel="noopener" class="absolute bottom-2 right-2 z-20 rounded-2xl bg-zinc-950 px-3 py-2 text-xs font-bold text-white shadow-lg shadow-zinc-900/20 transition hover:bg-zinc-800">
          Cómo llegar
        </a>
      </div>
    <% else %>
      <div class="rounded-2xl border border-amber-200 bg-amber-50 px-3 py-3 text-xs font-bold leading-5 text-amber-800">
        Este negocio todavía no cargó una ubicación exacta para mostrar el mapa.
      </div>
    <% end %>
  </article>
</template>
