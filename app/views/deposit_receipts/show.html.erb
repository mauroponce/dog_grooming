<% content_for :title, "Comprobante de seña" %>
<% content_for :full_width, true %>

<% file_name = @appointment.deposit_receipt.attached? ? @appointment.deposit_receipt.filename.to_s : nil %>
<% uploaded_label = @appointment.deposit_submitted_at.present? ? format_ar_datetime(@appointment.deposit_submitted_at) : nil %>
<% upload_accept = ".jpg,.jpeg,.png,.webp,.pdf,image/jpeg,image/png,image/webp,application/pdf" %>
<% upload_input_classes = "block w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm font-semibold text-zinc-700 file:mr-4 file:rounded-xl file:border-0 file:bg-zinc-950 file:px-4 file:py-2.5 file:text-xs file:font-bold file:text-white" %>
<% primary_button_classes = "inline-flex h-12 w-full cursor-pointer items-center justify-center rounded-2xl bg-zinc-950 px-5 text-sm font-bold text-white shadow-lg shadow-zinc-900/15 transition hover:bg-zinc-800" %>
<% secondary_link_classes = "inline-flex h-12 w-full items-center justify-center rounded-2xl border border-zinc-200 bg-white px-5 text-sm font-bold text-zinc-800 shadow-sm transition hover:bg-zinc-50" %>
<% receipt_token = params[:token].presence || @appointment.deposit_upload_token %>
<% payment_account = @appointment.service.effective_payment_account %>
<% payment_details = @appointment.service.deposit_payment_details %>
<% payment_link = @appointment.service.external_payment_link.presence || (payment_account.blank? ? @business.deposit_payment_link.presence : nil) %>

<div class="min-h-screen bg-[#F7F7FA] px-4 py-6 text-zinc-950 sm:px-6 sm:py-10">
  <div class="mx-auto grid max-w-5xl gap-5 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-start">
    <header class="lg:col-span-2">
      <div class="flex items-center gap-3">
        <div class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-zinc-950 text-sm font-bold text-white shadow-lg shadow-zinc-900/15"><%= @business.initials %></div>
        <div class="min-w-0">
          <p class="text-xs font-bold uppercase tracking-[.16em] text-brand-700">Link seguro</p>
          <h1 class="truncate text-2xl font-bold tracking-tight sm:text-3xl"><%= @business.name %></h1>
        </div>
      </div>
    </header>

    <main class="rounded-[32px] border border-white bg-white p-5 shadow-card sm:p-7">
      <% case @receipt_state %>
      <% when :empty %>
        <div>
          <span class="inline-flex rounded-full bg-brand-50 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[.12em] text-brand-700">Comprobante de seña</span>
          <h2 class="mt-4 text-3xl font-bold tracking-tight">Comprobante de seña</h2>
          <p class="mt-3 text-sm font-semibold leading-6 text-zinc-600">Transferí la seña y subí el comprobante desde este link. El turno queda confirmado cuando el centro lo revisa.</p>
        </div>

        <section class="mt-6 rounded-[24px] border border-zinc-200 bg-zinc-50 p-4">
          <p class="text-sm font-bold text-zinc-950">Datos para transferir</p>

          <% if payment_account.present? %>
            <p class="mt-4 text-xs font-bold uppercase tracking-[.14em] text-brand-700"><%= payment_account.display_name %></p>
          <% end %>

          <% if payment_details.present? %>
            <p class="mt-3 whitespace-pre-line rounded-2xl bg-white p-4 text-sm font-semibold leading-6 text-zinc-700"><%= payment_details %></p>
          <% elsif payment_link.present? %>
            <p class="mt-3 rounded-2xl bg-white p-4 text-sm font-semibold leading-6 text-zinc-500">Usá el enlace de pago del centro y luego subí el comprobante.</p>
          <% else %>
            <p class="mt-3 rounded-2xl bg-white p-4 text-sm font-semibold leading-6 text-zinc-500">El centro todavía no cargó datos de cuenta. Contactalo por WhatsApp antes de transferir.</p>
          <% end %>

          <% if payment_link.present? %>
            <%= link_to "Abrir enlace de pago", payment_link, target: "_blank", rel: "noopener", class: "mt-4 inline-flex h-11 w-full items-center justify-center rounded-2xl bg-zinc-950 px-4 text-sm font-bold text-white" %>
          <% end %>
        </section>

        <%= form_with url: deposit_receipt_path(receipt_token), class: "mt-6 grid gap-4", html: { multipart: true } do %>
          <div>
            <%= label_tag :deposit_receipt, "Subir comprobante", class: "mb-2 block text-sm font-bold text-zinc-900" %>
            <%= file_field_tag :deposit_receipt, required: true, accept: upload_accept, class: upload_input_classes %>
            <p class="mt-2 text-xs font-semibold leading-5 text-zinc-500">Formatos permitidos: JPG, JPEG, PNG, WebP o PDF. Máximo 5 MB.</p>
          </div>
          <%= submit_tag "Enviar comprobante", class: primary_button_classes %>
        <% end %>

      <% when :pending_review %>
        <section class="rounded-[28px] border border-emerald-200 bg-emerald-50 p-5 sm:p-6">
          <span class="inline-flex rounded-full bg-white px-3 py-1.5 text-[11px] font-bold uppercase tracking-[.12em] text-emerald-700">En revisión</span>
          <h2 class="mt-4 text-3xl font-bold tracking-tight text-zinc-950">Comprobante recibido</h2>
          <p class="mt-3 text-sm font-semibold leading-6 text-emerald-900">Tu comprobante quedó en revisión. El centro va a revisar la seña y te va a contactar por WhatsApp para confirmar.</p>
        </section>

        <dl class="mt-6 grid gap-3 rounded-[24px] border border-zinc-200 bg-white p-4 text-sm">
          <div class="flex justify-between gap-4"><dt class="font-semibold text-zinc-500">Servicio</dt><dd class="text-right font-bold text-zinc-950"><%= @appointment.service.name %></dd></div>
          <div class="flex justify-between gap-4"><dt class="font-semibold text-zinc-500">Fecha</dt><dd class="text-right font-bold text-zinc-950"><%= format_ar_date(@appointment.starts_at) %></dd></div>
          <div class="flex justify-between gap-4"><dt class="font-semibold text-zinc-500">Hora</dt><dd class="text-right font-bold text-zinc-950"><%= format_ar_time(@appointment.starts_at) %></dd></div>
          <div class="flex justify-between gap-4"><dt class="font-semibold text-zinc-500">Seña</dt><dd class="text-right font-bold text-zinc-950"><%= @appointment.formatted_deposit_amount %></dd></div>
          <% if file_name.present? %>
            <div class="flex justify-between gap-4"><dt class="font-semibold text-zinc-500">Archivo</dt><dd class="truncate text-right font-bold text-zinc-950"><%= file_name %></dd></div>
          <% end %>
          <% if uploaded_label.present? %>
            <div class="flex justify-between gap-4"><dt class="font-semibold text-zinc-500">Enviado</dt><dd class="text-right font-bold text-zinc-950"><%= uploaded_label %></dd></div>
          <% end %>
          <div class="flex justify-between gap-4"><dt class="font-semibold text-zinc-500">Estado</dt><dd class="text-right font-bold text-amber-700">En revisión</dd></div>
        </dl>

        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <%= link_to "Volver a WhatsApp", @appointment.manual_whatsapp_url, target: "_blank", rel: "noopener", class: primary_button_classes %>
          <%= link_to "Subí otro comprobante", deposit_receipt_path(receipt_token, replace: 1), class: secondary_link_classes %>
        </div>
        <p class="mt-4 text-sm font-semibold leading-6 text-zinc-500">Si el archivo era correcto, no tenés que hacer nada más.</p>

      <% when :replacement %>
        <section class="rounded-[28px] border border-amber-200 bg-amber-50 p-5 sm:p-6">
          <span class="inline-flex rounded-full bg-white px-3 py-1.5 text-[11px] font-bold uppercase tracking-[.12em] text-amber-700">Reemplazo</span>
          <h2 class="mt-4 text-3xl font-bold tracking-tight text-zinc-950">¿Subiste el archivo equivocado?</h2>
          <p class="mt-3 text-sm font-semibold leading-6 text-amber-900">Si subís un nuevo comprobante, va a reemplazar el anterior. El centro revisará únicamente el último archivo enviado.</p>
        </section>

        <% if file_name.present? %>
          <p class="mt-5 rounded-2xl border border-zinc-200 bg-zinc-50 p-4 text-sm font-semibold leading-6 text-zinc-600">Archivo actual: <span class="font-bold text-zinc-950"><%= file_name %></span></p>
        <% end %>

        <%= form_with url: deposit_receipt_path(receipt_token), class: "mt-6 grid gap-4", html: { multipart: true } do %>
          <div>
            <%= label_tag :deposit_receipt, "Nuevo comprobante", class: "mb-2 block text-sm font-bold text-zinc-900" %>
            <%= file_field_tag :deposit_receipt, required: true, accept: upload_accept, class: upload_input_classes %>
            <p class="mt-2 text-xs font-semibold leading-5 text-zinc-500">Formatos permitidos: JPG, JPEG, PNG, WebP o PDF. Máximo 5 MB.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <%= submit_tag "Reemplazar comprobante", class: primary_button_classes %>
            <%= link_to "Cancelar", deposit_receipt_path(receipt_token), class: secondary_link_classes %>
          </div>
        <% end %>

      <% when :approved %>
        <section class="rounded-[28px] border border-emerald-200 bg-emerald-50 p-5 sm:p-6">
          <span class="inline-flex rounded-full bg-white px-3 py-1.5 text-[11px] font-bold uppercase tracking-[.12em] text-emerald-700">Turno confirmado</span>
          <h2 class="mt-4 text-3xl font-bold tracking-tight text-zinc-950">Seña aprobada</h2>
          <p class="mt-3 text-sm font-semibold leading-6 text-emerald-900">Tu seña fue aprobada y tu turno está confirmado. No necesitás subir otro comprobante.</p>
        </section>
        <%= link_to "Consultar por WhatsApp", @appointment.manual_whatsapp_url, target: "_blank", rel: "noopener", class: "mt-6 #{primary_button_classes}" %>

      <% when :rejected %>
        <section class="rounded-[28px] border border-rose-200 bg-rose-50 p-5 sm:p-6">
          <span class="inline-flex rounded-full bg-white px-3 py-1.5 text-[11px] font-bold uppercase tracking-[.12em] text-rose-700">Rechazado</span>
          <h2 class="mt-4 text-3xl font-bold tracking-tight text-zinc-950">Necesitamos otro comprobante</h2>
          <p class="mt-3 text-sm font-semibold leading-6 text-rose-900">El centro no pudo validar el archivo anterior.</p>
          <% if @appointment.deposit_rejection_reason.present? %>
            <p class="mt-4 rounded-2xl bg-white p-4 text-sm font-semibold leading-6 text-rose-900"><span class="font-bold">Motivo:</span> <%= @appointment.deposit_rejection_reason %></p>
          <% end %>
        </section>

        <%= form_with url: deposit_receipt_path(receipt_token), class: "mt-6 grid gap-4", html: { multipart: true } do %>
          <div>
            <%= label_tag :deposit_receipt, "Nuevo comprobante", class: "mb-2 block text-sm font-bold text-zinc-900" %>
            <%= file_field_tag :deposit_receipt, required: true, accept: upload_accept, class: upload_input_classes %>
            <p class="mt-2 text-xs font-semibold leading-5 text-zinc-500">Formatos permitidos: JPG, JPEG, PNG, WebP o PDF. Máximo 5 MB.</p>
          </div>
          <%= submit_tag "Enviar nuevo comprobante", class: primary_button_classes %>
        <% end %>

      <% else %>
        <section class="rounded-[28px] border border-zinc-200 bg-zinc-50 p-5 sm:p-6">
          <span class="inline-flex rounded-full bg-white px-3 py-1.5 text-[11px] font-bold uppercase tracking-[.12em] text-zinc-600">No disponible</span>
          <h2 class="mt-4 text-3xl font-bold tracking-tight text-zinc-950">Este turno ya no permite subir comprobante</h2>
          <p class="mt-3 text-sm font-semibold leading-6 text-zinc-600">El turno fue cancelado, venció o ya no está disponible. Contactá al centro por WhatsApp para coordinar una nueva reserva.</p>
        </section>
        <%= link_to "Contactar por WhatsApp", @appointment.manual_whatsapp_url, target: "_blank", rel: "noopener", class: "mt-6 #{primary_button_classes}" %>
      <% end %>
    </main>

    <aside class="rounded-[32px] border border-white bg-white p-5 shadow-card sm:p-6">
      <p class="text-xs font-bold uppercase tracking-[.14em] text-brand-700">Reserva</p>
      <h2 class="mt-3 text-xl font-bold tracking-tight"><%= @appointment.service.name %></h2>
      <dl class="mt-5 grid gap-3 text-sm">
        <div class="flex justify-between gap-4 border-b border-zinc-100 pb-3">
          <dt class="font-semibold text-zinc-500">Fecha</dt>
          <dd class="text-right font-bold text-zinc-950"><%= format_ar_date(@appointment.starts_at) %></dd>
        </div>
        <div class="flex justify-between gap-4 border-b border-zinc-100 pb-3">
          <dt class="font-semibold text-zinc-500">Hora</dt>
          <dd class="text-right font-bold text-zinc-950"><%= format_ar_time(@appointment.starts_at) %></dd>
        </div>
        <div class="flex justify-between gap-4 border-b border-zinc-100 pb-3">
          <dt class="font-semibold text-zinc-500">Cliente</dt>
          <dd class="text-right font-bold text-zinc-950"><%= @appointment.customer_name %></dd>
        </div>
        <div class="flex justify-between gap-4 border-b border-zinc-100 pb-3">
          <dt class="font-semibold text-zinc-500">Seña</dt>
          <dd class="text-right font-bold text-zinc-950"><%= @appointment.formatted_deposit_amount %></dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="font-semibold text-zinc-500">Estado</dt>
          <dd class="text-right font-bold text-zinc-950"><%= appointment_deposit_status_label(@appointment) %></dd>
        </div>
      </dl>

      <%= link_to "WhatsApp", @appointment.manual_whatsapp_url, target: "_blank", rel: "noopener", class: "mt-6 inline-flex h-11 w-full items-center justify-center rounded-2xl border border-emerald-200 bg-emerald-50 px-4 text-sm font-bold text-emerald-700 transition hover:bg-emerald-100" %>
    </aside>
  </div>
</div>
